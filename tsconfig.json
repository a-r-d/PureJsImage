{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "paths": {
      "purejsimage": ["./src/index.ts"],
      "purejsimage/analysis": ["./src/analysis/index.ts"],
      "purejsimage/extensions": ["./src/extensions/index.ts"],
      "purejsimage/operations": ["./src/operations/index.ts"],
      "purejsimage/pathology": ["./src/pathology/index.ts"],
      "purejsimage/scientific": ["./src/scientific/index.ts"],
      "purejsimage/scientific/browser": ["./src/scientific/browser.ts"],
      "purejsimage/scientific/node": ["./src/scientific/node.ts"],
      "purejsimage/tiff": ["./src/tiff/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "docs-astro/src/**/*.ts",
    "benchmark/**/*.ts",
    "browser-tests/**/*.ts",
    "playwright.config.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": ["benchmark/scripts/verify-tiff-encode.ts"]
}
