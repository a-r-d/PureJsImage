---
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import '../styles/global.css'

interface Props {
  readonly title: string
  readonly description?: string
  readonly canonical?: string
  readonly bodyClass?: string
  readonly current?: string
  readonly home?: boolean
  readonly hideHeader?: boolean
  readonly noindex?: boolean
  readonly analytics?: boolean
  readonly skipLabel?: string
  readonly openGraph?: {
    readonly title: string
    readonly description: string
    readonly url: string
    readonly image?: string
    readonly imageAlt?: string
    readonly imageHeight?: number
    readonly imageWidth?: number
  }
  readonly twitterCard?: string
}

const {
  title,
  description,
  canonical,
  bodyClass,
  current,
  home = false,
  hideHeader = false,
  noindex = false,
  analytics = true,
  skipLabel,
  openGraph,
  twitterCard,
} = Astro.props
const base = import.meta.env.BASE_URL
const assetBase = base.endsWith('/') ? base : `${base}/`

// Every page with a canonical URL gets share tags. Pages without their own image use the site card.
const siteImage = {
  image: 'https://purejsimage.com/assets/purejsimage-og.png',
  imageAlt: 'PureJsImage: image codecs and scientific raster readers in strict TypeScript',
  imageWidth: 1200,
  imageHeight: 630,
}
const pageOpenGraph =
  openGraph ??
  (canonical ? { title, description: description ?? title, url: canonical } : undefined)
const og = pageOpenGraph?.image
  ? pageOpenGraph
  : pageOpenGraph && { ...pageOpenGraph, ...siteImage }
const card = twitterCard ?? (og ? 'summary_large_image' : undefined)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f6f7f2" />
    {
      og && (
        <>
          <meta property="og:title" content={og.title} />
          <meta property="og:description" content={og.description} />
          <meta property="og:type" content="website" />
          <meta property="og:url" content={og.url} />
          {og.image && <meta property="og:image" content={og.image} />}
          {og.imageAlt && <meta property="og:image:alt" content={og.imageAlt} />}
          {og.imageWidth && <meta property="og:image:width" content={og.imageWidth} />}
          {og.imageHeight && <meta property="og:image:height" content={og.imageHeight} />}
          {og.image && <meta name="twitter:image" content={og.image} />}
          {og.imageAlt && <meta name="twitter:image:alt" content={og.imageAlt} />}
          <meta name="twitter:title" content={og.title} />
          <meta name="twitter:description" content={og.description} />
        </>
      )
    }
    {card && <meta name="twitter:card" content={card} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href={`${assetBase}favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.dataset.theme =
        localStorage.getItem('purejsimage-theme') ||
        (matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light')
    </script>
    <script is:inline define:vars={{ analytics }}>
      if (analytics && location.hostname === 'purejsimage.com') {
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          window.dataLayer.push(arguments);
        };
        window.gtag('js', new Date());
        window.gtag('config', 'G-XHT55R2H3N');
        var script = document.createElement('script');
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtag/js?id=G-XHT55R2H3N';
        document.head.appendChild(script);
      }
    </script>
  </head>
  <body class={bodyClass}>
    {!hideHeader && <SiteHeader current={current} home={home} skipLabel={skipLabel} />}
    <slot />
    <SiteFooter />
    <script>
      import { initializeSite } from '../scripts/site'

      initializeSite()
    </script>
  </body>
</html>
