---
import alphaCompression from '../../../../benchmark/jpegxl/comparison/results/alpha-palette-production-controls.json'
import alphaDirect from '../../../../benchmark/jpegxl/comparison/results/alpha-point-production-controls.json'
import historicalPhotoCompression from '../../../../benchmark/jpegxl/comparison/results/filter-ac-production-controls.json'
import dcCompression from '../../../../benchmark/jpegxl/comparison/results/photo-parity-production-controls.json'
import originalPhoto from '../../../../benchmark/jpegxl/comparison/results/original-photo-production-controls.json'
import denseLossless from '../../../../benchmark/jpegxl/comparison/results/lossless-dense-training-production-controls.json'
import groupLossless from '../../../../benchmark/jpegxl/comparison/results/lossless-group-search-production-controls.json'
import repeatedLossless from '../../../../benchmark/jpegxl/comparison/results/lossless-rct-production-controls.json'
import compressionLossless from '../../../../benchmark/jpegxl/comparison/results/parity-funded-sampling-effort1-public.json'
import compressionLossless7 from '../../../../benchmark/jpegxl/comparison/results/parity-funded-sampling-effort7-public.json'
import compressionQuality from '../../../../benchmark/jpegxl/comparison/results/quality-funded-sampling-public.json'
import supplementalQuality from '../../../../benchmark/jpegxl/comparison/results/quality-photo-frontier-extension.json'
import subjectManifest from '../../../../benchmark/jpegxl/comparison/subjects.json'
import raw from '../../../../benchmark/jpegxl/comparison/website-data.json'
import crops from '../../data/jpegxl-comparison-crops.json'
import Layout from '../../layouts/JpegXlLayout.astro'

const record = (v: unknown): v is Record<string, unknown> =>
  typeof v === 'object' && v !== null && !Array.isArray(v)
const rows = (v: unknown): Record<string, unknown>[] => (Array.isArray(v) ? v.filter(record) : [])
const n = (v: unknown) => (typeof v === 'number' ? v : 0)
const text = (v: unknown) => (typeof v === 'string' ? v : 'unavailable')
const subjects = ['purejsimage', 'jsquash', 'oxide', 'vips']
if (
  alphaDirect.completed !== true ||
  alphaDirect.sourceAdopted !== true ||
  alphaDirect.fullParity !== false ||
  alphaDirect.publicComparisonCountsChanged !== false ||
  alphaDirect.implementationSourceSha256 !== originalPhoto.implementationSourceSha256 ||
  alphaDirect.comparisons.length !== 6 ||
  alphaDirect.comparisons.some(
    (row) => !row.dominatesBothMetrics || row.ratio === null || row.ratio > 1 || row.pure === null,
  )
)
  throw new Error('Incomplete current transparency comparisons')
if (
  originalPhoto.completed !== true ||
  originalPhoto.sourceAdopted !== true ||
  originalPhoto.fullParity !== false ||
  originalPhoto.secondaryMetricDominance !== false ||
  originalPhoto.extrapolation !== false ||
  originalPhoto.scoreTolerance !== 0.25 ||
  originalPhoto.inputGeometry.width !== 4000 ||
  originalPhoto.inputGeometry.height !== 3000 ||
  originalPhoto.freshEncodedFiles !== 6 ||
  originalPhoto.reusedQualifiedIndependentGrids !== 36 ||
  originalPhoto.comparisons.length !== 6 ||
  originalPhoto.comparisons.some(
    (row) =>
      row.status !== 'adequate bracket' ||
      row.ratio > 1 ||
      row.pure.width > 0.25 ||
      row.peer.width > 0.25,
  )
)
  throw new Error('Incomplete original-size photo compression evidence')
const originalPhotoRows = [70, 80, 90].map((target) => {
  const jsquash = originalPhoto.comparisons.find(
    (row) => row.target === target && row.comparator === 'jsquash',
  )
  const vips = originalPhoto.comparisons.find(
    (row) => row.target === target && row.comparator === 'vips',
  )
  if (!jsquash || !vips || jsquash.pure.interpolatedBytes !== vips.pure.interpolatedBytes)
    throw new Error('Original-size photo target missing')
  return {
    target,
    bytes: Math.round(jsquash.pure.interpolatedBytes),
    jsquashBytes: Math.round(jsquash.peer.interpolatedBytes),
    vipsBytes: Math.round(vips.peer.interpolatedBytes),
    jsquashReduction: ((1 - jsquash.ratio) * 100).toFixed(2),
    vipsReduction: ((1 - vips.ratio) * 100).toFixed(2),
  }
})
const alphaPoint = alphaCompression.pointDominance
if (
  alphaCompression.completed !== true ||
  alphaCompression.sourceAdopted !== true ||
  alphaCompression.fullParity !== false ||
  alphaCompression.publicComparisonCountsChanged !== false ||
  alphaPoint.alphaExact !== true ||
  alphaPoint.pureBytes >= alphaPoint.peerBytes ||
  alphaPoint.pureScore < alphaPoint.peerScore ||
  alphaPoint.pureButteraugli > alphaPoint.peerButteraugli
)
  throw new Error('Incomplete alpha compression evidence')
const names = [
  'PureJsImage repository build',
  ...['@jsquash/jxl', 'jxl-oxide-wasm', 'wasm-vips'].map((name) => {
    const p = subjectManifest.packages.find((p) => p.name === name)
    if (!p) throw new Error(`Missing tested package ${name}`)
    return `${p.name} ${p.manifest.version}`
  }),
]
const footprints = rows(raw.footprints),
  summaries = rows(raw.summaries).filter((r) => r.runtime === 'chromium'),
  supplements = rows(supplementalQuality.comparisons).filter(
    (r) => r.status === 'adequate bracket',
  ),
  quality = rows(compressionQuality.comparisons).map((original) => {
    const prior =
      supplements.find(
        (r) =>
          r.fixture === original.fixture &&
          r.target === original.target &&
          r.comparator === original.comparator,
      ) ?? original
    const updated = rows(dcCompression.matchedFrozenPeerComparisons).find(
      (r) =>
        r.fixture === prior.fixture &&
        r.target === prior.target &&
        r.comparator === prior.comparator,
    )
    if (!updated) return prior
    const band = rows(dcCompression.matchedPhotoBands).find(
      (r) => r.fixture === prior.fixture && r.target === prior.target,
    )
    if (
      !band ||
      prior.status !== 'adequate bracket' ||
      updated.frozenPeerBytes !== prior.comparatorBytes ||
      updated.frozenPeerWidth !== prior.comparatorWidth ||
      typeof updated.interpolatedBytes !== 'number' ||
      typeof updated.ratio !== 'number' ||
      typeof band.width !== 'number' ||
      band.width > 0.25
    )
      throw new Error('Integrated DC comparison must retain the exact adequate frozen peer')
    return {
      ...prior,
      pureBytes: updated.interpolatedBytes,
      pureWidth: band.width,
      ratio: updated.ratio,
    }
  })
if (
  supplementalQuality.implementationSourceSha256 !== compressionQuality.implementationSourceSha256
)
  throw new Error('Supplemental quality source differs from the full replay')
const adequate = quality.filter((r) => r.status === 'adequate bracket')
const unresolvedQuality = quality.filter((r) => r.status === 'unresolved').length
if (
  dcCompression.completed !== true ||
  dcCompression.sourceAdopted !== true ||
  dcCompression.fullParity !== false ||
  dcCompression.publicComparisonCountsChanged !== false ||
  dcCompression.scoreTolerance !== 0.25 ||
  dcCompression.extrapolation !== false ||
  dcCompression.matchedFrozenPeerComparisons.length !== 12 ||
  adequate.length !== 13 ||
  unresolvedQuality !== 11
)
  throw new Error('Integrated DC evidence or original comparison counts differ')
const timings = rows(raw.timingRows).filter(
  (r) =>
    text(r.sourceReport).includes('/main-node') &&
    r.fixture === 'im26-1030-diagnostic' &&
    r.operation === 'encode' &&
    record(r.settings) &&
    r.settings.lossless === true &&
    r.settings.effort === 1,
)
const specialized = rows(raw.capabilities).filter(
  (r) =>
    !r.fixture && !['runtime availability', 'dedicated module worker'].includes(text(r.feature)),
)
const coldRows = rows(raw.timingRows).filter(
  (r) =>
    text(r.sourceReport).includes('/cold-node') &&
    r.fixture === 'im26-1030-diagnostic' &&
    r.operation === 'encode' &&
    record(r.settings) &&
    r.settings.lossless === true &&
    r.settings.effort === 1,
)
const spread = (values: unknown[], divisor = 1) => {
  const sorted = values
    .filter((v): v is number => typeof v === 'number' && Number.isFinite(v))
    .sort((a, b) => a - b)
  if (!sorted.length) return 'unavailable'
  return `${(sorted[Math.floor(sorted.length / 2)] / divisor).toFixed(1)} [${(sorted[0] / divisor).toFixed(1)}, ${(sorted[sorted.length - 1] / divisor).toFixed(1)}] (n=${sorted.length})`
}
const cold = subjects.map((subject) => {
  const selected = coldRows.filter((r) => r.subject === subject)
  const verified = selected.filter((r) => r.status === 'verified')
  return {
    subject,
    status: verified.length ? 'verified' : text(selected[0]?.status),
    time: spread(verified.map((r) => r.coldMs)),
    memory: spread(
      verified.map((r) => (record(r.memory) ? r.memory.peakRssBytes : null)),
      1024 * 1024,
    ),
  }
})
const previews = subjects.map((subject) => {
  const selected = rows(raw.preview.rows)
    .filter((r) => r.subject === subject)
    .flatMap((r) => (record(r.result) ? [r.result] : []))
  return {
    subject,
    time: spread(selected.map((r) => r.firstUsefulMs)),
    bytes: spread(selected.map((r) => r.firstTransferred)),
    scope: selected.length ? text(selected[0].scope) : 'Public incremental preview API not exposed',
  }
})
const maxWarm = Math.max(...timings.map((r) => (record(r.warmMs) ? n(r.warmMs.median) : 0)))
const maxBytes = Math.max(...footprints.map((f) => n(f.brotliBytes)))
const currentPhoto = rows(compressionLossless.rows).find((r) => r.fixture === 'im26-1416-original')
const currentPhoto7 = rows(groupLossless.effort7Rows).find(
  (r) => r.fixture === 'im26-1416-original',
)
const currentScreenshot7 = rows(groupLossless.effort7Rows).find(
  (r) => r.fixture === 'im26-8160-original',
)
const photoAt80 = rows(compressionQuality.comparisons).find(
  (r) => r.fixture === 'im26-1030-diagnostic' && r.target === 80 && r.comparator === 'vips',
)
if (
  !currentPhoto ||
  typeof currentPhoto.bytes !== 'number' ||
  !currentPhoto7 ||
  typeof currentPhoto7.bytes !== 'number' ||
  !currentScreenshot7 ||
  typeof currentScreenshot7.bytes !== 'number' ||
  !photoAt80 ||
  photoAt80.status !== 'adequate bracket' ||
  typeof photoAt80.ratio !== 'number' ||
  compressionLossless.rows.length !== 16 ||
  compressionLossless7.rows.length !== 16 ||
  compressionLossless7.implementationSourceSha256 !==
    compressionQuality.implementationSourceSha256 ||
  compressionQuality.streams !== 91 ||
  compressionLossless.implementationSourceSha256 !== compressionQuality.implementationSourceSha256
)
  throw new Error('Incomplete compression update')
const currentPhotoBytes = currentPhoto.bytes.toLocaleString('en-US')
const currentPhoto7Bytes = currentPhoto7.bytes.toLocaleString('en-US')
const currentScreenshot7Bytes = currentScreenshot7.bytes.toLocaleString('en-US')
const integratedPhotoAt80 = quality.find(
  (r) => r.fixture === 'im26-1030-diagnostic' && r.target === 80 && r.comparator === 'vips',
)
if (!integratedPhotoAt80 || typeof integratedPhotoAt80.ratio !== 'number')
  throw new Error('Integrated photo comparison missing')
const photoSizeGap = ((integratedPhotoAt80.ratio - 1) * 100).toFixed(2)
const repeatedGraphics = rows(repeatedLossless.graphics)
if (
  repeatedLossless.completed !== true ||
  repeatedLossless.sourceAdopted !== true ||
  repeatedLossless.fullParity !== false ||
  repeatedLossless.originalFixtures !== 16 ||
  repeatedLossless.smallerLosslessFiles !== 4 ||
  repeatedLossless.unchangedLosslessFiles !== 12 ||
  repeatedLossless.largerLosslessFiles !== 0 ||
  repeatedLossless.completeIndependentNativeRustGrids !== 64 ||
  repeatedLossless.realBrowserCases !== 18 ||
  repeatedLossless.originalWorkingBudgetsRecovered !== true ||
  repeatedLossless.packageCeilingsPreserved !== true ||
  repeatedLossless.compressionFirstAuthorized !== true ||
  repeatedLossless.timingAndRssMeasured !== true ||
  repeatedLossless.unchangedEffort7Files !== 16 ||
  repeatedLossless.unchangedOriginalColorHashes !== 56 ||
  repeatedLossless.verifiedComparableLosslessCells !== 45 ||
  repeatedLossless.atOrBelowFrozenPeerLosslessCells !== 40 ||
  repeatedLossless.remainingMeasuredLosslessGaps.length !== 5 ||
  repeatedGraphics.length !== 4 ||
  repeatedGraphics.some(
    (r) =>
      r.allOriginalNativeSamplesExact !== true ||
      typeof r.bytes !== 'number' ||
      rows(r.peers).length !== 2 ||
      rows(r.peers).some(
        (p) => p.exactOriginalNativeSamples !== true || typeof p.bytes !== 'number',
      ),
  )
)
  throw new Error('Incomplete repeated lossless comparison')
if (
  denseLossless.completed !== true ||
  denseLossless.sourceAdopted !== true ||
  denseLossless.fullParity !== false ||
  denseLossless.verifiedComparableLosslessCells !== 45 ||
  denseLossless.atOrBelowFrozenPeerLosslessCells !== 43 ||
  denseLossless.remainingMeasuredLosslessGaps.length !== 2 ||
  denseLossless.effort7Rows.length !== 16 ||
  denseLossless.smallerEffort7Files !== 12 ||
  denseLossless.unchangedEffort7Files !== 4 ||
  denseLossless.largerEffort7Files !== 0 ||
  denseLossless.unchangedEffort1Files !== 16 ||
  denseLossless.completeIndependentNativeRustGrids !== 64 ||
  denseLossless.exactIndependentSamples !== 384733048 ||
  denseLossless.realBrowserCases !== 18 ||
  denseLossless.originalWorkingBudgetsRecovered !== true ||
  denseLossless.packageCeilingsPreserved !== true ||
  denseLossless.unchangedOriginalColorHashes !== 56
)
  throw new Error('Incomplete denser lossless production comparison')
if (
  groupLossless.completed !== true ||
  groupLossless.sourceAdopted !== true ||
  groupLossless.fullParity !== false ||
  groupLossless.integerLosslessCorpusParity !== true ||
  groupLossless.verifiedComparableLosslessCells !== 45 ||
  groupLossless.atOrBelowFrozenPeerLosslessCells !== 45 ||
  groupLossless.remainingMeasuredLosslessGaps.length !== 0 ||
  groupLossless.additionalPeerComparisons.length !== 4 ||
  groupLossless.rows.length !== 16 ||
  groupLossless.effort7Rows.length !== 16 ||
  groupLossless.smallerEffort1Files !== 6 ||
  groupLossless.unchangedEffort1Files !== 10 ||
  groupLossless.largerEffort1Files !== 0 ||
  groupLossless.smallerEffort7Files !== 4 ||
  groupLossless.unchangedEffort7Files !== 12 ||
  groupLossless.largerEffort7Files !== 0 ||
  groupLossless.completeIndependentNativeRustGrids !== 64 ||
  groupLossless.exactIndependentSamples !== 384733048 ||
  groupLossless.realBrowserCases !== 30 ||
  groupLossless.originalWorkingBudgetsRecovered !== true ||
  groupLossless.originalMinimumBoundariesPreserved !== true ||
  groupLossless.packageCeilingsPreserved !== true ||
  groupLossless.unchangedOriginalColorHashes !== 56 ||
  groupLossless.peerComparisons.some(
    (row) => row.currentBytes > row.peerBytes || row.exactOriginalNativeSamples !== true,
  ) ||
  groupLossless.additionalPeerComparisons.some(
    (row) => row.currentBytes > row.peerBytes || row.exactOriginalNativeSamples !== true,
  )
)
  throw new Error('Incomplete lossless group search comparison')
---
<Layout title="JPEG XL JavaScript library comparison" description="Dated public-API measurements across PureJsImage, jSquash, jxl-oxide-wasm and wasm-vips. Compare practical workflows and their limits." path="comparison/">
<section class="jxl-card quick">
<h2>Quick answer</h2>
<p>The original 4000 × 3000 photo now uses 4–13% fewer bytes than jSquash and 3–15% fewer than wasm-vips at matched SSIMULACRA2 70, 80 and 90. All six comparisons pass the original 0.25-score bracket rule without extrapolation. Butteraugli still shows tradeoffs, so this establishes parity for these SSIMULACRA2 targets on one original-size photo. Other original-size photos, HDR, float, CMYK and animation need separate compression evidence. <a href="/jpeg-xl/evidence/ORIGINAL-PHOTO.md" download>Original-size photo results and quality tradeoffs</a> and <a href="/jpeg-xl/evidence/original-photo-production-controls.json" download>Current original-photo production controls</a>.</p>
<div style="overflow:auto"><table><caption>Original 4000 × 3000 photo at matched SSIMULACRA2</caption><thead><tr><th>Target</th><th>PureJsImage bytes</th><th>jSquash bytes</th><th>wasm-vips bytes</th><th>Versus jSquash</th><th>Versus wasm-vips</th></tr></thead><tbody>{originalPhotoRows.map((row) => <tr><td>{row.target}</td><td>{row.bytes.toLocaleString('en-US')}</td><td>{row.jsquashBytes.toLocaleString('en-US')}</td><td>{row.vipsBytes.toLocaleString('en-US')}</td><td>{row.jsquashReduction}% smaller</td><td>{row.vipsReduction}% smaller</td></tr>)}</tbody></table></div>
<p>Sizes are interpolated estimates rounded for display. Fresh public production encodes reproduce all six independently qualified endpoints exactly. The 36 complete native/Rust grids and all 288 million public decoded samples retain their exact evidence pins and are explicitly counted as reused qualification. The correction extends opaque RGB DC precision above four megapixels when optional compression storage fits; allocation failure recovers the prior large-image path. Both complete packages retain exports and grow by 20 bytes within their unchanged ceilings. Current source SHA-256: <code>{originalPhoto.implementationSourceSha256}</code>. <a href="/jpeg-xl/evidence/original-photo-quality-study.json" download>All raw quality points and failed attempts</a> and <a href="/jpeg-xl/evidence/original-photo-endpoint-qualification.json" download>Complete endpoint qualification</a>.</p>
<p>Both pinned 1024 × 768 photographs also use fewer bytes than both frozen WASM peers at matched SSIMULACRA2 70, 80 and 90. The remaining first-photo score-70 gap changes from 3.00% larger to 0.53% smaller than wasm-vips. All twelve capped-photo comparisons pass the same original bracket rule. <a href="/jpeg-xl/evidence/PHOTO-PARITY.md" download>Capped photo compression and boundaries</a> and <a href="/jpeg-xl/evidence/photo-parity-production-controls.json" download>Preceding capped-photo measurements</a>.</p>
<p>The separately rechecked opaque graphic produces 14,055 bytes at SSIMULACRA2 84.39 and 37,051 bytes with every original sample exact. These points dominate all six sampled peer files selected at targets 70, 80 and 90 on size and both quality metrics. This is a direct point comparison; the missing interpolation brackets and original comparison counts stay visible. The full exact-artwork search takes several minutes per encode, so this establishes compression results without a speed claim. <a href="/jpeg-xl/evidence/GRAPHIC-POINTS.md" download>Graphic point comparisons</a> and <a href="/jpeg-xl/evidence/graphic-point-production-controls.json" download>Graphic production controls</a>.</p>
<p>The preceding alpha palette search reduces the original transparency fixture from 48,819 to 9,038 bytes with identical decoded colors, exact alpha and unchanged quality scores. A higher-quality {alphaPoint.pureBytes.toLocaleString('en-US')}-byte point is smaller than the frozen {alphaPoint.peerBytes.toLocaleString('en-US')}-byte wasm-vips point and scores better on both SSIMULACRA2 and Butteraugli. This proves dominance of that measured point and keeps the frozen matched-pair counts unchanged. <a href="/jpeg-xl/evidence/ALPHA-PALETTES.md" download>Alpha compression and boundaries</a> and <a href="/jpeg-xl/evidence/alpha-palette-production-controls.json" download>Alpha production measurements</a>.</p>
<p>The fresh transparency comparison passes all six selected peer/target files on size and both aggregate quality metrics. Distance 6 uses 8,409 bytes against wasm-vips at 8,642, with SSIMULACRA2 88.34796 versus 88.10510 and Butteraugli 2.28504 versus 2.39888. Alpha stays exact. Scores use the worse result over black and white backgrounds; individual background results remain in the report. The selected jSquash files alter alpha, while the selected wasm-vips files preserve it. The photo, graphic and transparency studies cover all 24 original peer/target selections using matched capped-photo brackets or direct graphic/transparency files. Other original-size photos, HDR, CMYK and animation compression need separate evidence. <a href="/jpeg-xl/evidence/ALPHA-POINTS.md" download>Transparency point comparisons</a> and <a href="/jpeg-xl/evidence/alpha-point-production-controls.json" download>Fresh transparency production controls</a>.</p>
<p>The latest integer-lossless encoding closes all three remaining measured size gaps. Every one of the 45 independently exact comparable cells in the original Node matrix now meets or beats the frozen peer size. All four separate original-size photo and screenshot controls also meet or beat peer size. This is compression parity on the pinned integer-lossless corpus. Broader lossy, float, CMYK and animation compression remains open.</p>
<p>PureJsImage now decodes all 16 pinned lossless inputs exactly, including the seven that previously failed. It exposes native sample and exact JPEG workflows. The dated comparison below records toolkit sizes and runtime performance. The WASM alternatives are faster on several workloads. The historical quality table still has {unresolvedQuality} missing adequate interpolation brackets; fresh direct graphic and transparency comparisons appear above.</p>
<p>Later unreleased compression changes reduce the same 4000 × 3000 lossless effort-1 photo from 15,389,193 to {currentPhotoBytes} bytes, versus the pinned 9,306,869-byte jSquash and 8,176,908-byte wasm-vips files. The preceding integrated DC model reduces 67 of the 91 original lossy files with identical decoded samples. The preceding photo filter changes 27 files, making them slightly larger at the same distance setting, with no SSIMULACRA2 regressions and ten Butteraugli regressions. Its separate cost studies pass the former 5% timing guard and authorized 10% peak RSS allowance. That historical photo source is <code>{historicalPhotoCompression.implementationSourceSha256}</code>. The current larger-transform and entropy search closes the remaining measured photo gap. The first photo is {(Math.abs(Number(photoSizeGap))).toFixed(2)}% smaller than wasm-vips at score 80 and 0.53% smaller at score 70. Every one of the 34 current photo files has complete native/Rust and public JavaScript pixel checks. The combined comparison has {adequate.length} adequately matched pairs and {unresolvedQuality} unresolved pairs. The second photo's tighter 0.05-score search remains inconclusive; its separately recomputed 0.11437-score bracket passes the original 0.25 rule. Package ceilings rise explicitly to 554,000/627,000 bytes; no speed or RSS parity is claimed. The speed tables below retain their earlier source. Current photo source SHA-256: <code>{dcCompression.implementationSourceSha256}</code>.</p>
<p>The earlier reversible-color checkpoint shrinks four more of the sixteen original files and leaves twelve byte-identical to the preceding checkpoint. None grows. Bounded reversible-color search reduces the map from 289,879 to 268,214 bytes, versus 268,611 for wasm-vips and 301,588 for jSquash. All four capped graphics below are now smaller than both frozen peers. All native samples, transparent RGB and alpha stay exact across 64 complete independent decoder grids. This checkpoint prioritizes compression first. Its independently audited 21-pair map study measures 37.20% more cold encoding time, 38.07% more warm time and 16.94% more cold peak RSS than the preceding PureJsImage checkpoint. The previous cost-guard failures remain recorded. Original working-memory budgets recover their former streams, and package ceilings stay unchanged. Every preceding effort-7 file and all 56 native color encodings remain byte-identical. Reversible-color checkpoint source SHA-256: <code>{repeatedLossless.implementationSourceSha256}</code>. <a href="/jpeg-xl/evidence/LOSSLESS-RCT.md" download>Reversible-color compression and remaining gaps</a>, <a href="/jpeg-xl/evidence/lossless-rct-production-controls.json" download>Reversible-color production controls</a>, and <a href="/jpeg-xl/evidence/LOSSLESS-SPATIAL.md" download>Preceding spatial checkpoint</a>.</p>
<p>The preceding effort-7 checkpoint compares denser prediction training while retaining the previous complete group. Twelve original files shrink, four remain byte-identical, and none grows. All original native samples, transparent RGB and alpha remain exact in both independent decoders. The map falls from 133,365 to 125,561 bytes, below both frozen peers. All effort-1 files and all 56 native color encodings remain byte-identical. Original working budgets recover their exact previous streams. This adds search work and makes no paired speed claim. Eighteen changed-path cases pass in Chromium, Firefox and WebKit. Denser training checkpoint source SHA-256: <code>{denseLossless.implementationSourceSha256}</code>. <a href="/jpeg-xl/evidence/DENSE-TRAINING.md" download>Denser lossless prediction checkpoint</a> and <a href="/jpeg-xl/evidence/lossless-dense-training-production-controls.json" download>Preceding production controls</a>.</p>
<div style="overflow:auto"><table><caption>Current effort-1 lossless graphics, 1024 × 1024, bytes; each encoder retains its original settings</caption><thead><tr><th>Input</th><th>Former PureJsImage</th><th>Current PureJsImage</th><th>Pinned jSquash</th><th>Pinned wasm-vips</th></tr></thead><tbody>{repeatedGraphics.map(r=><tr><td>{text(r.fixture)}</td><td>{n(r.originalBytes).toLocaleString('en-US')}</td><td>{n(r.bytes).toLocaleString('en-US')}</td><td>{n(rows(r.peers).find(p=>p.subject==='jsquash')?.bytes).toLocaleString('en-US')}</td><td>{n(rows(r.peers).find(p=>p.subject==='vips')?.bytes).toLocaleString('en-US')}</td></tr>)}</tbody></table></div>
<p>The latest optional group search retains every completed ordinary and patch file, then tries smaller groups with bounded local reversible color selection and a refined patch-display tree. Six effort-1 files and four effort-7 files shrink; none grows. The two remaining capped photo files become 819,166 bytes at effort 1 and 641,956 bytes at effort 7. The original screenshot becomes 386,813 bytes, below pinned jSquash at 391,394 bytes. Every original native sample, hidden RGB and alpha remains exact in both independent decoders. Existing memory limits, minimum boundaries, native color hashes, public exports and package ceilings remain preserved. Thirty changed-path cases pass in Chromium, Firefox and WebKit. This adds encoding work; no speed or RSS parity is claimed. Current lossless codec source SHA-256: <code>{groupLossless.implementationSourceSha256}</code>. <a href="/jpeg-xl/evidence/GROUP-SEARCH.md" download>Lossless group search and remaining scope</a> and <a href="/jpeg-xl/evidence/lossless-group-search-production-controls.json" download>Current lossless production controls</a>.</p>
<p>The original Node report has 45 independently exact comparable lossless cells. Current files are at or below the pinned peer size in all {groupLossless.atOrBelowFrozenPeerLosslessCells}. Three further cells have no exposed matching competitor API and remain excluded. Four additional original-size effort-7 controls retain their separate scope and all meet peer size. Overall compression parity remains open.</p>
<p><a href="/jpeg-xl/evidence/PARITY.md" download>Compression changes and controls</a>, <a href="/jpeg-xl/evidence/parity-funded-sampling-effort1-public.json" download>current lossless results</a>, and <a href="/jpeg-xl/evidence/quality-funded-sampling-public.json" download>prior full quality replay</a>.</p>
<p><a href="/jpeg-xl/evidence/FILTER-AC.md" download>Photo filtering and AC compression results</a>, <a href="/jpeg-xl/evidence/filter-ac-production-controls.json" download>Independent photo checkpoint controls</a>, and <a href="/jpeg-xl/evidence/DC-MODELS.md" download>earlier DC-only results</a> record the latest photo endpoints, original memory limits, package ceilings and browser checks. The frozen peer encoders were not rerun.</p>
<p>Six additional wasm-vips files resolved two previously missing comparisons on the second 1024 × 768 photo. The integrated DC comparison uses those frozen peer estimates; the table has {adequate.length} adequately matched pairs and {unresolvedQuality} unresolved pairs. The sampler refines the same nondominated curve used for matching, with the unchanged 0.25-score bracket limit. That peer supplement preserves the original reports and adds no PureJsImage encodes or speed measurements. <a href="/jpeg-xl/evidence/FRONTIER-SAMPLING.md" download>Sampling correction and scope</a>, <a href="/jpeg-xl/evidence/quality-photo-frontier-extension.json" download>Peer measurements and matching calculations</a>, and <a href="/jpeg-xl/evidence/quality-photo-extension.json" download>Earlier five-point supplement</a>.</p>
<p>The integrated opaque palette change improves the original 1024 × 1024 graphic. Its qualified 14,617-byte distance-8 file scores 84.390 in SSIMULACRA2 and 4.820 in Butteraugli, versus 25,580 bytes / 80.153 / 7.669 for one pinned jSquash file and 30,921 bytes / 80.459 / 5.574 for one pinned wasm-vips file. Actual candidate files beat all 24 measured wasm-vips graphic files and 23 of 24 jSquash files in size and both quality metrics. The jSquash quality-101 exception remains. These complete-file comparisons add no tight matched target or competitor speed result. Independent decoder checks, the original 123-file matrix and production tests in Node, Chromium, Firefox and WebKit pass. The runtime tables below retain their earlier source. <a href="/jpeg-xl/evidence/FLAT-PALETTE-CONFIRMATION.md" download>Palette results and limits</a>.</p>
