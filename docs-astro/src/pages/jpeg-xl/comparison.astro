---
import alphaCompression from '../../../../benchmark/jpegxl/comparison/results/alpha-palette-production-controls.json'
import alphaDirect from '../../../../benchmark/jpegxl/comparison/results/alpha-point-production-controls.json'
import historicalPhotoCompression from '../../../../benchmark/jpegxl/comparison/results/filter-ac-production-controls.json'
import largeIndependent from '../../../../benchmark/jpegxl/comparison/results/large-transform-independent-point.json'
import largeBa2 from '../../../../benchmark/jpegxl/comparison/results/large-transform-public-ba2.json'
import largeSsim80 from '../../../../benchmark/jpegxl/comparison/results/large-transform-public-ssim80.json'
import denseLossless from '../../../../benchmark/jpegxl/comparison/results/lossless-dense-training-production-controls.json'
import groupLossless from '../../../../benchmark/jpegxl/comparison/results/lossless-group-search-production-controls.json'
import repeatedLossless from '../../../../benchmark/jpegxl/comparison/results/lossless-rct-production-controls.json'
import coneFloor from '../../../../benchmark/jpegxl/comparison/results/original-cone-floor-controls.json'
import fineProduction from '../../../../benchmark/jpegxl/comparison/results/original-fine-production-controls.json'
import entropyControls from '../../../../benchmark/jpegxl/comparison/results/original-luma-context-controls.json'
import portraitBaseline from '../../../../benchmark/jpegxl/comparison/results/original-matrix-portrait-baseline.json'
import middleProduction from '../../../../benchmark/jpegxl/comparison/results/original-middle-channel-controls.json'
import originalPhoto from '../../../../benchmark/jpegxl/comparison/results/original-photo-production-controls.json'
import portraitBa3 from '../../../../benchmark/jpegxl/comparison/results/coherent-coarse-public.json'
import spatialControls from '../../../../benchmark/jpegxl/comparison/results/original-spatial-context-controls.json'
import compressionLossless from '../../../../benchmark/jpegxl/comparison/results/parity-funded-sampling-effort1-public.json'
import compressionLossless7 from '../../../../benchmark/jpegxl/comparison/results/parity-funded-sampling-effort7-public.json'
import dcCompression from '../../../../benchmark/jpegxl/comparison/results/photo-parity-production-controls.json'
import compressionQuality from '../../../../benchmark/jpegxl/comparison/results/quality-funded-sampling-public.json'
import supplementalQuality from '../../../../benchmark/jpegxl/comparison/results/quality-photo-frontier-extension.json'
import subjectManifest from '../../../../benchmark/jpegxl/comparison/subjects.json'
import raw from '../../../../benchmark/jpegxl/comparison/website-data.json'
import crops from '../../data/jpegxl-comparison-crops.json'
import Layout from '../../layouts/JpegXlLayout.astro'

if (
  fineProduction.completed !== true ||
  fineProduction.sourceAdopted !== true ||
  fineProduction.productionQualified !== true ||
  fineProduction.fullParity !== false ||
  fineProduction.equivalenceBridge.completed !== true ||
  fineProduction.equivalenceBridge.installedSourceAndPackagesVerified !== true ||
  fineProduction.protectedSSIM90.completed !== true ||
  fineProduction.remainingConfirmedGaps.length !== 3 ||
  fineProduction.unresolvedPortraitComparisonsPreserved.length !== 4 ||
  fineProduction.comparisons.filter((row) => row.metric === 'butteraugli' && row.target === 0.5)
    .length !== 4
)
  throw new Error('Incomplete adopted fine-photo comparison and protection evidence')
const fineRows = ['portrait-2400x3000', 'im26-1416-original'].map((fixture) => {
  const js = fineProduction.comparisons.find(
    (row) =>
      row.fixture === fixture &&
      row.metric === 'butteraugli' &&
      row.target === 0.5 &&
      row.comparator === 'jsquash',
  )
  const vips = fineProduction.comparisons.find(
    (row) =>
      row.fixture === fixture &&
      row.metric === 'butteraugli' &&
      row.target === 0.5 &&
      row.comparator === 'vips',
  )
  if (
    !js ||
    !vips ||
    js.interpolatedBytes !== vips.interpolatedBytes ||
    js.ratio > 1 ||
    vips.ratio > 1
  )
    throw new Error('Missing qualified fine-photo result')
  return {
    fixture: fixture === 'portrait-2400x3000' ? '2400 × 3000 portrait' : '4000 × 3000 photo',
    bytes: js.interpolatedBytes,
    jsBytes: js.peerBytes,
    vipsBytes: vips.peerBytes,
    jsReduction: ((1 - js.ratio) * 100).toFixed(2),
    vipsReduction: ((1 - vips.ratio) * 100).toFixed(2),
  }
})
const fineSsim90 = fineProduction.protectedSSIM90.currentBand.interpolatedBytes
const fineSsim90Reduction = (
  (1 - fineSsim90 / fineProduction.protectedSSIM90.baselineBytes) *
  100
).toFixed(2)

if (
  !middleProduction.completed ||
  !middleProduction.productionQualified ||
  !middleProduction.sourceAdopted ||
  middleProduction.fullParity ||
  !middleProduction.validation.fullCheck.completed ||
  !middleProduction.validation.chromiumCone.completed ||
  !middleProduction.validation.savedFileRecovery.completed ||
  middleProduction.bracket.width > 0.25 ||
  middleProduction.comparisons.length !== 2
)
  throw new Error('Incomplete middle-photo public comparison')
const middleReduction = ((1 - middleProduction.ratioToPrior) * 100).toFixed(2)
const middleGap = (comparator: string): string => {
  const row = middleProduction.comparisons.find((row) => row.comparator === comparator)
  if (!row || row.status !== 'adequate bracket') throw new Error('Missing middle-photo peer')
  return ((row.ratio - 1) * 100).toFixed(2)
}

if (
  portraitBa3.completed !== true ||
  portraitBa3.overallParity !== false ||
  portraitBa3.productionQualified !== true ||
  portraitBa3.sourceAdopted !== true ||
  portraitBa3.packageSizeGatesPassed !== true ||
  portraitBa3.currentBracket.width > 0.25 ||
  portraitBa3.remainingConfirmedGaps.length !== 5 ||
  portraitBa3.points.length !== 2 ||
  portraitBa3.points.some(
    (point) =>
      point.validation.publicSamples !== 28_800_000 ||
      point.validation.maximumError > 1 ||
      !point.validation.exactAlpha ||
      !point.validation.callerUnchanged ||
      point.validation.ownerLiveBytes !== 0 ||
      point.validation.ownerLiveAllocations !== 0,
  ) ||
  portraitBa3.comparisons.length !== 2 ||
  portraitBa3.comparisons.some(
    (row) => !row.qualified || row.peerBracket.width > 0.25 || row.relativeBytes <= 0,
  ) ||
  portraitBa3.packages.length !== 4 ||
  portraitBa3.packages.some((row) => !row.adoptedBudgetPassed || !row.byteIdentityToPrototype) ||
  portraitBa3.browserScope.samples !== 28_800_000 ||
  portraitBa3.browserScope.maximumError > 1 ||
  !portraitBa3.browserScope.exactAlpha ||
  !portraitBa3.browserScope.callerUnchanged ||
  portraitBa3.browserScope.ownership.liveBytes !== 0 ||
  !portraitBa3.independent.exactArtifactIdentity ||
  portraitBa3.independent.matchedComparisons !== 0
)
  throw new Error('Incomplete public portrait Butteraugli-three comparison')
const portraitBa3Gap = (peer: string): string => {
  const row = portraitBa3.comparisons.find((comparison) => comparison.peer === peer)
  if (!row) throw new Error('Missing portrait Butteraugli-three peer')
  return row.gapPercent.toFixed(2)
}

if (
  !largeBa2.completed ||
  largeBa2.overallParity ||
  largeBa2.targetButteraugli !== 2 ||
  largeBa2.bracket.width > 0.25 ||
  largeBa2.rows.length !== 2 ||
  largeBa2.rows.some(
    (row) =>
      row.publicSamples !== 28_800_000 ||
      row.maximumPublicError > 1 ||
      !row.exactOpaqueAlpha ||
      !row.callerUnchanged ||
      row.ownerLive !== 0,
  ) ||
  largeBa2.comparisons.length !== 2 ||
  largeBa2.comparisons.some((row) => row.peerBracket.width > 0.25) ||
  !largeIndependent.completed ||
  largeIndependent.result.rawComparison.matchedQuality ||
  largeIndependent.result.publicSamples !== 48_000_000 ||
  largeIndependent.result.maximumPublicError > 1 ||
  !largeIndependent.result.exactOpaqueAlpha ||
  !largeIndependent.result.callerUnchanged ||
  largeIndependent.result.ownerLive !== 0
)
  throw new Error('Incomplete public large-transform comparison')
const largeBa2Peers = largeBa2.comparisons.map((row) => ({
  name: row.peer === 'jsquash' ? 'jSquash' : 'wasm-vips',
  bytes: Math.round(row.peerBytes).toLocaleString('en-US'),
  difference: `${Math.abs(row.differencePercent).toFixed(2)}% ${row.ratio > 1 ? 'larger' : 'smaller'}`,
}))
const largeBa2Reduction = (-largeBa2.previousPublic.currentDifferencePercent).toFixed(2)
if (
  !largeSsim80.completed ||
  largeSsim80.overallParity ||
  largeSsim80.targetSsimulacra2 !== 80 ||
  largeSsim80.bracket.width > 0.25 ||
  largeSsim80.rows.length !== 6 ||
  largeSsim80.rows.some(
    (row) =>
      row.publicSamples !== 28_800_000 ||
      row.maximumPublicError > 1 ||
      !row.exactOpaqueAlpha ||
      !row.callerUnchanged ||
      row.ownerLive !== 0 ||
      row.ownerLiveAllocations !== 0,
  ) ||
  largeSsim80.comparisons.length !== 3 ||
  largeSsim80.comparisons.some((row) => row.bracket.width > 0.25)
)
  throw new Error('Incomplete public large-transform SSIM80 comparison')
const largeSsim80References = largeSsim80.comparisons.map((row) => ({
  name:
    row.subject === 'historical-purejsimage'
      ? 'Preceding PureJsImage'
      : row.subject === 'jsquash'
        ? 'jSquash'
        : 'wasm-vips',
  bytes: Math.round(row.bytes).toLocaleString('en-US'),
  difference: `${Math.abs(row.currentRelativeBytes * 100).toFixed(2)}% ${row.currentRelativeBytes > 0 ? 'larger' : 'smaller'}`,
}))
const largeIndependentReduction = (
  (1 - largeIndependent.result.rawComparison.bytesRatio) *
  100
).toFixed(2)

const record = (v: unknown): v is Record<string, unknown> =>
  typeof v === 'object' && v !== null && !Array.isArray(v)
const rows = (v: unknown): Record<string, unknown>[] => (Array.isArray(v) ? v.filter(record) : [])
const n = (v: unknown) => (typeof v === 'number' ? v : 0)
const text = (v: unknown) => (typeof v === 'string' ? v : 'unavailable')
const subjects = ['purejsimage', 'jsquash', 'oxide', 'vips']

if (
  coneFloor.completed !== true ||
  coneFloor.sourceAdopted !== true ||
  coneFloor.fullParity !== false ||
  !coneFloor.compiledPackagesIdenticalToMeasurements ||
  coneFloor.remainingConfirmedGaps.length === 0
)
  throw new Error('Incomplete scoped original-photo cone comparisons')
const coneRows = coneFloor.comparisons
  .filter((row) => row.comparator === 'purejsimage')
  .map((row) => {
    if (typeof row.ratio !== 'number') throw new Error('Missing scoped historical comparison')
    const peer = (comparator: string) =>
      coneFloor.comparisons.find(
        (other) =>
          other.fixture === row.fixture &&
          other.metric === row.metric &&
          other.target === row.target &&
          other.comparator === comparator,
      )
    return {
      ...row,
      fixtureLabel:
        row.fixture === 'portrait-2400x3000' ? '2400 × 3000 portrait' : '4000 × 3000 photo',
      metricLabel: row.metric === 'butteraugli' ? 'Butteraugli' : 'SSIMULACRA2',
      reduction: ((1 - row.ratio) * 100).toFixed(2),
      jsquashBytes: peer('jsquash')?.peerBytes ?? null,
      vipsBytes: peer('vips')?.peerBytes ?? null,
    }
  })
const conePortrait = coneRows.find(
  (row) => row.fixture === 'portrait-2400x3000' && row.metric === 'butteraugli' && row.target === 1,
)
if (!conePortrait) throw new Error('Missing current portrait target-one result')
const coneSize = (value: number | null) =>
  value === null ? 'Unresolved' : Math.round(value).toLocaleString('en-US')
const conePortraitGap = (comparator: string) => {
  const row = coneFloor.comparisons.find(
    (row) =>
      row.fixture === 'portrait-2400x3000' &&
      row.metric === 'butteraugli' &&
      row.target === 1 &&
      row.comparator === comparator,
  )
  if (!row || typeof row.ratio !== 'number') throw new Error('Missing current portrait peer result')
  return ((row.ratio - 1) * 100).toFixed(2)
}

const portraitGapPercentages = portraitBaseline.comparisons.flatMap((row) =>
  row.comparator === 'jsquash' &&
  row.metric === 'butteraugli' &&
  row.status === 'adequate bracket' &&
  typeof row.ratio === 'number'
    ? [(row.ratio - 1) * 100]
    : [],
)
if (
  portraitBaseline.completed !== true ||
  portraitBaseline.fullParity !== false ||
  portraitBaseline.fixture !== 'portrait-2400x3000' ||
  portraitGapPercentages.length !== 3 ||
  portraitGapPercentages.some((gap) => !Number.isFinite(gap) || gap <= 0)
)
  throw new Error('Incomplete broader portrait baseline')
const portraitMinimumGap = Math.min(...portraitGapPercentages).toFixed(2)
const portraitMaximumGap = Math.max(...portraitGapPercentages).toFixed(2)
if (
  entropyControls.completed !== true ||
  entropyControls.sourceAdopted !== true ||
  entropyControls.fullParity !== false ||
  entropyControls.matchedQualityComparison !== false ||
  entropyControls.freshEncodedFiles !== 6 ||
  entropyControls.freshCompleteIndependentGrids !== 12 ||
  entropyControls.freshPublicDecodedSamples !== 205440000 ||
  entropyControls.controls.length !== 6 ||
  entropyControls.controls.some(
    (row) => !row.identicalDecodedPixels || row.bytes > row.precedingBytes,
  )
)
  throw new Error('Incomplete original-size entropy preservation controls')
const entropyMinimumReduction = Math.min(
  ...entropyControls.controls.map((row) => row.reductionPercent),
).toFixed(2)
const entropyMaximumReduction = Math.max(
  ...entropyControls.controls.map((row) => row.reductionPercent),
).toFixed(2)
if (
  spatialControls.completed !== true ||
  spatialControls.sourceAdopted !== true ||
  spatialControls.fullParity !== false ||
  spatialControls.matchedQualityComparison !== false ||
  spatialControls.freshEncodedFiles !== 6 ||
  spatialControls.freshCompleteIndependentGrids !== 12 ||
  spatialControls.freshPublicDecodedSamples !== 205440000 ||
  spatialControls.controls.length !== 6 ||
  spatialControls.controls.some(
    (row) => !row.identicalDecodedPixels || row.bytes > row.precedingBytes,
  )
)
  throw new Error('Incomplete original-size spatial preservation controls')
const spatialSavedControls = spatialControls.controls.filter(
  (row) => row.bytes < row.precedingBytes,
)
if (
  spatialSavedControls.length !== 5 ||
  !spatialControls.controls.some(
    (row) => row.fixture === 'earthrise-2400x2400' && row.bytes === row.precedingBytes,
  )
)
  throw new Error('Original-size spatial selection floor changed')
const spatialMinimumReduction = Math.min(
  ...spatialSavedControls.map((row) => row.reductionPercent),
).toFixed(2)
const spatialMaximumReduction = Math.max(
  ...spatialSavedControls.map((row) => row.reductionPercent),
).toFixed(2)
if (
  alphaDirect.completed !== true ||
  alphaDirect.sourceAdopted !== true ||
  alphaDirect.fullParity !== false ||
  alphaDirect.publicComparisonCountsChanged !== false ||
  alphaDirect.implementationSourceSha256 !== originalPhoto.implementationSourceSha256 ||
  alphaDirect.comparisons.length !== 6 ||
  alphaDirect.comparisons.some(
    (row) => !row.dominatesBothMetrics || row.ratio === null || row.ratio > 1 || row.pure === null,
  )
)
  throw new Error('Incomplete current transparency comparisons')
if (
  originalPhoto.completed !== true ||
  originalPhoto.sourceAdopted !== true ||
  originalPhoto.fullParity !== false ||
  originalPhoto.secondaryMetricDominance !== false ||
  originalPhoto.extrapolation !== false ||
  originalPhoto.scoreTolerance !== 0.25 ||
  originalPhoto.butteraugliTolerance !== 0.25 ||
  originalPhoto.inputGeometry.width !== 4000 ||
  originalPhoto.inputGeometry.height !== 3000 ||
  originalPhoto.freshEncodedFiles !== 14 ||
  originalPhoto.reusedQualifiedIndependentGrids !== 74 ||
  originalPhoto.reusedQualifiedPublicDecodedSamples !== 672000000 ||
  originalPhoto.comparisons.length !== 6 ||
  originalPhoto.comparisons.some(
    (row) =>
      row.status !== 'adequate bracket' ||
      row.ratio > 1 ||
      row.pure.width > 0.25 ||
      row.peer.width > 0.25,
  ) ||
  originalPhoto.butteraugliComparisons.length !== 8 ||
  originalPhoto.butteraugliComparisons.some((row) =>
    row.status === 'adequate bracket'
      ? row.ratio === null ||
        row.ratio > 1 ||
        row.pure.width === null ||
        row.pure.width > 0.25 ||
        row.peer.width === null ||
        row.peer.width > 0.25
      : row.comparator !== 'vips' ||
        ![2, 3].includes(row.target) ||
        row.ratio !== null ||
        row.peer.interpolatedBytes !== null,
  )
)
  throw new Error('Incomplete original-size photo compression evidence')
const originalPhotoRows = [70, 80, 90].map((target) => {
  const jsquash = originalPhoto.comparisons.find(
    (row) => row.target === target && row.comparator === 'jsquash',
  )
  const vips = originalPhoto.comparisons.find(
    (row) => row.target === target && row.comparator === 'vips',
  )
  if (!jsquash || !vips || jsquash.pure.interpolatedBytes !== vips.pure.interpolatedBytes)
    throw new Error('Original-size photo target missing')
  return {
    target,
    bytes: Math.round(jsquash.pure.interpolatedBytes),
    jsquashBytes: Math.round(jsquash.peer.interpolatedBytes),
    vipsBytes: Math.round(vips.peer.interpolatedBytes),
    jsquashReduction: ((1 - jsquash.ratio) * 100).toFixed(2),
    vipsReduction: ((1 - vips.ratio) * 100).toFixed(2),
  }
})
const originalButteraugliRows = [0.5, 1, 2, 3].map((target) => {
  const jsquash = originalPhoto.butteraugliComparisons.find(
    (row) => row.target === target && row.comparator === 'jsquash',
  )
  const vips = originalPhoto.butteraugliComparisons.find(
    (row) => row.target === target && row.comparator === 'vips',
  )
  if (
    !jsquash ||
    !vips ||
    jsquash.ratio === null ||
    jsquash.pure.interpolatedBytes === null ||
    jsquash.peer.interpolatedBytes === null ||
    jsquash.pure.interpolatedBytes !== vips.pure.interpolatedBytes
  )
    throw new Error('Original-size Butteraugli target missing')
  return {
    target,
    bytes: Math.round(jsquash.pure.interpolatedBytes),
    jsquashBytes: Math.round(jsquash.peer.interpolatedBytes),
    vipsBytes:
      vips.peer.interpolatedBytes === null
        ? 'Unresolved'
        : Math.round(vips.peer.interpolatedBytes).toLocaleString('en-US'),
    jsquashReduction: `${((1 - jsquash.ratio) * 100).toFixed(2)}% smaller`,
    vipsReduction:
      vips.ratio === null ? 'Unresolved' : `${((1 - vips.ratio) * 100).toFixed(2)}% smaller`,
  }
})
const alphaPoint = alphaCompression.pointDominance
if (
  alphaCompression.completed !== true ||
  alphaCompression.sourceAdopted !== true ||
  alphaCompression.fullParity !== false ||
  alphaCompression.publicComparisonCountsChanged !== false ||
  alphaPoint.alphaExact !== true ||
  alphaPoint.pureBytes >= alphaPoint.peerBytes ||
  alphaPoint.pureScore < alphaPoint.peerScore ||
  alphaPoint.pureButteraugli > alphaPoint.peerButteraugli
)
  throw new Error('Incomplete alpha compression evidence')
const names = [
  'PureJsImage repository build',
  ...['@jsquash/jxl', 'jxl-oxide-wasm', 'wasm-vips'].map((name) => {
    const p = subjectManifest.packages.find((p) => p.name === name)
    if (!p) throw new Error(`Missing tested package ${name}`)
    return `${p.name} ${p.manifest.version}`
  }),
]
const footprints = rows(raw.footprints),
  summaries = rows(raw.summaries).filter((r) => r.runtime === 'chromium'),
  supplements = rows(supplementalQuality.comparisons).filter(
    (r) => r.status === 'adequate bracket',
  ),
  quality = rows(compressionQuality.comparisons).map((original) => {
    const prior =
      supplements.find(
        (r) =>
          r.fixture === original.fixture &&
          r.target === original.target &&
          r.comparator === original.comparator,
      ) ?? original
    const updated = rows(dcCompression.matchedFrozenPeerComparisons).find(
      (r) =>
        r.fixture === prior.fixture &&
        r.target === prior.target &&
        r.comparator === prior.comparator,
    )
    if (!updated) return prior
    const band = rows(dcCompression.matchedPhotoBands).find(
      (r) => r.fixture === prior.fixture && r.target === prior.target,
    )
    if (
      !band ||
      prior.status !== 'adequate bracket' ||
      updated.frozenPeerBytes !== prior.comparatorBytes ||
      updated.frozenPeerWidth !== prior.comparatorWidth ||
      typeof updated.interpolatedBytes !== 'number' ||
      typeof updated.ratio !== 'number' ||
      typeof band.width !== 'number' ||
      band.width > 0.25
    )
      throw new Error('Integrated DC comparison must retain the exact adequate frozen peer')
    return {
      ...prior,
      pureBytes: updated.interpolatedBytes,
      pureWidth: band.width,
      ratio: updated.ratio,
    }
  })
if (
  supplementalQuality.implementationSourceSha256 !== compressionQuality.implementationSourceSha256
)
  throw new Error('Supplemental quality source differs from the full replay')
const adequate = quality.filter((r) => r.status === 'adequate bracket')
const unresolvedQuality = quality.filter((r) => r.status === 'unresolved').length
if (
  dcCompression.completed !== true ||
  dcCompression.sourceAdopted !== true ||
  dcCompression.fullParity !== false ||
  dcCompression.publicComparisonCountsChanged !== false ||
  dcCompression.scoreTolerance !== 0.25 ||
  dcCompression.extrapolation !== false ||
  dcCompression.matchedFrozenPeerComparisons.length !== 12 ||
  adequate.length !== 13 ||
  unresolvedQuality !== 11
)
  throw new Error('Integrated DC evidence or original comparison counts differ')
const timings = rows(raw.timingRows).filter(
  (r) =>
    text(r.sourceReport).includes('/main-node') &&
    r.fixture === 'im26-1030-diagnostic' &&
    r.operation === 'encode' &&
    record(r.settings) &&
    r.settings.lossless === true &&
    r.settings.effort === 1,
)
const specialized = rows(raw.capabilities).filter(
  (r) =>
    !r.fixture && !['runtime availability', 'dedicated module worker'].includes(text(r.feature)),
)
const coldRows = rows(raw.timingRows).filter(
  (r) =>
    text(r.sourceReport).includes('/cold-node') &&
    r.fixture === 'im26-1030-diagnostic' &&
    r.operation === 'encode' &&
    record(r.settings) &&
    r.settings.lossless === true &&
    r.settings.effort === 1,
)
const spread = (values: unknown[], divisor = 1) => {
  const sorted = values
    .filter((v): v is number => typeof v === 'number' && Number.isFinite(v))
    .sort((a, b) => a - b)
  if (!sorted.length) return 'unavailable'
  return `${(sorted[Math.floor(sorted.length / 2)] / divisor).toFixed(1)} [${(sorted[0] / divisor).toFixed(1)}, ${(sorted[sorted.length - 1] / divisor).toFixed(1)}] (n=${sorted.length})`
}
const cold = subjects.map((subject) => {
  const selected = coldRows.filter((r) => r.subject === subject)
  const verified = selected.filter((r) => r.status === 'verified')
  return {
    subject,
    status: verified.length ? 'verified' : text(selected[0]?.status),
    time: spread(verified.map((r) => r.coldMs)),
    memory: spread(
      verified.map((r) => (record(r.memory) ? r.memory.peakRssBytes : null)),
      1024 * 1024,
    ),
  }
})
const previews = subjects.map((subject) => {
  const selected = rows(raw.preview.rows)
    .filter((r) => r.subject === subject)
    .flatMap((r) => (record(r.result) ? [r.result] : []))
  return {
    subject,
    time: spread(selected.map((r) => r.firstUsefulMs)),
    bytes: spread(selected.map((r) => r.firstTransferred)),
    scope: selected.length ? text(selected[0].scope) : 'Public incremental preview API not exposed',
  }
})
const maxWarm = Math.max(...timings.map((r) => (record(r.warmMs) ? n(r.warmMs.median) : 0)))
const maxBytes = Math.max(...footprints.map((f) => n(f.brotliBytes)))
const currentPhoto = rows(compressionLossless.rows).find((r) => r.fixture === 'im26-1416-original')
const currentPhoto7 = rows(groupLossless.effort7Rows).find(
  (r) => r.fixture === 'im26-1416-original',
)
const currentScreenshot7 = rows(groupLossless.effort7Rows).find(
  (r) => r.fixture === 'im26-8160-original',
)
const photoAt80 = rows(compressionQuality.comparisons).find(
  (r) => r.fixture === 'im26-1030-diagnostic' && r.target === 80 && r.comparator === 'vips',
)
if (
  !currentPhoto ||
  typeof currentPhoto.bytes !== 'number' ||
  !currentPhoto7 ||
  typeof currentPhoto7.bytes !== 'number' ||
  !currentScreenshot7 ||
  typeof currentScreenshot7.bytes !== 'number' ||
  !photoAt80 ||
