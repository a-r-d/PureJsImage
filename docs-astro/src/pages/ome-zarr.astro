---
import SiteLayout from '../layouts/SiteLayout.astro'
import { highlightTypeScript } from '../utils/highlight-typescript.ts'
import compatibilityReport from '../../../benchmark/generated/ome-zarr-compatibility.json' with {
  type: 'json',
}
import conformanceReport from '../../../benchmark/generated/ome-zarr-conformance.json' with {
  type: 'json',
}

const base = import.meta.env.BASE_URL
const assetBase = base.endsWith('/') ? base : `${base}/`
const featureTour = {
  label: 'Multidimensional + channels + labels + HCS',
  detail: 'Synthetic · 2 timepoints · 2 Z sections · 3 channels · 3 levels',
  url: `${assetBase}fixtures/ome-zarr-feature-tour`,
}
const publicSamples = [
  {
    label: 'Quick WSI',
    detail: '1.9 GiB · 53,760 × 32,256 · 3 channels',
    url: 'https://storage.googleapis.com/jax-public-ngff/public/41028.zarr',
    publishedBytes: 2_084_056_102,
  },
  {
    label: 'Square WSI',
    detail: '2.9 GiB · 38,400 × 38,656 · 3 channels',
    url: 'https://storage.googleapis.com/jax-public-ngff/public/46125.zarr',
    publishedBytes: 3_111_184_928,
  },
  {
    label: 'Large WSI',
    detail: '9.8 GiB · 96,000 × 55,296 · 3 channels',
    url: 'https://storage.googleapis.com/jax-public-ngff/public/42815.zarr',
    publishedBytes: 10_527_626_795,
  },
] as const

const defaultSample = publicSamples[0]

const collections = [
  ...new Set(compatibilityReport.results.map(({ collection }) => collection)),
].sort()
const surfaceLabels: Readonly<Record<string, string>> = {
  'ome-ngff-0.4-zarr-v2': 'OME-NGFF 0.4 / Zarr v2',
  'ome-ngff-0.5-zarr-v3': 'OME-NGFF 0.5 / Zarr v3',
  'regular-chunks': 'regular chunks',
  'sharding-indexed': 'sharding_indexed',
  'bioformats2raw-series': 'bioformats2raw series layout',
}
const representedSurfaces = [
  ...new Set(
    compatibilityReport.results.flatMap(({ observedSurfaces }) =>
      (observedSurfaces ?? []).filter((surface) => surfaceLabels[surface] !== undefined),
    ),
  ),
].map((surface) => surfaceLabels[surface])
const implementedSupport = [
  'OME-NGFF 0.4 and 0.5',
  'Zarr v2 and v3',
  'Regular and sharded reads',
  'OMERO display metadata',
  'Labels',
  'Plates and wells',
  'HTTP and ZIP stores',
  'Documented codec stack',
] as const
const outsideSupport = [
  'Writer',
  'OME-Zarr 0.6rc0',
  'Storage transformers',
  'Unsupported codecs and dtypes listed by the capability manifest',
  'Non-range-capable large remote serving',
] as const
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'PureJsImage OME-Zarr viewer',
  url: 'https://purejsimage.com/ome-zarr/',
  applicationCategory: 'ScientificApplication',
  operatingSystem: 'Modern web browsers',
  isAccessibleForFree: true,
  description:
    'A read-only OME-Zarr viewer demonstrating bounded browser access to multidimensional images, channels, labels, and HCS plates.',
})

const implementationCode = `import { createOmeZarrReader } from 'purejsimage/scientific/readers/ome-zarr'
import { createOmeZarrHttpContext } from 'purejsimage/scientific/browser'

// Public context: confined object names, bounded source LRU, cancellation,
// range validation, request coalescing, and measured network statistics.
const context = await createOmeZarrHttpContext(storeUrl, {
  maxOpenSources: 8,
  maxCacheBytesPerSource: 8_388_608,
})

const reader = createOmeZarrReader({
  limits: { rowsPerBlock: 1_024 },
  metadataValidation: 'compatible',
})
const document = await reader.open(context)

// Choose any displayable image or plate field. The UI persists these indices.
const summary = document.datasets.find(({ descriptor }) =>
  descriptor.axes.some(({ id }) => id === 'x') &&
  descriptor.axes.some(({ id }) => id === 'y'),
)
if (!summary) throw new Error('No x/y image dataset found')

const dataset = await document.openDataset(summary.id)
const fixedIndices = dataset.descriptor.axes
  .filter(({ id }) => id !== 'x' && id !== 'y')
  .map(({ id, length }) => ({ axisId: id, index: viewerAxisIndex(id, length) }))

// level and region come from the current canvas zoom and viewport.
for await (const block of dataset.readPlane({
  displayAxes: ['x', 'y'],
  fixedIndices,
  resolutionLevel: level,
  x,
  y,
  width,
  height,
  signal: request.signal,
})) {
  try {
    compositeIntoRgba(block)
  } finally {
    block.release?.()
  }
}

console.log(context.store.stats())
context.store.close()`

const httpAdapterCode = `import {
  createOmeZarrHttpContext,
  type OmeZarrHttpContext,
} from 'purejsimage/scientific/browser'

export const openRemoteOmeZarr = async (
  storeUrl: string,
  signal: AbortSignal,
): Promise<OmeZarrHttpContext> =>
  createOmeZarrHttpContext(storeUrl, {
    signal,
    maxOpenSources: 16,
    blockBytes: 262_144,
    maxCacheBytesPerSource: 2_097_152,
  })

// Pass the returned context directly to createOmeZarrReader().open().
// Keep context.store to inspect stats, reset counters, or close the session.`

const highlightedImplementationCode = highlightTypeScript(implementationCode)
const highlightedHttpAdapterCode = highlightTypeScript(httpAdapterCode)
---

<SiteLayout
  title="Only the Viewport | PureJsImage OME-Zarr viewer"
  description="Pan and zoom a multi-gigabyte OME-Zarr whole-slide image directly from object storage while measuring metadata, shard, chunk, range, cache, and cancellation activity."
  canonical="https://purejsimage.com/ome-zarr/"
  bodyClass="wsi-page ome-zarr-page"
  current="ome-zarr/"
  skipLabel="Skip to OME-Zarr viewer"
  openGraph={{
    title: 'Only the Viewport | PureJsImage OME-Zarr viewer',
    description: 'Browse a multi-gigabyte OME-Zarr WSI from static object storage and measure what the visible viewport actually fetches.',
    url: 'https://purejsimage.com/ome-zarr/',
    image: 'https://purejsimage.com/assets/ome-zarr-open-graph.png',
    imageAlt: 'PureJsImage OME-Zarr viewer with active channels and measured fetched bytes',
    imageWidth: 1200,
    imageHeight: 630,
  }}
  twitterCard="summary_large_image"
>
  <script type="application/ld+json" set:html={structuredData}></script>
  <main id="main">
    <section class="wsi-hero">
      <div class="container wsi-hero-grid">
        <div>
          <p class="eyebrow">OME-Zarr whole-slide image · measured in your browser</p>
          <h1>Only the viewport.</h1>
          <p class="wsi-lede">Pan and zoom a multi-gigabyte OME-Zarr whole-slide image. PureJsImage reads only the metadata, shard indexes, and chunks needed for the viewport directly from object storage—no application server or tile proxy.</p>
          <p class="ome-zarr-reader-scope">The current WSI proves large remote sharded access. The same reader also exposes Z/T navigation, channel display metadata, labels, image collections, and HCS plates and wells.</p>
          <div class="wsi-proof-pills" aria-label="Demo constraints">
            <span>Reader: NGFF 0.4 + 0.5</span><span>Reader: Zarr v2 + v3</span><span>Current sample: v3 sharded</span><span>Browser HTTP access</span><span>0 runtime dependencies</span>
          </div>
        </div>
        <aside class="wsi-claim-card">
          <span>MEASURED LIVE</span>
          <strong id="ome-zarr-measured-bytes">Reading metadata</strong>
          <p>fetched across metadata objects, shard indexes, and visible logical chunks</p>
          <small><span id="ome-zarr-measured-fraction">Opening…</span><span class="wsi-metadata-summary" id="ome-zarr-metadata-summary">Metadata objects pending</span></small>
        </aside>
      </div>
    </section>

    <section class="wsi-demo" aria-labelledby="ome-zarr-viewer-title">
      <div class="container">
        <div class="ome-zarr-demo-layout">
          <aside class="ome-zarr-launch-panel" aria-label="Choose and open an OME-Zarr store">
            <div class="wsi-source-bar">
              <div>
                <label for="ome-zarr-url">OME-Zarr store URL</label>
                <input id="ome-zarr-url" type="url" value={defaultSample.url} spellcheck="false" autocomplete="off" />
              </div>
              <button class="button" id="ome-zarr-open" type="button">Open store</button>
            </div>
            <div class="wsi-sample-picker" aria-labelledby="ome-zarr-sample-picker-label">
              <span id="ome-zarr-sample-picker-label">Sample stores</span>
              <div class="wsi-sample-group" data-sample-group="large-public-wsi">
                <span>Large public WSI</span>
                <div>
                  {publicSamples.map((sample, index) => (
                    <button
                      type="button"
                      data-ome-zarr-sample-url={sample.url}
                      data-ome-zarr-published-bytes={sample.publishedBytes}
                      aria-pressed={index === 0 ? 'true' : 'false'}
                    >
                      <strong>{sample.label}</strong>
                      <small>{sample.detail}</small>
                    </button>
                  ))}
                </div>
              </div>
              <div class="wsi-sample-group" data-sample-group="feature-tour">
                <span>Feature tour</span>
                <div>
                  <button
                    type="button"
                    data-ome-zarr-sample-url={featureTour.url}
                    aria-pressed="false"
                  >
                    <strong>{featureTour.label}</strong>
                    <small>{featureTour.detail}</small>
                  </button>
                </div>
              </div>
            </div>
            <p class="ome-zarr-source-credit">Public WSI from <a href="https://www.jax.org/" target="_blank" rel="noreferrer">The Jackson Laboratory</a> · <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noreferrer">CC BY 4.0</a> · no proxy</p>
            <details class="ome-zarr-source-details">
              <summary>Sample and HTTP details</summary>
              <p><strong>Feature Tour:</strong> a deterministic, synthetic same-origin store generated from shared first-party fixture code. It is not a real experiment.</p>
              <p>The public stores are OME 2024 NGFF Challenge conversions. Their shard responses return valid HTTP 206 ranges; Google Cloud currently hides <code>Content-Range</code> from browser JavaScript, so this demo establishes each object size with a measured HEAD request and still validates 206 plus exact response length. No PureJsImage proxy is involved.</p>
            </details>
          </aside>

          <div class="ome-zarr-demo-stage">
            <div class="wsi-workspace">
              <section class="wsi-canvas-panel" aria-labelledby="ome-zarr-viewer-title">
                <header class="wsi-canvas-toolbar">
                  <div><p class="demo-card-kicker">Logical chunks from sharded arrays</p><h2 id="ome-zarr-viewer-title">OME-Zarr viewport</h2></div>
                  <div class="wsi-view-controls">
                    <button id="ome-zarr-zoom-out" type="button" aria-label="Zoom out" disabled>−</button>
                    <button id="ome-zarr-fit" type="button" disabled>Fit</button>
                    <button id="ome-zarr-zoom-in" type="button" aria-label="Zoom in" disabled>+</button>
                    <button id="ome-zarr-fullscreen" type="button" aria-label="Enter full screen" disabled>Full screen</button>
                  </div>
                </header>
                <section class="ome-zarr-controls" aria-label="Scientific viewer controls">
                  <div class="ome-zarr-control-row ome-zarr-dataset-control">
                    <label for="ome-zarr-dataset">Image / plate field</label>
                    <select id="ome-zarr-dataset" disabled><option>Waiting for metadata…</option></select>
                    <span id="ome-zarr-plate-summary">Single image</span>
                  </div>
                  <div class="ome-zarr-axis-controls" id="ome-zarr-axis-controls" aria-label="Axis navigation"></div>
                  <div class="ome-zarr-channel-panel">
                    <header><strong>Channel mixer</strong><span>Up to three channels · window / gamma</span></header>
                    <div id="ome-zarr-channel-controls"></div>
                    <div class="ome-zarr-histogram-row">
                      <canvas id="ome-zarr-histogram" width="360" height="68" aria-label="Visible tile channel histograms"></canvas>
                      <button id="ome-zarr-auto-contrast" type="button" disabled>Auto contrast visible tiles</button>
                    </div>
                  </div>
                  <div class="ome-zarr-label-control">
                    <label for="ome-zarr-label">Label overlay</label>
                    <select id="ome-zarr-label" disabled><option value="">None available</option></select>
                    <label for="ome-zarr-label-opacity">Opacity <output id="ome-zarr-label-opacity-value">45%</output></label>
                    <input id="ome-zarr-label-opacity" type="range" min="0" max="100" value="45" disabled>
                  </div>
                </section>
                <div class="wsi-canvas-wrap" id="ome-zarr-canvas-wrap" aria-busy="true">
                  <canvas class="wsi-canvas" id="ome-zarr-canvas" aria-label="Pannable and zoomable OME-Zarr whole-slide image"></canvas>
                  <div class="wsi-canvas-help">Drag to pan · wheel or pinch to zoom</div>
                  <div class="ome-zarr-cursor-readout" id="ome-zarr-cursor-readout">X — · Y — · display RGB —</div>
                  <div class="ome-zarr-scale" id="ome-zarr-scale" hidden><span></span><output></output></div>
                  <canvas class="ome-zarr-minimap" id="ome-zarr-minimap" width="180" height="126" aria-label="Slide overview and current viewport"></canvas>
                  <div class="wsi-level-live" id="ome-zarr-level-live">Waiting for OME-Zarr metadata…</div>
                  <div class="wsi-loading" id="ome-zarr-loading" data-phase="opening" role="status" aria-live="polite" aria-atomic="true">
                    <div class="wsi-loading-card">
                      <span class="wsi-loading-spinner" aria-hidden="true"></span>
                      <div class="wsi-loading-copy">
                        <strong id="ome-zarr-loading-title">Opening OME-Zarr store</strong>
                        <span id="ome-zarr-loading-detail">Starting the worker and connecting to object storage…</span>
                      </div>
                      <div class="wsi-loading-progress" id="ome-zarr-loading-progress" role="progressbar" aria-label="OME-Zarr loading progress">
                        <span id="ome-zarr-loading-progress-bar"></span>
                      </div>
                    </div>
                  </div>
                </div>
                <p class="wsi-status" id="ome-zarr-status" role="status" aria-live="polite">Starting the worker…</p>
                <section class="wsi-activity" aria-labelledby="ome-zarr-activity-title">
                  <div><strong id="ome-zarr-activity-title">Viewport tile jobs</strong><span><i class="pending"></i>Pending <i class="decoded"></i>Decoded <i class="cancelled"></i>Cancelled</span></div>
                  <div class="wsi-request-strip" id="ome-zarr-request-strip" aria-live="polite" data-scroll-region="chips"></div>
                  <p>Each chip is a render job, not an HTTP request. Actual object and range requests are counted separately in the instrument.</p>
                </section>
              </section>

              <aside class="wsi-instrument" aria-labelledby="ome-zarr-instrument-title">
                <header><div><p class="demo-card-kicker">Measurement instrument</p><h2 id="ome-zarr-instrument-title">What this tab actually used</h2></div><span>MEASURED</span></header>
                <dl>
                  <div><dt>Store</dt><dd id="ome-zarr-stat-store">Not available</dd></div>
                  <div><dt>OME-NGFF</dt><dd id="ome-zarr-stat-version">Not available</dd></div>
                  <div><dt>Zarr</dt><dd id="ome-zarr-stat-zarr">Not available</dd></div>
                  <div><dt>Published size</dt><dd id="ome-zarr-stat-size">Not available</dd></div>
                  <div><dt>Dimensions</dt><dd id="ome-zarr-stat-dimensions">Not available</dd></div>
                  <div><dt>Axes</dt><dd id="ome-zarr-stat-axes">Not available</dd></div>
                  <div><dt>Active channels</dt><dd id="ome-zarr-stat-channels">Not available</dd></div>
                  <div><dt>Levels</dt><dd id="ome-zarr-stat-levels">Not available</dd></div>
                  <div><dt>Logical chunk</dt><dd id="ome-zarr-stat-logical-chunk">Not available</dd></div>
                  <div><dt>Shard</dt><dd id="ome-zarr-stat-shard">Not available</dd></div>
                  <div><dt>Codecs</dt><dd id="ome-zarr-stat-codecs">Not available</dd></div>
                </dl>
                <div class="wsi-stat-divider"></div>
                <dl>
                  <div><dt>Object requests</dt><dd id="ome-zarr-stat-object-requests">0</dd></div>
                  <div><dt>Range requests</dt><dd id="ome-zarr-stat-range-requests">0</dd></div>
                  <div><dt>Bytes fetched</dt><dd id="ome-zarr-stat-bytes">0 B</dd></div>
                  <div><dt>Unique source bytes</dt><dd id="ome-zarr-stat-unique-bytes">0 B</dd></div>
                  <div><dt>Metadata bytes</dt><dd id="ome-zarr-stat-metadata-bytes">0 B</dd></div>
                  <div><dt>Shard / chunk bytes</dt><dd id="ome-zarr-stat-array-bytes">0 B</dd></div>
                  <div class="wsi-fraction-row"><dt>Fraction of published store</dt><dd id="ome-zarr-stat-fraction">0.000%</dd></div>
                  <div><dt>Viewport tiles decoded</dt><dd id="ome-zarr-stat-decoded">0</dd></div>
                  <div><dt>Viewport tiles cancelled</dt><dd id="ome-zarr-stat-cancelled">0</dd></div>
                  <div><dt>Viewport tiles failed</dt><dd id="ome-zarr-stat-failed">0</dd></div>
                  <div><dt>Tile jobs in flight</dt><dd id="ome-zarr-stat-in-flight">0</dd></div>
                  <div><dt>Last / total decode</dt><dd id="ome-zarr-stat-decode-time">0 / 0 ms</dd></div>
                  <div><dt>Bitmap cache hits</dt><dd id="ome-zarr-stat-cache-hits">0</dd></div>
                  <div><dt>Bitmap cache resident</dt><dd id="ome-zarr-stat-cache-resident">0 / 192 tiles</dd></div>
                  <div><dt>Source cache hits</dt><dd id="ome-zarr-stat-source-cache-hits">0</dd></div>
                  <div><dt>Source cache resident</dt><dd id="ome-zarr-stat-source-cache-resident">0 B</dd></div>
                  <div><dt>Coalesced consumers</dt><dd id="ome-zarr-stat-coalesced">0</dd></div>
                  <div><dt>Aborted consumers</dt><dd id="ome-zarr-stat-aborted">0</dd></div>
                  <div><dt>Objects opened</dt><dd id="ome-zarr-stat-objects-opened">0</dd></div>
                </dl>
                <button class="button secondary" id="ome-zarr-reset" type="button" disabled>Reset counters</button>
                <p class="wsi-instrument-note">Reset establishes baselines against monotonic worker counters. It does not discard useful source or bitmap caches, so later viewport work may complete without new transfer.</p>
              </aside>
            </div>
            <p class="wsi-clinical-note ome-zarr-trust-line">Read-only technical demonstration. Not validated for diagnostic use.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section ome-zarr-evidence" aria-labelledby="ome-zarr-evidence-title">
      <div class="container">
        <div class="demo-section-heading">
          <div><p class="eyebrow">Checked-in evidence</p><h2 id="ome-zarr-evidence-title">OME-Zarr 0.5 attribute-case conformance</h2></div>
          <p>This is attribute-case conformance plus a separate public-store compatibility corpus. It is not a claim of complete Zarr v3 or full hierarchy conformance.</p>
        </div>
        <dl class="ome-zarr-evidence-grid">
          <div><dt>OME-Zarr version tested</dt><dd id="ome-zarr-evidence-version">{conformanceReport.omeZarrVersion}</dd></div>
          <div><dt>Upstream case-corpus revision</dt><dd id="ome-zarr-evidence-revision"><code>{conformanceReport.upstreamRevision}</code></dd></div>
          <div><dt>Normative attribute cases</dt><dd id="ome-zarr-evidence-normative">{conformanceReport.normative.passed} / {conformanceReport.normative.total}</dd></div>
          <div><dt>Optional strict cases</dt><dd id="ome-zarr-evidence-strict">{conformanceReport.strict.passed} / {conformanceReport.strict.total}</dd></div>
          <div><dt>Explicit exclusions</dt><dd id="ome-zarr-evidence-exclusions">{conformanceReport.excludedCases.length}</dd></div>
          <div><dt>Public roots tested</dt><dd id="ome-zarr-evidence-public-roots">{compatibilityReport.results.length}</dd></div>
          <div class="wide"><dt>Collections represented</dt><dd id="ome-zarr-evidence-collections">{collections.length} · {collections.join(' · ')}</dd></div>
          <div class="wide"><dt>Remote versions and layouts represented</dt><dd id="ome-zarr-evidence-layouts">{representedSurfaces.join(' · ')}</dd></div>
        </dl>
        <nav class="ome-zarr-evidence-links" aria-label="OME-Zarr evidence and support links">
          <a href="https://github.com/a-r-d/PureJsImage/blob/main/docs/generated/ome-zarr-compatibility.md">Readable report</a>
          <a href="https://raw.githubusercontent.com/a-r-d/PureJsImage/main/benchmark/generated/ome-zarr-conformance.json">Conformance JSON</a>
          <a href="https://raw.githubusercontent.com/a-r-d/PureJsImage/main/benchmark/generated/ome-zarr-compatibility.json">Compatibility JSON</a>
          <a href="https://github.com/a-r-d/PureJsImage/blob/main/docs/scientific-ome-zarr.md">Exact support documentation</a>
          <a href="https://github.com/a-r-d/PureJsImage/issues">Issue tracker</a>
        </nav>
      </div>
    </section>

    <section class="section ome-zarr-support" aria-labelledby="ome-zarr-support-title">
      <div class="container">
        <div class="demo-section-heading">
          <div><p class="eyebrow">Support boundary</p><h2 id="ome-zarr-support-title">What the reader does—and does not—cover.</h2></div>
          <p>The capability manifest and exact support documentation remain authoritative for codec, dtype, storage, validation-mode, and serving details.</p>
        </div>
        <div class="ome-zarr-support-grid">
          <section aria-labelledby="ome-zarr-implemented-title">
            <h3 id="ome-zarr-implemented-title">Implemented</h3>
            <ul>{implementedSupport.map((item) => <li>{item}</li>)}</ul>
          </section>
          <section aria-labelledby="ome-zarr-outside-title">
            <h3 id="ome-zarr-outside-title">Explicitly outside the current boundary</h3>
            <ul>{outsideSupport.map((item) => <li>{item}</li>)}</ul>
          </section>
        </div>
        <p class="ome-zarr-support-source">See the <a href={`${assetBase}capabilities.json`}>generated capability manifest</a> and <a href="https://github.com/a-r-d/PureJsImage/blob/main/docs/scientific-ome-zarr.md">exact OME-Zarr support documentation</a> for the complete boundary.</p>
      </div>
    </section>

    <section class="section wsi-how" aria-labelledby="ome-zarr-how-title">
      <div class="container">
        <div class="demo-section-heading">
          <div><p class="eyebrow">The access pattern</p><h2 id="ome-zarr-how-title">Metadata, shard index, intersecting chunks.</h2></div>
          <p>The worker owns the URL-backed store, existing PureJsImage OME-Zarr reader, channel composition, cancellation, and network counters. The main thread owns interaction, a bounded 192-bitmap LRU, best-level selection, and canvas drawing.</p>
        </div>
        <div class="wsi-flow" aria-label="OME-Zarr whole-slide data flow">
          <div><span>1</span><strong>NGFF metadata</strong><small>Enumerate image fields, wells, labels, channels, and calibrated axes</small></div>
          <i aria-hidden="true">→</i>
          <div><span>2</span><strong>Shard + chunk ranges</strong><small>Read only indexes and logical chunks intersecting the bounded region</small></div>
          <i aria-hidden="true">→</i>
          <div><span>3</span><strong>Worker + canvas</strong><small>Mix channels and labels, then transfer one generation-safe <code>ImageBitmap</code></small></div>
        </div>
        <div class="wsi-tradeoff"><strong>Read-only and bounded by design.</strong><p>The viewer exposes plate fields, non-spatial axes, a three-channel mixer, compatible label overlays, visible-tile histograms, and calibrated navigation without downloading the full store. It does not write annotations or data, authenticate private stores, or cache decoded chunks beyond the bounded bitmap LRU. Label overlays require matching x/y pyramid geometry; unsupported datasets remain visible but disabled.</p></div>
      </div>
    </section>

    <section class="section wsi-code" aria-labelledby="ome-zarr-code-title">
      <div class="container">
        <div class="demo-section-heading">
          <div><p class="eyebrow">Build it with PureJsImage</p><h2 id="ome-zarr-code-title">The viewport read in one worker.</h2></div>
          <p>The demo delegates OME-NGFF parsing, pyramid metadata, shard indexes, codecs, and bounded region reads to PureJsImage. Application code only resolves remote objects, chooses the visible level and region, and composites returned blocks for canvas display.</p>
        </div>
        <div class="code-window wsi-code-window">
          <div class="window-bar"><span class="window-dot"></span><span class="window-dot"></span><span class="window-dot"></span><span class="window-title">Implementation files</span></div>
          <fieldset class="code-tabset">
            <legend>Choose an implementation file</legend>
            <input id="ome-zarr-code-worker" name="ome-zarr-code-file" type="radio" checked>
            <input id="ome-zarr-code-http" name="ome-zarr-code-file" type="radio">
            <div class="code-tabs">
