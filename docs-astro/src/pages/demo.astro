---
import SiteLayout from '../layouts/SiteLayout.astro'
---

<SiteLayout title="Browser demo | PureJsImage" description="Open TIFF, BigTIFF, GeoTIFF, OME-TIFF, and whole-slide images locally in your browser. Drop a file or load a public example to inspect, pan, and zoom." canonical="https://purejsimage.com/demo/" bodyClass="demo-page" current="demo/" skipLabel="Skip to image workspace" openGraph={{"title":"PureJsImage browser TIFF viewer","description":"Drop a TIFF into a local browser viewer, or open a public GeoTIFF example and inspect it without an upload.","url":"https://purejsimage.com/demo/"}}>
<main id="main">
    <section class="demo-intro">
      <div class="container demo-intro-row">
        <div>
          <p class="eyebrow">Browser image viewer + converter</p>
          <h1 id="workspace-title">Open an image. Choose what to do.</h1>
          <p>View any supported image with pan and zoom, or switch to Convert and create JPEG, PNG, WebP, AVIF, TIFF, and other first-party output. The selected mode never changes when you choose a file.</p>
        </div>
        <p class="demo-local-summary"><strong>No server upload</strong><span>Your files stay in this tab. Public samples load from their named source only when you click Open here.</span></p>
      </div>
    </section>

    <section class="demo-workspace" aria-labelledby="workspace-title">
      <div class="container demo-tool-container">
        <div class="demo-app-layout">
          <aside class="demo-sidebar" aria-label="Open an image">
            <label class="demo-drop-zone" id="demo-drop-zone" for="demo-file">
              <input class="demo-file-input" id="demo-file" type="file" accept="image/*,.avif,.btf,.ico,.jp2,.j2c,.j2k,.svs,.tf2,.tf8,.tif,.tiff">
              <span class="demo-drop-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5M5 14v5h14v-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/></svg></span>
              <span><strong>Open or drop a weird image</strong><small>TIFF, BigTIFF, OME-TIFF, SVS, or another supported image</small></span>
              <span class="button small" aria-hidden="true">Choose file</span>
            </label>

            <section class="demo-example-panel" aria-labelledby="demo-example-title">
              <header>
                <div><p class="demo-card-kicker">Public sample files</p><h2 id="demo-example-title">Sample library</h2></div>
                <span>26 files</span>
              </header>
              <label class="demo-sample-search">
                <span>Search samples</span>
                <input id="demo-sample-search" type="search" placeholder="electron microscopy, OME, GeoTIFF, 12-bit…" autocomplete="off">
              </label>
              <div class="demo-example-list" aria-live="polite">
                <article class="demo-sample-card" data-demo-sample-card data-sample-search="real biological microscopy c elegans embryo tubulin histone gfp time series ome tiff channel 1">
