---
import SiteLayout from '../layouts/SiteLayout.astro'
import documentation from '../data/documentation-data.json'
import packageMetrics from '../data/package-metrics.json'

const mib = (bytes: number): string => `${(bytes / 1024 / 1024).toFixed(1)} MiB`
const kib = (bytes: number): string => `${(bytes / 1024).toFixed(1)} KiB`
const date = (value: string): string => value.slice(0, 10)
const github = (path: string | null): string | null =>
  path === null ? null : `https://github.com/a-r-d/PureJsImage/blob/main/${path}`
const ordinaryCharts = [
  {
    key: 'speed',
    title: 'Common web codec speed',
    description: 'Median wall time · logarithmic scale · lower is better',
  },
  {
    key: 'quality',
    title: 'Common web codec quality',
    description: 'Premultiplied-RGBA PSNR · higher is better',
  },
  {
    key: 'memory',
    title: 'Common web codec memory',
    description: 'Absolute process peak RSS · lower is better',
  },
] as const
const scientificCharts = Object.entries(documentation.scientific.charts)
const majorSizeIds = ['core', 'codecs-web', 'codecs-all', 'scientific', 'scientific-readers-all']
const majorSizes = packageMetrics.targets.filter(({ id }) => majorSizeIds.includes(id))
const competitorSizes = packageMetrics.targets.filter(({ category }) => category === 'competitor')
const hostInstalledBytes = packageMetrics.package.unpackedPackageBytes
const installedBytes = (entry: (typeof packageMetrics.targets)[number]): number =>
  entry.unpackedPackageBytes ?? hostInstalledBytes
---

<SiteLayout
  title="Validated image and scientific reader benchmarks | PureJsImage"
  description="Current correctness-gated common web codec and scientific reader benchmarks: speed, quality, peak RSS, source I/O, first-block latency, initialization, and package footprint."
  canonical="https://purejsimage.com/performance/"
  current="performance/"
  openGraph={{
    title: 'Validated image and scientific reader benchmarks | PureJsImage',
    description:
      'Separate, correctness-gated benchmark evidence for common web codec workflows and native scientific readers.',
    url: 'https://purejsimage.com/performance/',
  }}
  twitterCard="summary"
>
  <main id="main">
    <header class="page-hero">
      <div class="container">
        <p class="eyebrow">Generated performance evidence</p>
        <h1>Common web codec and scientific reader benchmarks.</h1>
        <p class="page-lede">
          Results stay separated by workload class. A timing is admitted only after dimensions,
          selection, sample or pixel hashes, output validation, and any required quality oracle pass.
          Unsupported and invalid rows never count as fast.
        </p>
        <div class="page-meta">
          <span class="pill">Isolated processes</span>
          <span class="pill">Absolute peak RSS</span>
          <span class="pill">Pinned fixtures</span>
          <span class="pill">Generated claims</span>
        </div>
      </div>
    </header>

    <section class="proof-section performance-showcase" id="common-web-codecs">
      <div class="container">
        <div class="proof-heading">
          <div>
            <p class="section-label">Common web codecs</p>
            <h2>Speed, quality, memory, and package footprint.</h2>
          </div>
          <p>
            The {date(documentation.ordinary.createdAt)} profile recorded {
              documentation.ordinary.statusCounts.pass
            } validated passes and {documentation.ordinary.statusCounts.unsupported} explicit
            unsupported rows across TypeScript, explicitly registered PureJsImage WASM, other pure
            JavaScript libraries, jSquash WebAssembly, and Sharp/libvips.
          </p>
        </div>
        <div class="benchmark-facts">
          <div>
            <strong>{documentation.ordinary.headline.memoryReductionPercent.toFixed(1)}%</strong>
            <span>less peak RSS than Jimp</span>
          </div>
          <div>
            <strong>{mib(documentation.ordinary.headline.pureJsImagePeakRssBytes)}</strong>
            <span>PureJsImage northstar RSS</span>
          </div>
          <div>
            <strong>{documentation.ordinary.statusCounts.pass}</strong>
            <span>validated result rows</span>
          </div>
          <div>
            <strong>0</strong>
            <span>invalid outputs or errors</span>
          </div>
        </div>
        <p class="section-note">
          The memory headline is the same 24-megapixel northstar photo workflow within one result and
          one environment fingerprint: {mib(documentation.ordinary.headline.pureJsImagePeakRssBytes)}
          for the TypeScript path versus {mib(documentation.ordinary.headline.jimpPeakRssBytes)} for
          Jimp. It is not a cross-date comparison.
        </p>
        <div class="codec-grid">
          {
            ordinaryCharts.map((chart) => (
              <figure class="card">
                <h3>{chart.title}</h3>
                <p>{chart.description}</p>
                <div class="benchmark-image-scroll">
                  <img
                    src={`../${documentation.ordinary.charts[chart.key]}`}
                    alt={`${chart.title} chart from the current validated common web codec profile`}
                    loading={chart.key === 'speed' ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </div>
                <figcaption>
                  Environment: {documentation.ordinary.environment.os}, {
                    documentation.ordinary.environment.architecture
                  }, Node {documentation.ordinary.environment.node}, {
                    documentation.ordinary.environment.cpu
                  }. Resize workflows use each engine’s documented default kernel.
                </figcaption>
              </figure>
            ))
          }
        </div>
        <h3>Recorded common web codec engines</h3>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Engine</th><th>Version</th><th>Class</th></tr></thead>
            <tbody>
              {
                documentation.ordinary.engineVersions.map((engine) => (
                  <tr><td>{engine.id}</td><td>{engine.version}</td><td>{engine.kind}</td></tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p>
          <a
            class="text-link"
            href={github(documentation.ordinary.reportMarkdown) ?? '#'}
            target="_blank"
            rel="noreferrer">Current common web codec report →</a
          >
        </p>
      </div>
    </section>

    <section class="section" id="scientific-readers">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="section-label">Scientific readers</p>
            <h2>First usable data, selected operations, source I/O, and footprint.</h2>
          </div>
          <p>
            The {date(documentation.scientific.baseline.createdAt)} PureJsImage baseline validated {
              documentation.scientific.baseline.statusCounts.supported
            }/{documentation.scientific.baseline.workloadCount} workloads across {
              documentation.support.scientificReaderCount
            } explicit readers. The competitor charts use only shared workloads with validated output;
            every published workload includes a PureJsImage row plus at least one external engine.
            The {date(documentation.scientific.scaling.createdAt)} scaling profile admitted {
              documentation.scientific.scaling.chartEligibleWorkloadCount
            }/{documentation.scientific.scaling.workloadCount} PureJsImage medium/large rows under the
            10% CV threshold. Unsupported semantics remain visible in chart notes and report status
            counts.
          </p>
        </div>
        {
          documentation.scientific.crossEnvironmentDisclaimer && (
            <div class="callout warning">
              <strong>Environment boundary.</strong>{' '}
              {documentation.scientific.crossEnvironmentDisclaimer}
            </div>
          )
        }
        {
          documentation.scientific.competitors.noisyRows.length > 0 && (
            <div class="callout warning">
              <strong>Measured noise remains visible.</strong> Rows at or above 10% coefficient of
              variation are labeled directly in the timing charts and are not used as documentation
              headlines. See the generated JSON for the exact engine, workload, metric, and CV.
            </div>
          )
        }
        <div class="codec-grid">
          {
            scientificCharts.map(([title, path]) => (
              <figure class="card">
                <h3>{title}</h3>
                <div class="benchmark-image-scroll">
                  <img
                    src={`../${path}`}
                    alt={`${title} for shared validated scientific JS and WASM workloads`}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <figcaption>
                  Generated from the {date(documentation.scientific.competitors.createdAt)} scientific
                  competitor artifact. Each SVG records scale direction, environment, engine class,
                  unsupported rows, and material input-copy differences.
                </figcaption>
              </figure>
            ))
          }
        </div>

        <h3>Scientific metric contract</h3>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Metric</th><th>Interpretation</th></tr></thead>
            <tbody>
              <tr><td>Time to first usable block</td><td>Latency until validated selected data becomes available after open and initialization.</td></tr>
              <tr><td>Selected-operation wall time</td><td>Complete public operation path for the pinned selection; validation remains outside timing.</td></tr>
              <tr><td>Absolute peak RSS</td><td>Whole isolated process, including runtime, native allocations, and WASM memory.</td></tr>
              <tr><td>Source requests and bytes</td><td>Instrumented request count, returned bytes, unique bytes, and overfetch for the selected operation.</td></tr>
              <tr><td>Import and initialization</td><td>Module import, registry construction, and WASM initialization remain separate from steady-state work.</td></tr>
              <tr><td>Bundle and WASM footprint</td><td>gzip/Brotli JavaScript, external or embedded WASM, installed bytes, and package count.</td></tr>
              <tr><td>Correctness</td><td>Expected shape, native sample type, selected-sample hash, calibration assertions, and output bytes.</td></tr>
            </tbody>
          </table>
        </div>

        <h3>Scientific JS/WASM engine versions</h3>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Engine</th><th>Version</th><th>Class</th></tr></thead>
            <tbody>
              {
                documentation.scientific.competitors.engineVersions.map((engine) => (
                  <tr>
                    <td>{engine.id}</td>
                    <td>{engine.packageVersion}</td>
                    <td>{engine.implementationClass}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p>
          <a
            class="text-link"
            href={github(documentation.scientific.baseline.reportMarkdown) ?? '#'}
            target="_blank"
            rel="noreferrer">PureJsImage scientific baseline →</a
          > · <a
            class="text-link"
            href={github(documentation.scientific.scaling.reportMarkdown) ?? '#'}
            target="_blank"
            rel="noreferrer">PureJsImage medium/large scaling report →</a
          > · <a
            class="text-link"
            href={github(documentation.scientific.competitors.reportMarkdown) ?? '#'}
            target="_blank"
            rel="noreferrer">Scientific JS/WASM report →</a
          > · <a class="text-link" href="../scientific-formats/">Scientific format reference →</a>
        </p>
      </div>
    </section>

    <section class="section tint" id="package-footprint">
      <div class="container">
        <div class="section-heading">
          <div><p class="section-label">Current generated sizes</p><h2>Entry points, installed packages, and WASM assets.</h2></div>
          <p>
            Minified JavaScript uses one deterministic esbuild configuration. npm package values are
            extracted installed bytes, not compressed tarball downloads. Native and WASM payloads are
            labeled separately from JavaScript wrappers.
          </p>
        </div>
        <h3>PureJsImage major entries</h3>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Entry</th><th>Import</th><th>Minified</th><th>gzip</th><th>Brotli</th><th>Installed</th></tr></thead>
            <tbody>
              {
                majorSizes.map((entry) => (
                  <tr>
                    <td>{entry.name}</td>
                    <td><code>{entry.entry.packageExports?.join(', ')}</code></td>
                    <td>{kib(entry.minifiedJsBytes)}</td>
                    <td>{kib(entry.gzipBytes)}</td>
                    <td>{kib(entry.brotliBytes)}</td>
                    <td>{mib(installedBytes(entry))}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <h3>Package footprint context</h3>
        <p>
          The PureJsImage common-web entry is measured above. The competitor table preserves the
          historical JPEG/PNG-matched package targets so adding AVIF does not silently redefine the
          older footprint comparison; each common-web benchmark report records the exact installed
          engine package set it used.
        </p>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Engine import</th><th>Implementation</th><th>Minified JS</th><th>Installed</th><th>Production packages</th></tr></thead>
            <tbody>
              {
                competitorSizes.map((entry) => (
                  <tr>
                    <td>{entry.name}</td>
                    <td>{entry.implementation}</td>
                    <td>{kib(entry.minifiedJsBytes)}</td>
                    <td>{mib(installedBytes(entry))}</td>
                    <td>
                      {entry.productionPackageCount ??
                        packageMetrics.package.productionPackageCount}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <h3>Optional PureJsImage WASM assets</h3>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Asset</th><th>Raw</th><th>gzip</th><th>Brotli</th></tr></thead>
            <tbody>
              {
                packageMetrics.wasmAssets.map((asset) => (
                  <tr><td>{asset.name}</td><td>{kib(asset.rawBytes)}</td><td>{kib(asset.gzipBytes)}</td><td>{kib(asset.brotliBytes)}</td></tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section" id="lambda">
      <div class="container prose">
        <p class="section-label">Historical deployment evidence</p>
        <h2>AWS Lambda measurements remain separately dated.</h2>
        <p>
          The August 9, 2026 Lambda reports remain useful for x86_64/ARM64, cold/warm, memory-tier,
          and explicit JPEG WASM context. They are historical deployment snapshots, not merged into
          the current local headline or scientific-reader charts.
        </p>
        <p>
          <a class="text-link" href="https://github.com/a-r-d/PureJsImage/blob/main/benchmark/results/aws-lambda-arm-wasm-2026-08-09.md" target="_blank" rel="noreferrer">ARM and explicit WASM report →</a>
          · <a class="text-link" href="https://github.com/a-r-d/PureJsImage/blob/main/benchmark/results/aws-lambda-2026-08-09.md" target="_blank" rel="noreferrer">Memory-tier report →</a>
        </p>
      </div>
    </section>

    <section class="section tint" id="methodology">
      <div class="container prose">
        <p class="section-label">Methodology</p>
        <h2>Reproduce and interpret the evidence.</h2>
        <ul>
          <li>Input bytes and fixture hashes are pinned before measurement.</li>
          <li>Measured samples run in isolated processes after configured untimed warmups.</li>
          <li>Output validation and independent quality measurement remain outside timed regions.</li>
          <li>Common web codec resize charts use engine-default kernels and are default-experience comparisons.</li>
          <li>Scientific charts compare only shared operations; they do not create an all-format winner score.</li>
          <li>Different environment fingerprints are not compared without an explicit disclaimer.</li>
        </ul>
        <pre><code>npm run fixtures:prepare
npm run fixtures:verify
npm run bench:web-codecs
npm run bench:web-codecs:charts
npm run bench:scientific:baseline
npm run bench:scientific:range
npm run bench:scientific:scaling
npm run bench:scientific:competitors:js
npm run bench:scientific:competitors:baseline
npm run bench:viewers:smoke
npm run documentation:write
npm run documentation:check</code></pre>
        <p>
          <a class="text-link" href="https://github.com/a-r-d/PureJsImage/blob/main/benchmark/README.md" target="_blank" rel="noreferrer">Complete benchmark methodology →</a>
          · <a class="text-link" href={`https://github.com/a-r-d/PureJsImage/blob/main/${documentation.generatedFrom.resultIndex}`} target="_blank" rel="noreferrer">Generated result index →</a>
        </p>
      </div>
    </section>
  </main>
</SiteLayout>
