---
import SiteLayout from '../layouts/SiteLayout.astro'
import documentation from '../data/documentation-data.json'
import packageMetrics from '../data/package-metrics.json'

const scientificReadersById = new Map(
  packageMetrics.scientificReaders.map((reader) => [reader.id, reader]),
)
const readerLabel = (id: string): string => {
  const reader = scientificReadersById.get(id)
  if (reader === undefined) throw new Error(`Missing scientific reader metric: ${id}`)
  return `${reader.format} (${reader.packageExport})`
}
---

<SiteLayout
  title="Scientific image readers and browser explorer | PureJsImage"
  description="Native-precision TypeScript readers for microscopy, whole-slide, AFM, surface metrology, medical volumes, spectroscopy, detector, and numeric interchange data."
  canonical="https://purejsimage.com/scientific/"
  bodyClass="scientific-page"
  current="scientific/"
  skipLabel="Skip to Scientific Raster Explorer"
  openGraph={{
    title: 'Scientific image readers and browser explorer | PureJsImage',
    description:
      'Native-precision scientific readers for microscopy, whole-slide, AFM, surface, volume, spectroscopy, detector, and numeric data in TypeScript.',
    url: 'https://purejsimage.com/scientific/',
    image: 'https://purejsimage.com/assets/scientific-hyperspectral-envi-viewer.png',
  }}
  twitterCard="summary_large_image"
>
  <main id="main">
    <section class="scientific-hero">
      <div class="container scientific-hero-grid">
        <div>
          <p class="eyebrow">Scientific readers and browser explorer</p>
          <h1>Native scientific data in TypeScript. The live explorer covers a few formats.</h1>
          <p class="scientific-lede">The package exposes {documentation.support.scientificReaderCount} explicit readers across microscopy, whole-slide, AFM and surface metrology, medical volumes, spectroscopy, detector, and raw numeric interchange. Numeric samples remain separate from RGB display pixels; range selection, palettes, slices, projections, and relief are explicit operations.</p>
        </div>
        <div class="scientific-local-card"><strong>Explorer scope is smaller than package scope</strong><span>The UI below currently wires GSF, ENVI, FITS, MRC, and CBF. It does not claim to open every package reader. Local files stay in the browser tab and large inputs use bounded Blob reads.</span></div>
      </div>
    </section>

    <section class="scientific-workspace" aria-labelledby="scientific-workspace-title">
      <div class="container">
        <div class="scientific-mode-tabs" role="tablist" aria-label="Scientific raster mode" data-scroll-region="tabs">
          <button id="scientific-mode-surface" type="button" role="tab" aria-selected="true">AFM / surface</button>
          <button id="scientific-mode-hyperspectral" type="button" role="tab" aria-selected="false">ENVI raster</button>
          <button id="scientific-mode-fits" type="button" role="tab" aria-selected="false">FITS image arrays</button>
          <button id="scientific-mode-mrc" type="button" role="tab" aria-selected="false">MRC volumes</button>
          <button id="scientific-mode-cbf" type="button" role="tab" aria-selected="false">CBF detector</button>
        </div>

        <div class="scientific-grid">
          <aside class="scientific-sidebar">
            <section class="scientific-panel" aria-labelledby="scientific-open-title">
              <header><span>01</span><div><p>Source</p><h2 id="scientific-open-title">Open a scientific raster</h2></div></header>
              <div id="scientific-surface-source">
                <button class="button small" id="scientific-sample-surface" type="button">Load synthetic GSF</button>
                <label class="scientific-file-label">Your .gsf file<input id="scientific-gsf-file" type="file" accept=".gsf"></label>
              </div>
              <div id="scientific-envi-source" hidden>
                <button class="button small" id="scientific-sample-envi" type="button">Load synthetic ENVI cube</button>
                <button class="button secondary small" id="scientific-sample-classification" type="button">Load synthetic classification map</button>
                <label class="scientific-file-label">ENVI header (.hdr or .hdr.txt)<input id="scientific-envi-header" type="file" accept=".hdr,.txt,text/plain"></label>
                <label class="scientific-file-label">Associated binary<input id="scientific-envi-data" type="file" accept=".bin,.dat,.img,.raw,application/octet-stream"></label>
                <button class="button secondary small" id="scientific-open-envi" type="button" disabled>Open paired files</button>
              </div>
              <div id="scientific-fits-source" hidden>
                <button class="button small" id="scientific-sample-fits" type="button">Load synthetic FITS cube</button>
                <label class="scientific-file-label">FITS file<input id="scientific-fits-file" type="file" accept=".fits,.fit,.fts,application/fits"></label>
              </div>
              <div id="scientific-mrc-source" hidden>
                <label class="scientific-file-label">MRC or CCP4 file<input id="scientific-mrc-file" type="file" accept=".mrc,.map,.ccp4,application/octet-stream"></label>
              </div>
              <div id="scientific-cbf-source" hidden>
                <label class="scientific-file-label">CBF or imgCIF file<input id="scientific-cbf-file" type="file" accept=".cbf,.img,application/octet-stream"></label>
              </div>
              <div id="scientific-drop-zone" class="scientific-drop-zone">Drop GSF, FITS, MRC, or CBF, or an ENVI header and binary pair</div>
            </section>

            <section class="scientific-panel" aria-labelledby="scientific-display-title">
              <header><span>02</span><div><p>Mapping</p><h2 id="scientific-display-title">Display numeric data</h2></div></header>
              <label id="scientific-display-mode-field" hidden>Hyperspectral view<select id="scientific-display-mode"><option value="band">Single band</option><option value="composite">False-color RGB</option></select></label>
              <label>Palette<select id="scientific-palette"><option>viridis</option><option>grayscale</option><option>magma</option><option>inferno</option><option>plasma</option></select></label>
              <label>Range<select id="scientific-range-mode"><option value="percentile">Percentile</option><option value="dataset">Dataset min/max</option><option value="explicit">Explicit min/max</option></select></label>
              <div id="scientific-percentiles" class="scientific-inline-fields"><label>Low %<input id="scientific-percentile-low" type="number" value="1" min="0" max="99" step="0.1"></label><label>High %<input id="scientific-percentile-high" type="number" value="99" min="1" max="100" step="0.1"></label></div>
              <div id="scientific-explicit-range" class="scientific-inline-fields" hidden><label>Minimum<input id="scientific-range-min" type="number" value="0" step="any"></label><label>Maximum<input id="scientific-range-max" type="number" value="1" step="any"></label></div>
              <label>Scale<select id="scientific-scale"><option>linear</option><option>log</option><option>sqrt</option><option>asinh</option></select></label>

              <label id="scientific-fits-hdu-field" hidden>Image HDU<select id="scientific-fits-hdu"></select></label>
              <div id="scientific-volume-controls" hidden>
                <label>Slice direction<select id="scientific-slice-axis"><option value="xy">XY</option><option value="xz">XZ</option><option value="yz">YZ</option></select></label>
                <label>Projection<select id="scientific-projection"><option value="none">None</option><option value="max">Maximum through Z</option><option value="mean">Mean through Z</option><option value="min">Minimum through Z</option></select></label>
                <label id="scientific-slice-index-field">Slice number <output id="scientific-slice-index-value">1 of 1</output><input id="scientific-slice-index" type="range" min="0" max="0" value="0" step="1"></label>
              </div>

              <div id="scientific-band-controls" hidden>
                <label>Spectral band <output id="scientific-wavelength-value">Band 1 of 1</output><input id="scientific-wavelength" type="range" min="0" max="0" value="0" step="1"></label>
              </div>
              <div id="scientific-composite-controls" hidden>
                <label>Red <output id="scientific-red-value">Band 1 of 1</output><input id="scientific-red" type="range" min="0" max="0" value="0" step="1"></label>
                <label>Green <output id="scientific-green-value">Band 1 of 1</output><input id="scientific-green" type="range" min="0" max="0" value="0" step="1"></label>
                <label>Blue <output id="scientific-blue-value">Band 1 of 1</output><input id="scientific-blue" type="range" min="0" max="0" value="0" step="1"></label>
              </div>

              <div id="scientific-relief-controls">
                <label class="scientific-check"><input id="scientific-relief" type="checkbox" checked> Relief shading</label>
                <label>Azimuth <output id="scientific-azimuth-value">315°</output><input id="scientific-azimuth" type="range" min="0" max="360" value="315"></label>
                <label>Elevation <output id="scientific-elevation-value">45°</output><input id="scientific-elevation" type="range" min="0" max="90" value="45"></label>
                <label>Strength <output id="scientific-strength-value">0.5</output><input id="scientific-strength" type="range" min="0" max="1" step="0.05" value="0.5"></label>
              </div>
            </section>
          </aside>

          <div class="scientific-main-panel">
            <div class="scientific-canvas-stage">
              <canvas id="scientific-canvas" width="128" height="96" aria-label="Rendered scientific raster"></canvas>
              <div id="scientific-empty">Choose a sample or open local scientific data.</div>
              <div id="scientific-loading" hidden>Working in a Web Worker…</div>
            </div>
            <p id="scientific-status" class="scientific-status" aria-live="polite">Ready.</p>
            <p id="scientific-selection" class="scientific-selection" hidden></p>
            <dl class="scientific-metrics">
              <div><dt>Source</dt><dd id="scientific-metric-name">Not loaded</dd></div>
              <div><dt>Dimensions</dt><dd id="scientific-metric-dimensions">Not loaded</dd></div>
              <div><dt>Native samples</dt><dd id="scientific-metric-samples">Not loaded</dd></div>
              <div><dt>Physical extent</dt><dd id="scientific-metric-physical">Not loaded</dd></div>
              <div><dt>Pixel size / bands</dt><dd id="scientific-metric-detail">Not loaded</dd></div>
              <div><dt>Native min/max</dt><dd id="scientific-metric-native-range">Not measured</dd></div>
              <div><dt>Display range</dt><dd id="scientific-metric-range">Not rendered</dd></div>
              <div><dt id="scientific-metric-bytes-label">Input size</dt><dd id="scientific-metric-bytes">Not loaded</dd></div>
              <div><dt>Render time</dt><dd id="scientific-metric-time">Not rendered</dd></div>
            </dl>
            <p class="scientific-quant-note"><strong>Quantitative source values remain unchanged.</strong> Palette, stretch, scale, and relief affect only the streamed display pixels shown above.</p>
            <button class="button small" id="scientific-download-png" type="button">Download PNG</button>
            <p class="scientific-quant-note">The PNG is the current display rendering, not a converted scientific dataset.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="scientific-sources" aria-labelledby="scientific-reader-surface-title">
      <div class="container">
        <div class="scientific-sources-heading">
          <div><p class="eyebrow">Generated package reader surface</p><h2 id="scientific-reader-surface-title">{documentation.support.scientificReaderCount} explicit scientific reader exports</h2></div>
          <p>The package surface is broader than the interactive explorer above. The explorer currently wires only {packageMetrics.liveDemoReaderIds.length} readers; it does not claim to open every newly supported format. Applications can register any explicit reader export listed below.</p>
        </div>
        <div class="scientific-source-grid">
          {documentation.support.scientificReaderFamilies.map((group) => <article><span>{group.label}</span><h3>{group.readerIds.length} package readers</h3><p>{group.readerIds.map(readerLabel).join(' · ')}</p></article>)}
        </div>
        <p class="scientific-quant-note"><strong>Live browser demo:</strong> {packageMetrics.liveDemoReaderIds.map(readerLabel).join(' · ')}. The remaining package readers are available through their explicit imports and the package reader aggregate, subject to their documented source and runtime boundaries.</p>
        <p><a class="text-link" href="../scientific-formats/">Open the generated scientific format reference, benchmark coverage, and import paths →</a></p>
      </div>
    </section>

    <section class="scientific-sources" aria-labelledby="scientific-sources-title">
      <div class="container">
        <div class="scientific-sources-heading">
          <div><p class="eyebrow">Real public data</p><h2 id="scientific-sources-title">Download compatible scientific raster files</h2></div>
          <p>These research, university, and government collections publish ENVI, FITS, MRC, and CBF files. Large files should be downloaded before opening them above.</p>
        </div>
        <div class="scientific-source-grid">
          <article>
            <span>RIT · .EDU</span>
            <h3>SHARE 2012 SpecTIR imagery</h3>
            <p>Direct directory of ENVI <code>.hdr</code> + <code>.img</code> reflectance cubes. Individual images range from about 951 MiB to 13 GiB.</p>
            <a href="https://dirsapps.cis.rit.edu/share2012/SPECTIR_HSI/" target="_blank" rel="noreferrer">Browse RIT files ↗</a>
          </article>
          <article>
            <span>NASA GSFC · .GOV</span>
            <h3>Official FITS sample files</h3>
            <p>The FITS Support Office publishes image, table, and conformance samples for testing FITS readers.</p>
            <a href="https://fits.gsfc.nasa.gov/fits_samples.html" target="_blank" rel="noreferrer">Browse NASA FITS samples ↗</a>
          </article>
          <article>
            <span>CCP-EM · GitHub</span>
            <h3>MRC compatibility maps</h3>
            <p>The CCP-EM mrcfile project maintains real MRC and CCP4 maps used to test MRC2014 readers.</p>
            <a href="https://github.com/ccpem/mrcfile/tree/master/tests/test_data" target="_blank" rel="noreferrer">Browse CCP-EM maps ↗</a>
          </article>
          <article>
            <span>Paul Scherrer Institute · GitHub</span>
            <h3>CBF detector examples</h3>
            <p>Real PILATUS detector frames with x-CBF_BYTE_OFFSET compression for CBF compatibility testing.</p>
            <a href="https://github.com/paulscherrerinstitute/cbf/tree/master/examples" target="_blank" rel="noreferrer">Browse PSI CBF files ↗</a>
          </article>
          <article>
            <span>NASA JPL · .GOV</span>
            <h3>Free AVIRIS flight lines</h3>
            <p>Five complete imaging-spectrometer products covering vegetation, cities, geology, calibration, and high-resolution data.</p>
            <a href="https://aviris.jpl.nasa.gov/data/free_data.html" target="_blank" rel="noreferrer">Browse free AVIRIS data ↗</a>
          </article>
          <article>
            <span>NASA ORNL DAAC · .GOV</span>
            <h3>AVIRIS-Classic reflectance</h3>
            <p>Cataloged ENVI <code>.hdr</code> + <code>.bin</code> products with 224 bands from roughly 400–2500 nm. Earthdata sign-in may be required.</p>
            <a href="https://daac.ornl.gov/AVIRIS/guides/AVIRIS-Classic_L2_Reflectance.html" target="_blank" rel="noreferrer">Open AVIRIS-Classic catalog ↗</a>
          </article>
          <article>
            <span>NASA ORNL DAAC · .GOV</span>
            <h3>HyTES thermal radiance</h3>
            <p>ENVI <code>.hdr</code> + <code>.dat</code> flight scenes with 256 thermal-infrared bands from 7.5–12 µm.</p>
            <a href="https://daac.ornl.gov/HYTES/guides/HyTES_L1_Radiance_2013_2016.html" target="_blank" rel="noreferrer">Open HyTES catalog ↗</a>
          </article>
        </div>
        <div class="scientific-direct-files" aria-labelledby="scientific-direct-files-title">
          <div class="scientific-direct-files-heading">
            <div><p class="eyebrow">Skip the catalog</p><h3 id="scientific-direct-files-title">Specific files ready to download</h3></div>
            <p>FITS, MRC, and CBF examples are single-file downloads. For a paired ENVI example, download both numbered files and select them together above.</p>
          </div>
          <div class="scientific-direct-file-grid">
            <article>
              <div class="scientific-direct-card-meta"><span class="scientific-file-type">ENVI</span><span class="scientific-file-source">Best first real cube · NASA .GOV</span></div>
              <h4>Moon Mineralogy Mapper radiance</h4>
              <p><code>304 × 251 × 85</code> · float32 · BIL · 24.7 MiB binary</p>
              <div class="scientific-direct-actions">
                <a href="https://planetarydata.jpl.nasa.gov/img/data/m3/CH1M3_0003/DATA/20081118_20090214/200811/L1B/M3G20081129T171431_V03_RDN.HDR" target="_blank" rel="noreferrer">1. Header · 35 KiB ↗</a>
                <a href="https://planetarydata.jpl.nasa.gov/img/data/m3/CH1M3_0003/DATA/20081118_20090214/200811/L1B/M3G20081129T171431_V03_RDN.IMG" target="_blank" rel="noreferrer">2. Binary · 24.7 MiB ↗</a>
              </div>
            </article>
            <article>
              <div class="scientific-direct-card-meta"><span class="scientific-file-type">ENVI</span><span class="scientific-file-source">Large reflectance cube · RIT .EDU</span></div>
              <h4>Avon AM SpecTIR reflectance</h4>
              <p><code>0920-1701_pol_ref_geo</code> · ENVI image · 951 MiB binary</p>
              <div class="scientific-direct-actions">
                <a href="https://dirsapps.cis.rit.edu/share2012/SPECTIR_HSI/SpecTIR_Reflectance_Georeferenced/AVON_AM/0920-1701_pol_ref_geo.hdr" target="_blank" rel="noreferrer">1. Header · 28 KiB ↗</a>
                <a href="https://dirsapps.cis.rit.edu/share2012/SPECTIR_HSI/SpecTIR_Reflectance_Georeferenced/AVON_AM/0920-1701_pol_ref_geo.img" target="_blank" rel="noreferrer">2. Binary · 951 MiB ↗</a>
              </div>
            </article>
            <article>
              <div class="scientific-direct-card-meta"><span class="scientific-file-type">ENVI CLASSIFICATION · ZIP</span><span class="scientific-file-source">Packaged map · USGS .GOV</span></div>
              <h4>Afghanistan 1 µm mineral map</h4>
              <p><code>37,679 × 39,594</code> · 29-class thematic map · 132 MiB ZIP / 1.49 GB extracted binary · bounded color preview.</p>
              <div class="scientific-direct-actions">
                <a href="https://pubs.usgs.gov/ds/787/downloads/afghan_thematicmap_1micron.zip" target="_blank" rel="noreferrer">Download specific archive ↗</a>
              </div>
            </article>
            <article>
              <div class="scientific-direct-card-meta"><span class="scientific-file-type">FITS</span><span class="scientific-file-source">Hubble · NASA .GOV</span></div>
              <h4>WFPC II image mosaic</h4>
              <p><code>100 × 100</code> · float32 · primary image · 61.9 KiB</p>
              <div class="scientific-direct-actions">
                <a href="https://fits.gsfc.nasa.gov/samples/WFPC2ASSNu5780205bx.fits" target="_blank" rel="noreferrer" download="WFPC2ASSNu5780205bx.fits">Download FITS · 61.9 KiB ↗</a>
              </div>
            </article>
            <article>
              <div class="scientific-direct-card-meta"><span class="scientific-file-type">FITS</span><span class="scientific-file-source">Ultraviolet telescope · NASA .GOV</span></div>
              <h4>NGC 4151 far-ultraviolet image</h4>
              <p><code>512 × 512</code> · scaled int16 · primary image · 526 KiB</p>
              <div class="scientific-direct-actions">
                <a href="https://fits.gsfc.nasa.gov/samples/UITfuv2582gc.fits" target="_blank" rel="noreferrer" download="UITfuv2582gc.fits">Download FITS · 526 KiB ↗</a>
              </div>
            </article>
            <article>
              <div class="scientific-direct-card-meta"><span class="scientific-file-type">FITS</span><span class="scientific-file-source">IUE spectrum · NASA .GOV</span></div>
              <h4>SWP 05569 low-dispersion image</h4>
              <p><code>831 × 110</code> · two scaled int16 image HDUs · 379.7 KiB</p>
              <div class="scientific-direct-actions">
                <a href="https://fits.gsfc.nasa.gov/nrao_data/samples/image/swp05569slg.fits" target="_blank" rel="noreferrer" download="swp05569slg.fits">Download FITS · 379.7 KiB ↗</a>
              </div>
            </article>
            <article>
              <div class="scientific-direct-card-meta"><span class="scientific-file-type">MRC</span><span class="scientific-file-source">Compatibility map · CCP-EM</span></div>
              <h4>EMD-3197 test volume</h4>
              <p><code>20 × 20 × 20</code> · float32 · little-endian · 32.3 KiB</p>
              <div class="scientific-direct-actions">
                <a href="https://raw.githubusercontent.com/ccpem/mrcfile/a2a8c6b569a57b7f18b023b5056fa7a14f2f99c2/tests/test_data/EMD-3197.map" target="_blank" rel="noreferrer" download="EMD-3197.map">Download MRC · 32.3 KiB ↗</a>
              </div>
            </article>
            <article>
              <div class="scientific-direct-card-meta"><span class="scientific-file-type">CBF</span><span class="scientific-file-source">PILATUS 300K · PSI</span></div>
              <h4>in16c detector frame</h4>
              <p><code>487 × 619</code> · signed int32 counts · byte-offset compression · 300.4 KiB</p>
              <div class="scientific-direct-actions">
                <a href="https://raw.githubusercontent.com/paulscherrerinstitute/cbf/88f4f5b6fdcee5577d1f96c46c27a653c6622e20/examples/in16c_010001.cbf" target="_blank" rel="noreferrer" download="in16c_010001.cbf">Download CBF · 300.4 KiB ↗</a>
              </div>
            </article>
          </div>
        </div>
        <p class="scientific-source-help"><strong>Open a single-file download:</strong> choose its FITS, MRC, or CBF tab, then select the downloaded file. <strong>Open an ENVI download:</strong> unpack the archive, choose its <code>.hdr</code> file under <em>ENVI header</em>, choose the matching <code>.img</code>, <code>.bin</code>, or <code>.dat</code> file under <em>Associated binary</em>, then click <em>Open paired files</em>. A browser may save a header as <code>.hdr.txt</code>; the explorer accepts that filename too. GSF is commonly exported from AFM/SPM software rather than distributed by institutional archives.</p>
      </div>
    </section>

    <section class="scientific-explain">
      <div class="container scientific-explain-grid">
        <div class="scientific-explain-copy">
          <p class="eyebrow">Scientific raster formats</p>
          <h2>Numeric data and display pixels use separate steps</h2>
          <p>
            GSF, ENVI, FITS, MRC, and CBF remain scientific datasets rather than photographic codecs.
            Their numeric samples use the same dataset API as OME-TIFF planes. FITS and MRC volumes
            share lazy cross-sections and bounded Z projections.
          </p>
        </div>
        <figure class="scientific-explain-figure">
          <img
            src="../assets/scientific-hyperspectral-envi-viewer.png"
            width="1280"
            height="720"
            loading="lazy"
            decoding="async"
            alt="ENVI hyperspectral cube displayed in PureJsImage with band and percentile controls"
          />
          <figcaption>
            Native uint16 scientific samples stay in the dataset. This view maps them into display
            pixels locally in the browser tab.
          </figcaption>
        </figure>
        <nav class="scientific-explain-links" aria-label="Scientific guides">
          <a href="./platform/">Application platform</a>
          <a href="./benchmarks/">Reader benchmarks</a>
          <a href="./envi/">ENVI guide</a>
          <a href="./gsf/">GSF guide</a>
          <a href="./fits/">FITS guide</a>
          <a href="./mrc/">MRC guide</a>
          <a href="./cbf/">CBF guide</a>
          <a href="./volumes/">Volume operations</a>
          <a href="../api/#scientific">Scientific API</a>
          <a href="../tiff/#scientific">OME-TIFF</a>
          <a href="../wsi/">Whole-slide viewer</a>
        </nav>
      </div>
    </section>
  </main>
  <script>
    import { startScientificExplorer } from '../scripts/scientific-explorer.ts'

    startScientificExplorer()
  </script>
</SiteLayout>
