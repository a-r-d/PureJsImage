---
import geoCapabilityManifest from '../data/geo-capabilities.json'
import SiteLayout from '../layouts/SiteLayout.astro'

const geoCapabilities = geoCapabilityManifest

const stateLabels: Readonly<Record<string, string>> = {
  tested: 'Tested',
  limited: 'Fixture-limited',
  metadata: 'Metadata only',
  unsupported: 'Unsupported',
  none: 'Unavailable',
  'out-of-scope': 'Out of scope',
}
const enabled = (state: string | undefined): boolean =>
  state === 'tested' || state === 'limited' || state === 'metadata'
const rowCapabilities = (format: (typeof geoCapabilities.formats)[number]): string => {
  const tokens = ['read']
  if (enabled(format.states['local-open'])) tokens.push('local')
  if (enabled(format.states['remote-open'])) tokens.push('remote')
  if (enabled(format.states.multiscale)) tokens.push('multiscale')
  if (enabled(format.states['time-dimension']) || enabled(format.states['vertical-dimension']))
    tokens.push('multidimensional')
  if (enabled(format.states.reprojection)) tokens.push('reprojection')
  if (enabled(format.states.writer)) tokens.push('write')
  const values = Object.values(format.states)
  if (values.includes('tested')) tokens.push('state-tested')
  if (values.includes('limited') || values.includes('metadata')) tokens.push('state-partial')
  if (values.includes('unsupported') || values.includes('none') || values.includes('out-of-scope'))
    tokens.push('state-unsupported')
  return tokens.join(' ')
}
const cogFacts = [
  ['format', 'Format'],
  ['container', 'TIFF container'],
  ['byteOrder', 'Byte order'],
  ['dimensions', 'Dimensions'],
  ['tileDimensions', 'Tile layout'],
  ['compression', 'Compression'],
  ['sampleType', 'Sample type'],
  ['crs', 'CRS'],
  ['affine', 'Pixel-to-world affine'],
  ['bounds', 'World bounds'],
  ['registration', 'Pixel registration'],
  ['levels', 'IFD / SubIFD levels'],
  ['activeLevel', 'Active overview'],
] as const
const zarrFacts = [
  ['zarrVersion', 'Zarr version'],
  ['conventions', 'GeoZarr conventions'],
  ['dimensions', 'Dimensions'],
  ['axes', 'Non-spatial dimensions'],
  ['crs', 'CRS'],
  ['affine', 'Pixel-to-world affine'],
  ['registration', 'Pixel registration'],
  ['levels', 'Levels'],
  ['activeLevel', 'Active level'],
  ['chunkShape', 'Logical chunk shape'],
  ['shardShape', 'Outer shard shape'],
  ['codecs', 'Codecs'],
] as const
const telemetryPrimary = [
  ['dataRequests', 'Data requests'],
  ['uniqueBytes', 'Unique bytes'],
  ['percentage', 'Source read'],
  ['cacheHits', 'Cache hits'],
] as const
const telemetrySecondary = [
  ['metadataRequests', 'Metadata requests'],
  ['transferredBytes', 'Transferred bytes'],
  ['coalesced', 'Coalesced reads'],
  ['cancelled', 'Cancelled reads'],
] as const
---

<SiteLayout title="Geo raster browser lab | PureJsImage" description="Explore real government COG imagery and multidimensional GeoZarr data directly in the browser with measured range requests, bounded analysis, and public PureJsImage APIs." canonical="https://purejsimage.com/geo/" current="geo/" bodyClass="geo-showcase-page">
  <main id="main">
    <header class="geo-hero">
      <div class="container geo-hero-grid">
        <div class="geo-hero-copy">
          <p class="eyebrow">Geospatial raster · measured in your browser</p>
          <h1>Browse a 100-megapixel government COG.</h1>
          <p class="geo-hero-lede">Pan, zoom, inspect bands, and measure the exact range requests used for each viewport. The Kentucky aerial survey opens automatically.</p>
          <div class="geo-proof-pills" aria-label="Demo constraints"><span>Direct object storage</span><span>Worker decode</span><span>Bounded viewport reads</span><span>No API key</span></div>
        </div>
        <aside class="geo-hero-dataset-card" aria-label="Kentucky From Above dataset summary">
          <div class="geo-card-topline"><span class="geo-live-dot"></span><span>Live government COG</span><span>CC BY 4.0</span></div>
          <strong>Kentucky leaf-off ortho</strong><span>Frankfort area · 2019 · 6 inch aerial survey</span>
          <div class="geo-hero-stats"><span><strong>10k × 10k</strong> pixels</span><span><strong>7</strong> levels</span><span><strong>4</strong> bands</span><span><strong>210.7 MB</strong> source</span></div>
        </aside>
      </div>
    </header>

    <div class="container geo-content">
      <section id="cog-range-lab" class="geo-lab-section">
        <div class="geo-section-heading"><div><p class="eyebrow">COG Range Lab</p><h2>Live aerial survey</h2></div><p>Pan the autoloaded Kentucky source, choose another fixture, or enter a CORS-enabled GeoTIFF URL.</p></div>
        <div id="cog-lab" class="geo-lab-shell" data-kind="cog" data-state="idle" data-worker="running">
          <div class="geo-source-gallery" aria-label="COG examples">
            <button class="geo-source-card geo-source-card-featured" type="button" aria-pressed="false" data-geo-autoload data-geo-preset-id="kentucky-ortho" data-geo-preset="https://kyfromabove.s3.us-west-2.amazonaws.com/imagery/orthos/Phase2/KY_KYAPED_2019_6IN/N082E280_2019_6IN_cog.tif" data-geo-preset-title="Kentucky leaf-off ortho" data-geo-preset-provider="Kentucky Division of Geographic Information" data-geo-initial-level="4" data-geo-initial-mode="rgb" data-geo-initial-region="center" data-geo-rgb="0,1,2" data-geo-cir="3,0,1">
              <span class="geo-source-card-kicker"><span class="geo-live-dot"></span> Live public data</span><strong>Kentucky From Above</strong><span>Natural color and color infrared aerial imagery with seven COG levels.</span><small>10,000 × 10,000 · JPEG tiles · EPSG:3089</small>
            </button>
            <button class="geo-source-card" type="button" aria-pressed="false" data-geo-preset-id="bundled-cog" data-geo-preset-kind="bundled" data-geo-preset="/fixtures/geo/overview-cog.tif" data-geo-preset-title="Rotated COG test fixture" data-geo-preset-provider="Bundled deterministic fixture" data-geo-initial-level="0">
              <span class="geo-source-card-kicker">Offline-ready</span><strong>Rotated multiscale COG</strong><span>Small deterministic source for testing affine rotation, SubIFDs, and range telemetry.</span><small>2,048 × 1,024 · Deflate · EPSG:32616</small>
            </button>
            <details class="geo-custom-source"><summary><span>Open another URL</span><small>COG or GeoTIFF</small></summary><div class="geo-source-bar"><label for="cog-url">HTTPS GeoTIFF URL</label><input id="cog-url" type="url" spellcheck="false" autocomplete="url" value="https://kyfromabove.s3.us-west-2.amazonaws.com/imagery/orthos/Phase2/KY_KYAPED_2019_6IN/N082E280_2019_6IN_cog.tif" /><button id="cog-open" class="button" type="button">Open URL</button><button id="cog-cancel" type="button" disabled>Cancel</button></div><p>Remote servers must allow CORS, byte-range GET requests, and a readable object size through <code>Content-Range</code> or <code>Content-Length</code>.</p></details>
          </div>
          <div class="geo-app-bar">
            <div class="geo-active-source"><span class="geo-state-light"></span><div><strong data-geo-source-title>Choose a source</strong><span data-geo-source-provider>Direct browser access</span></div></div>
            <div class="geo-controls"><label class="geo-control-muted">Dataset<select id="cog-dataset" disabled><option>Open a source</option></select></label><label>Overview<select id="cog-level" disabled><option>Open a source</option></select></label><label>Band<select id="cog-band" disabled><option>Open a source</option></select></label><label hidden>Time<select id="cog-time" disabled><option>Not present</option></select></label><label hidden>Vertical<select id="cog-vertical" disabled><option>Not present</option></select></label><label>Display<select id="cog-mode"><option value="grayscale">Grayscale</option><option value="rgb">Natural color</option><option value="cir">Color infrared</option></select></label></div>
          </div>
          <div class="geo-workbench">
            <div class="geo-canvas-panel" id="cog-canvas-wrap" aria-busy="false">
              <div class="geo-viewport-badges"><span data-geo-fact="crs">CRS pending</span><span data-geo-fact="activeLevel">Overview pending</span></div>
              <div class="geo-canvas-toolbar" aria-label="COG viewport controls"><button type="button" data-pan="up" aria-label="Pan up" title="Pan up">↑</button><div><button type="button" data-pan="left" aria-label="Pan left" title="Pan left">←</button><button type="button" data-pan="right" aria-label="Pan right" title="Pan right">→</button></div><button type="button" data-pan="down" aria-label="Pan down" title="Pan down">↓</button><span></span><button type="button" data-zoom="in">+</button><button type="button" data-zoom="out">−</button></div>
              <canvas id="cog-canvas" width="768" height="500" tabindex="0" aria-label="COG raster viewport. Drag or use arrow keys to pan. Use plus or minus to zoom."></canvas>
              <div class="geo-loading" id="cog-loading" role="status" aria-live="polite" aria-atomic="true" hidden>
                <div class="geo-loading-card">
                  <span class="geo-loading-spinner" aria-hidden="true"></span>
                  <div class="geo-loading-copy"><strong id="cog-loading-title">Opening the featured COG</strong><span id="cog-loading-detail">Connecting to object storage · just started</span></div>
                  <button id="cog-loading-cancel" type="button" disabled>Cancel</button>
                  <div class="geo-loading-progress" id="cog-loading-progress" role="progressbar" aria-label="COG loading progress" data-indeterminate="true"><span></span></div>
                </div>
              </div>
              <div class="geo-viewport-footer"><p id="cog-sample" class="geo-sample" aria-live="polite">Move over the raster to inspect coordinates and values.</p><p id="cog-status" class="geo-status" role="status" aria-live="polite">Choose the Kentucky survey or bundled fixture to begin.</p></div>
            </div>
            <aside class="geo-diagnostics" aria-label="COG diagnostics">
              <div class="geo-inspector-heading"><span>Live source telemetry</span><strong>Range monitor</strong></div>
              <dl class="geo-telemetry-grid">{telemetryPrimary.map(([id, label]) => <div><dt>{label}</dt><dd data-geo-telemetry={id}>0</dd></div>)}</dl>
              <dl class="geo-telemetry-secondary">{telemetrySecondary.map(([id, label]) => <><dt>{label}</dt><dd data-geo-telemetry={id}>0</dd></>)}</dl>
              <details class="geo-facts" open><summary>Source and grid</summary><dl>{cogFacts.filter(([id]) => id !== 'crs' && id !== 'activeLevel').map(([id, label]) => <><dt>{label}</dt><dd data-geo-fact={id}>n/a</dd></>)}</dl></details>
              <p class="geo-attribution"><strong>Featured source</strong> Kentucky Division of Geographic Information, KyFromAbove. <a href="https://kyfromabove.ky.gov/">Source information</a>. CC BY 4.0.</p>
            </aside>
          </div>
        </div>
      </section>

      <section id="raster-analysis" class="geo-analysis-section"><div><p class="eyebrow">Raster Analysis</p><h2>Analyze the active viewport.</h2><p>Operations run on the current bounded region. Point values come from the cursor position.</p></div><div class="geo-analysis-console"><div class="geo-analysis-actions"><button type="button" data-geo-analysis="normalized-difference"><span>ND</span><strong>Normalized difference</strong></button><button type="button" data-geo-analysis="hillshade"><span>HS</span><strong>Hillshade</strong></button><button type="button" data-geo-analysis="statistics"><span>Σ</span><strong>Regional statistics</strong></button><button type="button" data-geo-analysis="line-profile"><span>⌁</span><strong>Line profile</strong></button></div><output id="geo-analysis-output">Open a raster, then choose an operation.</output></div></section>

      <section id="geozarr-cube-lab" class="geo-lab-section">
        <div class="geo-section-heading"><div><p class="eyebrow">GeoZarr Cube Lab</p><h2>Select dimensions before chunks.</h2></div><p>The reader discovers declared metadata paths without listing a remote bucket. Time, band, vertical, and custom dimensions stay selectable.</p></div>
        <div id="geozarr-lab" class="geo-lab-shell" data-kind="geozarr" data-state="idle" data-worker="running">
          <div class="geo-source-gallery geo-source-gallery-zarr" aria-label="GeoZarr examples">
            <button class="geo-source-card geo-source-card-featured" type="button" aria-pressed="false" data-geo-preset-kind="bundled" data-geo-preset="/fixtures/geo/geozarr-cube/" data-geo-preset-title="Time and band cube" data-geo-preset-provider="Bundled deterministic GeoZarr"><span class="geo-source-card-kicker">Interactive cube</span><strong>Time × band × Y × X</strong><span>Switch time, band, and resolution while watching logical chunk requests.</span><small>Zarr v3 · 2 levels · 3 bands · 2 times</small></button>
            <button class="geo-source-card" type="button" aria-pressed="false" data-geo-preset="https://data.source.coop/pangeo/geozarr-examples/TCI.zarr/" data-geo-preset-title="Pangeo TCI GeoZarr" data-geo-preset-provider="Source Cooperative"><span class="geo-source-card-kicker">Compatibility boundary</span><strong>Public GeoZarr v1 example</strong><span>Inspect the explicit diagnostic for convention metadata newer than this reader.</span><small>Metadata probe · no false compatibility claim</small></button>
            <details class="geo-custom-source"><summary><span>Open another store</span><small>Zarr v2 or v3</small></summary><div class="geo-source-bar"><label for="geozarr-url">GeoZarr store root</label><input id="geozarr-url" type="url" spellcheck="false" autocomplete="url" value="/fixtures/geo/geozarr-cube/" /><button id="geozarr-open" class="button" type="button">Open store</button><button id="geozarr-cancel" type="button" disabled>Cancel</button></div></details>
          </div>
          <div class="geo-app-bar"><div class="geo-active-source"><span class="geo-state-light"></span><div><strong data-geo-source-title>Choose a store</strong><span data-geo-source-provider>Direct object-store access</span></div></div><div class="geo-controls"><label>Dataset<select id="geozarr-dataset" disabled><option>Open a source</option></select></label><label>Level<select id="geozarr-level" disabled><option>Open a source</option></select></label><label>Band<select id="geozarr-band" disabled><option>Open a source</option></select></label><label>Time<select id="geozarr-time" disabled><option>Open a source</option></select></label><label>Vertical<select id="geozarr-vertical" disabled><option>Not present</option></select></label><label>Display<select id="geozarr-mode"><option value="grayscale">Grayscale</option><option value="rgb">Natural color</option><option value="cir">Color infrared</option></select></label></div></div>
          <div class="geo-workbench">
            <div class="geo-canvas-panel" id="geozarr-canvas-wrap" aria-busy="false"><div class="geo-viewport-badges"><span data-geo-fact="crs">CRS pending</span><span data-geo-fact="activeLevel">Level pending</span></div><div class="geo-canvas-toolbar" aria-label="GeoZarr viewport controls"><button type="button" data-pan="up" aria-label="Pan up" title="Pan up">↑</button><div><button type="button" data-pan="left" aria-label="Pan left" title="Pan left">←</button><button type="button" data-pan="right" aria-label="Pan right" title="Pan right">→</button></div><button type="button" data-pan="down" aria-label="Pan down" title="Pan down">↓</button><span></span><button type="button" data-zoom="in">+</button><button type="button" data-zoom="out">−</button></div><canvas id="geozarr-canvas" width="768" height="500" tabindex="0" aria-label="GeoZarr raster viewport. Drag or use arrow keys to pan. Use plus or minus to zoom."></canvas><div class="geo-loading" id="geozarr-loading" role="status" aria-live="polite" aria-atomic="true" hidden><div class="geo-loading-card"><span class="geo-loading-spinner" aria-hidden="true"></span><div class="geo-loading-copy"><strong id="geozarr-loading-title">Opening the GeoZarr store</strong><span id="geozarr-loading-detail">Connecting to object storage · just started</span></div><button id="geozarr-loading-cancel" type="button" disabled>Cancel</button><div class="geo-loading-progress" id="geozarr-loading-progress" role="progressbar" aria-label="GeoZarr loading progress" data-indeterminate="true"><span></span></div></div></div><div class="geo-viewport-footer"><p id="geozarr-sample" class="geo-sample" aria-live="polite">Move over the raster to inspect coordinates and values.</p><p id="geozarr-status" class="geo-status" role="status" aria-live="polite">Choose the bundled cube or public store to begin.</p></div></div>
            <aside class="geo-diagnostics" aria-label="GeoZarr diagnostics"><div class="geo-inspector-heading"><span>Live store telemetry</span><strong>Chunk monitor</strong></div><dl class="geo-telemetry-grid">{telemetryPrimary.map(([id, label]) => <div><dt>{label}</dt><dd data-geo-telemetry={id}>0</dd></div>)}</dl><dl class="geo-telemetry-secondary">{telemetrySecondary.map(([id, label]) => <><dt>{label}</dt><dd data-geo-telemetry={id}>0</dd></>)}</dl><details class="geo-facts" open><summary>Store and grid</summary><dl>{zarrFacts.filter(([id]) => id !== 'crs' && id !== 'activeLevel').map(([id, label]) => <><dt>{label}</dt><dd data-geo-fact={id}>n/a</dd></>)}</dl></details></aside>
          </div>
        </div>
      </section>

      <section id="api-and-code" class="geo-doc-section"><div class="geo-section-heading"><div><p class="eyebrow">API and Code</p><h2>Copy the current bounded read.</h2></div><p>The example follows the selected source, level, dimensions, bands, and viewport. It imports documented package entry points and closes the source in <code>finally</code>.</p></div><div class="code-window geo-code-window"><div class="window-bar"><span class="window-title">geo-viewport.ts</span><button id="geo-copy-code" type="button">Copy TypeScript</button></div><pre><code id="geo-code"></code></pre></div></section>

      <section id="capability-matrix" class="geo-doc-section"><div class="geo-section-heading"><div><p class="eyebrow">Capability Matrix</p><h2>Support generated from executable evidence.</h2></div><p>Partial and unsupported states remain visible. Full claims and test references are available in <a href="../geo-capabilities.json">geo-capabilities.json</a>.</p></div><div class="geo-matrix-filters" aria-label="Capability matrix filters"><label>Format<select data-geo-matrix-filter="format"><option value="">All formats</option>{geoCapabilities.formats.map((format) => <option value={format.id}>{format.name}</option>)}</select></label><label>Access<select data-geo-matrix-filter="access"><option value="">Local or remote</option><option value="local">Local</option><option value="remote">Remote</option></select></label><label>Shape<select data-geo-matrix-filter="shape"><option value="">Any shape</option><option value="multiscale">Multiscale</option><option value="multidimensional">Multidimensional</option></select></label><label>Grid<select data-geo-matrix-filter="grid"><option value="">Any grid</option><option value="reprojection">Reprojection</option></select></label><label>Mode<select data-geo-matrix-filter="mode"><option value="">Read or write</option><option value="read">Read</option><option value="write">Write</option></select></label><label>Evidence<select data-geo-matrix-filter="state"><option value="">Any state</option><option value="state-tested">Tested</option><option value="state-partial">Partial</option><option value="state-unsupported">Unsupported present</option></select></label></div><p id="geo-matrix-count" aria-live="polite">{geoCapabilities.formats.length} formats shown</p><div class="table-wrap geo-matrix-wrap"><table><thead><tr><th>Format</th>{geoCapabilities.capabilities.map((capability) => <th>{capability.label}</th>)}</tr></thead><tbody>{geoCapabilities.formats.map((format) => <tr data-geo-format-row data-format={format.id} data-capabilities={rowCapabilities(format)}><td><strong>{format.name}</strong><br /><code>{format.publicEntry}</code></td>{geoCapabilities.capabilities.map((capability) => { const state = format.states[capability.id as keyof typeof format.states] ?? 'none'; return <td><span class={`geo-state geo-state-${state}`}>{stateLabels[state] ?? 'Unavailable'}</span></td> })}</tr>)}</tbody></table></div></section>

      <section id="package-boundaries" class="geo-safety"><div><p class="eyebrow">Package boundaries</p><h2>Safe defaults remain visible.</h2></div><ul><li>URLs and metadata render as untrusted text.</li><li>Cancellation reaches range reads, chunk reads, decoding, and analysis.</li><li>Cross-CRS reprojection requires a caller-supplied transform provider.</li><li>CORS, Range, codec, metadata, grid, and CRS errors keep their original diagnostic.</li><li>Required browser tests use deterministic local servers. Public sources remain opt-in smoke tests.</li></ul></section>
    </div>
  </main>
  <script type="module" src="../assets/geo-showcase.js"></script>
</SiteLayout>

<style>
