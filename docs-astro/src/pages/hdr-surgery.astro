---
import SiteLayout from '../layouts/SiteLayout.astro'

const title = 'Ultra HDR JPEG Editor and Gain Map Inspector for JavaScript | PureJsImage'
const description =
  'Inspect, render, crop, resize, and re-encode Ultra HDR (JPEG_R/JPEGR) and ISO 21496-1 gain-map images in JavaScript and TypeScript for browsers and Node.js.'
const canonical = 'https://purejsimage.com/hdr-surgery/'
const socialImage = 'https://purejsimage.com/assets/hdr-surgery-og.png'
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'PureJsImage HDR Surgery',
      applicationCategory: 'DeveloperApplication',
      browserRequirements: 'A modern browser with JavaScript and Web Workers',
      description,
      url: canonical,
    },
    {
      '@type': 'TechArticle',
      headline: 'Ultra HDR JPEG editor and gain map inspector for JavaScript',
      description,
      mainEntityOfPage: canonical,
      author: { '@type': 'Organization', name: 'PureJsImage' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'PureJsImage', item: 'https://purejsimage.com/' },
        { '@type': 'ListItem', position: 2, name: 'HDR Surgery', item: canonical },
      ],
    },
  ],
}
---

<SiteLayout title={title} description={description} canonical={canonical} bodyClass="hdr-surgery-page" current="hdr-surgery/" openGraph={{ title, description, url: canonical, image: socialImage, imageWidth: 1200, imageHeight: 630, imageAlt: 'PureJsImage HDR Surgery showing an SDR primary, encoded gain map, and adapted HDR result' }} twitterCard="summary_large_image">
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <main id="main" class="hdr-shell">
    <header class="hdr-hero"><div><p class="eyebrow">HDR Surgery</p><h1>Ultra HDR JPEG editor and gain map inspector for JavaScript</h1><p class="hdr-lede">Inspect and edit Ultra HDR JPEG, JPEG_R, JPEGR, and ISO 21496-1 gain-map images in JavaScript or TypeScript. The work stays in your browser.</p></div><div class="hdr-local"><strong>Local processing</strong><span>No image is uploaded to an application server.</span></div></header>

    <section id="quick-answer" class="hdr-copy hdr-quick"><h2>Quick answer</h2><p>PureJsImage can inspect, render, crop, resize, and re-encode an Ultra HDR JPEG without silently discarding its HDR gain map. It keeps an ordinary SDR JPEG as the backward-compatible primary and transforms the primary and gain map over the same image region.</p><ol><li>The ordinary SDR JPEG is the backward-compatible primary.</li><li>A smaller encoded gain map plus metadata describes highlight recovery.</li><li>PureJsImage applies it in linear light for the selected display boost and transforms both images together.</li></ol><p><strong>Important:</strong> this tool does not create genuine HDR detail from an unrelated SDR image.</p></section>

    <section id="interactive-workbench" aria-labelledby="workbench-heading"><h2 id="workbench-heading">Interactive workbench</h2><p id="hdr-display" class="hdr-display"></p>
      <div class="hdr-result" aria-label="Current transformed HDR previews">
        <article class="hdr-view"><div class="hdr-view-heading"><h3>Adapted result</h3><span>Current transformed state, SDR tone map</span></div><canvas id="hdr-adapted" aria-label="Current software-rendered adapted Ultra HDR result"></canvas><p id="hdr-probe">Move over the image to inspect pixel values.</p></article>
        <article class="hdr-view"><div class="hdr-view-heading"><h3>Highlight map</h3><span>Current transformed state, false color</span></div><canvas id="hdr-false-color" aria-label="Current false-color HDR gain visualization"></canvas></article>
        <article class="hdr-view"><div class="hdr-view-heading"><h3>SDR primary</h3><span>Current transformed base preview</span></div><canvas id="hdr-base" aria-label="Current transformed SDR primary preview"></canvas></article>
        <article class="hdr-view"><div class="hdr-view-heading"><h3>Encoded gain map</h3><span>Current transformed map samples</span></div><canvas id="hdr-gain" aria-label="Current transformed encoded gain map preview"></canvas></article>
      </div>
      <div class="hdr-workspace">
        <aside class="hdr-controls" aria-label="HDR Surgery controls"><h3>Open</h3><label>Included sample<select id="hdr-sample"><option value="hdr-surgery-synthetic-dual.jpg">Dual ISO and Ultra HDR metadata</option><option value="hdr-surgery-synthetic-xmp.jpg">Ultra HDR XMP only</option><option value="hdr-surgery-synthetic-iso.jpg">ISO 21496-1 only</option><option value="hdr-surgery-synthetic-rgb-progressive.jpg">RGB gain map, progressive primary</option><option value="hdr-surgery-synthetic-odd-scale.jpg">Rounded odd-dimension map</option></select></label><button id="hdr-open-sample" type="button">Open selected sample</button><label>Local JPEG<input id="hdr-file" type="file" accept="image/jpeg,.jpg,.jpeg" /></label><label>Remote URL<span class="hdr-inline"><input id="hdr-url" type="url" placeholder="https://example.com/photo.jpg" /><button id="hdr-open-url" type="button">Open</button></span></label><label>Display boost <output id="hdr-boost-value" for="hdr-boost">4.00×</output><input id="hdr-boost" type="range" min="1" max="16" step="0.25" value="4" /></label><p id="hdr-boost-details" class="hdr-note">1× SDR. Metadata capacity markers appear after inspection.</p>
          <h3>Transform both images</h3><div class="hdr-fields"><label>X<input id="hdr-crop-x" type="number" value="0" min="0" /></label><label>Y<input id="hdr-crop-y" type="number" value="0" min="0" /></label><label>Width<input id="hdr-crop-width" type="number" min="1" /></label><label>Height<input id="hdr-crop-height" type="number" min="1" /></label></div><div class="hdr-fields"><label>Output width<input id="hdr-output-width" type="number" min="1" /></label><label>Output height<input id="hdr-output-height" type="number" min="1" /></label></div><label>Resize kernel<select id="hdr-kernel"><option value="lanczos3">Lanczos3</option><option value="bilinear">Bilinear</option><option value="nearest">Nearest</option></select></label><div class="hdr-button-row"><button id="hdr-auto-orient" type="button">Auto-orient</button><button id="hdr-flip-h" type="button">Flip H</button><button id="hdr-flip-v" type="button">Flip V</button><button id="hdr-rotate" type="button">Rotate 90°</button></div><p class="hdr-note">Geometry is applied to the SDR primary and encoded gain field over the same normalized region.</p>
          <h3>Generate</h3><div class="hdr-fields"><label>Base quality<input id="hdr-base-quality" type="number" min="1" max="100" value="90" /></label><label>Map quality<input id="hdr-map-quality" type="number" min="1" max="100" value="90" /></label></div><label>Metadata<select id="hdr-metadata-mode"><option value="dual">Dual, recommended</option><option value="iso">ISO 21496-1</option><option value="ultra-hdr">Ultra HDR XMP</option></select></label><div class="hdr-button-row"><button id="hdr-jpeg" type="button" disabled>Generate JPEG</button><button id="hdr-avif" type="button" disabled>Generate AVIF</button></div><p class="hdr-note">AVIF output is limited to an opaque sRGB SDR base with one gain channel and constrained encoder dimensions.</p><div class="hdr-button-row"><button id="hdr-cancel" type="button" disabled>Cancel</button><button id="hdr-reset" type="button">Reset sample</button><button id="hdr-export" type="button">Export trace</button></div><p id="hdr-status" role="status">Loading the deterministic sample…</p></aside>
        <div class="hdr-details"><article><h3>Image summary</h3><dl id="hdr-summary" class="hdr-summary"><div><dt>Container</dt><dd>Waiting</dd></div></dl></article><article><h3>Source byte ranges</h3><div id="hdr-ranges" class="hdr-ranges" aria-label="Primary and gain-map byte ranges"></div></article><article id="hdr-output-card" hidden><h3>Generated result</h3><dl class="hdr-summary"><div><dt>Filename</dt><dd id="hdr-output-name"></dd></div><div><dt>Bytes</dt><dd id="hdr-output-bytes"></dd></div><div><dt>Dimensions</dt><dd id="hdr-output-dimensions"></dd></div><div><dt>Metadata</dt><dd id="hdr-output-mode"></dd></div><div><dt>Format boundary</dt><dd id="hdr-output-boundary"></dd></div></dl><div class="hdr-button-row"><button id="hdr-output-download" type="button">Download</button><button id="hdr-output-reopen" type="button">Reopen generated file</button></div><img id="hdr-native" alt="Native browser rendering of the generated Ultra HDR or AVIF gain-map image" /></article><details><summary>Raw metadata JSON</summary><pre id="hdr-metadata">Waiting for inspection.</pre></details><details><summary>Raw execution evidence JSON</summary><pre id="hdr-evidence">Waiting for execution.</pre></details></div>
      </div>
    </section>

    <section id="how-ultra-hdr-works" class="hdr-copy"><h2>How Ultra HDR JPEG gain maps work</h2><p>An Ultra HDR JPEG stores a normal SDR primary plus a smaller gain-map JPEG. MPF locates the child images. GContainer XMP and Ultra HDR XMP or ISO 21496-1 metadata describe how encoded map samples recover highlight headroom. An ordinary JPEG viewer still reads the SDR primary.</p></section>
    <section id="javascript-api" class="hdr-copy"><h2>JavaScript API example</h2><pre><code>{`import { openGainMapImage } from 'purejsimage/hdr'

const image = await openGainMapImage(bytes)
const output = await image.crop({ x: 0, y: 0, width: 1200, height: 800 })
  .resize({ width: 600, height: 400 })
  .jpeg({ metadataMode: 'dual' })
image.close()`}</code></pre></section>
    <section id="inspect-without-decoding" class="hdr-copy"><h2>Inspect without decoding pixels</h2><p><code>inspectGainMapImage()</code> reads bounded JPEG markers, XMP, ISO metadata, MPF ranges, and dimensions. It does not entropy-decode either child image.</p></section>
    <section id="transform-both" class="hdr-copy"><h2>Transform and re-encode both images together</h2><p>Crop, flip, EXIF auto-orientation, quarter turns, and resize are planned for both images. <code>extractOriginalBase()</code> and <code>extractOriginalGainMap()</code> always return the byte-exact source children. Transformed component previews are separate.</p></section>
    <section id="iso-versus-xmp" class="hdr-copy"><h2>ISO 21496-1 versus Ultra HDR XMP</h2><p>Dual output carries both representations for compatibility. Valid ISO 21496-1 metadata is preferred when both agree. Ultra HDR XMP in this release requires an SDR base. Invalid or conflicting gain metadata fails explicit HDR opening without blocking ordinary SDR JPEG display.</p></section>
    <section id="avif-gain-map" class="hdr-copy"><h2>AVIF gain-map support</h2><p><code>purejsimage/hdr</code> also opens the documented AVIF gain-map subset, including its proven HDR-base input path. Output is narrower: opaque sRGB SDR base pixels, one semantic gain channel encoded as achromatic YUV, ISO metadata, and constrained first-party AV1 dimensions.</p></section>
    <section id="node-browser" class="hdr-copy"><h2>Node.js and browser usage</h2><p>Node.js accepts bytes and file-backed inputs through the normal source APIs. Browsers accept <code>File</code>, <code>Blob</code>, <code>ArrayBuffer</code>, and <code>Uint8Array</code>. Shared HDR parsing, transforms, and codecs stay in portable strict TypeScript.</p></section>
    <section id="samples" class="hdr-copy"><h2>Ultra HDR JPEG samples</h2><ul><li>Dual ISO and Ultra HDR metadata</li><li>Ultra HDR XMP only</li><li>ISO 21496-1 only</li><li>RGB gain map with a progressive SDR primary</li><li>Rounded odd-dimension gain map</li></ul></section>
    <section id="limits" class="hdr-copy"><h2>Limits and non-goals</h2><p>HDR Surgery does not synthesize HDR from unrelated SDR and HDR images. It does not author C2PA, HEIF, JPEG XL, AVIF animation, arbitrary-angle rotation, drawing, filters, text, or compositing. JPEG gain-map input is SDR-base only in this release.</p></section>
    <section id="faq" class="hdr-copy"><h2>FAQ</h2><details><summary>What is an Ultra HDR JPEG?</summary><p>It is a backward-compatible SDR JPEG plus an encoded HDR gain map and reconstruction metadata.</p></details><details><summary>Is JPEG_R or JPEGR the same as Ultra HDR?</summary><p>JPEG_R and JPEGR are common names for the gain-map JPEG form used by Ultra HDR workflows.</p></details><details><summary>Can JavaScript edit an Ultra HDR image without discarding its gain map?</summary><p>Yes. PureJsImage applies supported geometry to both the primary and map, then writes a compound output.</p></details><details><summary>Does the output remain readable by an ordinary JPEG viewer?</summary><p>Yes. The first child is an ordinary SDR JPEG primary.</p></details><details><summary>What is ISO 21496-1?</summary><p>It defines gain-map metadata that can describe an alternate rendition and display-capacity behavior.</p></details><details><summary>Does PureJsImage generate HDR from a normal SDR JPEG?</summary><p>No. It does not invent genuine HDR detail from an unrelated SDR image.</p></details><details><summary>Does it work in Node.js and browsers?</summary><p>Yes. The portable TypeScript path supports both, with runtime-specific source and sink adapters.</p></details><details><summary>Does it support AVIF gain maps?</summary><p>It opens the documented AVIF gain-map subset and writes a narrower opaque sRGB, one-channel subset.</p></details></section>
  </main>
  <script type="module" src="/assets/hdr-surgery.js"></script>
</SiteLayout>

<style>
  .hdr-shell{width:min(1440px,calc(100% - 2rem));margin:0 auto;padding:2.5rem 0 5rem}.hdr-hero{display:flex;justify-content:space-between;gap:2rem;align-items:end;margin-bottom:1.5rem}.eyebrow{text-transform:uppercase;letter-spacing:.12em;font-weight:800;color:#0b7b6c}.hdr-hero h1{font-size:clamp(2.4rem,6vw,5.3rem);line-height:.94;margin:.25rem 0 1rem;max-width:20ch}.hdr-lede{max-width:54rem;font-size:clamp(1.05rem,2vw,1.35rem)}.hdr-local,.hdr-copy,.hdr-view,.hdr-controls,.hdr-details>article,.hdr-details>details{border:1px solid var(--border-color,#cad3d8);border-radius:1rem;background:var(--surface,#fff)}.hdr-local{display:grid;gap:.2rem;max-width:20rem;padding:1rem}.hdr-copy{padding:clamp(1rem,3vw,2rem);margin:1.25rem 0}.hdr-copy>h2,#interactive-workbench>h2{font-size:clamp(1.6rem,3vw,2.5rem)}.hdr-quick{border-left:6px solid #0b7b6c}.hdr-display{padding:.75rem 1rem;border-left:4px solid #0b7b6c;background:color-mix(in srgb,#0b7b6c 7%,transparent)}.hdr-result{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin:1.25rem 0}.hdr-view{min-width:0;overflow:hidden}.hdr-view-heading{display:flex;justify-content:space-between;gap:1rem;align-items:baseline;padding:.8rem 1rem}.hdr-view-heading h3{font-size:1rem;margin:0}.hdr-view-heading span{font-size:.75rem;opacity:.7}.hdr-view canvas,#hdr-native{display:block;width:100%;height:auto;aspect-ratio:16/9;object-fit:contain;background:repeating-conic-gradient(#e8ecee 0 25%,#f7f8f8 0 50%) 50%/20px 20px}.hdr-view p{padding:0 1rem .8rem;font:500 .75rem/1.4 ui-monospace,monospace}.hdr-workspace{display:grid;grid-template-columns:minmax(17rem,24rem) minmax(0,1fr);gap:1rem;align-items:start}.hdr-controls{position:sticky;top:1rem;display:grid;gap:.8rem;padding:1rem}.hdr-controls h3{font-size:1rem;margin:.5rem 0 0}.hdr-controls label{display:grid;gap:.35rem;font-size:.84rem;font-weight:650}.hdr-controls input,.hdr-controls select,.hdr-controls button,.hdr-details button{font:inherit;padding:.6rem;border:1px solid var(--border-color,#aab7be);border-radius:.55rem;background:var(--surface,#fff);color:inherit}.hdr-controls button:not(:disabled),.hdr-details button{cursor:pointer}.hdr-controls :focus-visible,.hdr-details :focus-visible{outline:3px solid #16a394;outline-offset:2px}.hdr-inline,.hdr-button-row{display:flex;gap:.5rem;flex-wrap:wrap}.hdr-inline input{min-width:0;flex:1}.hdr-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.5rem}.hdr-note{font-size:.78rem;line-height:1.4}.hdr-details{display:grid;gap:1rem}.hdr-details>article,.hdr-details>details{padding:1rem}.hdr-details pre{max-height:24rem;overflow:auto;white-space:pre-wrap;font-size:.72rem}.hdr-ranges{display:flex;min-height:3rem;border-radius:.5rem;overflow:hidden;background:#dde4e7}.hdr-ranges span{display:grid;place-items:center;min-width:4rem;padding:.4rem;font-size:.75rem}.range-base{background:#2d7068;color:white}.range-map{background:#d6a637;color:#1c1a12}.hdr-summary{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem}.hdr-summary div{padding:.6rem;background:color-mix(in srgb,#0b7b6c 6%,transparent);border-radius:.5rem}.hdr-summary dt{font-size:.72rem;text-transform:uppercase;letter-spacing:.04em}.hdr-summary dd{margin:.2rem 0 0;font-weight:700;overflow-wrap:anywhere}pre{overflow:auto}@media(max-width:900px){.hdr-workspace{grid-template-columns:1fr}.hdr-controls{position:static}.hdr-hero{align-items:start;flex-direction:column}}@media(max-width:600px){.hdr-shell{width:min(100% - 1rem,1440px);padding-top:1rem}.hdr-result,.hdr-summary,.hdr-fields{grid-template-columns:1fr}.hdr-view-heading{align-items:start;flex-direction:column;gap:.25rem}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
</style>
