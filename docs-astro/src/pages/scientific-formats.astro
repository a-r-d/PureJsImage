---
import ScientificFormatCard from '../components/ScientificFormatCard.astro'
import SiteLayout from '../layouts/SiteLayout.astro'
import documentation from '../data/documentation-data.json'

const formatAnchor = (id: string): string => id.replaceAll('/', '-')
const families = documentation.support.scientificReaderFamilies.map((family) => ({
  ...family,
  entries: documentation.scientificFormats.filter((entry) => entry.family === family.id),
}))
---

<SiteLayout
  title="Scientific format reference | PureJsImage"
  description="Generated PureJsImage scientific reader reference with format families, extensions, native precision, range-read support, resource models, benchmark coverage, oracles, and imports."
  canonical="https://purejsimage.com/scientific-formats/"
  current="scientific-formats/"
  openGraph={{
    title: 'Scientific format reference | PureJsImage',
    description:
      'Generated support and benchmark reference for every explicit PureJsImage scientific reader.',
    url: 'https://purejsimage.com/scientific-formats/',
  }}
  twitterCard="summary"
>
  <main id="main" data-scientific-reader-count={documentation.support.scientificReaderCount}>
    <header class="page-hero">
      <div class="container">
        <p class="eyebrow">Generated scientific reader contract</p>
        <h1>Scientific format and benchmark reference.</h1>
        <p class="page-lede">
          This page is generated from <code>capabilities/manifest.json</code>, the current package
          metrics, and the indexed scientific benchmark artifacts. It distinguishes package support
          from the smaller set in the live explorer.
        </p>
        <div class="page-meta">
          <span class="pill">{documentation.support.scientificReaderCount} readers</span>
          <span class="pill">{documentation.support.scientificReaderFamilies.length} format families</span>
          <span class="pill">Native precision</span>
          <span class="pill">Direct-range evidence</span>
        </div>
      </div>
    </header>

    <div class="container docs-layout format-reference-layout">
      <nav class="side-nav" aria-label="Format index">
        <div class="nav-group">
          <strong>On this page</strong>
          <a href="#coverage-scope">Coverage scope</a>
          {
            families.map((family) => (
              <>
                <a class="format-index-family" href={`#${family.id}`}>
                  {family.label}
                </a>
                <div class="format-index-children">
                  {family.entries.map((entry) => (
                    <a href={`#${formatAnchor(entry.id)}`}>{entry.format}</a>
                  ))}
                </div>
              </>
            ))
          }
          <a href="#methods">Methods and artifacts</a>
        </div>
        <div class="nav-group">
          <strong>Related</strong>
          <a href="../codecs/">Codec support</a>
          <a href="../scientific/">Scientific explorer</a>
          <a href="../ome-zarr/">OME-Zarr WSI viewer</a>
          <a href="../scientific/benchmarks/">Reader tables</a>
          <a href="../performance/#scientific-readers">Scientific charts</a>
        </div>
      </nav>

      <div class="content">
        <section id="coverage-scope">
          <h2>Coverage scope</h2>
          <p>
            The reader surface includes common raster and whole-slide data; DM3 and DM4; TIA SER and
            EMI; NCEM and Velox EMD; 4D-STEM detector data; AFM, SPM, and surface metrology; NIfTI,
            NRRD, MRC, and MetaImage volumes; OME-TIFF and Aperio SVS; spectroscopy and detector
            interchange; and raw NumPy arrays. “Direct range” means the reader can request selected
            source spans through the scientific source abstraction; it does not promise that every
            operation avoids all metadata or companion-resource reads.
          </p>
          <p>
            The <a href="../ome-zarr/">OME-Zarr WSI viewer</a> is the measured browser proof for
            remote, sharded OME-NGFF pyramids; the general scientific explorer remains local-file
            focused.
          </p>
          <div class="callout warning">
            <strong>Live explorer boundary.</strong> The browser explorer currently wires only its five
            generated demo reader IDs. Package readers below require explicit application registration
            unless and until their UI integration lands.
          </div>
        </section>

        {
          families.map((family) => (
            <section id={family.id}>
              <h2>{family.label}</h2>
              <p>
                {family.entries.length} explicit reader {
                  family.entries.length === 1 ? 'export' : 'exports'
                }.
              </p>
              <div class="scientific-format-grid">
                {
                  family.entries.map((entry) => (
                    <ScientificFormatCard
                      format={entry.format}
                      id={entry.id}
                      extensions={entry.extensions}
                      datasetKinds={entry.datasetKinds}
                      directRangeReads={entry.directRangeReads}
                      nativePrecision={entry.nativePrecision}
                      packageExport={entry.packageExport}
                      resourceModel={entry.resourceModel}
                      supportBoundary={entry.supportBoundary}
                      oracle={entry.oracle}
                      benchmarkCoverage={entry.benchmarkCoverage}
                    />
                  ))
                }
              </div>
            </section>
          ))
        }

        <section id="methods">
          <h2>Methods and artifacts</h2>
          <p>
            Baseline rows validate descriptor identity, selected shapes, native sample type, calibration
            assertions, sample hashes, and output bytes before admitting timing. Range rows additionally
            record request count, returned and unique source bytes, overfetch, and resource completeness.
          </p>
          <p>
            <a class="text-link" href="../performance/#scientific-readers">
              Scientific benchmark charts and methodology →
            </a>
            {' · '}
            <a class="text-link" href="../scientific/">Wired browser explorer →</a>
          </p>
        </section>
      </div>
    </div>
  </main>
</SiteLayout>
