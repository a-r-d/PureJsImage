---
import SiteLayout from '../layouts/SiteLayout.astro'

const configuredBase = import.meta.env.BASE_URL
const siteBase = configuredBase.endsWith('/') ? configuredBase : `${configuredBase}/`
---

<SiteLayout title="Page not found — PureJsImage" hideHeader noindex>
<main id="main" class="hero">
    <div class="container" style="min-height:70vh;display:grid;place-items:center;text-align:center">
      <div>
        <p class="eyebrow">404</p>
        <h1 style="font-size:clamp(3rem,10vw,7rem)">Page not found.</h1>
        <p class="page-lede" style="margin-inline:auto">No documentation page exists at this address. The link may be outdated or incomplete.</p>
        <div class="hero-actions" style="justify-content:center"><a class="button" href={siteBase}>Return home</a><a class="button secondary" href={`${siteBase}api/`}>Browse the API</a></div>
      </div>
    </div>
  </main>
</SiteLayout>
