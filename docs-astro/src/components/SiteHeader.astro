---
import { ThemeToggle } from './ThemeToggle'

interface Props {
  readonly current?: string
  readonly home?: boolean
  readonly skipLabel?: string
}

const { current, home = false, skipLabel = 'Skip to content' } = Astro.props
const navigation = [
  ['demo/', 'Demo'],
  ['wsi/', 'Whole slide'],
  ['guides/', 'Guides'],
  ['api/', 'API'],
  ['codecs/', 'Codecs'],
  ['performance/', 'Performance'],
  ['contributing/', 'Contribute'],
] as const
const configuredBase = import.meta.env.BASE_URL
const siteBase = configuredBase.endsWith('/') ? configuredBase : `${configuredBase}/`
---

<a class="skip-link" href="#main">{skipLabel}</a>
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={siteBase} aria-label="PureJsImage home">
      <span class="brand-mark" aria-hidden="true">
        <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
      </span>
      <span>PureJsImage</span>
    </a>
    <nav class="site-nav" data-nav aria-label="Primary navigation">
      {
        navigation.map(([href, label]) => (
          <a href={`${siteBase}${href}`} aria-current={current === href ? 'page' : undefined}>
            {label}
          </a>
        ))
      }
    </nav>
    <div class="header-actions">
      <ThemeToggle client:load />
      <a
        class="button secondary small github-header"
        href="https://github.com/a-r-d/PureJsImage"
        target="_blank"
        rel="noreferrer"
      >
        {
          home && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.88c-2.78.61-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.6 9.6 0 0 1 12 6.82a9.6 9.6 0 0 1 2.5.34c1.91-1.3 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.86V21c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"
              ></path>
            </svg>
          )
        }
        GitHub
      </a>
      <button
        class="icon-button menu-button"
        type="button"
        data-menu-toggle
        aria-label="Open navigation"
        aria-expanded="false"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M4 7h16M4 12h16M4 17h16"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-width="2"></path>
        </svg>
      </button>
    </div>
  </div>
</header>
