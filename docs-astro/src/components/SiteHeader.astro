---
import { ThemeToggle } from './ThemeToggle'

interface Props {
  readonly current?: string
  readonly home?: boolean
  readonly skipLabel?: string
}

interface NavLink {
  readonly href: string
  readonly label: string
}

const { current, skipLabel = 'Skip to content' } = Astro.props
const demoItems = [
  { href: 'demo/', label: 'Image converter' },
  { href: 'wsi/', label: 'Whole-slide viewer' },
  { href: 'ome-zarr/', label: 'OME-Zarr viewer' },
  { href: 'scientific/', label: 'Scientific explorer' },
  { href: 'geo/', label: 'Geo raster labs' },
] as const satisfies readonly NavLink[]
const appItems = [
  { href: 'https://lab.purejsimage.com/', label: 'Scientific imagery' },
  { href: 'https://geo.purejsimage.com/', label: 'Geospatial' },
] as const satisfies readonly NavLink[]
const benchmarkItems = [
  { href: 'performance/', label: 'Web codec charts' },
  { href: 'performance/#scientific-readers', label: 'Scientific reader charts' },
  { href: 'scientific/benchmarks/', label: 'Scientific reader tables' },
] as const satisfies readonly NavLink[]
const referenceItems = [
  { href: 'api/', label: 'API' },
  { href: 'codecs/', label: 'Codec support' },
  { href: 'scientific-formats/', label: 'Scientific formats' },
] as const satisfies readonly NavLink[]
const demoIsCurrent = demoItems.some(({ href }) => current === href)
const referenceIsCurrent =
  current === 'api/' || current === 'codecs/' || current === 'scientific-formats/'
const benchmarkIsCurrent = current === 'performance/' || current === 'scientific/benchmarks/'
const configuredBase = import.meta.env.BASE_URL
const siteBase = configuredBase.endsWith('/') ? configuredBase : `${configuredBase}/`
---

<a class="skip-link" href="#main">{skipLabel}</a>
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={siteBase} aria-label="PureJsImage home">
      <span class="brand-mark" aria-hidden="true">
        <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
      </span>
      <span>PureJsImage</span>
    </a>
    <nav class="site-nav" id="site-nav" data-nav aria-label="Primary navigation">
      <details class="nav-disclosure" data-nav-disclosure>
        <summary class="nav-summary" aria-current={demoIsCurrent ? 'true' : undefined}>Demos</summary>
        <div class="nav-submenu" role="group" aria-label="Demos">
          {
            demoItems.map(({ href, label }) => (
              <a href={`${siteBase}${href}`} aria-current={current === href ? 'page' : undefined}>
                {label}
              </a>
            ))
          }
        </div>
      </details>
      <details class="nav-disclosure" data-nav-disclosure>
        <summary class="nav-summary">Apps</summary>
        <div class="nav-submenu" role="group" aria-label="Apps">
          {
            appItems.map(({ href, label }) => (
              <a href={href} target="_blank" rel="noreferrer">
                {label}
              </a>
            ))
          }
        </div>
      </details>
      <a href={`${siteBase}guides/`} aria-current={current === 'guides/' ? 'page' : undefined}>
        Guides
      </a>
      <details class="nav-disclosure" data-nav-disclosure>
        <summary class="nav-summary" aria-current={referenceIsCurrent ? 'true' : undefined}>
          Reference
        </summary>
        <div class="nav-submenu" role="group" aria-label="Reference">
          {
            referenceItems.map(({ href, label }) => (
              <a href={`${siteBase}${href}`} aria-current={current === href ? 'page' : undefined}>
                {label}
              </a>
            ))
          }
        </div>
      </details>
      <details class="nav-disclosure" data-nav-disclosure>
        <summary class="nav-summary" aria-current={benchmarkIsCurrent ? 'true' : undefined}>
          Benchmarks
        </summary>
        <div class="nav-submenu" role="group" aria-label="Benchmarks">
          {
            benchmarkItems.map(({ href, label }) => (
              <a href={`${siteBase}${href}`} aria-current={current === href ? 'page' : undefined}>
                {label}
              </a>
            ))
          }
        </div>
      </details>
      <div class="nav-panel-extras">
        <div class="nav-project">
          <p class="nav-heading">Project</p>
          <a
            href={`${siteBase}contributing/`}
            aria-current={current === 'contributing/' ? 'page' : undefined}
          >
            Contribute
          </a>
          <a href="https://github.com/a-r-d/PureJsImage" target="_blank" rel="noreferrer">
            GitHub
          </a>
        </div>
      </div>
    </nav>
    <div class="header-actions">
      <ThemeToggle client:load />
      <a
        class="icon-button github-header"
        href="https://github.com/a-r-d/PureJsImage"
        target="_blank"
        rel="noreferrer"
        aria-label="GitHub"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z"
          ></path>
        </svg>
      </a>
      <button
        class="icon-button menu-button"
        type="button"
        data-menu-toggle
        aria-controls="site-nav"
        aria-label="Open navigation"
        aria-expanded="false"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M4 7h16M4 12h16M4 17h16"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-width="2"></path>
        </svg>
      </button>
    </div>
  </div>
</header>
