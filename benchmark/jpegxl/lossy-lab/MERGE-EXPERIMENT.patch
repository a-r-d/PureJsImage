diff --git a/tests/jpegxl-selector-merge-guard.test.ts b/tests/jpegxl-selector-merge-guard.test.ts
new file mode 100644
index 00000000..f2a9c7cc
--- /dev/null
+++ b/tests/jpegxl-selector-merge-guard.test.ts
@@ -0,0 +1,57 @@
+import { expect, it } from 'vitest'
+import {
+  copyMergeGuardCells,
+  mergeGuardAllows,
+  mergeGuardExcess,
+} from '../benchmark/jpegxl/lossy-lab/selector-merge-guard.ts'
+
+it('prevents one cell from spending another cell’s error budget', () => {
+  const incumbent = new Float64Array(64).fill(100)
+  const candidate = incumbent.slice()
+  candidate[0] = 0
+  candidate[1] = 101
+  expect(mergeGuardAllows(candidate, incumbent, 0, 0, 2, 1, 1)).toBe(false)
+  candidate[1] = 100
+  expect(mergeGuardAllows(candidate, incumbent, 0, 0, 2, 1, 1)).toBe(true)
+})
+
+it.each([2, 8] as const)('applies the relative error allowance in power %d', (power) => {
+  const incumbent = new Float64Array(64).fill(1)
+  const candidate = new Float64Array(64).fill(1.1 ** power)
+  expect(mergeGuardAllows(candidate, incumbent, 8, 8, 4, 4, 1.1 ** power)).toBe(true)
+  candidate[27] = 1.10001 ** power
+  expect(mergeGuardAllows(candidate, incumbent, 8, 8, 4, 4, 1.1 ** power)).toBe(false)
+})
+
+it('preserves exact-zero error and rejects nonfinite candidate loss', () => {
+  const incumbent = new Float64Array(64)
+  const candidate = new Float64Array(64)
+  expect(mergeGuardAllows(candidate, incumbent, 0, 0, 1, 1, 1)).toBe(true)
+  for (const value of [1e-30, Infinity, NaN]) {
+    candidate[0] = value
+    expect(mergeGuardAllows(candidate, incumbent, 0, 0, 1, 1, 1)).toBe(false)
+  }
+})
+
+it('updates only the chosen rectangle in the bounded tile, including tile edges', () => {
+  const incumbent = new Float64Array(64).fill(2)
+  const candidate = new Float64Array(64).fill(3)
+  const pending = incumbent.slice()
+  copyMergeGuardCells(candidate, pending, 14, 13, 2, 3)
+  for (let y = 0; y < 8; y++)
+    for (let x = 0; x < 8; x++) expect(pending[y * 8 + x]).toBe(x >= 6 && y >= 5 ? 3 : 2)
+})
+
+it.each([2, 8] as const)(
+  'penalizes the worst local norm increase without rewarding other cells, power %d',
+  (power) => {
+    const incumbent = new Float64Array(64).fill(64)
+    const candidate = incumbent.slice()
+    candidate[0] = 0
+    expect(mergeGuardExcess(candidate, incumbent, 0, 0, 2, 1, power)).toBe(0)
+    candidate[1] = 64 * 1.25 ** power
+    expect(mergeGuardExcess(candidate, incumbent, 0, 0, 2, 1, power)).toBeCloseTo(0.25, 12)
+    candidate[1] = Infinity
+    expect(mergeGuardExcess(candidate, incumbent, 0, 0, 2, 1, power)).toBe(Infinity)
+  },
+)
