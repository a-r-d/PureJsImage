diff --git a/benchmark/jpegxl/lossy-lab/filtered-rounding.ts b/benchmark/jpegxl/lossy-lab/filtered-rounding.ts
new file mode 100644
index 00000000..5029f6e6
--- /dev/null
+++ b/benchmark/jpegxl/lossy-lab/filtered-rounding.ts
@@ -0,0 +1,89 @@
+/** First-party development trials. Reuses our decoder centroids and rate proxy. */
+import { defaultJpegXlQuantizationBiases } from '../../../src/codecs/jpegxl-vardct-quantization.ts'
+import type { JpegXlDevelopmentTransformContext } from '../../../src/codecs/jpegxl-development-decisions.ts'
+
+export const filteredRoundingModes = [
+  'standalone-rd25',
+  'standalone-rd25-filtered',
+  'standalone-rd50',
+  'standalone-rd100',
+  'standalone-rd50-all',
+  'standalone-promote-existing',
+  'standalone-promote-two',
+  'standalone-promote-class',
+] as const
+export type FilteredRounding = (typeof filteredRoundingModes)[number]
+export function isFilteredRounding(mode: string): mode is FilteredRounding {
+  return filteredRoundingModes.some((value) => value === mode)
+}
+export function regularTraceDct(strategy: number): boolean {
+  return (
+    strategy === 0 ||
+    strategy === 4 ||
+    strategy === 5 ||
+    strategy === 6 ||
+    strategy === 7 ||
+    strategy === 10 ||
+    strategy === 11 ||
+    (strategy >= 18 && strategy <= 26)
+  )
+}
+/** Interior DCT response of the decoder's default 3x3 Gaborish kernel. */
+export function gaborishResponse(width: number, height: number, output: Float64Array): void {
+  const adjacent = 1.1 * 0.104699568,
+    diagonal = 1.1 * 0.055680538
+  const norm = 1 / (1 + 4 * (adjacent + diagonal))
+  for (let y = 0; y < height; y++)
+    for (let x = 0; x < width; x++) {
+      const cx = Math.cos((Math.PI * x) / width),
+        cy = Math.cos((Math.PI * y) / height)
+      output[y * width + x] = ((1 + 2 * adjacent * (cx + cy) + 4 * diagonal * cx * cy) * norm) ** 2
+    }
+}
+export function inferredRate(context: JpegXlDevelopmentTransformContext, channel: number): number {
+  let low = 0,
+    high = 1
+  for (let i = 0; i < 12; i++) {
+    const middle = (low + high) / 2
+    if (context.quantize(middle, channel) === 0) low = middle
+    else high = middle
+  }
+  const bias = defaultJpegXlQuantizationBiases[channel] ?? 1
+  return Math.max(0, (2 * bias * ((low + high) / 2) - bias * bias) / 3)
+}
+const decoded = (q: number, bias: number): number => (q === 0 ? 0 : q === 1 ? bias : q - 0.145 / q)
+const rate = (q: number): number => (q === 0 ? 0 : 1 + 2 * Math.log2(q + 1))
+
+export function filteredRound(
+  value: number,
+  baseline: number,
+  channel: number,
+  response: number,
+  weight: number,
+  mode: FilteredRounding,
+  highFrequency: boolean,
+): number {
+  if (channel !== 1 && mode !== 'standalone-rd50-all') return baseline
+  const q = Math.abs(baseline),
+    v = Math.abs(value),
+    bias = defaultJpegXlQuantizationBiases[channel] ?? 1
+  if (mode.startsWith('standalone-promote')) {
+    if (!highFrequency || q < 1 || (mode === 'standalone-promote-two' && q < 2)) return baseline
+    const upper = q + 1
+    if (mode === 'standalone-promote-class' && Math.clz32(q) !== Math.clz32(upper)) return baseline
+    if ((v - decoded(upper, bias)) ** 2 >= (v - decoded(q, bias)) ** 2) return baseline
+    return value < 0 ? -upper : upper
+  }
+  if (q === 0) return baseline
+  const strength =
+    mode === 'standalone-rd25' || mode === 'standalone-rd25-filtered'
+      ? 0.25
+      : mode === 'standalone-rd100'
+        ? 1
+        : 0.5
+  const penalty = weight * strength
+  const lower = q - 1
+  const errorChange = response * ((v - decoded(lower, bias)) ** 2 - (v - decoded(q, bias)) ** 2)
+  if (errorChange >= penalty * (rate(q) - rate(lower))) return baseline
+  return value < 0 ? -lower : lower
+}
diff --git a/tests/jpegxl-filtered-rounding.test.ts b/tests/jpegxl-filtered-rounding.test.ts
new file mode 100644
index 00000000..b80b103e
--- /dev/null
+++ b/tests/jpegxl-filtered-rounding.test.ts
@@ -0,0 +1,75 @@
+import { expect, it } from 'vitest'
+import {
+  filteredRound,
+  filteredRoundingModes,
+  gaborishResponse,
+  inferredRate,
+} from '../benchmark/jpegxl/lossy-lab/filtered-rounding.ts'
+import { encodeTransplant } from '../benchmark/jpegxl/lossy-lab/transplant.ts'
+import { libjxlPortOverrides } from '../benchmark/jpegxl/lossy-lab/libjxl-ports.ts'
+import { decodeDisplayStages } from '../benchmark/jpegxl/lossy-lab/display-error-trace.ts'
+
+it('keeps DC gain one and attenuates alternating pixels in the Gaborish response', () => {
+  const values = new Float64Array(64)
+  gaborishResponse(8, 8, values)
+  expect(values[0]).toBeCloseTo(1, 12)
+  const sample = (x: number, y: number) =>
+    Math.cos((Math.PI * (x + 0.5) * 7) / 8) * Math.cos((Math.PI * (y + 0.5) * 7) / 8)
+  const adjacent = 1.1 * 0.104699568,
+    diagonal = 1.1 * 0.055680538
+  let filtered = sample(3, 3)
+  for (const [x, y] of [
+    [2, 3],
+    [4, 3],
+    [3, 2],
+    [3, 4],
+  ])
+    filtered += adjacent * sample(x ?? 0, y ?? 0)
+  for (const [x, y] of [
+    [2, 2],
+    [4, 2],
+    [2, 4],
+    [4, 4],
+  ])
+    filtered += diagonal * sample(x ?? 0, y ?? 0)
+  filtered /= 1 + 4 * (adjacent + diagonal)
+  expect(values[63]).toBeCloseTo((filtered / sample(3, 3)) ** 2, 12)
+  expect(values.every((v) => v > 0 && v <= 1)).toBe(true)
+})
+it('does not create new nonzeros in promotion or rate-saving trials', () => {
+  for (const mode of filteredRoundingModes) {
+    expect(filteredRound(0.45, 0, 1, 0.15, 0.1, mode, true)).toBe(0)
+    expect(filteredRound(-0.45, 0, 1, 0.15, 0.1, mode, true)).toBe(0)
+  }
+  expect(filteredRound(3, 2, 1, 0.15, 0.1, 'standalone-promote-class', true)).toBe(3)
+  expect(filteredRound(4, 3, 1, 0.15, 0.1, 'standalone-promote-class', true)).toBe(3)
+})
+it('infers a nonnegative finite scalar rate cost from a live quantizer', () => {
+  const rate = inferredRate({ readBlock: () => [], quantize: Math.round }, 1)
+  expect(rate).toBeGreaterThanOrEqual(0)
+  expect(rate).toBeLessThan(0.1)
+})
+it.each(filteredRoundingModes)(
+  'encodes odd-edge mixed textures with %s',
+  async (mode) => {
+    const width = 73,
+      height = 29
+    const pixels = Uint8Array.from({ length: width * height * 4 }, (_, i) =>
+      i % 4 === 3 ? 255 : (i * 13 + Math.floor(i / width) * 7) % 256,
+    )
+    const before = pixels.slice()
+    const result = await encodeTransplant(
+      pixels,
+      width,
+      height,
+      2,
+      libjxlPortOverrides(mode, 2, width, height),
+    )
+    const decoded = await decodeDisplayStages(result.bytes)
+    expect(decoded.width).toBe(width)
+    expect(decoded.height).toBe(height)
+    expect(pixels).toEqual(before)
+    expect(result.managedPeakBytes).toBeLessThan(2_000_000)
+  },
+  30_000,
+)
