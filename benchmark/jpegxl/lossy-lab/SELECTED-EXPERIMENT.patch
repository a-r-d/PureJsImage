@@ -0,0 +1,49 @@
+import { createHash } from 'node:crypto'
+import { readFile, writeFile } from 'node:fs/promises'
+import { PNG } from 'pngjs'
+import { libjxlStandaloneOverrides } from './libjxl-standalone-port.ts'
+import { createSelectorCounts } from './selector-counts.ts'
+import { encodeTransplant } from './transplant.ts'
+
+const [path, output] = process.argv.slice(2)
+if (!path || !output) throw new Error('Need input and output')
+const png = PNG.sync.read(await readFile(path)),
+  pixels = Uint8Array.from(png.data),
+  rows = []
+let expected: string | undefined
+for (const mode of [
+  'standalone-forward-all',
+  'standalone-prune-known',
+  'standalone-prune-minimum',
+  'standalone-prune-partial',
+  'standalone-prune-partition',
+  'standalone-prune-combined',
+] as const) {
+  const audit = createSelectorCounts()
+  const result = await encodeTransplant(
+    pixels,
+    png.width,
+    png.height,
+    2,
+    libjxlStandaloneOverrides(2, png.width, png.height, mode, { audit }),
+  )
+  const hash = createHash('sha256').update(result.bytes).digest('hex')
+  expected ??= hash
+  if (hash !== expected) throw new Error(`Pruning changed ${mode}`)
+  rows.push({
+    mode,
+    hash,
+    counts: Object.fromEntries((['candidates','forward','inverse','beforeInverse','afterInverse','early'] as const).map(k=>[k,Array.from(audit[k])])),
+    totals: Object.fromEntries(
+      (['candidates','forward','inverse','beforeInverse','afterInverse','early'] as const).map(k=>[k,audit[k].reduce((a,b)=>a+b,0)]),
+    ),
+  })
+}
+await writeFile(output, JSON.stringify({ path, distance: 2, rows }, null, 2) + '\n')
+console.log(
+  JSON.stringify(
+    rows.map((r) => ({ mode: r.mode, ...r.totals })),
+    null,
+    2,
+  ),
+)
