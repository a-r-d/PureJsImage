+/** Development-only accounting for candidate work and rejection stages. */
+export interface SelectorCounts {
+  candidates: Float64Array
+  forward: Float64Array
+  inverse: Float64Array
+  beforeInverse: Float64Array
+  afterInverse: Float64Array
+  early: Float64Array
+}
+export function createSelectorCounts(): SelectorCounts {
+  return {
+    candidates: new Float64Array(27),
+    forward: new Float64Array(81),
+    inverse: new Float64Array(81),
+    beforeInverse: new Float64Array(81),
+    afterInverse: new Float64Array(81),
+    early: new Float64Array(81),
+  }
+}
diff --git a/benchmark/jpegxl/lossy-lab/summarize-selected.ts b/benchmark/jpegxl/lossy-lab/summarize-selected.ts
new file mode 100644
index 00000000..768024b4
--- /dev/null
+++ b/benchmark/jpegxl/lossy-lab/summarize-selected.ts
@@ -0,0 +1,86 @@
+import { readdir, readFile, writeFile } from 'node:fs/promises'
+import { number, object } from '../comparison/model.ts'
+import { regularDct } from './selected-error.ts'
+
+const [root, output] = process.argv.slice(2)
+if (!root || !output) throw new Error('Need audit directory and summary path')
+const files = (await readdir(root)).filter((f) => /^im26-\d+-[\d.]+\.json$/u.test(f))
+if (files.length !== 576) throw new Error(`Need 576 audit points, got ${files.length}`)
+const groups = new Map<
+  number,
+  {
+    count: number
+    pixels: number
+    counts: Record<string, number[]>
+    errors: Record<string, number[]>
+  }
+>()
+for (const f of files) {
+  const row = object(JSON.parse(await readFile(`${root}/${f}`, 'utf8'))),
+    distance = number(row.distance)
+  let group = groups.get(distance)
+  if (!group) {
+    group = { count: 0, pixels: 0, counts: {}, errors: {} }
+    groups.set(distance, group)
+  }
+  group.count++
+  group.pixels += number(row.pixels)
+  for (const [field, target] of [
+    [row.counts, group.counts],
+    [row.error, group.errors],
+  ] as const)
+    for (const [key, value] of Object.entries(object(field))) {
+      if (!Array.isArray(value)) throw new Error('Missing vector')
+      const sum = (target[key] ??= new Array<number>(value.length).fill(0))
+      if (sum.length !== value.length) throw new Error('Mixed vector extent')
+      for (let i = 0; i < sum.length; i++) sum[i] = (sum[i] ?? 0) + number(value[i])
+    }
+}
+const rows = [...groups]
+  .sort((a, b) => a[0] - b[0])
+  .map(([distance, g]) => {
+    if (g.count !== 64) throw new Error('Incomplete distance')
+    const regularLuma = {
+      count: [0, 0, 0, 0],
+      nonzero: [0, 0, 0, 0],
+      error: [0, 0, 0, 0],
+      avoidable: [0, 0, 0, 0],
+      signal: [0, 0, 0, 0],
+    }
+    for (const key of ['count', 'nonzero', 'error', 'avoidable', 'signal'] as const)
+      for (let strategy = 0; strategy < 27; strategy++)
+        if (regularDct(strategy))
+          for (let band = 0; band < 4; band++)
+            regularLuma[key][band] =
+              (regularLuma[key][band] ?? 0) + (g.errors[key]?.[(strategy * 3 + 1) * 4 + band] ?? 0)
+    return {
+      distance,
+      ...g,
+      regularLuma,
+      work: Object.fromEntries(
+        Object.entries(g.counts).map(([key, value]) => [key, value.reduce((a, b) => a + b, 0)]),
+      ),
+    }
+  })
+await writeFile(
+  output,
+  JSON.stringify(
+    {
+      base: 'c10c99be',
+      points: files.length,
+      bands: ['unclassified-special', 'low', 'middle', 'high'],
+      policy:
+        'AC coefficient-domain energy before display filtering. Regular DCT energy is scaled to spatial SSE. Chroma is residual-domain only. Nearest-level excess ignores rate cost. No holdout.',
+      rows,
+    },
+    null,
+    2,
+  ) + '\n',
+)
+console.log(
+  JSON.stringify(
+    rows.map((r) => ({ distance: r.distance, regularLuma: r.regularLuma, work: r.work })),
+    null,
+    2,
+  ),
+)
diff --git a/tests/jpegxl-selected-error.test.ts b/tests/jpegxl-selected-error.test.ts
new file mode 100644
index 00000000..463e1aa2
--- /dev/null
+++ b/tests/jpegxl-selected-error.test.ts
@@ -0,0 +1,112 @@
+import { expect, it } from 'vitest'
+import {
+  createSelectedError,
+  decodedLevel,
+  guardRoundedCoefficient,
+  recordSelectedError,
+  regularDct,
+  roundingShift,
+  selectedFrequencyBand,
+} from '../benchmark/jpegxl/lossy-lab/selected-error.ts'
+import { forwardSelectorTransform } from '../benchmark/jpegxl/lossy-lab/selector-transforms.ts'
+import { inverseJpegXlDevelopmentTransform } from '../src/codecs/jpegxl-vardct-render.ts'
+
+it('labels regular-transform frequencies and leaves special transforms unclassified', () => {
+  expect(selectedFrequencyBand(0, 8, 8)).toBe(0)
+  expect(selectedFrequencyBand(2, 8, 8)).toBe(1)
+  expect(selectedFrequencyBand(24, 16, 8)).toBe(2)
+  expect(selectedFrequencyBand(63, 8, 8)).toBe(3)
+  expect(regularDct(1)).toBe(false)
+  expect(regularDct(3)).toBe(false)
+  expect(regularDct(10)).toBe(true)
+  expect(roundingShift('high', 0, 1)).toBe(0)
+  expect(roundingShift('high', 3, 0)).toBe(0)
+  expect(roundingShift('high', 3, 1)).toBe(0.08)
+  expect(roundingShift('low', 3, 1)).toBe(-0.08)
+})
+it.each([
+  [0, 8, 8],
+  [4, 16, 16],
+  [6, 16, 8],
+])('accounts for coefficient normalization for strategy %i', (strategy, width, height) => {
+  const size = width * height,
+    src = Float32Array.from({ length: size }, (_, i) => Math.sin(i * 0.31) * 0.1)
+  const coefficients = new Float64Array(size),
+    scratch = new Float64Array(4096),
+    reconstructed = new Float64Array(size),
+    out = new Float32Array(size),
+    active = new Uint16Array(64)
+  forwardSelectorTransform(strategy, src, scratch, coefficients)
+  const audit = createSelectedError(),
+    step = 0.002,
+    naturalWidth = Math.max(width, height)
+  for (let p = 0; p < size; p++) {
+    if (
+      p % naturalWidth < naturalWidth / 8 &&
+      Math.floor(p / naturalWidth) < Math.min(width, height) / 8
+    ) {
+      reconstructed[p] = coefficients[p] ?? 0
+      continue
+    }
+    const normalized = (coefficients[p] ?? 0) / step,
+      q = Math.round(normalized)
+    reconstructed[p] = decodedLevel(q, 1) * step
+    recordSelectedError(
+      audit,
+      strategy,
+      1,
+      selectedFrequencyBand(p, naturalWidth, size / naturalWidth),
+      normalized,
+      q,
+      step,
+      size,
+    )
+  }
+  inverseJpegXlDevelopmentTransform(strategy, reconstructed, scratch, out, active)
+  const spatial = src.reduce((sum, v, i) => sum + (v - (out[i] ?? 0)) ** 2, 0)
+  expect(audit.error.reduce((a, b) => a + b, 0)).toBeCloseTo(spatial, 8)
+  expect(audit.avoidable.reduce((a, b) => a + b, 0)).toBeGreaterThanOrEqual(0)
+})
+
+it('preserves streams when stronger bounds prune losing transform candidates', async () => {
+  const { encodeTransplant } = await import('../benchmark/jpegxl/lossy-lab/transplant.ts')
+  const { libjxlPortOverrides } = await import('../benchmark/jpegxl/lossy-lab/libjxl-ports.ts')
+  const width = 137,
+    height = 75,
+    pixels = Uint8Array.from({ length: width * height * 4 }, (_, i) =>
+      i % 4 === 3 ? 255 : 30 + ((i * 17 + Math.floor(i / width) * 31) % 200),
+    )
+  for (const distance of [0.45, 2, 7.5]) {
+    const control = await encodeTransplant(
+      pixels,
+      width,
+      height,
+      distance,
+      libjxlPortOverrides('standalone-forward-all', distance, width, height),
+    )
+    for (const mode of [
+      'standalone-prune-known',
+      'standalone-prune-minimum',
+      'standalone-prune-partial',
+      'standalone-prune-partition',
+      'standalone-prune-combined',
+    ] as const) {
+      const result = await encodeTransplant(
+        pixels,
+        width,
+        height,
+        distance,
+        libjxlPortOverrides(mode, distance, width, height),
+      )
+      expect(result.bytes).toEqual(control.bytes)
+      expect(result.managedPeakBytes).toBe(control.managedPeakBytes)
+    }
+  }
+})
+
+it('does not spend a high-frequency token on greater decoded error', () => {
+  expect(guardRoundedCoefficient(0.4, 0, 1, 1)).toBe(0)
+  expect(guardRoundedCoefficient(0.6, 0, 1, 1)).toBe(1)
+  expect(guardRoundedCoefficient(-0.6, 0, -1, 1)).toBe(-1)
+  expect(guardRoundedCoefficient(0, 0, 0, 1)).toBe(0)
+})
