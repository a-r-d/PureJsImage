@@ -0,0 +1,83 @@
+import { spawn } from 'node:child_process'
+import { createHash } from 'node:crypto'
+import { mkdir, readFile, writeFile } from 'node:fs/promises'
+import { PNG } from 'pngjs'
+import { parsePreparedManifest, selectPreparedFixtures } from './fixture-selection.ts'
+import { libjxlStandaloneOverrides } from './libjxl-standalone-port.ts'
+import { createSelectedError } from './selected-error.ts'
+import { createSelectorCounts } from './selector-counts.ts'
+import { encodeTransplant } from './transplant.ts'
+
+const [root, shardText] = process.argv.slice(2)
+if (!root) throw new Error('Need output directory')
+await mkdir(root, { recursive: true })
+if (shardText === undefined) {
+  const outcomes = await Promise.all(
+    [0, 1, 2, 3].map(
+      (shard) =>
+        new Promise<void>((resolve, reject) => {
+          const child = spawn(process.execPath, [import.meta.filename, root, String(shard)], {
+            stdio: 'inherit',
+          })
+          child.once('error', reject)
+          child.once('exit', (code) =>
+            code === 0 ? resolve() : reject(new Error(`Audit shard ${shard} failed ${code}`)),
+          )
+        }),
+    ),
+  )
+  console.log(`Completed ${outcomes.length} development shards`)
+} else {
+  const shard = Number(shardText)
+  if (!Number.isInteger(shard) || shard < 0 || shard > 3) throw new Error('Bad shard')
+  const manifest = parsePreparedManifest(
+    JSON.parse(await readFile('.tmp/jpegxl-lossy-lab/corpus-512-v2/manifest.json', 'utf8')),
+  )
+  const fixtures = selectPreparedFixtures(manifest, { mode: 'lab' })
+  if (!fixtures.complete || fixtures.fixtures.length !== 64) throw new Error('Incomplete fixed lab')
+  const distances = [0.45, 0.65, 0.9, 1.3, 1.85, 3, 3.8, 5.35, 7.5]
+  const hash = (bytes: Uint8Array) => createHash('sha256').update(bytes).digest('hex')
+  for (const [index, f] of fixtures.fixtures.entries()) {
+    if (index % 4 !== shard) continue
+    const bytes = await readFile(f.png)
+    if (hash(bytes) !== f.fixtureSha256) throw new Error('Source hash changed')
+    const png = PNG.sync.read(bytes),
+      pixels = Uint8Array.from(png.data)
+    for (const distance of distances) {
+      const audit = createSelectedError(),
+        counts = createSelectorCounts()
+      const output = await encodeTransplant(
+        pixels,
+        png.width,
+        png.height,
+        distance,
+        libjxlStandaloneOverrides(distance, png.width, png.height, 'standalone-forward-all', {
+          writerResearch: { audit },
+          audit: counts,
+        }),
+      )
+      const saved = await readFile(
+        `.tmp/jpegxl-lossy-lab/standalone-reconstruction-20261017/forward-lab/standalone-forward-all-purejsimage/${f.id}-lab/${distance}.jxl`,
+      )
+      if (hash(output.bytes) !== hash(saved))
+        throw new Error(`Audit changed stream ${f.id}/${distance}`)
+      await writeFile(
+        `${root}/${f.id}-${distance}.json`,
+        JSON.stringify({
+          id: f.id,
+          distance,
+          pixels: png.width * png.height,
+          hash: hash(output.bytes),
+          error: Object.fromEntries(
+            Object.entries(audit).map(([key, value]) => [key, Array.from(value)]),
+          ),
+          counts: Object.fromEntries(
+            Object.entries(counts).map(([key, value]) => [key, Array.from(value)]),
+          ),
+        }) + '\n',
+        { flag: 'wx' },
+      )
+    }
+    console.log(f.id)
+  }
+}
