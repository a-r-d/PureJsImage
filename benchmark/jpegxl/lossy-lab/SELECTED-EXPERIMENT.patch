@@ -0,0 +1,73 @@
+import { spawnSync } from 'node:child_process'
+import { appendFileSync, closeSync, mkdirSync, openSync, readFileSync } from 'node:fs'
+import { number, object, string } from '../comparison/model.ts'
+
+const [root] = process.argv.slice(2)
+if (!root) throw new Error('Need output root')
+mkdirSync(root, { recursive: true })
+const modes = [
+  'standalone-forward-all',
+  'standalone-round-high',
+  'standalone-round-low',
+  'standalone-round-middle',
+  'standalone-round-weak',
+  'standalone-round-all',
+  'standalone-round-high-only',
+]
+for (const [index, mode] of modes.entries()) {
+  const out = `${root}/${mode}-screen`
+  mkdirSync(out)
+  const fd = openSync(`${out}/run.log`, 'wx')
+  const run = (args: string[]) => {
+    const r = spawnSync(process.execPath, args, { stdio: ['ignore', fd, fd] })
+    if (r.status !== 0) throw new Error(`Failed ${mode}: ${r.status}`)
+  }
+  console.log(`Starting ${mode}`)
+  run([
+    'benchmark/jpegxl/lossy-lab/run.ts',
+    '--manifest',
+    '.tmp/jpegxl-lossy-lab/corpus-512-v2/manifest.json',
+    '--out',
+    out,
+    '--mode',
+    'screen',
+    '--variant',
+    mode,
+    '--workers',
+    '4',
+    '--strategy-port',
+    mode,
+  ])
+  run([
+    'benchmark/jpegxl/lossy-lab/summarize-port.ts',
+    out,
+    `${root}/standalone-forward-all-screen/standalone-forward-all-purejsimage`,
+  ])
+  closeSync(fd)
+  const result = object(JSON.parse(readFileSync(`${out}/against-control.json`, 'utf8')))
+  if (
+    !Array.isArray(result.control) ||
+    !Array.isArray(result.peers) ||
+    !Array.isArray(result.failures) ||
+    result.failures.length
+  )
+    throw new Error('Invalid quality results')
+  const rates = (rows: unknown[]) =>
+    ['ssimulacra2', 'butteraugliNorm3', 'butteraugliMax']
+      .map((metric) => {
+        const row = rows.map(object).find((r) => r.metric === metric)
+        if (!row || number(row.count) !== 16) throw new Error('Incomplete metric')
+        return number(row.mean).toFixed(3)
+      })
+      .join('/')
+  const peers = result.peers
+  const control = rates(result.control),
+    peer = (name: string) => rates(peers.filter((v) => string(object(v).peer) === name))
+  const vips = peer('vips'),
+    jsquash = peer('jsquash')
+  console.log(JSON.stringify({ mode, control, vips, jsquash }))
+  appendFileSync(
+    'benchmark/jpegxl/lossy-lab-log.md',
+    `\n| LL-${957 + index}, 2026-10-28 | ${mode}: frequency-dependent emitted rounding with the retained selected transforms. | All 80 screen outputs decode and score. Control ${control}%; vips ${vips}%; jSquash ${jsquash}%. | Concurrent quality timings excluded. | Screen evidence; no holdout. Raw: selected-20261028/${mode}-screen. | measured |\n`,
+  )
+}
diff --git a/benchmark/jpegxl/lossy-lab/selected-error.ts b/benchmark/jpegxl/lossy-lab/selected-error.ts
new file mode 100644
index 00000000..358e326d
--- /dev/null
+++ b/benchmark/jpegxl/lossy-lab/selected-error.ts
@@ -0,0 +1,95 @@
+/** First-party coefficient-domain diagnostic; uses normative decoder centroids. */
+import { defaultJpegXlQuantizationBiases } from '../../../src/codecs/jpegxl-vardct-quantization.ts'
+
+export type FrequencyRounding = 'high' | 'low' | 'middle' | 'weak' | 'all' | 'high-only' | 'guarded'
+export interface SelectedError {
+  readonly count: Float64Array
+  readonly nonzero: Float64Array
+  readonly error: Float64Array
+  readonly avoidable: Float64Array
+  readonly signal: Float64Array
+}
+export interface WriterResearch {
+  readonly rounding?: FrequencyRounding
+  readonly audit?: SelectedError
+}
+export function createSelectedError(): SelectedError {
+  return {
+    count: new Float64Array(27 * 3 * 4),
+    nonzero: new Float64Array(27 * 3 * 4),
+    error: new Float64Array(27 * 3 * 4),
+    avoidable: new Float64Array(27 * 3 * 4),
+    signal: new Float64Array(27 * 3 * 4),
+  }
+}
+export function regularDct(strategy: number): boolean {
+  return (
+    strategy === 0 ||
+    strategy === 4 ||
+    strategy === 5 ||
+    strategy === 6 ||
+    strategy === 7 ||
+    strategy === 10 ||
+    strategy === 11 ||
+    strategy === 18 ||
+    strategy === 19 ||
+    strategy === 20
+  )
+}
+export function selectedFrequencyBand(p: number, width: number, height: number): number {
+  if (p === 0) return 0
+  const frequency = (p % width) / width + Math.floor(p / width) / height
+  return frequency <= 0.25 ? 1 : frequency <= 0.75 ? 2 : 3
+}
+export function decodedLevel(value: number, channel: number): number {
+  return value === 0
+    ? 0
+    : Math.abs(value) === 1
+      ? Math.sign(value) * (defaultJpegXlQuantizationBiases[channel] ?? 1)
+      : value - 0.145 / value
+}
+export function roundingShift(mode: FrequencyRounding, band: number, channel: number): number {
+  if (band === 0 || (channel !== 1 && mode !== 'all')) return 0
+  const strength = mode === 'weak' ? 0.04 : 0.08
+  if (mode === 'middle') return band === 2 ? strength : -strength / 2
+  if (mode === 'high-only' || mode === 'guarded') return band === 3 ? strength : 0
+  const direction = mode === 'low' ? -1 : 1
+  return direction * (band === 3 ? strength : band === 1 ? -strength : 0)
+}
+export function recordSelectedError(
+  audit: SelectedError,
+  strategy: number,
+  channel: number,
+  band: number,
+  source: number,
+  emitted: number,
+  step: number,
+  area: number,
+): void {
+  const at = (strategy * 3 + channel) * 4 + band
+  const weight = regularDct(strategy) ? area : 1
+  const error = (source - decodedLevel(emitted, channel)) ** 2
+  const magnitude = Math.abs(source),
+    lower = Math.floor(magnitude)
+  let best = error
+  for (let value = Math.max(0, lower - 1); value <= lower + 2; value++)
+    best = Math.min(best, (magnitude - decodedLevel(value, channel)) ** 2)
+  audit.count[at] = (audit.count[at] ?? 0) + 1
+  audit.nonzero[at] = (audit.nonzero[at] ?? 0) + (emitted !== 0 ? 1 : 0)
+  audit.error[at] = (audit.error[at] ?? 0) + error * step * step * weight
+  audit.avoidable[at] = (audit.avoidable[at] ?? 0) + (error - best) * step * step * weight
+  audit.signal[at] = (audit.signal[at] ?? 0) + source * source * step * step * weight
+}
+
+/** Accept a proposed higher precision token only when its decoded error falls. */
+export function guardRoundedCoefficient(
+  source: number,
+  original: number,
+  proposal: number,
+  channel: number,
+): number {
+  return (source - decodedLevel(proposal, channel)) ** 2 <
+    (source - decodedLevel(original, channel)) ** 2
+    ? proposal
+    : original
+}
