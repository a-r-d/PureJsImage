diff --git a/tests/jpegxl-perceptual-sampling.test.ts b/tests/jpegxl-perceptual-sampling.test.ts
new file mode 100644
index 00000000..5164cdfd
--- /dev/null
+++ b/tests/jpegxl-perceptual-sampling.test.ts
@@ -0,0 +1,61 @@
+import { expect, it } from 'vitest'
+import {
+  preparePerceptualImage,
+  perceptualQuadraticMaps,
+} from '../benchmark/jpegxl/lossy-lab/libjxl-perceptual-local-port.ts'
+import {
+  perceptualDirectionalMap,
+  maltaDirectionalCost,
+} from '../benchmark/jpegxl/lossy-lab/libjxl-perceptual-malta-port.ts'
+
+it('preserves complete metric inputs and values at sampled output locations', () => {
+  const width = 37,
+    height = 31,
+    a = new Uint8Array(width * height * 4),
+    b = a.slice()
+  for (let p = 0; p < width * height; p++)
+    for (let c = 0; c < 4; c++) {
+      a[p * 4 + c] = c === 3 ? 255 : (p * 7 + c * 31) % 256
+      b[p * 4 + c] = c === 3 ? 255 : (p * 7 + c * 31 + (p % 13 < 7 ? 11 : 0)) % 256
+    }
+  const source = preparePerceptualImage(a, width, height),
+    decoded = preparePerceptualImage(b, width, height)
+  for (const box of [undefined, { x: 7, y: 9, width: 29, height: 21 }]) {
+    const w = box?.width ?? width,
+      h = box?.height ?? height,
+      fullQ = perceptualQuadraticMaps(source, decoded, box),
+      full = perceptualDirectionalMap(source, decoded, fullQ.asymmetric, box)
+    for (const step of [2, 4, 8]) {
+      const sparseQ = perceptualQuadraticMaps(source, decoded, box, step),
+        sparse = perceptualDirectionalMap(source, decoded, sparseQ.asymmetric, box, step)
+      for (let y = 0; y < h; y++)
+        for (let x = 0; x < w; x++) {
+          const p = y * w + x,
+            sampled = x % step === 0 && y % step === 0
+          expect(sparse[p]).toBe(sampled ? full[p] : 0)
+          expect(sparseQ.asymmetric[p]).toBe(sampled ? fullQ.asymmetric[p] : 0)
+          expect(sparseQ.masked[p]).toBe(sampled ? fullQ.masked[p] : 0)
+          expect(sparseQ.unmasked[p]).toBe(sampled ? fullQ.unmasked[p] : 0)
+        }
+    }
+  }
+  for (const step of [0, 3, -1, Number.NaN]) {
+    expect(() => perceptualQuadraticMaps(source, decoded, undefined, step)).toThrow('sampling')
+    expect(() =>
+      perceptualDirectionalMap(source, decoded, new Float64Array(width * height), undefined, step),
+    ).toThrow('sampling')
+    expect(() =>
+      maltaDirectionalCost(
+        source.hf[0],
+        decoded.hf[0],
+        width,
+        height,
+        1,
+        5,
+        'low',
+        undefined,
+        step,
+      ),
+    ).toThrow('sampling')
+  }
+})
diff --git a/tests/jpegxl-coefficient-reuse.test.ts b/tests/jpegxl-coefficient-reuse.test.ts
new file mode 100644
index 00000000..ce9fda85
--- /dev/null
+++ b/tests/jpegxl-coefficient-reuse.test.ts
@@ -0,0 +1,80 @@
+import { expect, it } from 'vitest'
+import { libjxlPortOverrides } from '../benchmark/jpegxl/lossy-lab/libjxl-ports.ts'
+import { libjxlGaborishContext } from '../benchmark/jpegxl/lossy-lab/libjxl-gaborish-port.ts'
+import { rewriteStrategyGeometry } from '../benchmark/jpegxl/lossy-lab/strategy-transplant.ts'
+import { encodeTransplant } from '../benchmark/jpegxl/lossy-lab/transplant.ts'
+
+it('preserves the stream when reusing unaffected transforms across groups and odd edges', async () => {
+  const width = 263,
+    height = 73,
+    distance = 2,
+    pixels = Uint8Array.from({ length: width * height * 4 }, (_, i) =>
+      i % 4 === 3 ? 255 : (i * 7 + Math.floor(i / width) * 11) % 256,
+    ),
+    streams: Uint8Array[] = []
+  for (const reuse of [false, true]) {
+    const options = libjxlPortOverrides('standalone-forward-all', distance, width, height),
+      rewrite = options.rewriteGeometry
+    if (!rewrite) throw new Error('Missing selector')
+    const encoded = await encodeTransplant(pixels, width, height, distance, {
+      ...options,
+      rewriteGeometry(base, context) {
+        const g = rewrite(base, context),
+          memory = g.memory
+        if (!memory || !g.quantizationMap || !g.strategyMap || !g.developmentFirstBlocks)
+          throw new Error('Missing geometry')
+        const quantizationMap = memory.allocate(Int32Array, g.quantizationMap.length),
+          dcComponents = g.dcComponents.map((plane) => {
+            const coefficients = memory.allocate(Int32Array, plane.coefficients.length)
+            coefficients.set(plane.coefficients)
+            return { ...plane, coefficients }
+          }),
+          decisions = {
+            blocksWide: g.blocksWide,
+            blocksHigh: g.blocksHigh,
+            strategies: Array.from(g.strategyMap),
+            strategyFirstBlocks: Array.from(g.developmentFirstBlocks),
+          },
+          filtered = libjxlGaborishContext(g, context, width, height, true)
+        quantizationMap.set(g.quantizationMap)
+        for (let y = 0; y < g.blocksHigh; y++)
+          for (let x = 0; x < g.blocksWide; x++)
+            if (x < 8 || x >= 32) {
+              const p = y * g.blocksWide + x
+              quantizationMap[p] = Math.min(256, Math.round((quantizationMap[p] ?? 1) * 1.25))
+            }
+        const changed = { ...g, dcComponents, quantizationMap }
+        try {
+          if (reuse)
+            expect(() =>
+              rewriteStrategyGeometry(
+                { ...changed, globalScale: (g.globalScale ?? 1) + 1 },
+                filtered,
+                decisions,
+                true,
+                false,
+                true,
+                'all',
+                g,
+              ),
+            ).toThrow('identical coding')
+          return rewriteStrategyGeometry(
+            changed,
+            filtered,
+            decisions,
+            true,
+            false,
+            true,
+            'all',
+            reuse ? g : undefined,
+          )
+        } finally {
+          filtered.release()
+          memory.release(quantizationMap)
+        }
+      },
+    })
+    streams.push(encoded.bytes)
+  }
+  expect(streams[1]).toEqual(streams[0])
+}, 30000)
