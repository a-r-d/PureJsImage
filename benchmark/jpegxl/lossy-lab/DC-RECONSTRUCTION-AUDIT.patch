@@ -0,0 +1,87 @@
+// Read-only comparison with the pinned source. No new native algorithm is ported.
+import assert from 'node:assert/strict'
+import { execFile } from 'node:child_process'
+import { promisify } from 'node:util'
+import { readFile, writeFile } from 'node:fs/promises'
+import { createHash } from 'node:crypto'
+import { dctBasis, developmentDcGrid } from './transform-kernels.ts'
+const root = '.tmp/jpegxl-lossy-lab/dc-reconstruction-audit-20261103'
+const revision = 'a7a9c787341cf703dede03c2009fa460cae5e5df'
+const source = '.tmp/jpegxl-oracles/libjxl-v0.12.0/source'
+const files = [
+  'lib/jxl/enc_transforms-inl.h',
+  'lib/jxl/dec_transforms-inl.h',
+  'lib/jxl/dct_scales.h',
+  'lib/jxl/compressed_dc.cc',
+  'lib/jxl/quantizer.h',
+  'lib/jxl/enc_group.cc',
+]
+const verified = []
+for (const file of files) {
+  const bytes = await readFile(`${source}/${file}`)
+  const archived = await promisify(execFile)(
+    'tar',
+    [
+      '-xOf',
+      '.tmp/jpegxl-oracles/libjxl-v0.12.0/source-a7a9c787.tar.gz',
+      `libjxl-${revision}/${file}`,
+    ],
+    { maxBuffer: 1024 * 1024 },
+  )
+  assert.equal(bytes.toString(), archived.stdout)
+  verified.push({
+    file,
+    sha256: createHash('sha256').update(bytes).digest('hex'),
+    archiveExact: true,
+  })
+}
+const text = await readFile(`${source}/lib/jxl/dct_scales.h`, 'utf8')
+const scales = []
+for (const size of [1, 2, 4, 8]) {
+  const match = new RegExp(
+    `struct DCTResampleScales<${size * 8}, ${size}> \\{[\\s\\S]*?kScales\\[\\] = \\{([^}]+)\\}`,
+  ).exec(text)
+  if (!match?.[1]) throw new Error('Missing pinned resample table')
+  const native = match[1]
+    .split(',')
+    .map((v) => v.trim())
+    .filter(Boolean)
+    .map(Number)
+  assert.equal(native.length, size)
+  const basis = dctBasis(size)
+  for (let k = 0; k < size; k++)
+    for (const vertical of [false, true]) {
+      const coefficients = new Float64Array(size * 64),
+        dc = new Float64Array(size)
+      coefficients[k] = 1
+      developmentDcGrid(coefficients, vertical ? 1 : size, vertical ? size : 1, dc)
+      let gain = 0
+      for (let p = 0; p < size; p++)
+        gain += ((dc[p] ?? 0) * (basis[k * size + p] ?? 0)) / Math.sqrt(size)
+      const expected = native[k]
+      if (expected === undefined || !Number.isFinite(expected))
+        throw new Error('Invalid resample table')
+      assert.equal(Math.fround(gain), Math.fround(expected))
+      scales.push({
+        size,
+        k,
+        vertical,
+        gain,
+        source: expected,
+        absoluteDifference: Math.abs(gain - expected),
+        float32Equal: true,
+      })
+    }
+}
+await writeFile(
+  `${root}/source-checks.json`,
+  JSON.stringify({ passed: true, revision, verified, scales }, null, 2) + '\n',
+)
+console.log(
+  JSON.stringify({
+    passed: true,
+    sourceFiles: verified.length,
+    scaleCases: scales.length,
+    maxDifference: Math.max(...scales.map((r) => r.absoluteDifference)),
+  }),
+)
diff --git a/benchmark/jpegxl/lossy-lab/verify-dc-wire-helper.ts b/benchmark/jpegxl/lossy-lab/verify-dc-wire-helper.ts
new file mode 100644
--- /dev/null
+++ b/benchmark/jpegxl/lossy-lab/verify-dc-wire-helper.ts
@@ -0,0 +1,27 @@
+// First-party proposal: use the exact serialized DC matrix when quantizing DC.
+// This helper has unit coverage only; no new encoder configuration has run.
+import { JpegXlBitReader } from '../../../src/codecs/jpegxl-bitstream.ts'
+import { JpegXlBitWriter } from '../../../src/codecs/jpegxl-modular-encode.ts'
+import { writeJpegXlDevelopmentF16 } from '../../../src/codecs/jpegxl-jpeg-encode.ts'
+import {
+  type JpegXlEncoderMemory,
+  withJpegXlMemory,
+} from '../../../src/codecs/jpegxl-encoder-memory.ts'
+
+export function dcWireMatrix(
+  values: readonly number[],
+  memory?: JpegXlEncoderMemory,
+): readonly [number, number, number] {
+  if (values.length !== 3 || values.some((value) => !(value > 0) || !Number.isFinite(value)))
+    throw new Error('Invalid DC matrix')
+  return withJpegXlMemory(memory, () => {
+    const writer = new JpegXlBitWriter(memory, 6)
+    for (const value of values) writeJpegXlDevelopmentF16(writer, value * 128)
+    const reader = new JpegXlBitReader(writer.finish())
+    const read = (): number => {
+      const bits = reader.readBits(16)
+      return ((1 + (bits & 1023) / 1024) * 2 ** (((bits >>> 10) & 31) - 15)) / 128
+    }
+    return [read(), read(), read()]
+  })
+}
diff --git a/benchmark/jpegxl/lossy-lab/verify-dc-wire-matrix.ts b/benchmark/jpegxl/lossy-lab/verify-dc-wire-matrix.ts
new file mode 100644
--- /dev/null
+++ b/benchmark/jpegxl/lossy-lab/verify-dc-wire-matrix.ts
@@ -0,0 +1,156 @@
+import assert from 'node:assert/strict'
+import { readFile, writeFile } from 'node:fs/promises'
+import { dcWireMatrix } from './verify-dc-wire-helper.ts'
+import { JpegXlEncoderMemory } from '../../../src/codecs/jpegxl-encoder-memory.ts'
+import { JpegXlBitWriter } from '../../../src/codecs/jpegxl-modular-encode.ts'
+import { writeJpegXlDevelopmentF16 } from '../../../src/codecs/jpegxl-jpeg-encode.ts'
+import { object, number } from '../comparison/model.ts'
+import { libjxlPortOverrides } from '../../../.tmp/jpegxl-lossy-lab/block-allocation-20261103/ac125/libjxl-ports.ts'
+import { extractDecisions } from './decisions.ts'
+const root = '.tmp/jpegxl-lossy-lab/dc-reconstruction-audit-20261103'
+const memory = new JpegXlEncoderMemory(100000)
+for (const values of [
+  [],
+  [1, 2],
+  [1, 2, 3, 4],
+  [0, 1, 1],
+  [-1, 1, 1],
+  [NaN, 1, 1],
+  [Infinity, 1, 1],
+  [2 ** -22, 1, 1],
+  [512, 1, 1],
+])
+  assert.throws(() => dcWireMatrix(values, memory))
+for (const values of [
+  [2 ** -20, 2 ** -18, 2 ** -16],
+  [2 ** -12, 2 ** -9, 2 ** -8],
+  [2 ** -21, 511.75, 1],
+])
+  assert.deepEqual(dcWireMatrix(values, memory), values)
+const curve = object(
+  JSON.parse(
+    await readFile(
+      '.tmp/jpegxl-lossy-lab/block-allocation-20261103/ac125-lab/standalone-block-ac125-purejsimage/im26-3012-lab/result.json',
+      'utf8',
+    ),
+  ),
+)
+if (!Array.isArray(curve.points)) throw new Error('Missing ladder')
+interface MatrixRow {
+  distance: number
+  matrix: number[]
+  rounded: readonly [number, number, number]
+  wireExact: boolean
+  idempotent: boolean
+  relativeStepError: number[]
+}
+const rows: MatrixRow[] = []
+for (const item of curve.points) {
+  const point = object(item),
+    distance = number(point.setting)
+  const bytes = await readFile(
+    `.tmp/jpegxl-lossy-lab/block-allocation-20261103/ac125-lab/standalone-block-ac125-purejsimage/im26-3012-lab/${distance}.jxl`,
+  )
+  const decisions = await extractDecisions(bytes)
+  const requested = libjxlPortOverrides('standalone-block-ac125', distance, 512, 512).dc
+  if (!requested) throw new Error('Missing frozen policy')
+  const matrix = requested.quantization.map(
+    (q) =>
+      (((q * 65536) / requested.globalScale / requested.quantDc) *
+        decisions.globalScale *
+        decisions.quantDc) /
+      65536,
+  )
+  const rounded = dcWireMatrix(matrix, memory)
+  assert.deepEqual(rounded, decisions.dcQuantization)
+  assert.deepEqual(dcWireMatrix(rounded, memory), rounded)
+  const before = new JpegXlBitWriter(),
+    after = new JpegXlBitWriter()
+  for (const value of matrix) writeJpegXlDevelopmentF16(before, value * 128)
+  for (const value of rounded) writeJpegXlDevelopmentF16(after, value * 128)
+  assert.deepEqual(before.finish(), after.finish())
+  rows.push({
+    distance,
+    matrix,
+    rounded,
+    wireExact: true,
+    idempotent: true,
+    relativeStepError: rounded.map((v, c) => v / (matrix[c] ?? 0) - 1),
+  })
+}
+assert.equal(memory.liveBytes, 0)
+const peak = memory.peakBytes
+memory.close()
+const source = object(JSON.parse(await readFile(`${root}/reconstruction.json`, 'utf8')))
+if (!Array.isArray(source.rows)) throw new Error('Missing observations')
+const reconstruction = []
+for (const item of source.rows) {
+  const row = object(item)
+  if (typeof row.id !== 'string' || !Array.isArray(row.channels))
+    throw new Error('Invalid observed row')
+  const y = object(row.channels[1]),
+    path = object(y.source).path
+  if (typeof path !== 'string') throw new Error('Missing luma source')
+  const target = new Float32Array(Uint8Array.from(await readFile(path)).buffer)
+  const distance = number(row.distance),
+    id = row.id
+  const point = rows.find((row) => row.distance === distance)
+  if (!point) throw new Error('Missing matrix')
+  const requested = libjxlPortOverrides('standalone-block-ac125', distance, 512, 512).dc
+  if (!requested) throw new Error('Missing allocation')
+  const intended = (requested.quantization[1] * 65536) / requested.globalScale / requested.quantDc
+  const step = intended * (point.rounded[1] / (point.matrix[1] ?? 0))
+  let before = 0,
+    after = 0,
+    changed = 0,
+    maxError = 0
+  for (const value of target) {
+    const old = Math.round(value / intended),
+      next = Math.round(value / step)
+    const oldError = old - value / step,
+      newError = next - value / step
+    before += oldError * oldError
+    after += newError * newError
+    changed += Number(old !== next)
+    maxError = Math.max(maxError, Math.abs(newError))
+    assert.ok(newError * newError <= oldError * oldError + 1e-10)
+  }
+  assert.ok(maxError <= 0.5)
+  reconstruction.push({
+    id,
+    distance,
+    samples: target.length,
+    beforeSquared: before,
+    afterSquared: after,
+    ratio: after / before,
+    changed,
+    maxError,
+  })
+}
+await writeFile(
+  `${root}/wire-checks.json`,
+  JSON.stringify(
+    {
+      passed: true,
+      invalidCases: 9,
+      exactMatrixCases: 3,
+      ladderCases: rows.length,
+      managedPeakBytes: peak,
+      liveBytesAfter: 0,
+      rows,
+      reconstruction,
+      policy:
+        'Only the rounding helper and scalar luma quantization arithmetic were tested. No encoded candidate, new quality configuration or measured BD-rate. The proposal preserves the serialized DC matrix and aligns the quantizer with it.',
+    },
+    null,
+    2,
+  ) + '\n',
+)
+console.log(
+  JSON.stringify({
+    passed: true,
+    ladderCases: rows.length,
+    managedPeakBytes: peak,
+    reconstruction,
+  }),
+)
