+import { readFile, writeFile, readdir, mkdir } from 'node:fs/promises'
+import { resolve, dirname } from 'node:path'
+const root = resolve('.tmp/jpegxl-lossy-lab/dc-reconstruction-audit-20261103')
+const frozen = resolve('.tmp/jpegxl-lossy-lab/dc-completion-20261103/prototype')
+await mkdir(`${root}/prototype`, { recursive: true })
+const observerSource = resolve(process.argv[2] ?? `${root}/prototype/dc-observer.ts`)
+const observer = (await readFile(observerSource, 'utf8')).replace(
+  /from (['"])(\.[^'"]+)\1/gu,
+  (_all: string, quote: string, path: string) =>
+    `from ${quote}${resolve(dirname(observerSource), path)}${quote}`,
+)
+for (const file of await readdir(frozen)) {
+  if (!file.endsWith('.ts')) continue
+  let code = (await readFile(`${frozen}/${file}`, 'utf8')).replaceAll(frozen, `${root}/prototype`)
+  if (file === 'strategy-transplant.ts') {
+    code = code.replace(
+      ' */\n',
+      " * Diagnostic copy: observe source DC and transform roundtrip errors only.\n */\nimport {captureDcSource,recordDcRoundtrip} from '../../../.tmp/jpegxl-lossy-lab/dc-reconstruction-audit-20261103/dc-observer.ts'\n",
+    )
+    const a = '              developmentDcGrid(result, bw, bh, dc)'
+    const b = '  libjxlQuantizeDc(base, rawDc)'
+    if (!code.includes(a) || !code.includes(b)) throw new Error('Missing observation points')
+    code = code.replace(a, a + '\n              recordDcRoundtrip(strategy,c,bw,bh,result,dc)')
+    code = code.replace(b, '  captureDcSource(base, rawDc, strategies, firstBlocks)\n' + b)
+  }
+  await writeFile(`${root}/prototype/${file}`, code)
+}
+await writeFile(`${root}/prototype/dc-observer.ts`, observer)
+await writeFile(
+  `${root}/tsconfig.json`,
+  JSON.stringify({
+    extends: '../../../tsconfig.json',
+    include: ['*.ts', 'prototype/*.ts'],
+    exclude: [],
+  }) + '\n',
+)
+console.log('Prepared first-party observation copy of frozen coupled DC mode')
diff --git a/benchmark/jpegxl/lossy-lab/dc-reconstruction-observer.ts b/benchmark/jpegxl/lossy-lab/dc-reconstruction-observer.ts
new file mode 100644
--- /dev/null
+++ b/benchmark/jpegxl/lossy-lab/dc-reconstruction-observer.ts
@@ -0,0 +1,95 @@
+// First-party diagnostic only. Observe existing values without changing decisions.
+import type { VarDctCoefficientGeometry } from '../../../.tmp/jpegxl-lossy-lab/dc-reconstruction-audit-20261103/prototype/jpegxl-jpeg-encode.ts'
+import { populateJpegXlDevelopmentLowestFrequencies } from '../../../src/codecs/jpegxl-vardct-render.ts'
+interface ErrorStat {
+  count: number
+  maxAbsolute: number
+  squared: number
+  sourceSquared: number
+}
+const stat = (): ErrorStat => ({ count: 0, maxAbsolute: 0, squared: 0, sourceSquared: 0 })
+function add(s: ErrorStat, actual: number, expected: number): void {
+  const delta = actual - expected
+  s.count++
+  s.maxAbsolute = Math.max(s.maxAbsolute, Math.abs(delta))
+  s.squared += delta * delta
+  s.sourceSquared += expected * expected
+}
+interface Roundtrip {
+  strategy: number
+  channel: number
+  blocks: number
+  exact: ErrorStat
+  floatGrid: ErrorStat
+}
+export interface SourceSnapshot {
+  width: number
+  height: number
+  planes: Float32Array[]
+  strategies: Int32Array
+  firstBlocks: Uint8Array
+  dcQuantization: readonly number[]
+  globalScale: number
+  quantDc: number
+}
+let snapshot: SourceSnapshot | undefined
+let captures = 0
+const roundtrips = new Map<string, Roundtrip>()
+const recovered = new Float64Array(4096),
+  recoveredFloat = new Float64Array(4096)
+const grid = new Float64Array(64),
+  scratch = new Float64Array(64)
+export function resetDcObserver(): void {
+  snapshot = undefined
+  captures = 0
+  roundtrips.clear()
+}
+export function recordDcRoundtrip(
+  strategy: number,
+  channel: number,
+  bw: number,
+  bh: number,
+  coefficients: Float64Array,
+  dc: Float64Array,
+): void {
+  const key = `${strategy}/${channel}`
+  let row = roundtrips.get(key)
+  if (!row) {
+    row = { strategy, channel, blocks: 0, exact: stat(), floatGrid: stat() }
+    roundtrips.set(key, row)
+  }
+  row.blocks++
+  populateJpegXlDevelopmentLowestFrequencies(recovered, dc, bw, bh, scratch)
+  for (let i = 0; i < bw * bh; i++) grid[i] = Math.fround(dc[i] ?? 0)
+  populateJpegXlDevelopmentLowestFrequencies(recoveredFloat, grid, bw, bh, scratch)
+  for (let y = 0; y < bh; y++)
+    for (let x = 0; x < bw; x++) {
+      const i = bh >= bw ? x * bh * 8 + y : y * bw * 8 + x
+      add(row.exact, recovered[i] ?? 0, coefficients[i] ?? 0)
+      add(row.floatGrid, recoveredFloat[i] ?? 0, coefficients[i] ?? 0)
+    }
+}
+export function captureDcSource(
+  base: VarDctCoefficientGeometry,
+  planes: readonly Float32Array[],
+  strategies: Int32Array,
+  firstBlocks: Uint8Array,
+): void {
+  if (!base.dcQuantization || !base.globalScale || !base.quantDc)
+    throw new Error('Missing DC scale')
+  captures++
+  snapshot = {
+    width: base.blocksWide,
+    height: base.blocksHigh,
+    planes: planes.map((p) => p.slice()),
+    strategies: strategies.slice(),
+    firstBlocks: firstBlocks.slice(),
+    dcQuantization: [...base.dcQuantization],
+    globalScale: base.globalScale,
+    quantDc: base.quantDc,
+  }
+}
+export function readDcObserver() {
+  if (!snapshot || captures !== 1) throw new Error(`Expected one source capture, got ${captures}`)
+  return { snapshot, roundtrips: [...roundtrips.values()] }
+}
diff --git a/benchmark/jpegxl/lossy-lab/audit-dc-reconstruction.ts b/benchmark/jpegxl/lossy-lab/audit-dc-reconstruction.ts
new file mode 100644
--- /dev/null
+++ b/benchmark/jpegxl/lossy-lab/audit-dc-reconstruction.ts
@@ -0,0 +1,247 @@
+import assert from 'node:assert/strict'
+import { readFile, writeFile, mkdir } from 'node:fs/promises'
+import { createHash } from 'node:crypto'
+import { PNG } from 'pngjs'
+import { encodeTransplant } from '../../../.tmp/jpegxl-lossy-lab/dc-reconstruction-audit-20261103/prototype/transplant.ts'
+import { libjxlPortOverrides } from '../../../.tmp/jpegxl-lossy-lab/dc-reconstruction-audit-20261103/prototype/libjxl-ports.ts'
+import { resetDcObserver, readDcObserver } from './dc-reconstruction-observer.ts'
+import {
+  inspectJpegXlSource,
+  JpegXlCodestreamSource,
+} from '../../../src/codecs/jpegxl-container.ts'
+import { readJpegXlSourceFrameStructures } from '../../../src/codecs/jpegxl-decode.ts'
+import { prepareJpegXlVarDctLowFrequency } from '../../../src/codecs/jpegxl-vardct-render.ts'
+import { JpegXlVarDctMemoryLedger } from '../../../src/codecs/jpegxl-vardct-memory.ts'
+import {
+  jpegXlVarDctStrategyBlockWidths,
+  jpegXlVarDctStrategyBlockHeights,
+} from '../../../src/codecs/jpegxl-vardct-jpeg.ts'
+import { resolveJpegXlLimits } from '../../../src/codecs/jpegxl-limits.ts'
+import { defaultImageLimits } from '../../../src/limits.ts'
+import { MemorySource } from '../../../src/source.ts'
+const root = '.tmp/jpegxl-lossy-lab/dc-reconstruction-audit-20261103'
+const frozen = '.tmp/jpegxl-lossy-lab/dc-completion-20261103'
+const previous = '.tmp/jpegxl-lossy-lab/dc-quantization-20261103'
+const hash = (bytes: Uint8Array) => createHash('sha256').update(bytes).digest('hex')
+function assertValues(a: ArrayLike<number>, b: ArrayLike<number>): void {
+  assert.equal(a.length, b.length)
+  for (let i = 0; i < a.length; i++) assert.equal(a[i], b[i])
+}
+assertValues(Uint8Array.of(0, 1, 255), Int32Array.of(0, 1, 255))
+assert.throws(() => assertValues(Uint8Array.of(0, 1), Int32Array.of(0, 2)))
+interface ErrorStat {
+  count: number
+  beforeSquared: number
+  afterSquared: number
+  shiftSquared: number
+  crossTerm: number
+  beforeAbsMax: number
+  afterAbsMax: number
+  changed: number
+  improved: number
+  worsened: number
+}
+const newStat = (): ErrorStat => ({
+  count: 0,
+  beforeSquared: 0,
+  afterSquared: 0,
+  shiftSquared: 0,
+  crossTerm: 0,
+  beforeAbsMax: 0,
+  afterAbsMax: 0,
+  changed: 0,
+  improved: 0,
+  worsened: 0,
+})
+function add(stat: ErrorStat, before: number, after: number): void {
+  const shift = after - before
+  stat.count++
+  stat.beforeSquared += before * before
+  stat.afterSquared += after * after
+  stat.shiftSquared += shift * shift
+  stat.crossTerm += 2 * before * shift
+  stat.beforeAbsMax = Math.max(stat.beforeAbsMax, Math.abs(before))
+  stat.afterAbsMax = Math.max(stat.afterAbsMax, Math.abs(after))
+  if (Math.abs(shift) > 1e-12) {
+    stat.changed++
+    if (after * after < before * before) stat.improved++
+    else if (after * after > before * before) stat.worsened++
+  }
+}
+async function decode(bytes: Uint8Array) {
+  const source = new MemorySource(bytes),
+    logical = new JpegXlCodestreamSource(
+      source,
+      await inspectJpegXlSource(source, resolveJpegXlLimits()),
+    )
+  const frame = (await readJpegXlSourceFrameStructures(logical, defaultImageLimits)).at(-1)
+  if (!frame) throw new Error('Missing frame')
+  const sections = await Promise.all(frame.sections.map((s) => logical.read(s.offset, s.length)))
+  return prepareJpegXlVarDctLowFrequency(
+    sections,
+    frame,
+    new JpegXlVarDctMemoryLedger(defaultImageLimits.maxDecodedBytes),
+  )
+}
+await mkdir(`${root}/sources`, { recursive: true })
+const rows = []
+for (const id of ['im26-2004', 'im26-3012', 'im26-3312']) {
+  const input = PNG.sync.read(await readFile(`.tmp/jpegxl-lossy-lab/corpus-512-v2/${id}.png`))
+  const pixels = Uint8Array.from(input.data)
+  for (const distance of [0.45, 1.85, 7.5]) {
+    resetDcObserver()
+    const encoded = await encodeTransplant(
+      pixels,
+      input.width,
+      input.height,
+      distance,
+      libjxlPortOverrides('standalone-dc-complete', distance, input.width, input.height),
+    )
+    const expected = await readFile(
+      `${frozen}/lab/standalone-dc-complete-purejsimage/${id}-lab/${distance}.jxl`,
+    )
+    assertValues(encoded.bytes, expected)
+    const observed = readDcObserver(),
+      snapshot = observed.snapshot
+    const before = await decode(
+      await readFile(
+        `${previous}/lab/standalone-dc-nonlinear-purejsimage/${id}-lab/${distance}.jxl`,
+      ),
+    )
+    const after = await decode(expected)
+    try {
+      assert.deepEqual(before.dcGroup.dcCoefficients, after.dcGroup.dcCoefficients)
+      assertValues(snapshot.strategies, after.dcGroup.strategies)
+      assertValues(snapshot.firstBlocks, after.dcGroup.strategyFirstBlocks)
+      const width = snapshot.width,
+        height = snapshot.height
+      const owners = new Int32Array(width * height).fill(-1)
+      for (let y = 0; y < height; y++)
+        for (let x = 0; x < width; x++) {
+          const at = y * width + x
+          if (snapshot.firstBlocks[at] !== 1) continue
+          const strategy = snapshot.strategies[at] ?? -1,
+            bw = jpegXlVarDctStrategyBlockWidths[strategy] ?? 0,
+            bh = jpegXlVarDctStrategyBlockHeights[strategy] ?? 0
+          if (bw < 1 || bh < 1 || x + bw > width || y + bh > height)
+            throw new Error('Invalid selected footprint')
+          for (let dy = 0; dy < bh; dy++)
+            for (let dx = 0; dx < bw; dx++) {
+              const i = (y + dy) * width + x + dx
+              assert.equal(owners[i], -1)
+              owners[i] = at
+            }
+        }
+      assert.ok(owners.every((owner) => owner >= 0))
+      const channels = []
+      for (let c = 0; c < 3; c++) {
+        const src = snapshot.planes[c],
+          y = snapshot.planes[1],
+          a = before.dcPlanes[c],
+          b = after.dcPlanes[c]
+        if (!src || !y || !a || !b) throw new Error('Missing DC plane')
+        const target =
+          c === 2 ? Float32Array.from(src, (v, i) => Math.fround(v + (y[i] ?? 0))) : src
+        const step =
+          (65536 / after.lfGlobal.globalScale / after.lfGlobal.quantDc) *
+          (after.lfGlobal.dcQuantization[c] ?? 0)
+        const intendedStep =
+          (65536 / snapshot.globalScale / snapshot.quantDc) * (snapshot.dcQuantization[c] ?? 0)
+        if (!(step > 0)) throw new Error('Invalid decoded step')
+        const total = newStat(),
+          byStrategy = new Map<number, ErrorStat>(),
+          byRegion = new Map<string, ErrorStat>()
+        for (let i = 0; i < target.length; i++) {
+          const x = i % width,
+            y = Math.floor(i / width),
+            strategy = snapshot.strategies[i] ?? -1
+          const region =
+            x === 0 || y === 0 || x === width - 1 || y === height - 1
+              ? 'image-edge'
+              : [
+                    i - 1,
+                    i + 1,
+                    i - width,
+                    i + width,
+                    i - width - 1,
+                    i - width + 1,
+                    i + width - 1,
+                    i + width + 1,
+                  ].every((n) => owners[n] === owners[i])
+                ? 'transform-interior'
+                : 'transform-boundary'
+          const old = ((a[i] ?? 0) - (target[i] ?? 0)) / step,
+            next = ((b[i] ?? 0) - (target[i] ?? 0)) / step
+          add(total, old, next)
+          let strategyStat = byStrategy.get(strategy)
+          if (!strategyStat) {
+            strategyStat = newStat()
+            byStrategy.set(strategy, strategyStat)
+          }
+          add(strategyStat, old, next)
+          let regionStat = byRegion.get(region)
+          if (!regionStat) {
+            regionStat = newStat()
+            byRegion.set(region, regionStat)
+          }
+          add(regionStat, old, next)
+        }
+        const path = `${root}/sources/${id}-${distance}-${c}.f32`
+        const raw = new Uint8Array(target.buffer, target.byteOffset, target.byteLength)
+        await writeFile(path, raw)
+        channels.push({
+          channel: c,
+          step,
+          intendedStep,
+          relativeStepError: step / intendedStep - 1,
+          total,
+          byStrategy: [...byStrategy].map(([strategy, errors]) => ({ strategy, errors })),
+          byRegion: [...byRegion].map(([region, errors]) => ({ region, errors })),
+          source: { path, sha256: hash(raw) },
+        })
+      }
+      const row = {
+        id,
+        distance,
+        width: input.width,
+        height: input.height,
+        hash: hash(expected),
+        outputExact: true,
+        channels,
+        roundtrips: observed.roundtrips,
+      }
+      rows.push(row)
+      console.log(
+        JSON.stringify({
+          id,
+          distance,
+          exact: true,
+          channels: channels.map((c) => ({
+            channel: c.channel,
+            stepError: c.relativeStepError,
+            changed: c.total.changed,
+            mseRatio: c.total.afterSquared / c.total.beforeSquared,
+          })),
+          maxRoundtrip: Math.max(...observed.roundtrips.map((r) => r.exact.maxAbsolute)),
+        }),
+      )
+    } finally {
+      before.release()
+      after.release()
+    }
+  }
+}
+await writeFile(
+  `${root}/reconstruction.json`,
+  JSON.stringify(
+    {
+      passed: true,
+      points: rows.length,
+      rows,
+      policy:
+        'Observe the frozen coupled-DC mode on nine existing development points. All encoded bytes must equal saved native-valid streams. No new decisions, quality configuration, scoring, peer replay or holdout access. Errors use selected-transform source DC and decoded nominal DC-step units. B is restored from source B-Y with the quantizer float32 boundary. Timing and memory are not performance measurements.',
+    },
+    null,
+    2,
+  ) + '\n',
+)
diff --git a/benchmark/jpegxl/lossy-lab/audit-dc-matrix.ts b/benchmark/jpegxl/lossy-lab/audit-dc-matrix.ts
new file mode 100644
--- /dev/null
+++ b/benchmark/jpegxl/lossy-lab/audit-dc-matrix.ts
@@ -0,0 +1,182 @@
+import assert from 'node:assert/strict'
+import { readFile, writeFile } from 'node:fs/promises'
+import { object, number } from '../comparison/model.ts'
+import {
+  inspectJpegXlSource,
+  JpegXlCodestreamSource,
+} from '../../../src/codecs/jpegxl-container.ts'
+import { readJpegXlSourceFrameStructures } from '../../../src/codecs/jpegxl-decode.ts'
+import { prepareJpegXlVarDctLowFrequency } from '../../../src/codecs/jpegxl-vardct-render.ts'
+import { JpegXlVarDctMemoryLedger } from '../../../src/codecs/jpegxl-vardct-memory.ts'
+import { resolveJpegXlLimits } from '../../../src/codecs/jpegxl-limits.ts'
+import { defaultImageLimits } from '../../../src/limits.ts'
+import { MemorySource } from '../../../src/source.ts'
+import { libjxlPortOverrides as ac125Overrides } from '../../../.tmp/jpegxl-lossy-lab/block-allocation-20261103/ac125/libjxl-ports.ts'
+const root = '.tmp/jpegxl-lossy-lab/dc-reconstruction-audit-20261103'
+const mode = process.argv[2] ?? 'nonlinear'
+if (mode !== 'nonlinear' && mode !== 'ac125') throw new Error('Saved-stream audit mode only')
+const input = object(JSON.parse(await readFile(`${root}/reconstruction.json`, 'utf8')))
+if (!Array.isArray(input.rows)) throw new Error('Missing numerical audit')
+async function decode(path: string) {
+  const source = new MemorySource(await readFile(path)),
+    logical = new JpegXlCodestreamSource(
+      source,
+      await inspectJpegXlSource(source, resolveJpegXlLimits()),
+    )
+  const frame = (await readJpegXlSourceFrameStructures(logical, defaultImageLimits)).at(-1)
+  if (!frame) throw new Error('Missing frame')
+  const sections = await Promise.all(frame.sections.map((s) => logical.read(s.offset, s.length)))
+  return prepareJpegXlVarDctLowFrequency(
+    sections,
+    frame,
+    new JpegXlVarDctMemoryLedger(defaultImageLimits.maxDecodedBytes),
+  )
+}
+const rows = []
+for (const item of input.rows) {
+  const row = object(item)
+  if (typeof row.id !== 'string' || !Array.isArray(row.channels)) throw new Error('Invalid point')
+  const distance = number(row.distance),
+    id = row.id
+  const channels = row.channels.map(object)
+  const state = await decode(
+    mode === 'nonlinear'
+      ? `.tmp/jpegxl-lossy-lab/dc-quantization-20261103/lab/standalone-dc-nonlinear-purejsimage/${id}-lab/${distance}.jxl`
+      : `.tmp/jpegxl-lossy-lab/block-allocation-20261103/ac125-lab/standalone-block-ac125-purejsimage/${id}-lab/${distance}.jxl`,
+  )
+  try {
+    const control = await decode(
+      `.tmp/jpegxl-lossy-lab/dc-completion-20261103/lab/standalone-dc-complete-purejsimage/${id}-lab/${distance}.jxl`,
+    )
+    try {
+      assert.deepEqual(state.dcGroup.strategies, control.dcGroup.strategies)
+      assert.deepEqual(state.dcGroup.strategyFirstBlocks, control.dcGroup.strategyFirstBlocks)
+      assert.deepEqual(state.dcGroup.quantization, control.dcGroup.quantization)
+    } finally {
+      control.release()
+    }
+    const dc = ac125Overrides(
+      'standalone-block-ac125',
+      distance,
+      number(row.width),
+      number(row.height),
+    ).dc
+    if (!dc) throw new Error('Missing frozen AC125 DC policy')
+    const intended =
+      mode === 'nonlinear'
+        ? channels.map((c) => number(c.intendedStep))
+        : dc.quantization.map((q) => (q * 65536) / dc.globalScale / dc.quantDc)
+    const y = state.dcGroup.dcCoefficients[0]
+    if (!y) throw new Error('Missing Y')
+    const matrix = []
+    for (let c = 0; c < 3; c++) {
+      const channel = channels[c],
+        q = state.dcGroup.dcCoefficients[c < 2 ? c ^ 1 : c],
+        actual = state.dcPlanes[c]
+      if (!channel || !q || !actual) throw new Error('Missing plane')
+      const source = object(channel.source)
+      if (typeof source.path !== 'string') throw new Error('Missing source')
+      const bytes = Uint8Array.from(await readFile(source.path))
+      assert.equal(bytes.length % 4, 0)
+      const target = new Float32Array(bytes.buffer)
+      const corr = state.lfGlobal.colorCorrelation
+      const factor =
+        c === 0
+          ? corr.baseCorrelationX + corr.yToXDc / corr.colorFactor
+          : c === 2
+            ? corr.baseCorrelationB + corr.yToBDc / corr.colorFactor
+            : 0
+      let quantSquared = 0,
+        wireSquared = 0,
+        scaleSquared = 0,
+        crossTerm = 0,
+        scaleBias = 0,
+        scaleMax = 0
+      const step =
+        (65536 / state.lfGlobal.globalScale / state.lfGlobal.quantDc) *
+        (state.lfGlobal.dcQuantization[c] ?? 0)
+      for (let i = 0; i < target.length; i++) {
+        const own =
+          (q[i] ?? 0) * (intended[c] ?? 0) +
+          (c === 1 ? 0 : (y[i] ?? 0) * (intended[1] ?? 0) * factor)
+        const quantError = (own - (target[i] ?? 0)) / step,
+          wireError = ((actual[i] ?? 0) - (target[i] ?? 0)) / step,
+          scaleError = ((actual[i] ?? 0) - own) / step
+        quantSquared += quantError * quantError
+        wireSquared += wireError * wireError
+        scaleSquared += scaleError * scaleError
+        crossTerm += 2 * quantError * scaleError
+        scaleBias += scaleError / target.length
+        scaleMax = Math.max(scaleMax, Math.abs(scaleError))
+      }
+      assert.ok(Math.abs(wireSquared - quantSquared - scaleSquared - crossTerm) < 1e-7)
+      matrix.push({
+        channel: c,
+        samples: target.length,
+        step,
+        intendedStep: intended[c],
+        relativeStepError: step / (intended[c] ?? 0) - 1,
+        quantSquared,
+        wireSquared,
+        scaleSquared,
+        crossTerm,
+        scaleBias,
+        scaleMax,
+        wireToIntendedMse: wireSquared / quantSquared,
+      })
+    }
+    const curve = object(
+      JSON.parse(
+        await readFile(
+          `.tmp/jpegxl-lossy-lab/dc-completion-20261103/lab/standalone-dc-complete-purejsimage/${id}-lab/result.json`,
+          'utf8',
+        ),
+      ),
+    )
+    if (typeof curve.fixtureSha256 !== 'string') throw new Error('Missing fixture identity')
+    const native = await decode(
+      `.tmp/jpegxl-lossy-lab/peer-cache/vips-0.0.19-curve/${curve.fixtureSha256}/${distance}.jxl`,
+    )
+    try {
+      rows.push({
+        id,
+        distance,
+        matrix,
+        nativeDcMatrix: native.lfGlobal.dcQuantization,
+        nativeGlobalScale: native.lfGlobal.globalScale,
+        nativeQuantDc: native.lfGlobal.quantDc,
+      })
+    } finally {
+      native.release()
+    }
+    console.log(
+      JSON.stringify({
+        id,
+        distance,
+        channels: matrix.map((m) => ({
+          c: m.channel,
+          mseRatio: m.wireToIntendedMse,
+          biasInDcSteps: m.scaleBias,
+          maxInDcSteps: m.scaleMax,
+        })),
+      }),
+    )
+  } finally {
+    state.release()
+  }
+}
+await writeFile(
+  `${root}/matrix-${mode}.json`,
+  JSON.stringify(
+    {
+      passed: true,
+      mode,
+      points: rows.length,
+      rows,
+      policy:
+        'Read-only arithmetic decomposition of saved DC coefficients. Intended-grid reconstruction is a diagnostic, not an encoded candidate or measured quality gain. Uses the same quantized integers; re-quantizing with signaled steps has not been tried. No quality or holdout run.',
+    },
+    null,
+    2,
+  ) + '\n',
+)
