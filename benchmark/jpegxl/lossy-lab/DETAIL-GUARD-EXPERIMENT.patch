diff --git a/benchmark/jpegxl/lossy-lab/libjxl-selector-detail-loss.ts b/benchmark/jpegxl/lossy-lab/libjxl-selector-detail-loss.ts
new file mode 100644
index 00000000..2b1b5621
--- /dev/null
+++ b/benchmark/jpegxl/lossy-lab/libjxl-selector-detail-loss.ts
@@ -0,0 +1,65 @@
+/**
+ * Source: libjxl tools/ssimulacra2.cc, SSIMMap, v0.12.0,
+ * a7a9c787341cf703dede03c2009fa460cae5e5df.
+ * Copyright (c) the JPEG XL Project Authors. BSD-3-Clause
+ * Changes: the regularized mode reuses the structure denominator and 0.0009
+ * stabilizer. First-party 8x8 box moments on preconditioned luma replace Gaussian
+ * display moments; DC, other channels, scales and edge terms are excluded.
+ * Contrast-only and unregularized modes are first-party diagnostic alternatives.
+ * No peer decisions. This is not a metric implementation or public encoder.
+ */
+export function selectorDetailLoss(
+  source: Float32Array,
+  error: Float32Array,
+  width: number,
+  height: number,
+  scale: number,
+  kind: 'contrast' | 'structure' | 'regularized' | 'lost-detail',
+): number {
+  let total = 0
+  for (let by = 0; by < height; by += 8)
+    for (let bx = 0; bx < width; bx += 8) {
+      let sum = 0,
+        sumError = 0,
+        square = 0,
+        squareError = 0,
+        cross = 0
+      for (let y = 0; y < 8; y++)
+        for (let x = 0; x < 8; x++) {
+          const at = (by + y) * width + bx + x
+          const value = source[at] ?? 0
+          const residual = (error[at] ?? 0) * scale
+          sum += value
+          sumError += residual
+          square += value * value
+          squareError += residual * residual
+          cross += value * residual
+        }
+      const variance = Math.max(0, square - (sum * sum) / 64)
+      const errorVariance = Math.max(0, squareError - (sumError * sumError) / 64)
+      const covariance = cross - (sum * sumError) / 64
+      const reconstructed = Math.max(0, variance + errorVariance - 2 * covariance)
+      if (kind === 'lost-detail') {
+        // First-party asymmetric residual: only locally removed detail matters.
+        // Normalize by error energy so flat offsets and added contrast contribute zero.
+        let lostEnergy = 0
+        for (let y = 0; y < 8; y++)
+          for (let x = 0; x < 8; x++) {
+            const at = (by + y) * width + bx + x
+            const centered = (source[at] ?? 0) - sum / 64
+            const residual = (error[at] ?? 0) * scale - sumError / 64
+            const lost = Math.max(0, Math.abs(centered) - Math.abs(centered - residual))
+            lostEnergy += lost * lost
+          }
+        total += Math.sqrt(Math.min(1, lostEnergy / Math.max(errorVariance, 64e-8)))
+        continue
+      }
+      // Stabilize flat cells in the physical XYB scale; DC offsets are excluded.
+      const epsilon = kind === 'regularized' ? 64 * 0.0009 : 64e-8
+      total +=
+        kind === 'contrast'
+          ? Math.max(0, 1 - Math.sqrt((reconstructed + epsilon) / (variance + epsilon)))
+          : Math.min(1, errorVariance / (variance + reconstructed + epsilon))
+    }
+  return total / ((width * height) / 64)
+}
diff --git a/tests/jpegxl-selector-detail-loss.test.ts b/tests/jpegxl-selector-detail-loss.test.ts
new file mode 100644
index 00000000..a2da7c89
--- /dev/null
+++ b/tests/jpegxl-selector-detail-loss.test.ts
@@ -0,0 +1,55 @@
+import { expect, it } from 'vitest'
+import { selectorDetailLoss } from '../benchmark/jpegxl/lossy-lab/libjxl-selector-detail-loss.ts'
+
+const source = Float32Array.from({ length: 64 }, (_, i) => 0.5 + (i % 8) / 32)
+const mean = source.reduce((a, b) => a + b) / 64
+
+it.each(['contrast', 'structure', 'lost-detail'] as const)(
+  'ignores identity and DC shifts for %s',
+  (kind) => {
+    expect(selectorDetailLoss(source, new Float32Array(64), 8, 8, 1, kind)).toBe(0)
+    expect(selectorDetailLoss(source, new Float32Array(64).fill(0.125), 8, 8, 1, kind)).toBe(0)
+  },
+)
+
+it('penalizes removed contrast without penalizing increased contrast', () => {
+  const removed = Float32Array.from(source, (value) => (value - mean) / 2)
+  const increased = Float32Array.from(removed, (value) => -value)
+  expect(selectorDetailLoss(source, removed, 8, 8, 1, 'contrast')).toBeCloseTo(0.5, 5)
+  expect(selectorDetailLoss(source, increased, 8, 8, 1, 'contrast')).toBe(0)
+  expect(selectorDetailLoss(source, removed, 8, 8, 2, 'contrast')).toBeGreaterThan(0.99)
+})
+
+it('detects phase error even when contrast is preserved', () => {
+  const inverted = Float32Array.from(source, (value) => 2 * (value - mean))
+  expect(selectorDetailLoss(source, inverted, 8, 8, 1, 'contrast')).toBe(0)
+  expect(selectorDetailLoss(source, inverted, 8, 8, 1, 'structure')).toBe(1)
+})
+
+it('pools individual cells and stays finite on flat cells', () => {
+  const pixels = new Float32Array(128).fill(0.5)
+  const errors = new Float32Array(128)
+  for (let y = 0; y < 8; y++)
+    for (let x = 0; x < 8; x++) {
+      pixels[y * 16 + x] = source[y * 8 + x] ?? 0
+      errors[y * 16 + x] = ((source[y * 8 + x] ?? 0) - mean) / 2
+    }
+  expect(selectorDetailLoss(pixels, errors, 16, 8, 1, 'contrast')).toBeCloseTo(0.25, 5)
+  expect(selectorDetailLoss(pixels, errors, 16, 8, 1, 'structure')).toBeCloseTo(0.1, 5)
+})
+
+it('stabilizes nearly flat structure loss while retaining stronger detail errors', () => {
+  const faint = Float32Array.from(source, (value) => 0.5 + (value - mean) / 100)
+  const removed = Float32Array.from(faint, (value) => value - 0.5)
+  expect(selectorDetailLoss(faint, removed, 8, 8, 1, 'structure')).toBeGreaterThan(0.9)
+  expect(selectorDetailLoss(faint, removed, 8, 8, 1, 'regularized')).toBeLessThan(0.001)
+  const strong = Float32Array.from(source, (value) => value - mean)
+  expect(selectorDetailLoss(source, strong, 8, 8, 1, 'regularized')).toBeGreaterThan(0.8)
+})
+
+it('distinguishes lost detail from added detail at equal error energy', () => {
+  const removed = Float32Array.from(source, (value) => (value - mean) / 2)
+  const added = Float32Array.from(removed, (value) => -value)
+  expect(selectorDetailLoss(source, removed, 8, 8, 1, 'lost-detail')).toBeCloseTo(1, 5)
+  expect(selectorDetailLoss(source, added, 8, 8, 1, 'lost-detail')).toBe(0)
+})
