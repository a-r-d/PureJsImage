@@ -0,0 +1,137 @@
+import assert from 'node:assert/strict'
+import { createHash } from 'node:crypto'
+import { readFile, writeFile } from 'node:fs/promises'
+import { PNG } from 'pngjs'
+import { object, number } from '../comparison/model.ts'
+import { parseButteraugliOutput, parseSsimulacra2Output } from './metrics.ts'
+import { variants, verifyRestoration } from './dc-channel-restoration.ts'
+
+const root = '.tmp/jpegxl-lossy-lab/dc-channel-audit-20261104'
+const hash = (bytes: Uint8Array) => createHash('sha256').update(bytes).digest('hex')
+const audit = object(JSON.parse(await readFile(`${root}/audit.json`, 'utf8')))
+const plan = object(JSON.parse(await readFile(`${root}/plan.json`, 'utf8')))
+const prior = object(
+  JSON.parse(await readFile('.tmp/jpegxl-lossy-lab/dc-display-audit-20261104/audit.json', 'utf8')),
+)
+assert.equal(audit.passed, true)
+assert.equal(audit.reconstructed, 800)
+assert.ok(Array.isArray(audit.rows) && Array.isArray(prior.rows))
+const oldRows = prior.rows.map(object)
+let imageChecks = 0,
+  streamChecks = 0,
+  actualPixelMatches = 0,
+  correctedPixelMatches = 0,
+  sourceChecks = 0
+const keys = new Set<string>()
+for (const row of audit.rows.map(object)) {
+  const key = `${String(row.id)}/${String(row.distance)}`
+  assert.equal(keys.has(key), false)
+  keys.add(key)
+  const previous = oldRows.find((r) => r.id === row.id && r.distance === row.distance)
+  assert.ok(previous)
+  assert.equal(row.sourceHash, previous.sourceHash)
+  assert.equal(typeof row.sourcePng, 'string')
+  if (typeof row.sourcePng !== 'string') throw new Error('Missing source')
+  assert.equal(hash(await readFile(row.sourcePng)), row.sourceHash)
+  sourceChecks++
+  assert.ok(Array.isArray(row.observations) && Array.isArray(previous.observations))
+  const previousModes = previous.observations.map(object)
+  let correctedHash: string | undefined
+  assert.deepEqual(
+    row.observations.map((value) => object(value).mode),
+    ['aligned', 'predictor'],
+  )
+  for (const point of row.observations.map(object)) {
+    const priorMode = previousModes.find((p) => p.mode === point.mode)
+    assert.ok(priorMode)
+    assert.equal(point.streamHash, priorMode.streamHash)
+    assert.equal(typeof point.path, 'string')
+    if (typeof point.path !== 'string') throw new Error('Missing stream')
+    const stream = await readFile(point.path)
+    assert.equal(hash(stream), point.streamHash)
+    assert.equal(stream.length, point.bytes)
+    streamChecks++
+    assert.ok(Array.isArray(point.variants))
+    const values = point.variants.map(object)
+    assert.deepEqual(
+      values.map((value) => value.variant),
+      variants,
+    )
+    for (const value of values) {
+      assert.equal(typeof value.imagePath, 'string')
+      if (typeof value.imagePath !== 'string') throw new Error('Missing diagnostic PNG')
+      const bytes = await readFile(value.imagePath)
+      assert.equal(hash(bytes), value.pngHash)
+      const png = PNG.sync.read(bytes)
+      assert.equal(png.width, 512)
+      assert.equal(png.height, 512)
+      assert.equal(hash(png.data), value.displayHash)
+      imageChecks++
+      const raw = object(value.rawScorerOutput),
+        scores = object(value.metrics)
+      const ba = parseButteraugliOutput(raw.butteraugli),
+        ssim = parseSsimulacra2Output(raw.ssimulacra2)
+      assert.equal(ba.max, number(scores.butteraugliMax))
+      assert.equal(ba.norm3, number(scores.butteraugliNorm3))
+      assert.equal(ssim, number(scores.ssimulacra2))
+      if (value.variant === 'actual') {
+        assert.equal(value.displayHash, priorMode.displayHash)
+        actualPixelMatches++
+      }
+      if (value.variant === 'all') {
+        assert.equal(typeof value.displayHash, 'string')
+        if (typeof value.displayHash !== 'string') throw new Error('Missing pixel hash')
+        if (correctedHash === undefined) correctedHash = value.displayHash
+        else {
+          assert.equal(value.displayHash, correctedHash)
+          correctedPixelMatches++
+        }
+      }
+    }
+  }
+}
+assert.equal(keys.size, 80)
+assert.equal(imageChecks, 800)
+assert.equal(streamChecks, 160)
+assert.equal(actualPixelMatches, 160)
+assert.equal(correctedPixelMatches, 80)
+let toolAndHelperChecks = 0
+for (const key of ['scorers', 'helpers']) {
+  const values = plan[key]
+  assert.ok(Array.isArray(values))
+  for (const value of values.map(object)) {
+    assert.equal(typeof value.path, 'string')
+    if (typeof value.path !== 'string') throw new Error('Missing receipt path')
+    assert.equal(hash(await readFile(value.path)), value.sha256)
+    toolAndHelperChecks++
+  }
+}
+await writeFile(
+  `${root}/verification.json`,
+  JSON.stringify(
+    {
+      passed: true,
+      imageChecks,
+      streamChecks,
+      actualPixelMatches,
+      correctedPixelMatches,
+      sourceChecks,
+      toolAndHelperChecks,
+      restorationTests: verifyRestoration(),
+      limits:
+        'Saved image and stream integrity and exact scorer parsing. No re-encoding or extra metric runs.',
+    },
+    null,
+    2,
+  ) + '\n',
+)
