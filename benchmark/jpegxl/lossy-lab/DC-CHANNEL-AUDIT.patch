+import assert from 'node:assert/strict'
+import type { TracePlanes } from './display-error-trace.ts'
+
+export const variants = ['actual', 'x', 'y', 'b', 'all'] as const
+export type Variant = (typeof variants)[number]
+
+/** Independent reconstructed XYB DC planes, not coded X/Y/B-minus-Y residuals. */
+export function restoreDc(actual: TracePlanes, source: TracePlanes, variant: Variant): TracePlanes {
+  const selected = variant === 'x' ? 0 : variant === 'y' ? 1 : variant === 'b' ? 2 : -1
+  const result = [actual[0].slice(), actual[1].slice(), actual[2].slice()] as const
+  for (let c = 0; c < 3; c++) {
+    const old = actual[c],
+      ideal = source[c],
+      out = result[c]
+    assert.ok(old && ideal && out && old.length === ideal.length)
+    if (variant === 'all' || selected === c) out.set(ideal)
+  }
+  return result
+}
+
+export function verifyRestoration() {
+  const actual = [Float64Array.of(1, 2), Float64Array.of(3, 4), Float64Array.of(5, 6)] as const
+  const source = [
+    Float64Array.of(11, 12),
+    Float64Array.of(13, 14),
+    Float64Array.of(15, 16),
+  ] as const
+  for (const variant of variants) {
+    const restored = restoreDc(actual, source, variant)
+    const selected = variant === 'x' ? 0 : variant === 'y' ? 1 : variant === 'b' ? 2 : -1
+    for (let c = 0; c < 3; c++) {
+      assert.deepEqual(restored[c], variant === 'all' || selected === c ? source[c] : actual[c])
+      assert.notEqual(restored[c], actual[c])
+      assert.notEqual(restored[c], source[c])
+    }
+  }
+  assert.deepEqual([...actual[0], ...actual[1], ...actual[2]], [1, 2, 3, 4, 5, 6])
+  assert.throws(() => restoreDc(actual, [new Float64Array(0), source[1], source[2]], 'x'))
+  return { variants: 5, channelChecks: 15, invalidExtent: 1, sourceMutation: false }
+}
diff --git a/benchmark/jpegxl/lossy-lab/audit-dc-channels.ts b/benchmark/jpegxl/lossy-lab/audit-dc-channels.ts
