--- /dev/null
+++ b/benchmark/jpegxl/lossy-lab/libjxl-fixed-dc-port.ts
@@ -0,0 +1,93 @@
+/**
+ * Source: libjxl lib/jxl/modular/encoding/enc_encoding.cc, MakeFixedTree and
+ * PredefinedTree(kWPFixedDC), v0.12.0, a7a9c787341cf703dede03c2009fa460cae5e5df.
+ * Copyright (c) the JPEG XL Project Authors. BSD-3-Clause
+ * Changes: scalar TypeScript tree builder using first-party node types and
+ * explicit BFS leaf context IDs. Retains source cutoffs, size pruning and
+ * bit-depth scaling. Existing first-party weighted prediction and ANS write
+ * the shared DC stream; metadata keeps local trees. No native entropy port.
+ */
+import type { JpegXlModularNode } from '../../../src/codecs/jpegxl-decode.ts'
+
+const cutoffs = Int32Array.of(
+  -500,
+  -392,
+  -255,
+  -191,
+  -127,
+  -95,
+  -63,
+  -47,
+  -31,
+  -23,
+  -15,
+  -11,
+  -7,
+  -4,
+  -3,
+  -1,
+  0,
+  1,
+  3,
+  5,
+  7,
+  11,
+  15,
+  23,
+  31,
+  47,
+  63,
+  95,
+  127,
+  191,
+  255,
+  392,
+  500,
+)
+
+export function libjxlFixedDcTree(samples: number, bitdepth: number): readonly JpegXlModularNode[] {
+  if (
+    !Number.isSafeInteger(samples) ||
+    samples < 1 ||
+    !Number.isInteger(bitdepth) ||
+    bitdepth < 1 ||
+    bitdepth > 32
+  )
+    throw new Error('Invalid fixed DC tree extent or depth')
+  const logPixels = Math.ceil(Math.log2(samples))
+  const minGap = logPixels < 14 ? 8 * (14 - logPixels) : 0
+  const multiplier = 2 ** Math.min(4, Math.max(0, bitdepth - 11))
+  const leaf = (): JpegXlModularNode => ({
+    kind: 'leaf',
+    predictor: 6,
+    offset: 0,
+    multiplier: 1,
+    context: 0,
+  })
+  const nodes: JpegXlModularNode[] = [leaf()]
+  const queue = [{ begin: 0, end: cutoffs.length, position: 0 }]
+  for (let i = 0; i < queue.length; i++) {
+    const item = queue[i]
+    if (!item || item.begin + minGap >= item.end) continue
+    const split = Math.floor((item.begin + item.end) / 2)
+    const cutoff = cutoffs[split]
+    if (cutoff === undefined) throw new Error('Missing fixed DC cutoff')
+    nodes[item.position] = {
+      kind: 'branch',
+      property: 15,
+      split: cutoff * multiplier,
+      greater: nodes.length,
+      lessOrEqual: nodes.length + 1,
+    }
+    queue.push({ begin: split + 1, end: item.end, position: nodes.length })
+    nodes.push(leaf())
+    queue.push({ begin: item.begin, end: split, position: nodes.length })
+    nodes.push(leaf())
+  }
+  let context = 0
+  for (let i = 0; i < nodes.length; i++) {
+    const node = nodes[i]
+    if (node?.kind === 'leaf') nodes[i] = { ...node, context: context++ }
+  }
+  return nodes
+}
