+/** First-party development estimate of our predictor-5 sharpness stream cost.
+ * Counts signed residuals per DC group, with Shannon bits and an alphabet charge.
+ * This estimates the map only; measured complete output bytes remain the gate.
+ */
+export function sharpnessResidual(
+  map: Uint8Array,
+  width: number,
+  x: number,
+  y: number,
+  rx = -1,
+  ry = -1,
+  right = -1,
+  bottom = -1,
+  value = 4,
+): number {
+  const localX = x % 256,
+    localY = y % 256
+  const left =
+    localX > 0
+      ? sharpnessSample(map, width, x - 1, y, rx, ry, right, bottom, value)
+      : localY > 0
+        ? sharpnessSample(map, width, x, y - 1, rx, ry, right, bottom, value)
+        : 0
+  const top =
+    localY > 0 ? sharpnessSample(map, width, x, y - 1, rx, ry, right, bottom, value) : left
+  const diagonal =
+    localX > 0 && localY > 0
+      ? sharpnessSample(map, width, x - 1, y - 1, rx, ry, right, bottom, value)
+      : left
+  const prediction = Math.max(
+    Math.min(left, top),
+    Math.min(Math.max(left, top), left + top - diagonal),
+  )
+  return sharpnessSample(map, width, x, y, rx, ry, right, bottom, value) - prediction + 7
+}
+
+export function sharpnessHistogramBits(histogram: Int32Array, offset = 0): number {
+  let total = 0,
+    sum = 0,
+    alphabet = 0
+  for (let i = 0; i < 15; i++) {
+    const n = histogram[offset + i] ?? 0
+    total += n
+    if (n > 0) {
+      sum += n * Math.log2(n)
+      alphabet++
+    }
+  }
+  return total ? total * Math.log2(total) - sum + alphabet * (Math.log2(total + 1) + 3) : 0
+}
+
+export function sharpnessMapCost(map: Uint8Array, width: number, height: number) {
+  const across = Math.ceil(width / 256)
+  const histogram = new Int32Array(across * Math.ceil(height / 256) * 15)
+  const delta = new Int32Array(histogram.length)
+  for (let y = 0; y < height; y++)
+    for (let x = 0; x < width; x++) {
+      const at =
+        (Math.floor(y / 256) * across + Math.floor(x / 256)) * 15 +
+        sharpnessResidual(map, width, x, y)
+      histogram[at] = (histogram[at] ?? 0) + 1
+    }
+  return {
+    bits(): number {
+      let bits = 0
+      for (let at = 0; at < histogram.length; at += 15)
+        bits += sharpnessHistogramBits(histogram, at)
+      return bits
+    },
+    change(
+      rx: number,
+      ry: number,
+      right: number,
+      bottom: number,
+      value: number,
+      commit = false,
+    ): number {
+      delta.fill(0)
+      // The predictor sees left, top and top-left: only this rectangle plus
+      // its right and bottom neighbors can change. DC-group edges reset it.
+      for (let y = ry; y < Math.min(height, bottom + 1); y++)
+        for (let x = rx; x < Math.min(width, right + 1); x++) {
+          const at = (Math.floor(y / 256) * across + Math.floor(x / 256)) * 15
+          const old = at + sharpnessResidual(map, width, x, y)
+          const next = at + sharpnessResidual(map, width, x, y, rx, ry, right, bottom, value)
+          delta[old] = (delta[old] ?? 0) - 1
+          delta[next] = (delta[next] ?? 0) + 1
+        }
+      let difference = 0
+      for (let at = 0; at < histogram.length; at += 15) {
+        const before = sharpnessHistogramBits(histogram, at)
+        for (let i = at; i < at + 15; i++) histogram[i] = (histogram[i] ?? 0) + (delta[i] ?? 0)
+        difference += sharpnessHistogramBits(histogram, at) - before
+        if (!commit)
+          for (let i = at; i < at + 15; i++) histogram[i] = (histogram[i] ?? 0) - (delta[i] ?? 0)
+      }
+      if (commit)
+        for (let y = ry; y < bottom; y++) map.fill(value, y * width + rx, y * width + right)
+      return difference
+    },
+  }
+}
+
+function sharpnessSample(
+  map: Uint8Array,
+  width: number,
+  x: number,
+  y: number,
+  rx: number,
+  ry: number,
+  right: number,
+  bottom: number,
+  value: number,
+): number {
+  return x >= rx && x < right && y >= ry && y < bottom ? value : (map[y * width + x] ?? 0)
+}
