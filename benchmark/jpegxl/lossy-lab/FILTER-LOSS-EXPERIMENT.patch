index 00000000..58891a49
--- /dev/null
+++ b/benchmark/jpegxl/lossy-lab/filter-loss-diagnostic.ts
@@ -0,0 +1,245 @@
+/**
+ * Source: libjxl tools/ssimulacra2.cc, SSIMMap and EdgeDiffMap, v0.12.0,
+ * a7a9c787341cf703dede03c2009fa460cae5e5df.
+ * Copyright (c) the JPEG XL Project Authors. BSD-3-Clause
+ * Changes: offline development diagnostics, four-pixel box neighborhoods instead
+ * of Gaussian windows. Uses our forward color constants and actual decoded PNGs.
+ * RGB downsampling is linear. Reports feature differences, not a substitute score.
+ */
+import { readFile, readdir, writeFile } from 'node:fs/promises'
+import { PNG } from 'pngjs'
+import { object } from '../comparison/model.ts'
+import { parsePoint } from './model.ts'
+import { filterFeaturePercent } from './libjxl-filter-loss.ts'
+const [candidateRoot, controlRoot, outputPath] = process.argv.slice(2)
+if (!candidateRoot || !controlRoot || !outputPath)
+  throw new Error('Need candidate engine, control engine and output JSON')
+const transfer = Float64Array.from({ length: 256 }, (_, i) =>
+  i / 255 <= 0.04045 ? i / 255 / 12.92 : ((i / 255 + 0.055) / 1.055) ** 2.4,
+)
+const bias = 0.0037930732552754493,
+  rootBias = Math.cbrt(bias)
+function linear(png: PNG) {
+  const planes = [
+    new Float32Array(png.width * png.height),
+    new Float32Array(png.width * png.height),
+    new Float32Array(png.width * png.height),
+  ] as const
+  for (let p = 0; p < png.width * png.height; p++)
+    for (let c = 0; c < 3; c++) {
+      const plane = planes[c]
+      if (plane) plane[p] = transfer[png.data[p * 4 + c] ?? 0] ?? 0
+    }
+  return planes
+}
+function downsample(planes: readonly Float32Array[], width: number, height: number): void {
+  const nw = Math.ceil(width / 2),
+    nh = Math.ceil(height / 2)
+  for (const plane of planes)
+    for (let y = 0; y < nh; y++)
+      for (let x = 0; x < nw; x++) {
+        const p = y * 2 * width + x * 2,
+          right = Math.min(width - 1, x * 2 + 1) - x * 2,
+          bottom = (Math.min(height - 1, y * 2 + 1) - y * 2) * width
+        plane[y * nw + x] =
+          ((plane[p] ?? 0) +
+            (plane[p + right] ?? 0) +
+            (plane[p + bottom] ?? 0) +
+            (plane[p + bottom + right] ?? 0)) *
+          0.25
+      }
+}
+function xyb(rgb: readonly Float32Array[], length: number) {
+  const result = [
+    new Float32Array(length),
+    new Float32Array(length),
+    new Float32Array(length),
+  ] as const
+  for (let p = 0; p < length; p++) {
+    const r = rgb[0]?.[p] ?? 0,
+      g = rgb[1]?.[p] ?? 0,
+      b = rgb[2]?.[p] ?? 0
+    const l = Math.cbrt(0.3 * r + 0.622 * g + 0.078 * b + bias) - rootBias,
+      m = Math.cbrt(0.23 * r + 0.692 * g + 0.078 * b + bias) - rootBias
+    const y = (l + m) * 0.5
+    result[0][p] = (l - m) * 7
+    result[1][p] = y
+    result[2][p] =
+      Math.cbrt(0.2434226894556144 * r + 0.20476744435558894 * g + 0.5518098669709147 * b + bias) -
+      rootBias -
+      y
+  }
+  return result
+}
+function features(
+  a: readonly Float32Array[],
+  b: readonly Float32Array[],
+  width: number,
+  height: number,
+) {
+  const result = new Float64Array(18)
+  for (let c = 0; c < 3; c++) {
+    const src = a[c],
+      dst = b[c]
+    if (!src || !dst) throw new Error('Missing diagnostic plane')
+    let mse = 0,
+      ssim = 0,
+      ring = 0,
+      blur = 0,
+      ring4 = 0,
+      blur4 = 0
+    for (let ty = 0; ty < height; ty += 4)
+      for (let tx = 0; tx < width; tx += 4) {
+        let sa = 0,
+          sb = 0,
+          saa = 0,
+          sbb = 0,
+          sab = 0,
+          n = 0
+        for (let y = ty; y < Math.min(height, ty + 4); y++)
+          for (let x = tx; x < Math.min(width, tx + 4); x++) {
+            const p = y * width + x,
+              av = src[p] ?? 0,
+              bv = dst[p] ?? 0
+            sa += av
+            sb += bv
+            saa += av * av
+            sbb += bv * bv
+            sab += av * bv
+            mse += (av - bv) ** 2
+            n++
+          }
+        const ma = sa / n,
+          mb = sb / n,
+          va = Math.max(0, saa / n - ma * ma),
+          vb = Math.max(0, sbb / n - mb * mb),
+          cov = sab / n - ma * mb
+        ssim +=
+          Math.max(0, 1 - ((1 - (ma - mb) ** 2) * (2 * cov + 0.0009)) / (va + vb + 0.0009)) * n
+        for (let y = ty; y < Math.min(height, ty + 4); y++)
+          for (let x = tx; x < Math.min(width, tx + 4); x++) {
+            const p = y * width + x,
+              edge = (1 + Math.abs((dst[p] ?? 0) - mb)) / (1 + Math.abs((src[p] ?? 0) - ma)) - 1
+            const added = Math.max(0, edge),
+              lost = Math.max(0, -edge)
+            ring += added
+            blur += lost
+            ring4 += added ** 4
+            blur4 += lost ** 4
+          }
+      }
+    result.set(
+      [
+        mse / (width * height),
+        ssim / (width * height),
+        ring / (width * height),
+        blur / (width * height),
+        (ring4 / (width * height)) ** 0.25,
+        (blur4 / (width * height)) ** 0.25,
+      ],
+      c * 6,
+    )
+  }
+  return result
+}
+interface DiagnosticScale {
+  scale: number
+  control: number[]
+  candidate: number[]
+  percent: (number | null)[]
+}
+interface DiagnosticRow {
+  id: string
+  setting: number
+  ssimDelta: number
+  ba3Delta: number
+  scales: DiagnosticScale[]
+}
+const rows: DiagnosticRow[] = []
+for (const id of await readdir(candidateRoot)) {
+  const candidate = object(
+      JSON.parse(await readFile(`${candidateRoot}/${id}/result.json`, 'utf8')),
+    ),
+    control = object(JSON.parse(await readFile(`${controlRoot}/${id}/result.json`, 'utf8')))
+  if (
+    typeof candidate.reference !== 'string' ||
+    !Array.isArray(candidate.points) ||
+    !Array.isArray(control.points)
+  )
+    throw new Error('Invalid diagnostic curves')
+  for (const setting of [2, 4]) {
+    const point = candidate.points.map(parsePoint).find((p) => p.setting === setting),
+      base = control.points.map(parsePoint).find((p) => p.setting === setting)
+    if (!point || !base) throw new Error('Missing fixed diagnostic point')
+    const original = PNG.sync.read(await readFile(candidate.reference))
+    const own = PNG.sync.read(await readFile(`${candidateRoot}/${id}/${setting}.png`)),
+      old = PNG.sync.read(await readFile(`${controlRoot}/${id}/${setting}.png`))
+    if (
+      own.width !== original.width ||
+      own.height !== original.height ||
+      old.width !== original.width ||
+      old.height !== original.height
+    )
+      throw new Error('Diagnostic dimensions differ')
+    const source = linear(original),
+      output = linear(own),
+      reference = linear(old)
+    let width = original.width,
+      height = original.height
+    const scales: DiagnosticScale[] = []
+    for (let scale = 0; scale < 4; scale++) {
+      const src = xyb(source, width * height),
+        a = features(src, xyb(output, width * height), width, height),
+        b = features(src, xyb(reference, width * height), width, height)
+      scales.push({
+        scale,
+        control: Array.from(b),
+        candidate: Array.from(a),
+        percent: Array.from(a, (value, i) => filterFeaturePercent(value, b[i] ?? 0)),
+      })
+      downsample(source, width, height)
+      downsample(output, width, height)
+      downsample(reference, width, height)
+      width = Math.ceil(width / 2)
+      height = Math.ceil(height / 2)
+    }
+    rows.push({
+      id,
+      setting,
+      ssimDelta: point.ssimulacra2 - base.ssimulacra2,
+      ba3Delta: point.butteraugliNorm3 - base.butteraugliNorm3,
+      scales,
+    })
+  }
+}
+const mean = (values: readonly number[]) => values.reduce((a, b) => a + b, 0) / values.length
+const summary = Array.from({ length: 4 }, (_, scale) => ({
+  scale,
+  meanFeaturePercent: Array.from({ length: 18 }, (_, feature) =>
+    mean(
+      rows
+        .map((row) => row.scales[scale]?.percent[feature])
+        .filter((v): v is number => typeof v === 'number'),
+    ),
+  ),
+}))
+const report = {
+  candidateRoot,
+  controlRoot,
+  features: [
+    'MSE',
+    'correctedSSIM',
+    'addedEdgesMean',
+    'lostDetailMean',
+    'addedEdgesL4',
+    'lostDetailL4',
+  ],
+  channelOrder: ['X-times-14', 'Y', 'B-Y'],
+  ssimDeltaMean: mean(rows.map((r) => r.ssimDelta)),
+  summary,
+  rows,
+  policy:
+    'Offline full-crop box-window diagnostic, not the exact metric. Actual native metric scores and encoded bytes remain gates.',
+}
+await writeFile(outputPath, `${JSON.stringify(report, null, 2)}\n`)
+console.log(JSON.stringify({ ssimDeltaMean: report.ssimDeltaMean, summary }, null, 2))
diff --git a/benchmark/jpegxl/lossy-lab/filter-loss-region-audit.ts b/benchmark/jpegxl/lossy-lab/filter-loss-region-audit.ts
