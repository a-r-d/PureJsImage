index 00000000..057de73f
--- /dev/null
+++ b/benchmark/jpegxl/lossy-lab/libjxl-filter-gaussian-loss.ts
@@ -0,0 +1,181 @@
+/**
+ * Source: libjxl tools/ssimulacra2.cc, SSIMMap, EdgeDiffMap, MakePositiveXYB,
+ * and Msssim::Score, v0.12.0, a7a9c787341cf703dede03c2009fa460cae5e5df.
+ * Copyright (c) the JPEG XL Project Authors. BSD-3-Clause
+ * Changes: sampled three-scale development surrogate with separable seven-tap
+ * Gaussian moments at sigma 1.5, clamped patch edges and XYB pooling. Exact
+ * metric weights are separately attributed. No score polynomial or full-image
+ * metric claim. Reuses bounded caller scratch and our emitted reconstruction.
+ */
+import { filterMetricWeights } from './libjxl-ssim-weights.ts'
+const kernel = Float64Array.from({ length: 7 }, (_, i) =>
+  Math.exp(-((i - 3) ** 2) / (2 * 1.5 ** 2)),
+)
+let normalization = 0
+for (let i = 0; i < 7; i++) normalization += kernel[i] ?? 0
+for (let i = 0; i < 7; i++) kernel[i] = (kernel[i] ?? 0) / normalization
+
+export function gaussianFilterLoss(
+  source: readonly Float32Array[],
+  output: readonly Float32Array[],
+  size: number,
+  width: number,
+  height: number,
+  scratch: readonly Float32Array[],
+  features?: Float64Array,
+): number {
+  const a = scratch[0],
+    b = scratch[1],
+    ha = scratch[2],
+    hb = scratch[3],
+    haa = scratch[4],
+    hbb = scratch[5],
+    hab = scratch[6]
+  if (!a || !b || !ha || !hb || !haa || !hbb || !hab)
+    throw new Error('Missing Gaussian loss scratch')
+  let total = 0
+  for (let c = 0; c < 3; c++) {
+    for (let y = 0; y < height; y++)
+      for (let x = 0; x < width; x++) {
+        const p = y * size + x
+        a[p] =
+          c === 0
+            ? (source[0]?.[p] ?? 0) * 14
+            : c === 1
+              ? (source[1]?.[p] ?? 0)
+              : (source[2]?.[p] ?? 0) - (source[1]?.[p] ?? 0)
+        b[p] =
+          c === 0
+            ? (output[0]?.[p] ?? 0) * 14
+            : c === 1
+              ? (output[1]?.[p] ?? 0)
+              : (output[2]?.[p] ?? 0) - (output[1]?.[p] ?? 0)
+      }
+    let w = width,
+      h = height
+    for (let scale = 0; scale < 3; scale++) {
+      for (let y = 0; y < h; y++)
+        for (let x = 0; x < w; x++) {
+          let sa = 0,
+            sb = 0,
+            saa = 0,
+            sbb = 0,
+            sab = 0
+          for (let k = -3; k <= 3; k++) {
+            const p = y * size + Math.max(0, Math.min(w - 1, x + k)),
+              weight = kernel[k + 3] ?? 0,
+              av = a[p] ?? 0,
+              bv = b[p] ?? 0
+            sa += weight * av
+            sb += weight * bv
+            saa += weight * av * av
+            sbb += weight * bv * bv
+            sab += weight * av * bv
+          }
+          const p = y * size + x
+          ha[p] = sa
+          hb[p] = sb
+          haa[p] = saa
+          hbb[p] = sbb
+          hab[p] = sab
+        }
+      let structural = 0,
+        structural4 = 0,
+        ring = 0,
+        ring4 = 0,
+        blur = 0,
+        blur4 = 0
+      for (let y = 0; y < h; y++)
+        for (let x = 0; x < w; x++) {
+          let ma = 0,
+            mb = 0,
+            qa = 0,
+            qb = 0,
+            qab = 0
+          for (let k = -3; k <= 3; k++) {
+            const p = Math.max(0, Math.min(h - 1, y + k)) * size + x,
+              weight = kernel[k + 3] ?? 0
+            ma += weight * (ha[p] ?? 0)
+            mb += weight * (hb[p] ?? 0)
+            qa += weight * (haa[p] ?? 0)
+            qb += weight * (hbb[p] ?? 0)
+            qab += weight * (hab[p] ?? 0)
+          }
+          const d = Math.max(
+            0,
+            1 -
+              ((1 - (ma - mb) ** 2) * (2 * (qab - ma * mb) + 0.0009)) /
+                (qa - ma * ma + qb - mb * mb + 0.0009),
+          )
+          structural += d
+          structural4 += d ** 4
+          const p = y * size + x,
+            edge = (1 + Math.abs((b[p] ?? 0) - mb)) / (1 + Math.abs((a[p] ?? 0) - ma)) - 1,
+            added = Math.max(0, edge),
+            lost = Math.max(0, -edge)
+          ring += added
+          ring4 += added ** 4
+          blur += lost
+          blur4 += lost ** 4
+        }
+      const at = (c * 6 + scale) * 6,
+        n = w * h
+      if (features) {
+        const slot = (c * 3 + scale) * 6
+        features[slot] = structural / n
+        features[slot + 1] = ring / n
+        features[slot + 2] = blur / n
+        features[slot + 3] = structural4 / n
+        features[slot + 4] = ring4 / n
+        features[slot + 5] = blur4 / n
+      }
+      total +=
+        ((filterMetricWeights[at] ?? 0) * structural) / n +
+        ((filterMetricWeights[at + 1] ?? 0) * ring) / n +
+        ((filterMetricWeights[at + 2] ?? 0) * blur) / n +
+        (filterMetricWeights[at + 3] ?? 0) * (structural4 / n) ** 0.25 +
+        (filterMetricWeights[at + 4] ?? 0) * (ring4 / n) ** 0.25 +
+        (filterMetricWeights[at + 5] ?? 0) * (blur4 / n) ** 0.25
+      if (scale < 2) {
+        const nw = Math.ceil(w / 2),
+          nh = Math.ceil(h / 2)
+        for (let y = 0; y < nh; y++)
+          for (let x = 0; x < nw; x++) {
+            const p = y * 2 * size + x * 2,
+              right = Math.min(w - 1, x * 2 + 1) - x * 2,
+              bottom = (Math.min(h - 1, y * 2 + 1) - y * 2) * size
+            a[y * size + x] =
+              ((a[p] ?? 0) +
+                (a[p + right] ?? 0) +
+                (a[p + bottom] ?? 0) +
+                (a[p + bottom + right] ?? 0)) *
+              0.25
+            b[y * size + x] =
+              ((b[p] ?? 0) +
+                (b[p + right] ?? 0) +
+                (b[p + bottom] ?? 0) +
+                (b[p + bottom + right] ?? 0)) *
+              0.25
+          }
+        w = nw
+        h = nh
+      }
+    }
+  }
+  return total
+}
+
+/** Pool mean maps and fourth moments across the image before taking roots. */
+export function pooledFilterFeatures(features: Float64Array): number {
+  let total = 0
+  for (let c = 0; c < 3; c++)
+    for (let scale = 0; scale < 3; scale++) {
+      const source = (c * 3 + scale) * 6,
+        weights = (c * 6 + scale) * 6
+      for (let f = 0; f < 6; f++)
+        total +=
+          (filterMetricWeights[weights + f] ?? 0) *
+          (f < 3 ? (features[source + f] ?? 0) : Math.max(0, features[source + f] ?? 0) ** 0.25)
+    }
+  return total
+}
