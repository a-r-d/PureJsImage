+import { expect, it } from 'vitest'
+import { pooledFilterFeatures } from '../benchmark/jpegxl/lossy-lab/libjxl-filter-gaussian-loss.ts'
+import { filterMetricWeights } from '../benchmark/jpegxl/lossy-lab/libjxl-ssim-weights.ts'
+import {
+  filterFeaturePercent,
+  filterPatchLoss,
+  type FilterLoss,
+} from '../benchmark/jpegxl/lossy-lab/libjxl-filter-loss.ts'
+const modes: readonly FilterLoss[] = [
+  'metric',
+  'metric-hybrid',
+  'l1',
+  'dual',
+  'gaussian',
+  'opponent',
+  'gradient',
+  'gradient3',
+  'structure',
+  'detail',
+  'multiscale',
+  'hybrid',
+  'tail',
+]
+const scratch = () => Array.from({ length: 8 }, () => new Float32Array(256))
+function image() {
+  const y = Float32Array.from({ length: 256 }, (_, p) => 0.4 + (p % 4 < 2 ? 0.03 : -0.03))
+  return [new Float32Array(256), y, Float32Array.from(y, (v) => v + 0.05)] as const
+}
+it.each(modes)('has zero loss for identical patches in %s', (mode) => {
+  const original = image()
+  expect(filterPatchLoss(original, original, 16, 16, 16, mode, scratch())).toBeCloseTo(0, 10)
+})
+it('penalizes lost local contrast more than an equal pointwise brightness error', () => {
+  const original = image(),
+    shift = image(),
+    blur = image()
+  for (let p = 0; p < 256; p++) {
+    shift[1][p] = (original[1][p] ?? 0) + 0.01
+    shift[2][p] = (original[2][p] ?? 0) + 0.01
+    blur[1][p] = 0.4 + (((original[1][p] ?? 0) - 0.4) * 2) / 3
+    blur[2][p] = (blur[1][p] ?? 0) + 0.05
+  }
+  const shiftLoss = filterPatchLoss(original, shift, 16, 16, 16, 'structure', scratch())
