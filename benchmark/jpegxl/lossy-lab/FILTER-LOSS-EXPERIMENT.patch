index 00000000..12fb19df
--- /dev/null
+++ b/benchmark/jpegxl/lossy-lab/filter-loss-region-audit.ts
@@ -0,0 +1,220 @@
+/**
+ * Source: libjxl lib/jxl/enc_heuristics.cc, ComputeBlockL2Distance, v0.12.0,
+ * a7a9c787341cf703dede03c2009fa460cae5e5df.
+ * Copyright (c) the JPEG XL Project Authors. BSD-3-Clause
+ * Changes: first-party offline causal audit of sixteen fixed development regions.
+ * Measure sharpness interventions with native SSIMULACRA2; no native decisions
+ * enter our encoder. Compare sampled and full-region loss predictions only.
+ */
+import { execFileSync } from 'node:child_process'
+import { mkdir, readFile, writeFile } from 'node:fs/promises'
+import { PNG } from 'pngjs'
+import { encodeTransplant } from './transplant.ts'
+import { libjxlPortOverrides } from './libjxl-ports.ts'
+import { libjxlSampledArSharpness } from './libjxl-sampled-ar-port.ts'
+import { filterPatchLoss } from './libjxl-filter-loss.ts'
+import { parseSsimulacra2Output } from './metrics.ts'
+import { convertJpegXlNativeXybPlanes } from '../../../src/codecs/jpegxl-vardct-render.ts'
+import { metrics, oracle } from '../comparison/io.ts'
+const [inputPath, outputRoot] = process.argv.slice(2)
+if (!inputPath || !outputRoot) throw new Error('Need development PNG and fresh output root')
+await mkdir(outputRoot, { recursive: true })
+const input = PNG.sync.read(await readFile(inputPath)),
+  pixels = Uint8Array.from(input.data),
+  distance = Number(process.argv[4] ?? '2')
+const overrides = libjxlPortOverrides(
+    'standalone-forward-all',
+    distance,
+    input.width,
+    input.height,
+  ),
+  rewrite = overrides.rewriteGeometry
+if (!rewrite || (distance !== 2 && distance !== 4) || input.width !== 512 || input.height !== 512)
+  throw new Error('Audit requires fixed 512 development crop')
+interface Prediction {
+  native4: number
+  native7: number
+  gaussian4: number
+  gaussian7: number
+}
+const reconstruction4 = [
+  new Float64Array(512 * 512),
+  new Float64Array(512 * 512),
+  new Float64Array(512 * 512),
+] as const
+const reconstruction7 = [
+  new Float64Array(512 * 512),
+  new Float64Array(512 * 512),
+  new Float64Array(512 * 512),
+] as const
+function parity(rgb: readonly Float64Array[], png: PNG, rx: number, ry: number, size: number) {
+  let maximum = 0,
+    overOne = 0,
+    total = 0
+  for (let y = ry; y < ry + size; y++)
+    for (let x = rx; x < rx + size; x++)
+      for (let c = 0; c < 3; c++) {
+        const at = y * 512 + x,
+          expected = Math.max(0, Math.min(255, Math.round((rgb[c]?.[at] ?? 0) * 255))),
+          delta = Math.abs(expected - (png.data[at * 4 + c] ?? 0))
+        maximum = Math.max(maximum, delta)
+        overOne += delta > 1 ? 1 : 0
+        total++
+      }
+  return { maximum, overOne, total }
+}
+const sampled: Prediction[] = Array.from({ length: 64 }, () => ({
+  native4: 0,
+  native7: 0,
+  gaussian4: 0,
+  gaussian7: 0,
+}))
+const full: Prediction[] = Array.from({ length: 64 }, () => ({
+  native4: 0,
+  native7: 0,
+  gaussian4: 0,
+  gaussian7: 0,
+}))
+const score = (name: string): number => {
+  execFileSync(
+    `${oracle}/djxl`,
+    [
+      `${outputRoot}/${name}.jxl`,
+      `${outputRoot}/${name}.png`,
+      '--num_threads=1',
+      '--bits_per_sample=8',
+    ],
+    { stdio: 'pipe' },
+  )
+  return parseSsimulacra2Output(
+    execFileSync(`${metrics}/ssimulacra2`, [inputPath, `${outputRoot}/${name}.png`], {
+      encoding: 'utf8',
+    }),
+  )
+}
+const baseline = await encodeTransplant(pixels, 512, 512, distance, {
+  ...overrides,
+  rewriteGeometry(base, context) {
+    const geometry = rewrite(base, context)
+    for (const patch of [16, 64]) {
+      const scratch = Array.from({ length: 8 }, () => new Float32Array(patch * patch))
+      libjxlSampledArSharpness(
+        geometry,
+        context,
+        distance,
+        512,
+        512,
+        { region: 64, patch, count: 1, rate: 1 },
+        (sharpness, x, y, size, planes, source, mask) => {
+          if (sharpness !== 4 && sharpness !== 7) return
+          if (patch === 64) {
+            const targets = sharpness === 4 ? reconstruction4 : reconstruction7
+            for (let py = 0; py < size; py++)
+              for (let px = 0; px < size; px++)
+                for (let c = 0; c < 3; c++) {
+                  const target = targets[c]
+                  if (target) target[(y + py) * 512 + x + px] = planes[c]?.[py * size + px] ?? 0
+                }
+          }
+          const target = (patch === 16 ? sampled : full)[
+            Math.floor(y / 64) * 8 + Math.floor(x / 64)
+          ]
+          if (!target) throw new Error('Missing region prediction')
+          let error = 0
+          for (let p = 0; p < size * size; p++)
+            for (let c = 0; c < 3; c++) {
+              const delta = (source[c]?.[p] ?? 0) - (planes[c]?.[p] ?? 0),
+                m = mask[p] ?? 1
+              error += delta * delta * m * m * (c === 0 ? 12.339445295782363 : c === 1 ? 1 : 0.2)
+            }
+          const perceptual = filterPatchLoss(source, planes, size, size, size, 'gaussian', scratch)
+          if (sharpness === 4) {
+            target.native4 = error
+            target.gaussian4 = perceptual
+          } else {
+            target.native7 = error
+            target.gaussian7 = perceptual
+          }
+        },
+      )
+      geometry.sharpnessMap?.fill(4)
+    }
+    return geometry
+  },
+})
+await writeFile(`${outputRoot}/control.jxl`, baseline.bytes)
+const controlScore = score('control')
+const rgb4 = convertJpegXlNativeXybPlanes(reconstruction4, undefined),
+  rgb7 = convertJpegXlNativeXybPlanes(reconstruction7, undefined)
+const controlParity = parity(
+  rgb4,
+  PNG.sync.read(await readFile(`${outputRoot}/control.png`)),
+  0,
+  0,
+  512,
+)
+const rows = []
+for (let ry = 0; ry < 8; ry += 2)
+  for (let rx = 0; rx < 8; rx += 2) {
+    const result = await encodeTransplant(pixels, 512, 512, distance, {
+      ...overrides,
+      rewriteGeometry(base, context) {
+        const geometry = rewrite(base, context),
+          map = geometry.sharpnessMap
+        if (!map) throw new Error('Missing sharpness map')
+        for (let y = ry * 8; y < (ry + 1) * 8; y++)
+          map.fill(7, y * geometry.blocksWide + rx * 8, y * geometry.blocksWide + (rx + 1) * 8)
+        return geometry
+      },
+    })
+    const name = `${rx}-${ry}`
+    await writeFile(`${outputRoot}/${name}.jxl`, result.bytes)
+    const nativeScore = score(name),
+      a = sampled[ry * 8 + rx],
+      b = full[ry * 8 + rx]
+    if (!a || !b) throw new Error('Missing predicted loss')
+    const row = {
+      x: rx * 64,
+      y: ry * 64,
+      ssimDelta: nativeScore - controlScore,
+      parity: parity(
+        rgb7,
+        PNG.sync.read(await readFile(`${outputRoot}/${name}.png`)),
+        rx * 64,
+        ry * 64,
+        64,
+      ),
+      bytes: result.bytes.length,
+      sampled: a,
+      full: b,
+    }
+    rows.push(row)
+    console.log(JSON.stringify(row))
+  }
+const agrees = (predicted: number, actual: number) => Math.sign(predicted) === Math.sign(actual)
+const summary = {
+  regions: rows.length,
+  controlParity,
+  maximumRegionDifference: Math.max(...rows.map((row) => row.parity.maximum)),
+  regionValuesOverOne: rows.reduce((n, row) => n + row.parity.overOne, 0),
+  controlScore,
+  controlBytes: baseline.bytes.length,
+  sampledNativeCorrect: rows.filter((r) =>
+    agrees(r.sampled.native4 - r.sampled.native7, r.ssimDelta),
+  ).length,
+  fullNativeCorrect: rows.filter((r) => agrees(r.full.native4 - r.full.native7, r.ssimDelta))
+    .length,
+  sampledGaussianCorrect: rows.filter((r) =>
+    agrees(r.sampled.gaussian4 - r.sampled.gaussian7, r.ssimDelta),
+  ).length,
+  fullGaussianCorrect: rows.filter((r) => agrees(r.full.gaussian4 - r.full.gaussian7, r.ssimDelta))
+    .length,
+  nativeFullWrongOnHarm: rows.filter((r) => r.ssimDelta < 0 && r.full.native7 < r.full.native4)
+    .length,
+  harmful: rows.filter((r) => r.ssimDelta < 0).length,
+}
+await writeFile(
+  `${outputRoot}/report.json`,
+  `${JSON.stringify({ inputPath, distance, summary, rows }, null, 2)}\n`,
+)
+console.log(JSON.stringify(summary))
