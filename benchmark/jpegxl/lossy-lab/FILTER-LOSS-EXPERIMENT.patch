index 00000000..2e9700d6
--- /dev/null
+++ b/benchmark/jpegxl/lossy-lab/libjxl-filter-loss.ts
@@ -0,0 +1,212 @@
+/**
+ * Source: libjxl tools/ssimulacra2.cc, SSIMMap, EdgeDiffMap and MakePositiveXYB,
+ * v0.12.0, a7a9c787341cf703dede03c2009fa460cae5e5df.
+ * Copyright (c) the JPEG XL Project Authors. BSD-3-Clause
+ * Changes: development-only sampled loss. Four-pixel box moments replace the
+ * Gaussian neighborhood; two XYB-pooled scales approximate RGB downsampling.
+ * Retains corrected SSIM, normalized X and B-Y, and separate edge/detail terms.
+ * Channel weights and gradient diagnostics are first-party adaptations. This
+ * surrogate is not the SSIMULACRA2 metric. Native full-image scores remain gates.
+ */
+import { gaussianFilterLoss } from './libjxl-filter-gaussian-loss.ts'
+import { filterMetricWeights } from './libjxl-ssim-weights.ts'
+
+export type FilterLoss =
+  | 'dual'
+  | 'gaussian'
+  | 'metric'
+  | 'metric-hybrid'
+  | 'l1'
+  | 'opponent'
+  | 'gradient'
+  | 'gradient3'
+  | 'structure'
+  | 'detail'
+  | 'multiscale'
+  | 'hybrid'
+  | 'tail'
+
+export function filterPatchLoss(
+  source: readonly Float32Array[],
+  output: readonly Float32Array[],
+  size: number,
+  width: number,
+  height: number,
+  mode: FilterLoss,
+  scratch: readonly Float32Array[],
+  mask?: Float32Array,
+  features?: Float64Array,
+): number {
+  if (mode === 'gaussian' || mode === 'dual')
+    return gaussianFilterLoss(source, output, size, width, height, scratch, features)
+  let total = 0
+  const metric = mode === 'metric' || mode === 'metric-hybrid'
+  const levels = metric ? 3 : mode === 'multiscale' || mode === 'hybrid' ? 2 : 1
+  if (mode === 'l1' || mode === 'opponent' || mode === 'gradient' || mode === 'gradient3') {
+    for (let c = 0; c < 3; c++) {
+      const a = source[c],
+        b = output[c]
+      if (!a || !b) throw new Error('Missing filter loss plane')
+      const weight = c === 0 ? 12.339445295782363 : c === 1 ? 1 : 0.2
+      for (let y = 0; y < height; y++)
+        for (let x = 0; x < width; x++) {
+          const p = y * size + x
+          const error =
+            c === 2
+              ? (a[p] ?? 0) - (source[1]?.[p] ?? 0) - (b[p] ?? 0) + (output[1]?.[p] ?? 0)
+              : (a[p] ?? 0) - (b[p] ?? 0)
+          const maskedWeight = weight * (mask?.[p] ?? 1) ** 2
+          total +=
+            mode === 'l1'
+              ? Math.sqrt(weight) * (mask?.[p] ?? 1) * Math.abs(error)
+              : maskedWeight * error * error
+          if (mode === 'opponent' || mode === 'l1') continue
+          if (x + 1 < width) {
+            const next =
+              c === 2
+                ? (a[p + 1] ?? 0) -
+                  (source[1]?.[p + 1] ?? 0) -
+                  (b[p + 1] ?? 0) +
+                  (output[1]?.[p + 1] ?? 0)
+                : (a[p + 1] ?? 0) - (b[p + 1] ?? 0)
+            total += maskedWeight * (error - next) ** 2 * (mode === 'gradient3' ? 3 : 1)
+          }
+          if (y + 1 < height) {
+            const next =
+              c === 2
+                ? (a[p + size] ?? 0) -
+                  (source[1]?.[p + size] ?? 0) -
+                  (b[p + size] ?? 0) +
+                  (output[1]?.[p + size] ?? 0)
+                : (a[p + size] ?? 0) - (b[p + size] ?? 0)
+            total += maskedWeight * (error - next) ** 2 * (mode === 'gradient3' ? 3 : 1)
+          }
+        }
+    }
+    return total
+  }
+  for (let c = 0; c < 3; c++) {
+    const a = scratch[c * 2],
+      b = scratch[c * 2 + 1]
+    if (!a || !b) throw new Error('Missing filter loss scratch')
+    for (let y = 0; y < height; y++)
+      for (let x = 0; x < width; x++) {
+        const p = y * size + x
+        a[p] =
+          c === 0
+            ? (source[0]?.[p] ?? 0) * 14
+            : c === 1
+              ? (source[1]?.[p] ?? 0)
+              : (source[2]?.[p] ?? 0) - (source[1]?.[p] ?? 0)
+        b[p] =
+          c === 0
+            ? (output[0]?.[p] ?? 0) * 14
+            : c === 1
+              ? (output[1]?.[p] ?? 0)
+              : (output[2]?.[p] ?? 0) - (output[1]?.[p] ?? 0)
+      }
+    let w = width,
+      h = height
+    for (let scale = 0; scale < levels; scale++) {
+      let structural = 0,
+        structural4 = 0,
+        ringing = 0,
+        blur = 0,
+        ringing4 = 0,
+        blur4 = 0,
+        count = 0
+      for (let ty = 0; ty < h; ty += 4)
+        for (let tx = 0; tx < w; tx += 4) {
+          let sa = 0,
+            sb = 0,
+            saa = 0,
+            sbb = 0,
+            sab = 0,
+            n = 0
+          for (let y = ty; y < Math.min(h, ty + 4); y++)
+            for (let x = tx; x < Math.min(w, tx + 4); x++) {
+              const p = y * size + x,
+                av = a[p] ?? 0,
+                bv = b[p] ?? 0
+              sa += av
+              sb += bv
+              saa += av * av
+              sbb += bv * bv
+              sab += av * bv
+              n++
+            }
+          const ma = sa / n,
+            mb = sb / n,
+            va = Math.max(0, saa / n - ma * ma),
+            vb = Math.max(0, sbb / n - mb * mb),
+            cov = sab / n - ma * mb
+          const d = Math.max(
+            0,
+            1 - ((1 - (ma - mb) ** 2) * (2 * cov + 0.0009)) / (va + vb + 0.0009),
+          )
+          structural += d * n
+          structural4 += d ** 4 * n
+          count += n
+          if (metric || mode === 'detail' || mode === 'multiscale' || mode === 'hybrid')
+            for (let y = ty; y < Math.min(h, ty + 4); y++)
+              for (let x = tx; x < Math.min(w, tx + 4); x++) {
+                const p = y * size + x
+                const edge = (1 + Math.abs((b[p] ?? 0) - mb)) / (1 + Math.abs((a[p] ?? 0) - ma)) - 1
+                ringing += Math.max(0, edge)
+                blur += Math.max(0, -edge)
+                if (metric) {
+                  ringing4 += Math.max(0, edge) ** 4
+                  blur4 += Math.max(0, -edge) ** 4
+                }
+              }
+        }
+      if (count) {
+        const structure = mode === 'tail' ? (structural4 / count) ** 0.25 : structural / count
+        if (metric) {
+          const at = (c * 6 + scale) * 6
+          total +=
+            ((filterMetricWeights[at] ?? 0) * structural) / count +
+            ((filterMetricWeights[at + 1] ?? 0) * ringing) / count +
+            ((filterMetricWeights[at + 2] ?? 0) * blur) / count +
+            (filterMetricWeights[at + 3] ?? 0) * (structural4 / count) ** 0.25 +
+            (filterMetricWeights[at + 4] ?? 0) * (ringing4 / count) ** 0.25 +
+            (filterMetricWeights[at + 5] ?? 0) * (blur4 / count) ** 0.25
+        } else
+          total +=
+            (c === 1 ? 1 : 0.2) *
+            (structure + (ringing + 2 * blur) / count) *
+            (scale === 0 ? 1 : 0.5)
+      }
+      if (scale + 1 < levels) {
+        const nextW = Math.ceil(w / 2),
+          nextH = Math.ceil(h / 2)
+        for (let y = 0; y < nextH; y++)
+          for (let x = 0; x < nextW; x++) {
+            const p = y * 2 * size + x * 2,
+              right = Math.min(w - 1, x * 2 + 1) - x * 2,
+              bottom = (Math.min(h - 1, y * 2 + 1) - y * 2) * size
+            a[y * size + x] =
+              ((a[p] ?? 0) +
+                (a[p + right] ?? 0) +
+                (a[p + bottom] ?? 0) +
+                (a[p + bottom + right] ?? 0)) *
+              0.25
+            b[y * size + x] =
+              ((b[p] ?? 0) +
+                (b[p + right] ?? 0) +
+                (b[p + bottom] ?? 0) +
+                (b[p + bottom + right] ?? 0)) *
+              0.25
+          }
+        w = nextW
+        h = nextH
+      }
+    }
+  }
+  return total
+}
+
+/** A newly nonzero diagnostic has no finite percentage relative to zero. */
+export function filterFeaturePercent(candidate: number, control: number): number | null {
+  return control === 0 ? (candidate === 0 ? 0 : null) : (candidate / control - 1) * 100
+}
diff --git a/benchmark/jpegxl/lossy-lab/libjxl-filter-gaussian-loss.ts b/benchmark/jpegxl/lossy-lab/libjxl-filter-gaussian-loss.ts
