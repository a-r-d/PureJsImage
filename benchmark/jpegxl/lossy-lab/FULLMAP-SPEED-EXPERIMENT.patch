+import { expect, it } from 'vitest'
+import {
+  preparePerceptualImage,
+  perceptualQuadraticMaps,
+} from '../benchmark/jpegxl/lossy-lab/libjxl-perceptual-local-port.ts'
+import {
+  perceptualDirectionalMap,
+  maltaDirectionalCost,
+} from '../benchmark/jpegxl/lossy-lab/libjxl-perceptual-malta-port.ts'
+
+it('preserves complete metric inputs and values at sampled output locations', () => {
+  const width = 37,
+    height = 31,
+    a = new Uint8Array(width * height * 4),
+    b = a.slice()
+  for (let p = 0; p < width * height; p++)
+    for (let c = 0; c < 4; c++) {
+      a[p * 4 + c] = c === 3 ? 255 : (p * 7 + c * 31) % 256
+      b[p * 4 + c] = c === 3 ? 255 : (p * 7 + c * 31 + (p % 13 < 7 ? 11 : 0)) % 256
+    }
+  const source = preparePerceptualImage(a, width, height),
+    decoded = preparePerceptualImage(b, width, height)
+  for (const box of [undefined, { x: 7, y: 9, width: 29, height: 21 }]) {
+    const w = box?.width ?? width,
+      h = box?.height ?? height,
+      fullQ = perceptualQuadraticMaps(source, decoded, box),
+      full = perceptualDirectionalMap(source, decoded, fullQ.asymmetric, box)
+    for (const step of [2, 4, 8]) {
+      const sparseQ = perceptualQuadraticMaps(source, decoded, box, step),
+        sparse = perceptualDirectionalMap(source, decoded, sparseQ.asymmetric, box, step)
+      for (let y = 0; y < h; y++)
+        for (let x = 0; x < w; x++) {
+          const p = y * w + x,
+            sampled = x % step === 0 && y % step === 0
+          expect(sparse[p]).toBe(sampled ? full[p] : 0)
+          expect(sparseQ.asymmetric[p]).toBe(sampled ? fullQ.asymmetric[p] : 0)
+          expect(sparseQ.masked[p]).toBe(sampled ? fullQ.masked[p] : 0)
+          expect(sparseQ.unmasked[p]).toBe(sampled ? fullQ.unmasked[p] : 0)
+        }
+    }
+  }
+  for (const step of [0, 3, -1, Number.NaN]) {
+    expect(() => perceptualQuadraticMaps(source, decoded, undefined, step)).toThrow('sampling')
+    expect(() =>
+      perceptualDirectionalMap(source, decoded, new Float64Array(width * height), undefined, step),
+    ).toThrow('sampling')
+    expect(() =>
+      maltaDirectionalCost(
+        source.hf[0],
+        decoded.hf[0],
+        width,
+        height,
+        1,
+        5,
+        'low',
+        undefined,
+        step,
+      ),
+    ).toThrow('sampling')
+  }
+})
