+import { describe, expect, it } from 'vitest'
+import { libjxlRefineQuantField } from '../benchmark/jpegxl/lossy-lab/libjxl-quant-refine-port.ts'
+
+describe('development reconstruction-driven quantization', () => {
+  it('redistributes precision without changing the source field', () => {
+    const field = new Int32Array([100, 100]),
+      map = new Float64Array(16 * 8)
+    for (let y = 0; y < 8; y++) for (let x = 0; x < 16; x++) map[y * 16 + x] = x < 8 ? 1 : 2
+    const result = libjxlRefineQuantField(
+      {
+        blocksWide: 2,
+        blocksHigh: 1,
+        quantizationMap: field,
+        strategyMap: new Int32Array(2),
+        developmentFirstBlocks: new Uint8Array([1, 1]),
+      },
+      map,
+      16,
+      8,
+      2,
+    )
+    expect(Array.from(result)).toEqual([90, 120])
+    expect(Array.from(field)).toEqual([100, 100])
+  })
+  it('keeps a selected transform coherent at cropped image edges', () => {
+    const g = {
+      blocksWide: 2,
+      blocksHigh: 2,
+      quantizationMap: new Int32Array(4).fill(100),
+      strategyMap: new Int32Array(4).fill(4),
+      developmentFirstBlocks: new Uint8Array([1, 0, 0, 0]),
+    }
+    expect(
+      Array.from(libjxlRefineQuantField(g, new Float64Array(13 * 9).fill(2), 13, 9, 2)),
+    ).toEqual([120, 120, 120, 120])
+    expect(
+      Array.from(libjxlRefineQuantField(g, new Float64Array(13 * 9).fill(100), 13, 9, 2)),
+    ).toEqual([256, 256, 256, 256])
+    expect(Array.from(libjxlRefineQuantField(g, new Float64Array(13 * 9), 13, 9, 2))).toEqual([
+      3, 3, 3, 3,
+    ])
+  })
+  it('rejects malformed error maps and target distances', () => {
+    const g = {
+      blocksWide: 1,
+      blocksHigh: 1,
+      quantizationMap: new Int32Array([100]),
+      strategyMap: new Int32Array([0]),
+      developmentFirstBlocks: new Uint8Array([1]),
+    }
+    expect(() => libjxlRefineQuantField(g, new Float64Array(64).fill(NaN), 8, 8, 2)).toThrow(
+      'Invalid perceptual',
+    )
+    expect(() => libjxlRefineQuantField(g, new Float64Array(64), 8, 8, 0)).toThrow(
+      'Invalid refinement',
+    )
+    expect(() => libjxlRefineQuantField(g, new Float64Array(63), 8, 8, 2)).toThrow(
+      'Invalid refinement',
+    )
+  })
+})
