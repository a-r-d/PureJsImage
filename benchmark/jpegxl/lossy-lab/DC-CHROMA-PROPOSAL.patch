@@ -0,0 +1,18 @@
+/**
+ * Source: libjxl lib/jxl/enc_modular.cc, AddVarDCTDC; v0.12.0,
+ * a7a9c787341cf703dede03c2009fa460cae5e5df.
+ * Copyright (c) the JPEG XL Project Authors. BSD-3-Clause
+ * Changes: scalar TypeScript preserves our Float64 transform/DC arithmetic,
+ * physical allocation and nearest rounding. Restore B from B-Y before removing
+ * reconstructed luma. No nonlinear quantizer, extra precision or smoothing.
+ * Proposal only: no candidate encoder has executed this module.
+ */
+export function libjxlDcCorrelationResidual(
+  value: number,
+  originalY: number,
+  reconstructedY: number,
+  factor: number,
+  blue: boolean,
+): number {
+  return (blue ? value + originalY : value) - reconstructedY * factor
+}
