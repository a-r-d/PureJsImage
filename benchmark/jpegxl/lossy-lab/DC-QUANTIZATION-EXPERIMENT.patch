+/**
+ * Source: libjxl lib/jxl/enc_modular.cc, QuantizeWP and AddVarDCTDC;
+ * lib/jxl/quantizer.h and modular/encoding/context_predict.h; v0.12.0,
+ * a7a9c787341cf703dede03c2009fa460cae5e5df.
+ * Copyright (c) the JPEG XL Project Authors. BSD-3-Clause
+ * Changes: scalar TypeScript uses our first-party weighted predictor and memory
+ * ledger. Gather DC at one sample per 8x8 cell; reset prediction per DC group.
+ * Restore B from B-Y before subtracting reconstructed Y. Preserve float32
+ * boundaries and round halfway away from zero. Reject out-of-range integers.
+ * No native infrastructure, peer decisions or runtime dependencies.
+ */
+import {
+  defaultJpegXlWeightedPredictor,
+  JpegXlWeightedPredictor,
+} from '../../../src/codecs/jpegxl-decode.ts'
+import type { JpegXlEncoderMemory } from '../../../src/codecs/jpegxl-encoder-memory.ts'
+import type { VarDctCoefficientGeometry } from '../../../src/codecs/jpegxl-jpeg-encode.ts'
+
+const deadZone = Math.fround(0.62)
+
+/** Quantize a scaled value relative to the current weighted prediction. */
+export function libjxlNonlinearDcValue(value: number, inverseStep: number, prediction: number): number {
+  let residual = Math.fround(Math.fround(value * inverseStep) - prediction)
+  if (residual > -deadZone && residual < deadZone) residual = 0
+  if (!Number.isFinite(residual)) throw new Error('Non-finite DC quantizer input')
+  let rounded = Math.sign(residual) * Math.floor(Math.abs(residual) + 0.5)
+  if (rounded > 2 || rounded < -2)
+    rounded = Math.sign(residual) * Math.floor(Math.abs(residual * 0.5) + 0.5) * 2
+  const result = rounded + prediction
+  if (!Number.isSafeInteger(result) || result < -2_147_483_648 || result > 2_147_483_647)
+    throw new Error('DC quantizer exceeds signed 32-bit range')
+  return result === 0 ? 0 : result
+}
+
+/** In-place source adaptation; the incoming blue plane stores B minus original Y. */
+export function libjxlDcChromaResidual(
+  value: number, originalY: number, quantizedY: number, yStep: number,
+  factor: number, blue: boolean,
+): number {
+  const original = blue ? Math.fround(value + originalY) : value
+  return Math.fround(original - Math.fround(quantizedY * Math.fround(yStep * factor)))
+}
+
+export function libjxlQuantizeDcPlane(
+  source: Float32Array,
+  target: Int32Array,
+  stride: number,
+  originX: number,
+  originY: number,
+  width: number,
+  height: number,
+  inverseStep: number,
+  memory: JpegXlEncoderMemory,
+): void {
+  if (!(inverseStep > 0) || !Number.isFinite(inverseStep) || width < 1 || height < 1 ||
+      originX < 0 || originY < 0 || originX + width > stride ||
+      (originY + height) * stride > source.length || source.length !== target.length)
+    throw new Error('Invalid DC plane geometry or precision')
+  memory.run(() => {
+    const predictor = new JpegXlWeightedPredictor(width, defaultJpegXlWeightedPredictor, {
+      predictions: memory.allocate(Float64Array, 4),
+      predictionErrors: Array.from({ length: 4 }, () => memory.allocate(Uint32Array, (width + 2) * 2)),
+      errors: memory.allocate(Int32Array, (width + 2) * 2),
+    })
+    const properties = memory.allocate(Int32Array, 16)
+    for (let y = 0; y < height; y++) {
+      const row = (originY + y) * stride + originX
+      for (let x = 0; x < width; x++) {
+        const at = row + x
+        const left = x > 0 ? (target[at - 1] ?? 0) : y > 0 ? (target[at - stride] ?? 0) : 0
+        const top = y > 0 ? (target[at - stride] ?? 0) : left
+        const topLeft = x > 0 && y > 0 ? (target[at - stride - 1] ?? 0) : left
+        const topRight = x + 1 < width && y > 0 ? (target[at - stride + 1] ?? 0) : top
+        const topTop = y > 1 ? (target[at - 2 * stride] ?? 0) : top
+        const prediction = predictor.predict(x, y, width, top, left, topRight, topLeft, topTop, properties)
+        const quantized = libjxlNonlinearDcValue(source[at] ?? 0, inverseStep, prediction)
+        target[at] = quantized
+        predictor.update(quantized, x, y)
+      }
+    }
+  })
+}
+
+export function libjxlQuantizeDc(base: VarDctCoefficientGeometry, source: readonly Float32Array[]): void {
+  const memory = base.memory
+  const width = base.blocksWide, height = base.blocksHigh
+  if (!memory || base.colorTransform !== 'xyb' || base.shifts.some(shift => shift[0] !== 0 || shift[1] !== 0))
+    throw new Error('Nonlinear DC trial requires planar XYB 4:4:4')
+  const y = base.dcComponents[0], x = base.dcComponents[1], b = base.dcComponents[2]
+  const sourceX = source[0], sourceY = source[1], sourceB = source[2]
+  if (!x || !y || !b || !(x.coefficients instanceof Int32Array) ||
+      !(y.coefficients instanceof Int32Array) || !(b.coefficients instanceof Int32Array) ||
+      x.coefficientStride !== 1 || y.coefficientStride !== 1 || b.coefficientStride !== 1 ||
+      !sourceX || !sourceY || !sourceB || source.some(plane => plane.length !== width * height))
+    throw new Error('Invalid nonlinear DC coefficient storage')
+  const global = Math.fround((base.globalScale ?? 0) / 65536)
+  const quantizedScale = Math.fround(global * (base.quantDc ?? 0))
+  const inverseQuantDc = Math.fround(1 / quantizedScale)
+  const dcQuantization = base.dcQuantization
+  if (!dcQuantization || dcQuantization.length !== 3 || dcQuantization.some(step => !(step > 0)))
+    throw new Error('Missing nonlinear DC matrix')
+  const inverseSteps = dcQuantization.map(step => Math.fround(Math.fround(1 / Math.fround(step)) * quantizedScale) * 2)
+  const yStep = Math.fround(inverseQuantDc * Math.fround(dcQuantization[1] ?? 0)) / 2
+  const correlation = base.developmentCorrelation
+  const colorScale = Math.fround(1 / (correlation?.colorFactor ?? 84))
+  const xFactor = Math.fround((correlation?.baseCorrelationX ?? 0) + Math.fround((correlation?.yToXDc ?? 0) * colorScale))
+  const bFactor = Math.fround((correlation?.baseCorrelationB ?? base.baseB ?? 0) + Math.fround((correlation?.yToBDc ?? 0) * colorScale))
+  for (let originY = 0; originY < height; originY += 256) {
+    for (let originX = 0; originX < width; originX += 256) {
+      const groupWidth = Math.min(256, width - originX), groupHeight = Math.min(256, height - originY)
+      libjxlQuantizeDcPlane(sourceY, y.coefficients, width, originX, originY, groupWidth, groupHeight, inverseSteps[1] ?? 0, memory)
+      for (let row = 0; row < groupHeight; row++) {
+        const start = (originY + row) * width + originX
+        for (let column = 0; column < groupWidth; column++) {
+          const at = start + column
+          sourceX[at] = libjxlDcChromaResidual(sourceX[at] ?? 0, sourceY[at] ?? 0, y.coefficients[at] ?? 0, yStep, xFactor, false)
+          sourceB[at] = libjxlDcChromaResidual(sourceB[at] ?? 0, sourceY[at] ?? 0, y.coefficients[at] ?? 0, yStep, bFactor, true)
+        }
+      }
+      libjxlQuantizeDcPlane(sourceX, x.coefficients, width, originX, originY, groupWidth, groupHeight, inverseSteps[0] ?? 0, memory)
+      libjxlQuantizeDcPlane(sourceB, b.coefficients, width, originX, originY, groupWidth, groupHeight, inverseSteps[2] ?? 0, memory)
+    }
+  }
+}
