@@ -0,0 +1,61 @@
+import { describe, expect, it } from 'vitest'
+import { libjxlRefineQuantField } from '../benchmark/jpegxl/lossy-lab/libjxl-quant-refine-port.ts'
+
+describe('development reconstruction-driven quantization', () => {
+  it('redistributes precision without changing the source field', () => {
+    const field = new Int32Array([100, 100]),
+      map = new Float64Array(16 * 8)
+    for (let y = 0; y < 8; y++) for (let x = 0; x < 16; x++) map[y * 16 + x] = x < 8 ? 1 : 2
