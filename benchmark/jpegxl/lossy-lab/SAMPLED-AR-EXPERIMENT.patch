+        let bx = Math.floor(sampleX / 8);
+        bx < Math.ceil(Math.min(width, sampleX + patch) / 8);
+        bx++
+      ) {
+        const block = context.readBlock(bx, by, false)
+        for (
+          let y = Math.max(sampleY, by * 8);
+          y < Math.min(height, sampleY + patch, by * 8 + 8);
+          y++
+        )
+          for (
+            let x = Math.max(sampleX, bx * 8);
+            x < Math.min(width, sampleX + patch, bx * 8 + 8);
+            x++
+          ) {
+            const p = (y - sampleY) * patch + x - sampleX,
