index 00000000..f71d74b9
--- /dev/null
+++ b/tests/jpegxl-sampled-ar.test.ts
@@ -0,0 +1,137 @@
+import { expect, it } from 'vitest'
+import {
+  sharpnessMapCost,
+  sharpnessResidual,
+} from '../benchmark/jpegxl/lossy-lab/sampled-sharpness-cost.ts'
+import { libjxlSampledArSharpness } from '../benchmark/jpegxl/lossy-lab/libjxl-sampled-ar-port.ts'
+import { libjxlPortOverrides } from '../benchmark/jpegxl/lossy-lab/libjxl-ports.ts'
+import { encodeTransplant } from '../benchmark/jpegxl/lossy-lab/transplant.ts'
+import { convertJpegXlNativeXybPlanes } from '../src/codecs/jpegxl-vardct-render.ts'
+import { jpegxlCodec } from '../src/codecs/jpegxl.ts'
+import { MemorySource } from '../src/source.ts'
+import { defaultImageLimits } from '../src/limits.ts'
+
+it('charges map transitions and predicts incremental cost across image and DC-group edges', () => {
+  const width = 269,
+    height = 263
+  const map = new Uint8Array(width * height).fill(4)
+  const cost = sharpnessMapCost(map, width, height)
+  for (const [x, y, right, bottom, value] of [
+    [0, 0, 8, 8, 0],
+    [8, 0, 16, 8, 7],
+    [254, 253, 269, 263, 2],
+    [0, 0, 269, 263, 7],
+    [256, 256, 269, 263, 4],
+  ]) {
+    if (
+      x === undefined ||
+      y === undefined ||
+      right === undefined ||
+      bottom === undefined ||
+      value === undefined
+    )
+      throw new Error('Missing region')
+    const before = cost.bits(),
+      copy = map.slice()
+    const delta = cost.change(x, y, right, bottom, value)
+    expect(map).toEqual(copy)
+    for (let row = y; row < bottom; row++) copy.fill(value, row * width + x, row * width + right)
+    const expected = sharpnessMapCost(copy, width, height).bits()
+    expect(before + delta).toBeCloseTo(expected, 8)
+    expect(cost.change(x, y, right, bottom, value, true)).toBeCloseTo(delta, 8)
+    expect(cost.bits()).toBeCloseTo(expected, 8)
+    expect(map).toEqual(copy)
+  }
+  const flat = new Uint8Array(4096).fill(4),
+    flatCost = sharpnessMapCost(flat, 64, 64)
+  expect(flatCost.change(8, 8, 16, 16, 0)).toBeGreaterThan(0)
+  expect(sharpnessResidual(flat, 64, 0, 0)).toBe(11)
+  expect(sharpnessResidual(flat, 64, 1, 0)).toBe(7)
+})
+
+it.each([
+  [73, 29],
+  [273, 37],
+  [1, 9],
+] as const)(
+  'sampled final-coefficient reconstruction matches full decoding for %ix%i',
+  async (width, height) => {
+    const pixels = Uint8Array.from({ length: width * height * 4 }, (_, i) =>
+      i % 4 === 3
+        ? 255
+        : Math.round(
+            100 +
+              (i % 4) * 20 +
+              25 * Math.sin(Math.floor(i / 4) / 7) +
+              15 * Math.cos(Math.floor(i / 4 / width) / 5),
+          ),
+    )
+    const reconstructed = [
+      new Float64Array(width * height),
+      new Float64Array(width * height),
+      new Float64Array(width * height),
+    ] as const
+    const seen = new Uint8Array(width * height)
+    const overrides = libjxlPortOverrides('standalone-forward-all', 2, width, height),
+      rewrite = overrides.rewriteGeometry
+    if (!rewrite) throw new Error('Missing standalone rewrite')
+    const encoded = await encodeTransplant(pixels, width, height, 2, {
+      ...overrides,
+      rewriteGeometry(base, context) {
+        const geometry = rewrite(base, context)
+        libjxlSampledArSharpness(
+          geometry,
+          context,
+          2,
+          width,
+          height,
+          { region: 32, patch: 16, count: 4, rate: 1 },
+          (sharpness, x, y, size, planes) => {
+            if (sharpness !== 4) return
+            for (let py = 0; py < Math.min(size, height - y); py++)
+              for (let px = 0; px < Math.min(size, width - x); px++) {
+                const at = (y + py) * width + x + px
+                seen[at] = 1
+                for (let c = 0; c < 3; c++) {
+                  const target = reconstructed[c]
+                  if (!target) throw new Error('Missing reconstruction target')
+                  target[at] = planes[c]?.[py * size + px] ?? 0
+                }
+              }
+          },
+        )
+        geometry.sharpnessMap?.fill(4)
+        return geometry
+      },
+    })
+    const rgb = convertJpegXlNativeXybPlanes(reconstructed, undefined)
+    const decoder = await jpegxlCodec.createDecoder?.(
+      new MemorySource(encoded.bytes),
+      defaultImageLimits,
+    )
+    if (!decoder) throw new Error('Missing decoder')
+    let maximum = 0,
+      count = 0
+    for await (const block of decoder.decode()) {
+      try {
+        for (let y = 0; y < block.height; y++)
+          for (let x = 0; x < block.width; x++) {
+            const at = (block.y + y) * width + x
+            if (!seen[at]) continue
+            for (let c = 0; c < 3; c++) {
+              const expected = Math.max(0, Math.min(255, Math.round((rgb[c]?.[at] ?? 0) * 255)))
+              maximum = Math.max(
+                maximum,
+                Math.abs(expected - (block.data[y * block.stride + x * 4 + c] ?? 0)),
+              )
+              count++
+            }
+          }
+      } finally {
+        block.release?.()
+      }
+    }
+    expect(count).toBeGreaterThan(0)
+    expect(maximum).toBeLessThanOrEqual(1)
+  },
+)
