+          Math.abs((filtered[1][p] ?? 0) - (filtered[1][p + 1] ?? 0)) * 5 +
+          Math.abs((filtered[2][p] ?? 0) - (filtered[2][p + 1] ?? 0)) * 3.5
+        differences[1][p] =
+          Math.abs((filtered[0][p] ?? 0) - (filtered[0][p + stride] ?? 0)) * 40 +
+          Math.abs((filtered[1][p] ?? 0) - (filtered[1][p + stride] ?? 0)) * 5 +
+          Math.abs((filtered[2][p] ?? 0) - (filtered[2][p + stride] ?? 0)) * 3.5
+      }
+    for (
+      let by = Math.floor(sampleY / 8);
+      by < Math.ceil(Math.min(height, sampleY + patch) / 8);
+      by++
+    )
