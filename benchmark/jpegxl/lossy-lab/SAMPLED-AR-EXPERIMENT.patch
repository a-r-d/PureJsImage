+/**
+ * Source: libjxl lib/jxl/enc_heuristics.cc, ComputeARHeuristics and
+ * ComputeBlockL2Distance, v0.12.0, a7a9c787341cf703dede03c2009fa460cae5e5df.
+ * Copyright (c) the JPEG XL Project Authors. BSD-3-Clause
+ * Changes: reconstruct sampled patches from our final coefficients, use our
+ * one-iteration filter policy, include sharpness four and test the native zero bias separately.
+ * Select one sharpness per coarse region using first-party estimated map bits.
+ * Bounded scratch, original pixels and our decisions only. Development only.
+ */
+import type { JpegXlDevelopmentTransformContext } from '../../../src/codecs/jpegxl-development-decisions.ts'
+import type { VarDctCoefficientGeometry } from '../../../src/codecs/jpegxl-jpeg-encode.ts'
+import {
+  jpegXlDevelopmentDequantization,
+  populateJpegXlDevelopmentLowestFrequencies,
+} from '../../../src/codecs/jpegxl-vardct-render.ts'
+import {
+  jpegXlVarDctStrategyBlockWidths as widths,
+  jpegXlVarDctStrategyBlockHeights as heights,
+} from '../../../src/codecs/jpegxl-vardct-jpeg.ts'
+import { defaultJpegXlQuantizationBiases } from '../../../src/codecs/jpegxl-vardct-quantization.ts'
+import { inverseWeightedSelectorTransform } from './selector-inverse-weights.ts'
+import { sampledTileMask } from './sampled-tile-mask.ts'
+import { sharpnessMapCost } from './sampled-sharpness-cost.ts'
+
+export interface SampledArOptions {
+  readonly region: number
+  readonly patch: number
+  readonly count: number
+  readonly rate: number
+  readonly globalError?: boolean
+  readonly zeroBias?: boolean
+}
+export function sampledArOptions(mode: string): SampledArOptions | undefined {
+  switch (mode) {
+    case 'standalone-sample64-global-rd':
+      return { region: 64, patch: 16, count: 1, rate: 1, globalError: true }
+    case 'standalone-sample64-four-global-rd':
+      return { region: 64, patch: 16, count: 4, rate: 1, globalError: true }
+    case 'standalone-sample64-native':
+      return { region: 64, patch: 16, count: 4, rate: 1, zeroBias: true }
+    case 'standalone-sample-global-native':
+      return { region: 0, patch: 16, count: 4, rate: 1, zeroBias: true }
+    case 'standalone-sample64':
+      return { region: 64, patch: 16, count: 1, rate: 1 }
+    case 'standalone-sample128':
+      return { region: 128, patch: 16, count: 1, rate: 1 }
+    case 'standalone-sample32':
+      return { region: 32, patch: 8, count: 1, rate: 1 }
+    case 'standalone-sample-global':
+      return { region: 0, patch: 16, count: 4, rate: 1 }
+    case 'standalone-sample64-small':
+      return { region: 64, patch: 8, count: 1, rate: 2 }
+    case 'standalone-sample64-four':
+      return { region: 64, patch: 16, count: 4, rate: 1 }
+    case 'standalone-sample64-rate4':
+      return { region: 64, patch: 16, count: 1, rate: 4 }
+    case 'standalone-sample64-rate0':
+      return { region: 64, patch: 16, count: 1, rate: 0 }
+    default:
+      return undefined
+  }
+}
+function mirror(value: number, size: number): number {
+  let p = value
+  while (p < 0 || p >= size) p = p < 0 ? -p - 1 : 2 * size - p - 1
+  return p
+}
+
+export function libjxlSampledArSharpness(
+  base: VarDctCoefficientGeometry,
+  context: JpegXlDevelopmentTransformContext,
+  distance: number,
+  width: number,
+  height: number,
+  options: SampledArOptions,
+  observe?: (
+    sharpness: number,
+    x: number,
+    y: number,
+    size: number,
+    planes: readonly Float32Array[],
+  ) => void,
+): void {
+  const memory = base.memory,
+    sharpness = base.sharpnessMap,
+    strategies = base.strategyMap,
+    first = base.developmentFirstBlocks,
+    quantization = base.quantizationMap
+  if (!memory || !sharpness || !strategies || !first || !quantization || !base.loadAc)
+    throw new Error('Missing sampled AR geometry')
+  if (distance < 0.5 || base.developmentFilters?.epfIterations === 0) return
+  if (base.smoothDc || base.developmentFilters?.epfIterations !== 1)
+    throw new Error('Sampled AR requires unsmoothed DC and one EPF iteration')
+  const loadAc = base.loadAc
+  const patch = options.patch,
+    stride = patch + 16,
+    length = stride * stride
+  const raw = [
+    memory.allocate(Float32Array, length),
+    memory.allocate(Float32Array, length),
+    memory.allocate(Float32Array, length),
+  ] as const
+  const filtered = [
+    memory.allocate(Float32Array, length),
+    memory.allocate(Float32Array, length),
+    memory.allocate(Float32Array, length),
+  ] as const
+  const source = [
+    memory.allocate(Float32Array, patch * patch),
+    memory.allocate(Float32Array, patch * patch),
+    memory.allocate(Float32Array, patch * patch),
+  ] as const
+  const output = [
+    memory.allocate(Float32Array, patch * patch),
+    memory.allocate(Float32Array, patch * patch),
+    memory.allocate(Float32Array, patch * patch),
+  ] as const
+  const differences = [
+    memory.allocate(Float32Array, length),
+    memory.allocate(Float32Array, length),
+  ] as const
+  const values = [
+    memory.allocate(Float64Array, 4096),
+    memory.allocate(Float64Array, 4096),
+    memory.allocate(Float64Array, 4096),
+  ] as const
+  const samples = [
+    memory.allocate(Float32Array, 4096),
+    memory.allocate(Float32Array, 4096),
+    memory.allocate(Float32Array, 4096),
+  ] as const
+  const scratch = memory.allocate(Float64Array, 4096),
+    dc = memory.allocate(Float64Array, 64),
+    frequencies = memory.allocate(Float64Array, 64),
+    active = memory.allocate(Uint16Array, 64),
+    seen = memory.allocate(Int32Array, 100)
+  const errors = memory.allocate(Float64Array, 4),
+    steps = [0, 2, 4, 7] as const
+  const mask = sampledTileMask(base, context, patch)
+  const cost = sharpnessMapCost(sharpness, base.blocksWide, base.blocksHigh)
+  const invGlobal = 65536 / (base.globalScale ?? 0)
+  // A cheap complete-file rate normalizer from our final quantized coefficients.
+  // Absolute map bits come from the predictor histogram, not this coefficient proxy.
+  let fileBits = strategies.length * 6
+  for (let group = 0; group < base.groupsAcross * base.groupsDown; group++) {
+    fileBits += 128
+    for (const plane of loadAc(group, 0))
+      for (let p = 0; p < plane.coefficients.length; p++) {
+        const q = Math.abs(plane.coefficients[p] ?? 0)
+        if (q) fileBits += 2 + 32 - Math.clz32(q)
+      }
+  }
+  const sampleErrors = (sampleX: number, sampleY: number): void => {
+    const originX = sampleX - 8,
+      originY = sampleY - 8
+    const right = Math.min(width, originX + stride),
+      bottom = Math.min(height, originY + stride)
+    const left = Math.max(0, originX),
+      top = Math.max(0, originY)
+    let seenCount = 0
+    for (let by = Math.floor(top / 8); by < Math.ceil(bottom / 8); by++)
+      for (let bx = Math.floor(left / 8); bx < Math.ceil(right / 8); bx++) {
+        const strategy: number = strategies[by * base.blocksWide + bx] ?? 0
+        const bw: number = widths[strategy] ?? 0,
+          bh: number = heights[strategy] ?? 0
+        const ox: number = bx - (bx % bw),
+          oy: number = by - (by % bh),
+          owner: number = oy * base.blocksWide + ox
+        if (!bw || !bh || first[owner] !== 1) throw new Error('Unaligned sampled transform')
+        let found = false
+        for (let i = 0; i < seenCount; i++)
+          if (seen[i] === owner) {
+            found = true
+            break
+          }
+        if (found) continue
+        seen[seenCount++] = owner
+        {
+          const x = owner % base.blocksWide,
+            y = Math.floor(owner / base.blocksWide)
+          const strategy = strategies[owner] ?? 0,
+            bw = widths[strategy] ?? 0,
+            bh = heights[strategy] ?? 0
+          const size = bw * bh * 64
+          const group = Math.floor(y / 32) * base.groupsAcross + Math.floor(x / 32)
+          const planes = loadAc(group, 0)
+          const tile = Math.floor(y / 8) * Math.ceil(base.blocksWide / 8) + Math.floor(x / 8)
+          const correlation = base.developmentCorrelation
+          for (let c = 0; c < 3; c++) {
+            const plane = planes[c],
+              target = values[c],
+              matrix = jpegXlDevelopmentDequantization(strategy)[c]
+            const dcPlane = base.dcComponents[c < 2 ? c ^ 1 : c]?.coefficients
+            const dst = samples[c]
+            if (!plane || !target || !matrix || !dcPlane || !dst)
+              throw new Error('Missing AR coefficient plane')
+            const offset =
+              plane.coefficientOffsets?.[(y % 32) * plane.blocksPerLineForMcu + (x % 32)]
+            if (offset === undefined || offset < 0) throw new Error('Missing AR coefficient offset')
+            const scale =
+              (invGlobal / (quantization[owner] ?? 1)) *
+              (c === 0
+                ? 0.8 ** ((base.xScale ?? 2) - 2)
+                : c === 2
+                  ? 0.8 ** ((base.bScale ?? 2) - 2)
+                  : 1)
+            for (let p = 0; p < size; p++) {
+              const q =
+                plane.coefficients[offset + (size === 64 ? (p & 7) * 8 + (p >>> 3) : p)] ?? 0
+              target[p] =
+                (Math.abs(q) === 1
+                  ? Math.sign(q) * (defaultJpegXlQuantizationBiases[c] ?? 1)
+                  : q === 0
+                    ? 0
+                    : q - 0.145 / q) *
+                scale *
+                (matrix[p] ?? 0)
+            }
+          }
+          for (let c = 0; c < 3; c++) {
+            const target = values[c],
+              dst = samples[c],
+              dcPlane = base.dcComponents[c < 2 ? c ^ 1 : c]?.coefficients
+            if (!target || !dst || !dcPlane) throw new Error('Missing AR inverse plane')
+            const ratio =
+              c === 0
+                ? (correlation?.baseCorrelationX ?? 0) +
+                  (base.correlationX?.[tile] ?? 0) / (correlation?.colorFactor ?? 84)
+                : c === 2
+                  ? (correlation ? correlation.baseCorrelationB - 1 : 0) +
+                    (base.correlationB?.[tile] ?? 0) / (correlation?.colorFactor ?? 84)
+                  : 0
+            if (c !== 1)
+              for (let p = 0; p < size; p++)
+                target[p] = (target[p] ?? 0) + (values[1][p] ?? 0) * ratio
+            const dcStep = (invGlobal * (base.dcQuantization?.[c] ?? 0)) / (base.quantDc ?? 0)
+            for (let dy = 0; dy < bh; dy++)
+              for (let dx = 0; dx < bw; dx++)
+                dc[dy * bw + dx] = (dcPlane[(y + dy) * base.blocksWide + x + dx] ?? 0) * dcStep
+            populateJpegXlDevelopmentLowestFrequencies(target, dc, bw, bh, frequencies)
+            inverseWeightedSelectorTransform(
+              strategy,
+              target.subarray(0, size),
+              scratch,
+              dst.subarray(0, size),
+              active,
+            )
+          }
+          for (let py = Math.max(top, y * 8); py < Math.min(bottom, (y + bh) * 8); py++)
+            for (let px = Math.max(left, x * 8); px < Math.min(right, (x + bw) * 8); px++) {
+              const p = (py - y * 8) * bw * 8 + px - x * 8,
+                at = (py - originY) * stride + px - originX
+              raw[0][at] = samples[0][p] ?? 0
+              raw[1][at] = samples[1][p] ?? 0
+              raw[2][at] = (samples[2][p] ?? 0) + (samples[1][p] ?? 0)
+            }
+        }
+      }
+    // Clamp before forward Gaborish, then mirror the filtered image for EPF.
+    for (let py = 0; py < stride; py++)
+      for (let px = 0; px < stride; px++) {
+        const x = Math.max(left, Math.min(right - 1, originX + px)) - originX
+        const y = Math.max(top, Math.min(bottom - 1, originY + py)) - originY
+        for (let c = 0; c < 3; c++) {
+          const plane = raw[c]
+          if (plane) plane[py * stride + px] = plane[y * stride + x] ?? 0
+        }
+      }
+    const adjacent = 1.1 * 0.104699568,
+      diagonal = 1.1 * 0.055680538,
+      normalization = 1 / (1 + 4 * (adjacent + diagonal))
+    for (let c = 0; c < 3; c++) {
+      const plane = raw[c],
+        target = filtered[c]
+      if (!plane || !target) throw new Error('Missing sampled filter plane')
+      for (let y = 1; y < stride - 1; y++)
+        for (let x = 1; x < stride - 1; x++) {
+          const p = y * stride + x
+          target[p] = base.developmentFilters?.gaborish
+            ? (plane[p] ?? 0) * normalization +
+              ((plane[p - 1] ?? 0) +
+                (plane[p + 1] ?? 0) +
+                (plane[p - stride] ?? 0) +
+                (plane[p + stride] ?? 0)) *
+                (adjacent * normalization) +
+              ((plane[p - stride - 1] ?? 0) +
+                (plane[p - stride + 1] ?? 0) +
+                (plane[p + stride - 1] ?? 0) +
+                (plane[p + stride + 1] ?? 0)) *
+                (diagonal * normalization)
+            : (plane[p] ?? 0)
+        }
+    }
+    for (let y = 2; y < stride - 2; y++)
+      for (let x = 2; x < stride - 2; x++) {
+        const gx = originX + x,
+          gy = originY + y
+        if (gx >= 0 && gx < width && gy >= 0 && gy < height) continue
+        const p = (mirror(gy, height) - originY) * stride + mirror(gx, width) - originX
+        for (let c = 0; c < 3; c++) {
+          const plane = filtered[c]
+          if (plane) plane[y * stride + x] = plane[p] ?? 0
+        }
+      }
+    for (let y = 3; y < stride - 3; y++)
+      for (let x = 3; x < stride - 3; x++) {
+        const p = y * stride + x
+        differences[0][p] =
