+      }
+    mask.fill(sampleX, sampleY)
+    const h = differences[0],
+      v = differences[1]
+    for (let s = 0; s < steps.length; s++) {
+      let error = 0
+      for (let y = 0; y < Math.min(patch, height - sampleY); y++)
+        for (let x = 0; x < Math.min(patch, width - sampleX); x++) {
+          const gx = sampleX + x,
+            gy = sampleY + y,
+            p = (y + 8) * stride + x + 8,
+            dest = y * patch + x
+          const rawQ = quantization[Math.floor(gy / 8) * base.blocksWide + Math.floor(gx / 8)] ?? 1
+          const sigma = Math.min(
+            -1e-4,
+            ((0.46 / (((base.globalScale ?? 0) / 65536) * rawQ * -1.17157287525381)) *
+              (steps[s] ?? 0)) /
+              7,
+          )
+          const inverse = 1 / sigma
+          let wt = 0,
+            wl = 0,
+            wr = 0,
+            wb = 0
+          if (inverse >= -3.9052429175127) {
+            const scale =
+              inverse *
+              1.65 *
+              ((gx & 7) === 0 || (gx & 7) === 7 || (gy & 7) === 0 || (gy & 7) === 7 ? 2 / 3 : 1)
+            wt = Math.max(
+              0,
+              1 +
+                ((v[p - stride] ?? 0) +
+                  (v[p - stride - 1] ?? 0) +
+                  (v[p - 2 * stride] ?? 0) +
+                  (v[p - stride + 1] ?? 0) +
+                  (v[p] ?? 0)) *
+                  scale,
+            )
+            wl = Math.max(
+              0,
+              1 +
+                ((h[p - 1] ?? 0) +
+                  (h[p - 2] ?? 0) +
+                  (h[p - stride - 1] ?? 0) +
+                  (h[p] ?? 0) +
+                  (h[p + stride - 1] ?? 0)) *
+                  scale,
+            )
+            wr = Math.max(
+              0,
+              1 +
+                ((h[p] ?? 0) +
+                  (h[p - 1] ?? 0) +
+                  (h[p - stride] ?? 0) +
+                  (h[p + 1] ?? 0) +
+                  (h[p + stride] ?? 0)) *
+                  scale,
+            )
+            wb = Math.max(
+              0,
+              1 +
+                ((v[p] ?? 0) +
+                  (v[p - 1] ?? 0) +
+                  (v[p - stride] ?? 0) +
+                  (v[p + 1] ?? 0) +
+                  (v[p + stride] ?? 0)) *
+                  scale,
+            )
+          }
+          const total = 1 + wt + wl + wr + wb,
+            m = mask.data[dest] ?? 1
+          for (let c = 0; c < 3; c++) {
+            const plane = filtered[c],
+              target = output[c],
+              original = source[c]
+            if (!plane || !target || !original) throw new Error('Missing sampled error plane')
+            target[dest] =
+              ((plane[p] ?? 0) +
+                wt * (plane[p - stride] ?? 0) +
+                wl * (plane[p - 1] ?? 0) +
+                wr * (plane[p + 1] ?? 0) +
+                wb * (plane[p + stride] ?? 0)) /
+              total
+            const difference = (original[dest] ?? 0) - (target[dest] ?? 0)
+            error +=
+              difference * difference * m * m * (c === 0 ? 12.339445295782363 : c === 1 ? 1 : 0.2)
+          }
+        }
+      errors[s] = (errors[s] ?? 0) + error
+      observe?.(steps[s] ?? 0, sampleX, sampleY, patch, output)
+    }
+  }
+  const region = options.region || Math.max(base.blocksWide, base.blocksHigh) * 8
+  const regionsAcross = Math.ceil((base.blocksWide * 8) / region)
+  const cachedErrors = options.globalError
+    ? memory.allocate(Float64Array, regionsAcross * Math.ceil((base.blocksHigh * 8) / region) * 4)
+    : undefined
+  let totalError = 0
+  const chooseRegion = (
+    rx: number,
+    ry: number,
+    right: number,
+    bottom: number,
+    replay: boolean,
+  ): void => {
+    const at = (Math.floor((ry * 8) / region) * regionsAcross + Math.floor((rx * 8) / region)) * 4
+    const expansion = ((right - rx) * (bottom - ry) * 64) / (patch * patch * options.count)
+    if (cachedErrors && replay) errors.set(cachedErrors.subarray(at, at + 4))
+    else {
+      errors.fill(0)
+      const count = options.count
+      for (let sample = 0; sample < count; sample++) {
+        const fx = count === 1 ? 0.5 : sample % 2 === 0 ? 0.25 : 0.75
+        const fy = count === 1 ? 0.5 : sample < 2 ? 0.25 : 0.75
+        // Place the halo inside a 32-pixel transform tile where possible.
+        const cx = Math.floor(((rx + (right - rx) * fx) * 8) / 32) * 32 + 16
+        const cy = Math.floor(((ry + (bottom - ry) * fy) * 8) / 32) * 32 + 16
+        const x = Math.max(rx * 8, Math.min(width - patch, right * 8 - patch, cx - patch / 2))
+        const y = Math.max(ry * 8, Math.min(height - patch, bottom * 8 - patch, cy - patch / 2))
+        sampleErrors(x, y)
+      }
+    }
+    const baseline = errors[2] ?? 0
+    if (cachedErrors && !replay) {
+      cachedErrors.set(errors, at)
+      totalError += baseline * expansion
+      return
+    }
+    if (!(baseline > 0)) return
+    let best = 4,
+      bestCost = 1
+    const budget = options.globalError
+      ? (fileBits * baseline * expansion) / totalError
+      : (fileBits * (right - rx) * (bottom - ry)) / strategies.length
+    for (let s = 0; s < steps.length; s++) {
+      const value = steps[s] ?? 4
+      const preference =
+        value === 0 && options.zeroBias
+          ? Math.max(0.85970338919928291, 0.98017198824148288 ** Math.min(5, distance))
+          : 1
+      const score =
+        ((errors[s] ?? 0) * preference) / baseline +
+        (options.rate * cost.change(rx, ry, right, bottom, value)) / budget
+      if (score < bestCost) {
+        best = value
+        bestCost = score
+      }
+    }
+    cost.change(rx, ry, right, bottom, best, true)
+  }
+  const visit = (replay: boolean): void => {
+    if (!options.region) chooseRegion(0, 0, base.blocksWide, base.blocksHigh, replay)
+    else
+      for (let gy = 0; gy < base.blocksHigh; gy += 32)
+        for (let gx = 0; gx < base.blocksWide; gx += 32)
+          for (let y = gy; y < Math.min(gy + 32, base.blocksHigh); y += region / 8)
+            for (let x = gx; x < Math.min(gx + 32, base.blocksWide); x += region / 8)
+              chooseRegion(
+                x,
+                y,
+                Math.min(x + region / 8, base.blocksWide),
+                Math.min(y + region / 8, base.blocksHigh),
+                replay,
+              )
+  }
+  try {
+    visit(false)
+    if (cachedErrors) visit(true)
+  } finally {
+    if (cachedErrors) memory.release(cachedErrors)
+    mask.release()
+    for (const buffer of [
+      ...raw,
+      ...filtered,
+      ...source,
+      ...output,
+      ...differences,
+      ...values,
+      ...samples,
+      scratch,
+      dc,
+      frequencies,
+      active,
+      seen,
+      errors,
+    ])
+      memory.release(buffer)
+  }
+}
diff --git a/benchmark/jpegxl/lossy-lab/sampled-sharpness-cost.ts b/benchmark/jpegxl/lossy-lab/sampled-sharpness-cost.ts
new file mode 100644
index 00000000..c4316d96
--- /dev/null
+++ b/benchmark/jpegxl/lossy-lab/sampled-sharpness-cost.ts
@@ -0,0 +1,116 @@
+/** First-party development estimate of our predictor-5 sharpness stream cost.
+ * Counts signed residuals per DC group, with Shannon bits and an alphabet charge.
+ * This estimates the map only; measured complete output bytes remain the gate.
+ */
+export function sharpnessResidual(
+  map: Uint8Array,
+  width: number,
+  x: number,
+  y: number,
+  rx = -1,
+  ry = -1,
+  right = -1,
+  bottom = -1,
+  value = 4,
+): number {
+  const localX = x % 256,
+    localY = y % 256
+  const left =
+    localX > 0
+      ? sharpnessSample(map, width, x - 1, y, rx, ry, right, bottom, value)
+      : localY > 0
+        ? sharpnessSample(map, width, x, y - 1, rx, ry, right, bottom, value)
+        : 0
+  const top =
+    localY > 0 ? sharpnessSample(map, width, x, y - 1, rx, ry, right, bottom, value) : left
+  const diagonal =
+    localX > 0 && localY > 0
+      ? sharpnessSample(map, width, x - 1, y - 1, rx, ry, right, bottom, value)
+      : left
+  const prediction = Math.max(
+    Math.min(left, top),
+    Math.min(Math.max(left, top), left + top - diagonal),
+  )
+  return sharpnessSample(map, width, x, y, rx, ry, right, bottom, value) - prediction + 7
+}
+
+export function sharpnessHistogramBits(histogram: Int32Array, offset = 0): number {
+  let total = 0,
+    sum = 0,
+    alphabet = 0
+  for (let i = 0; i < 15; i++) {
+    const n = histogram[offset + i] ?? 0
+    total += n
+    if (n > 0) {
+      sum += n * Math.log2(n)
+      alphabet++
+    }
+  }
+  return total ? total * Math.log2(total) - sum + alphabet * (Math.log2(total + 1) + 3) : 0
+}
+
+export function sharpnessMapCost(map: Uint8Array, width: number, height: number) {
+  const across = Math.ceil(width / 256)
+  const histogram = new Int32Array(across * Math.ceil(height / 256) * 15)
+  const delta = new Int32Array(histogram.length)
+  for (let y = 0; y < height; y++)
+    for (let x = 0; x < width; x++) {
+      const at =
+        (Math.floor(y / 256) * across + Math.floor(x / 256)) * 15 +
+        sharpnessResidual(map, width, x, y)
+      histogram[at] = (histogram[at] ?? 0) + 1
+    }
+  return {
+    bits(): number {
+      let bits = 0
+      for (let at = 0; at < histogram.length; at += 15)
+        bits += sharpnessHistogramBits(histogram, at)
+      return bits
+    },
+    change(
+      rx: number,
+      ry: number,
+      right: number,
+      bottom: number,
+      value: number,
+      commit = false,
+    ): number {
+      delta.fill(0)
+      // The predictor sees left, top and top-left: only this rectangle plus
+      // its right and bottom neighbors can change. DC-group edges reset it.
+      for (let y = ry; y < Math.min(height, bottom + 1); y++)
+        for (let x = rx; x < Math.min(width, right + 1); x++) {
+          const at = (Math.floor(y / 256) * across + Math.floor(x / 256)) * 15
+          const old = at + sharpnessResidual(map, width, x, y)
+          const next = at + sharpnessResidual(map, width, x, y, rx, ry, right, bottom, value)
+          delta[old] = (delta[old] ?? 0) - 1
+          delta[next] = (delta[next] ?? 0) + 1
+        }
+      let difference = 0
+      for (let at = 0; at < histogram.length; at += 15) {
+        const before = sharpnessHistogramBits(histogram, at)
+        for (let i = at; i < at + 15; i++) histogram[i] = (histogram[i] ?? 0) + (delta[i] ?? 0)
+        difference += sharpnessHistogramBits(histogram, at) - before
+        if (!commit)
+          for (let i = at; i < at + 15; i++) histogram[i] = (histogram[i] ?? 0) - (delta[i] ?? 0)
+      }
+      if (commit)
+        for (let y = ry; y < bottom; y++) map.fill(value, y * width + rx, y * width + right)
+      return difference
+    },
+  }
+}
+
+function sharpnessSample(
+  map: Uint8Array,
+  width: number,
+  x: number,
+  y: number,
+  rx: number,
+  ry: number,
+  right: number,
+  bottom: number,
+  value: number,
+): number {
+  return x >= rx && x < right && y >= ry && y < bottom ? value : (map[y * width + x] ?? 0)
+}
diff --git a/benchmark/jpegxl/lossy-lab/sampled-tile-mask.ts b/benchmark/jpegxl/lossy-lab/sampled-tile-mask.ts
new file mode 100644
index 00000000..21e032f3
--- /dev/null
+++ b/benchmark/jpegxl/lossy-lab/sampled-tile-mask.ts
@@ -0,0 +1,118 @@
+/**
+ * Source: libjxl lib/jxl/enc_adaptive_quantization.cc, v0.12.0,
+ * a7a9c787341cf703dede03c2009fa460cae5e5df.
+ * Copyright (c) the JPEG XL Project Authors. BSD-3-Clause
+ * Changes: the separately ported Laplacian and Blur1x1Masking formula computed
+ * on one sampled selector patch with a three-pixel halo. Clamped padded borders,
+ * Float32 intermediate storage and accumulation order match the full-plane port.
+ * Scratch is bounded independently of image dimensions. Development only.
+ */
+import type { JpegXlDevelopmentTransformContext } from '../../../src/codecs/jpegxl-development-decisions.ts'
+import type { VarDctCoefficientGeometry } from '../../../src/codecs/jpegxl-jpeg-encode.ts'
+
+export function sampledTileMask(
+  base: VarDctCoefficientGeometry,
+  context: JpegXlDevelopmentTransformContext,
+  size: number,
+) {
+  const memory = base.memory
+  if (!memory) throw new Error('Missing tile mask memory')
+  const width = base.blocksWide * 8,
+    height = base.blocksHigh * 8
+  const luma = memory.allocate(Float32Array, (size + 6) * (size + 6))
+  const raw = memory.allocate(Float32Array, (size + 4) * (size + 4))
+  const data = memory.allocate(Float32Array, size * size)
+  const numeratorMul = ((18.6580932135 * Math.LN2) / 73.377132366608819) * 3 * 226.77216153508914
+  const denominatorMul = Math.LN2 * 226.77216153508914
+  const offset = 7.7825991679894591 * Math.LN2 + 0.01
+  const adjacent = 0.364911248,
+    diagonal = 0.05,
+    farAxis = 0.1688888021,
+    mixed = 0.221069183,
+    farDiagonal = 0.306563504
+  const normalization = 1 / (1 + 4 * (adjacent + diagonal + farAxis + farDiagonal + 2 * mixed))
+  const kernel = Float64Array.of(
+    1,
+    adjacent,
+    farAxis,
+    adjacent,
+    diagonal,
+    mixed,
+    farAxis,
+    mixed,
+    farDiagonal,
+  )
+  return {
+    data,
+    fill(pixelX: number, pixelY: number): void {
+      const originX = pixelX,
+        originY = pixelY
+      // Copy each intersecting block once. readBlock returns reusable scratch.
+      for (
+        let by = Math.floor((originY - 3) / 8);
+        by <= Math.floor((originY + (size + 2)) / 8);
+        by++
+      )
+        for (
+          let bx = Math.floor((originX - 3) / 8);
+          bx <= Math.floor((originX + (size + 2)) / 8);
+          bx++
+        ) {
+          const source = context.readBlock(
+            Math.max(0, Math.min(base.blocksWide - 1, bx)),
+            Math.max(0, Math.min(base.blocksHigh - 1, by)),
+            false,
+          )[1]
+          if (!source) throw new Error('Missing tile mask luminance')
+          for (
+            let y = Math.max(originY - 3, by * 8);
+            y < Math.min(originY + (size + 3), by * 8 + 8);
+            y++
+          )
+            for (
+              let x = Math.max(originX - 3, bx * 8);
+              x < Math.min(originX + (size + 3), bx * 8 + 8);
+              x++
+            )
+              luma[(y - originY + 3) * (size + 6) + x - originX + 3] =
+                source[
+                  (Math.max(0, Math.min(height - 1, y)) % 8) * 8 +
+                    (Math.max(0, Math.min(width - 1, x)) % 8)
+                ] ?? 0
+        }
+      for (let y = 0; y < size + 4; y++)
+        for (let x = 0; x < size + 4; x++) {
+          // Clamp the Laplacian center before reading its neighbors. Clamping
+          // raw-mask coordinates is not the same as differentiating padding.
+          const px = Math.max(0, Math.min(width - 1, originX + x - 2)) - originX + 3
+          const py = Math.max(0, Math.min(height - 1, originY + y - 2)) - originY + 3
+          const at = py * (size + 6) + px,
+            value = luma[at] ?? 0
+          const average =
+            0.25 *
+            ((luma[at - (size + 6)] ?? 0) +
+              (luma[at + (size + 6)] ?? 0) +
+              (luma[at - 1] ?? 0) +
+              (luma[at + 1] ?? 0))
+          const v = Math.max(0, value + 0.019)
+          const gamma = (denominatorMul * v * v * v + offset) / (numeratorMul * v * v + 0.01)
+          raw[y * (size + 4) + x] = 1 / (Math.log1p(Math.abs(gamma * (value - average))) + 0.01)
+        }
+      for (let y = 0; y < Math.min(size, height - originY); y++)
+        for (let x = 0; x < Math.min(size, width - originX); x++) {
+          let sum = 0
+          for (let dy = -2; dy <= 2; dy++)
+            for (let dx = -2; dx <= 2; dx++)
+              sum +=
+                (kernel[Math.abs(dy) * 3 + Math.abs(dx)] ?? 0) *
+                (raw[(y + dy + 2) * (size + 4) + x + dx + 2] ?? 0)
+          data[y * size + x] = sum * normalization
+        }
+    },
+    release(): void {
+      memory.release(luma)
+      memory.release(raw)
+      memory.release(data)
+    },
+  }
+}
diff --git a/tests/jpegxl-sampled-ar.test.ts b/tests/jpegxl-sampled-ar.test.ts
