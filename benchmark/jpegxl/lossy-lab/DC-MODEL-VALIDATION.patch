@@ -0,0 +1,27 @@
+import { displayLinearPlanes, downsampleDisplay } from './libjxl-display-loss.ts'
+import { perceptualQuadraticMaps, preparePerceptualLinear } from './libjxl-perceptual-local-port.ts'
+import { mixPerceptualScales, perceptualDirectionalMap } from './libjxl-perceptual-malta-port.ts'
+import { poolNativePerceptual } from './libjxl-perceptual-pool-port.ts'
+
+/** Same first-party composition as the screened full reference; omit rejected outputs. */
+export function prepare(rgba: Uint8Array, width: number, height: number) {
+  const linear = displayLinearPlanes(rgba, width, height)
+  return {
+    full: preparePerceptualLinear(linear, width, height),
+    half: preparePerceptualLinear(
+      downsampleDisplay(linear, width, height),
+      Math.ceil(width / 2),
+      Math.ceil(height / 2),
+    ),
+  }
+}
+
+export function evaluate(source: ReturnType<typeof prepare>, decoded: ReturnType<typeof prepare>) {
+  const fineQ = perceptualQuadraticMaps(source.full, decoded.full).asymmetric
+  const halfQ = perceptualQuadraticMaps(source.half, decoded.half).asymmetric
+  const fine = perceptualDirectionalMap(source.full, decoded.full, fineQ)
+  const half = perceptualDirectionalMap(source.half, decoded.half, halfQ)
+  return poolNativePerceptual(
+    mixPerceptualScales(fine, half, source.full.width, source.full.height),
+  )
+}
