diff --git a/benchmark/jpegxl/lossy-lab/summarize-dc-model-validation.ts b/benchmark/jpegxl/lossy-lab/summarize-dc-model-validation.ts
new file mode 100644
--- /dev/null
+++ b/benchmark/jpegxl/lossy-lab/summarize-dc-model-validation.ts
@@ -0,0 +1,181 @@
+import assert from 'node:assert/strict'
+import { readFile, writeFile } from 'node:fs/promises'
+import { object, number, string } from '../comparison/model.ts'
+import { predictionAgreement } from './local-error-predictors.ts'
+
+const root = '.tmp/jpegxl-lossy-lab/dc-model-validation-20261104'
+const result = object(JSON.parse(await readFile(`${root}/results.json`, 'utf8')))
+assert.equal(result.passed, true)
+assert.equal(result.reconstructed, 1440)
+assert.ok(Array.isArray(result.rows))
+const rows = result.rows.map(object)
+type Row = ReturnType<typeof object>
+interface Pair {
+  id: string
+  distance: number
+  cohort: 'actual' | 'restorations'
+  mode: string
+  variant: string
+  before: Row
+  after: Row
+}
+function select(row: Row, key: 'observations' | 'variants', field: string, name: string) {
+  const values = row[key]
+  assert.ok(Array.isArray(values))
+  const found = values.map(object).find((value) => value[field] === name)
+  assert.ok(found)
+  return found
+}
+const pairs: Pair[] = []
+for (const row of rows) {
+  const id = string(row.id),
+    distance = number(row.distance)
+  const aligned = select(row, 'observations', 'mode', 'aligned'),
+    predictor = select(row, 'observations', 'mode', 'predictor')
+  pairs.push({
+    id,
+    distance,
+    cohort: 'actual',
+    mode: 'paired',
+    variant: 'actual',
+    before: select(aligned, 'variants', 'variant', 'actual'),
+    after: select(predictor, 'variants', 'variant', 'actual'),
+  })
+  for (const mode of [aligned, predictor])
+    for (const name of ['x', 'y', 'b', 'all']) {
+      pairs.push({
+        id,
+        distance,
+        cohort: 'restorations',
+        mode: string(mode.mode),
+        variant: name,
+        before: select(mode, 'variants', 'variant', 'actual'),
+        after: select(mode, 'variants', 'variant', name),
+      })
+    }
+}
+assert.equal(pairs.filter((p) => p.cohort === 'actual').length, 144)
+assert.equal(pairs.filter((p) => p.cohort === 'restorations').length, 1152)
+function comparison(pair: Pair, metric: 'maximum' | 'norm3') {
+  const before = number(object(pair.before.native)[metric]),
+    after = number(object(pair.after.native)[metric])
+  assert.ok(before > 0)
+  return {
+    id: pair.id,
+    distance: pair.distance,
+    cohort: pair.cohort,
+    mode: pair.mode,
+    variant: pair.variant,
+    actual: 100 * (after / before - 1),
+    predicted:
+      number(object(pair.after.predicted)[metric]) - number(object(pair.before.predicted)[metric]),
+    nativeBefore: before,
+    nativeAfter: after,
+  }
+}
+const assessments = [],
+  misses = []
+for (const cohort of ['actual', 'restorations', 'all'])
+  for (const metric of ['maximum', 'norm3'] as const) {
+    const selected = pairs
+      .filter((p) => cohort === 'all' || p.cohort === cohort)
+      .map((p) => comparison(p, metric))
+    const material = predictionAgreement(selected, 0.1)
+    assessments.push({
+      cohort,
+      metric,
+      material,
+      nonzero: predictionAgreement(selected, 1e-6),
+      nativeHarmsAboveOnePercent: selected.filter((p) => p.actual > 1).length,
+      alwaysBetterAccuracy: material.material ? material.improved / material.material : null,
+      passed:
+        material.material >= 10 &&
+        material.accuracy !== null &&
+        material.accuracy >= 0.8 &&
+        material.missedHarm === 0,
+    })
+    if (cohort !== 'all')
+      for (const row of selected)
+        if (row.actual > 1 && row.predicted <= 1e-9) misses.push({ metric, ...row })
+  }
+const gates = assessments.filter((row) => row.cohort !== 'all')
+assert.equal(gates.length, 4)
+const fidelity = (['maximum', 'norm3'] as const).map((metric) => {
+  const errors: number[] = []
+  for (const row of rows)
+    for (const name of ['aligned', 'predictor']) {
+      const mode = select(row, 'observations', 'mode', name)
+      assert.ok(Array.isArray(mode.variants))
+      for (const value of mode.variants.map(object))
+        errors.push(
+          Math.abs(number(object(value.predicted)[metric]) - number(object(value.native)[metric])),
+        )
+    }
+  assert.equal(errors.length, 1440)
+  return {
+    metric,
+    states: errors.length,
+    maximumAbsoluteError: Math.max(...errors),
+    meanAbsoluteError: errors.reduce((a, b) => a + b, 0) / errors.length,
+  }
+})
+function describe(selected: readonly Pair[]) {
+  const delta = (metric: 'maximum' | 'norm3') => selected.map((p) => comparison(p, metric).actual)
+  const maximum = delta('maximum'),
+    norm3 = delta('norm3')
+  const ssim = selected.map(
+    (p) => number(object(p.after.native).ssimulacra2) - number(object(p.before.native).ssimulacra2),
+  )
+  const mean = (values: readonly number[]) => values.reduce((a, b) => a + b, 0) / values.length
+  return {
+    pairs: selected.length,
+    ssimulacra2Points: mean(ssim),
+    norm3Percent: mean(norm3),
+    maximumPercent: mean(maximum),
+    maxHarmsAboveOnePercent: maximum.filter((p) => p > 1).length,
+    norm3HarmsAboveOnePercent: norm3.filter((p) => p > 1).length,
+    ssimImproves: ssim.filter((p) => p > 0).length,
+    norm3Improves: norm3.filter((p) => p < 0).length,
+    maxWorsens: maximum.filter((p) => p > 0).length,
+  }
+}
+const restorations = ['aligned', 'predictor'].flatMap((mode) =>
+  ['x', 'y', 'b', 'all'].map((variant) => ({
+    mode,
+    variant,
+    ...describe(
+      pairs.filter((p) => p.cohort === 'restorations' && p.mode === mode && p.variant === variant),
+    ),
+  })),
+)
+const summary = {
+  passed: true,
+  modelPassed: gates.every((p) => p.passed),
+  photos: 48,
+  states: 1440,
+  actualPairs: 144,
+  restorationPairs: 1152,
+  assessments,
+  misses,
+  fidelity,
+  descriptiveActual: describe(pairs.filter((p) => p.cohort === 'actual')),
+  descriptiveRestorations: restorations,
+  policy:
+    'Only the four actual/restoration metric gates decide. Combined and channel summaries are descriptive. No formula, threshold or subset changes.',
+  limits:
+    'Separate from the sixteen-photo model screen, but already used by the broader development campaign. Correlated distances and restorations. Butteraugli prediction is not SSIM protection, an encoder policy or speed qualification.',
+}
+await writeFile(`${root}/summary.json`, JSON.stringify(summary, null, 2) + '\n')
+console.log(
+  JSON.stringify(
+    {
+      modelPassed: summary.modelPassed,
+      assessments,
+      fidelity,
+      descriptiveActual: summary.descriptiveActual,
+      descriptiveRestorations: restorations,
+    },
+    null,
+    2,
+  ),
+)
