+import assert from 'node:assert/strict'
+import { createHash } from 'node:crypto'
+import { readFile, writeFile } from 'node:fs/promises'
+import { PNG } from 'pngjs'
+import { object, number, string } from '../comparison/model.ts'
+import { parseButteraugliOutput, parseSsimulacra2Output } from './metrics.ts'
+
+const root = '.tmp/jpegxl-lossy-lab/dc-model-validation-20261104'
+const hash = (bytes: Uint8Array) => createHash('sha256').update(bytes).digest('hex')
+const plan = object(JSON.parse(await readFile(`${root}/plan.json`, 'utf8')))
+const proposalBytes = await readFile(string(plan.proposalPath))
+assert.equal(hash(proposalBytes), plan.proposalHash)
+const proposal = object(JSON.parse(proposalBytes.toString()))
+for (const key of ['fixtureIds', 'distances', 'modes', 'variants', 'gates', 'inputs'])
+  assert.deepEqual(plan[key], proposal[key])
+assert.ok(Array.isArray(plan.sourceHashes) && Array.isArray(plan.scorerHashes))
+for (const value of [...plan.sourceHashes, ...plan.scorerHashes].map(object))
+  assert.equal(hash(await readFile(string(value.path))), value.sha256)
+const result = object(JSON.parse(await readFile(`${root}/results.json`, 'utf8')))
+assert.ok(
+  Array.isArray(result.rows) && Array.isArray(plan.inputs) && Array.isArray(plan.fixtureIds),
+)
+const inputs = plan.inputs.map(object),
+  ids = plan.fixtureIds.map(string),
+  seen = new Set<string>(),
+  sources = new Set<string>()
+const cached = new Map<string, ReturnType<typeof object>>()
+let states = 0,
+  streams = 0,
+  reused = 0,
+  evaluated = 0,
+  maximumNativePixelDifference = 0,
+  changedNativeSamples = 0
+for (const row of result.rows.map(object)) {
+  const id = string(row.id),
+    key = `${id}/${number(row.distance)}`
+  assert.ok(ids.includes(id) && !seen.has(key))
+  seen.add(key)
+  assert.ok([0.9, 1.85, 3.8].includes(number(row.distance)))
+  assert.equal(row.sharedAcAndDecisions, true)
+  assert.equal(row.allRestoredIdentical, true)
+  if (!sources.has(id)) {
+    assert.equal(hash(await readFile(string(row.sourcePng))), row.sourceHash)
+    sources.add(id)
+  }
+  assert.ok(Array.isArray(row.observations))
+  assert.deepEqual(
+    row.observations.map((p) => object(p).mode),
+    ['aligned', 'predictor'],
+  )
+  let allHash: string | undefined
+  for (const mode of row.observations.map(object)) {
+    const input = inputs.find(
+      (p) => p.id === id && p.distance === row.distance && p.mode === mode.mode,
+    )
+    assert.ok(input)
+    assert.equal(mode.streamPath, input.path)
+    const bytes = await readFile(string(mode.streamPath))
+    assert.equal(hash(bytes), mode.streamHash)
+    assert.equal(bytes.length, input.bytes)
+    streams++
+    const parity = object(mode.nativeParity)
+    maximumNativePixelDifference = Math.max(maximumNativePixelDifference, number(parity.maximum))
+    changedNativeSamples += number(parity.changed)
+    assert.ok(Array.isArray(mode.variants))
+    assert.deepEqual(
+      mode.variants.map((p) => object(p).variant),
+      ['actual', 'x', 'y', 'b', 'all'],
+    )
+    for (const variant of mode.variants.map(object)) {
+      const image = await readFile(string(variant.imagePath))
+      assert.equal(hash(image), variant.pngHash)
+      const png = PNG.sync.read(image)
+      assert.equal(png.width, 512)
+      assert.equal(png.height, 512)
+      assert.equal(hash(png.data), variant.displayHash)
+      const output = object(variant.scorerOutput),
+        native = object(variant.native),
+        ba = parseButteraugliOutput(string(output.butteraugli))
+      assert.deepEqual(native, {
+        maximum: ba.max,
+        norm3: ba.norm3,
+        ssimulacra2: parseSsimulacra2Output(string(output.ssimulacra2)),
+      })
+      const score = object(variant.predicted)
+      assert.deepEqual(Object.keys(score), ['maximum', 'norm3'])
+      assert.ok(number(score.maximum) >= 0 && number(score.norm3) >= 0)
+      const cacheKey = `${id}/${string(variant.displayHash)}`
+      if (variant.reused === true) {
+        assert.deepEqual(score, cached.get(cacheKey))
+        reused++
+      } else {
+        assert.equal(variant.reused, false)
+        assert.ok(!cached.has(cacheKey))
+        cached.set(cacheKey, score)
+        evaluated++
+      }
+      if (variant.variant === 'all') {
+        if (allHash) assert.equal(variant.displayHash, allHash)
+        else allHash = string(variant.displayHash)
+      }
+      states++
+    }
+  }
+}
+assert.equal(seen.size, 144)
+assert.equal(sources.size, 48)
+assert.equal(streams, 288)
+assert.equal(states, 1440)
+assert.equal(evaluated, result.evaluated)
+assert.equal(evaluated + reused, 1440)
+assert.ok(maximumNativePixelDifference <= 1)
+const license = (await readFile('.tmp/jpegxl-oracles/libjxl-v0.12.0/source/LICENSE', 'utf8')).trim()
+assert.ok((await readFile('THIRD_PARTY_NOTICES', 'utf8')).includes(license))
+assert.ok(
+  (await readFile('docs-astro/src/pages/third-party-notices.astro', 'utf8')).includes(
+    '../../../THIRD_PARTY_NOTICES?raw',
+  ),
+)
+const verification = {
+  passed: true,
+  photos: sources.size,
+  pairs: seen.size,
+  streams,
+  states,
+  evaluated,
+  reused,
+  maximumNativePixelDifference,
+  changedNativeSamples,
+  modelAndHelpersUnchanged: true,
+  nativeScorerReceiptsExact: true,
+  allRestoredPairsIdentical: 144,
+  fixedProposalUnchanged: true,
+  fullPackageDocsNotices: true,
+}
+await writeFile(`${root}/verification.json`, JSON.stringify(verification, null, 2) + '\n')
+console.log(JSON.stringify(verification))
diff --git a/benchmark/jpegxl/lossy-lab/verify-dc-validation-fixtures.ts b/benchmark/jpegxl/lossy-lab/verify-dc-validation-fixtures.ts
new file mode 100644
--- /dev/null
+++ b/benchmark/jpegxl/lossy-lab/verify-dc-validation-fixtures.ts
@@ -0,0 +1,57 @@
+import assert from 'node:assert/strict'
+import { readFile, writeFile } from 'node:fs/promises'
+import { PNG } from 'pngjs'
+import { object } from '../comparison/model.ts'
+import { parsePreparedManifest } from './fixture-selection.ts'
+import { verifyRestoration } from '../../../.tmp/jpegxl-lossy-lab/dc-channel-audit-20261104/channel.ts'
+import { prepare, evaluate } from './dc-validation-model.ts'
+
+const result = object(
+  JSON.parse(await readFile('.tmp/jpegxl-lossy-lab/dc-model-screen-20261104/results.json', 'utf8')),
+)
+assert.ok(Array.isArray(result.rows))
+const row = object(result.rows[0])
+const manifest = parsePreparedManifest(
+  JSON.parse(await readFile('.tmp/jpegxl-lossy-lab/corpus-512-v2/manifest.json', 'utf8')),
+)
+const fixture = manifest.fixtures.find((f) => f.id === row.id)
+assert.ok(fixture && fixture.split === 'development')
+const source = PNG.sync.read(await readFile(fixture.png)),
+  reference = prepare(source.data, source.width, source.height)
+assert.ok(Array.isArray(row.observations))
+let exact = 0
+for (const mode of row.observations.map(object)) {
+  assert.ok(Array.isArray(mode.variants))
+  for (const value of mode.variants.map(object)) {
+    if (value.variant !== 'actual' && value.variant !== 'all') continue
+    assert.equal(typeof value.imagePath, 'string')
+    if (typeof value.imagePath !== 'string') throw new Error('Missing image')
+    const png = PNG.sync.read(await readFile(value.imagePath))
+    assert.deepEqual(
+      evaluate(reference, prepare(png.data, png.width, png.height)),
+      object(value.models).directional_multiscale,
+    )
+    exact++
+  }
+}
+assert.equal(exact, 4)
+const rgba = new Uint8Array(19 * 17 * 4)
+for (let p = 0; p < 19 * 17; p++) {
+  rgba[p * 4] = p % 255
+  rgba[p * 4 + 1] = 64
+  rgba[p * 4 + 2] = 128
+  rgba[p * 4 + 3] = 255
+}
+const identity = prepare(rgba, 19, 17)
+assert.deepEqual(evaluate(identity, identity), { maximum: 0, norm3: 0 })
+const checks = {
+  passed: true,
+  exactPreviousScreenPredictions: exact,
+  oddSizeIdentity: 1,
+  restoration: verifyRestoration(),
+}
+await writeFile(
+  '.tmp/jpegxl-lossy-lab/dc-model-validation-20261104/fixture-tests.json',
+  JSON.stringify(checks, null, 2) + '\n',
+)
+console.log(JSON.stringify(checks))
