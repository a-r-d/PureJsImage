+++ b/benchmark/jpegxl/lossy-lab/dc-model-assessment.ts
@@ -0,0 +1,22 @@
+import { predictionAgreement } from './local-error-predictors.ts'
+
+export interface Prediction {
+  readonly predicted: number
+  readonly actual: number
+}
+
+/** Unchanged screening rule from PREDICTOR-REPORT.md, applied per cohort/metric. */
+export function assess(pairs: readonly Prediction[]) {
+  const material = predictionAgreement(pairs, 0.1)
+  return {
+    material,
+    nonzero: predictionAgreement(pairs, 1e-6),
+    nativeHarmsAboveOnePercent: pairs.filter((p) => p.actual > 1).length,
+    alwaysBetterAccuracy: material.material ? material.improved / material.material : null,
+    passed:
+      material.material >= 10 &&
+      material.accuracy !== null &&
+      material.accuracy >= 0.8 &&
+      material.missedHarm === 0,
+  }
+}
diff --git a/benchmark/jpegxl/lossy-lab/summarize-dc-model-screen.ts b/benchmark/jpegxl/lossy-lab/summarize-dc-model-screen.ts
new file mode 100644
--- /dev/null
+++ b/benchmark/jpegxl/lossy-lab/summarize-dc-model-screen.ts
@@ -0,0 +1,191 @@
+import assert from 'node:assert/strict'
+import { readFile, writeFile } from 'node:fs/promises'
+import { object, number } from '../comparison/model.ts'
+import { modelNames } from './dc-screen-models.ts'
+import { assess } from './dc-model-assessment.ts'
+
+const root = '.tmp/jpegxl-lossy-lab/dc-model-screen-20261104'
+const result = object(JSON.parse(await readFile(`${root}/results.json`, 'utf8')))
+assert.equal(result.passed, true)
+assert.ok(Array.isArray(result.rows))
+type Row = ReturnType<typeof object>
+const rows = result.rows.map(object)
+function mode(row: Row, name: string) {
+  assert.ok(Array.isArray(row.observations))
+  const value = row.observations.map(object).find((p) => p.mode === name)
+  assert.ok(value)
+  return value
+}
+function variant(row: Row, name: string) {
+  assert.ok(Array.isArray(row.variants))
+  const value = row.variants.map(object).find((p) => p.variant === name)
+  assert.ok(value)
+  return value
+}
+interface Pair {
+  id: string
+  distance: number
+  cohort: 'actual' | 'restorations'
+  mode: string
+  variant: string
+  before: Row
+  after: Row
+}
+const pairs: Pair[] = []
+for (const row of rows) {
+  assert.equal(typeof row.id, 'string')
+  if (typeof row.id !== 'string') throw new Error('Missing photo identity')
+  const id = row.id,
+    distance = number(row.distance)
+  const aligned = mode(row, 'aligned'),
+    predictor = mode(row, 'predictor')
+  pairs.push({
+    id,
+    distance,
+    cohort: 'actual',
+    mode: 'paired',
+    variant: 'actual',
+    before: variant(aligned, 'actual'),
+    after: variant(predictor, 'actual'),
+  })
+  for (const entry of [aligned, predictor])
+    for (const name of ['x', 'y', 'b', 'all']) {
+      assert.equal(typeof entry.mode, 'string')
+      if (typeof entry.mode !== 'string') throw new Error('Missing mode')
+      pairs.push({
+        id,
+        distance,
+        cohort: 'restorations',
+        mode: entry.mode,
+        variant: name,
+        before: variant(entry, 'actual'),
+        after: variant(entry, name),
+      })
+    }
+}
+assert.equal(pairs.length, 720)
+function comparison(pair: Pair, model: (typeof modelNames)[number], metric: 'maximum' | 'norm3') {
+  const before = number(object(pair.before.native)[metric]),
+    after = number(object(pair.after.native)[metric])
+  assert.ok(before > 0)
+  const pBefore = number(object(object(pair.before.models)[model])[metric])
+  const pAfter = number(object(object(pair.after.models)[model])[metric])
+  return {
+    id: pair.id,
+    distance: pair.distance,
+    cohort: pair.cohort,
+    mode: pair.mode,
+    variant: pair.variant,
+    model,
+    metric,
+    predicted: pAfter - pBefore,
+    actual: 100 * (after / before - 1),
+    before: pBefore,
+    after: pAfter,
+    nativeBefore: before,
+    nativeAfter: after,
+  }
+}
+const assessments: (ReturnType<typeof assess> & {
+  model: (typeof modelNames)[number]
+  cohort: string
+  metric: 'maximum' | 'norm3'
+})[] = []
+const misses = []
+for (const model of modelNames)
+  for (const cohort of ['actual', 'restorations', 'all'])
+    for (const metric of ['maximum', 'norm3'] as const) {
+      const selected = pairs
+        .filter((p) => cohort === 'all' || p.cohort === cohort)
+        .map((p) => comparison(p, model, metric))
+      assessments.push({ model, cohort, metric, ...assess(selected) })
+      if (cohort !== 'all')
+        for (const pair of selected)
+          if (pair.actual > 1 && pair.predicted <= 1e-9) misses.push(pair)
+    }
+const decisions = modelNames.map((model) => {
+  const gates = assessments.filter((row) => row.model === model && row.cohort !== 'all')
+  assert.equal(gates.length, 4)
+  return {
+    model,
+    passed: gates.every((row) => row.passed),
+    failed: gates.filter((row) => !row.passed).map((row) => `${row.cohort}/${row.metric}`),
+  }
+})
+const perVariant = []
+for (const model of modelNames)
+  for (const name of ['x', 'y', 'b', 'all'])
+    for (const metric of ['maximum', 'norm3'] as const) {
+      const selected = pairs
+        .filter((p) => p.cohort === 'restorations' && p.variant === name)
+        .map((p) => comparison(p, model, metric))
+      perVariant.push({ model, variant: name, metric, ...assess(selected) })
+    }
+const perPhoto = rows.reduce((photos: string[], row) => {
+  assert.equal(typeof row.id, 'string')
+  if (typeof row.id === 'string' && !photos.includes(row.id)) photos.push(row.id)
+  return photos
+}, [])
+const photoResults = perPhoto.map((id) => ({
+  id,
+  assessments: modelNames.flatMap((model) =>
+    (['maximum', 'norm3'] as const).map((metric) => ({
+      model,
+      metric,
+      ...assess(pairs.filter((p) => p.id === id).map((p) => comparison(p, model, metric))),
+    })),
+  ),
+}))
+const scoreFidelity = modelNames.map((model) => ({
+  model,
+  metrics: (['maximum', 'norm3'] as const).map((metric) => {
+    const errors: number[] = []
+    for (const row of rows)
+      for (const name of ['aligned', 'predictor']) {
+        const entry = mode(row, name)
+        assert.ok(Array.isArray(entry.variants))
+        for (const p of entry.variants.map(object))
+          errors.push(
+            Math.abs(
+              number(object(object(p.models)[model])[metric]) - number(object(p.native)[metric]),
+            ),
+          )
+      }
+    assert.equal(errors.length, 800)
+    return {
+      metric,
+      maximumAbsoluteError: Math.max(...errors),
+      meanAbsoluteError: errors.reduce((a, b) => a + b, 0) / errors.length,
+    }
+  }),
+}))
+await writeFile(
+  `${root}/summary.json`,
+  JSON.stringify(
+    {
+      passed: true,
+      states: 800,
+      actualPairs: 80,
+      restorationPairs: 640,
+      decisions,
+      assessments,
+      perVariant,
+      photoResults,
+      scoreFidelity,
+      misses,
+      policy:
+        'Only actual and restorations rows enter decisions. All, per-photo and per-variant rows are descriptive, not selection opportunities. Criteria and models remain unchanged from plan.json.',
+      limits:
+        'Sixteen previously inspected screen photos; strongly correlated distances, modes and counterfactuals. A passing model is only a candidate for later independent development validation. No encoder or speed qualification.',
+    },
+    null,
+    2,
+  ) + '\n',
+)
+console.log(
+  JSON.stringify(
+    { decisions, assessments: assessments.filter((row) => row.cohort !== 'all'), scoreFidelity },
+    null,
+    2,
+  ),
+)
diff --git a/benchmark/jpegxl/lossy-lab/verify-dc-model-assessment.ts b/benchmark/jpegxl/lossy-lab/verify-dc-model-assessment.ts
