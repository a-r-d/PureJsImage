+import assert from 'node:assert/strict'
+import { createHash } from 'node:crypto'
+import { mkdir, readFile, writeFile } from 'node:fs/promises'
+import { PNG } from 'pngjs'
+import { object, number } from '../comparison/model.ts'
+import { parsePreparedManifest, selectPreparedFixtures } from './fixture-selection.ts'
+import { evaluate, prepare, modelNames, type ModelScores } from './dc-screen-models.ts'
+
+const root = '.tmp/jpegxl-lossy-lab/dc-model-screen-20261104'
+const hash = (bytes: Uint8Array) => createHash('sha256').update(bytes).digest('hex')
+const planBytes = await readFile(`${root}/plan.json`)
+const plan = object(JSON.parse(planBytes.toString()))
+assert.ok(Array.isArray(plan.models))
+assert.deepEqual(
+  plan.models.map((v) => object(v).name),
+  modelNames,
+)
+assert.equal(plan.input, '.tmp/jpegxl-lossy-lab/dc-channel-audit-20261104/audit.json')
+const inputBytes = await readFile('.tmp/jpegxl-lossy-lab/dc-channel-audit-20261104/audit.json')
+const input = object(JSON.parse(inputBytes.toString()))
+assert.equal(input.passed, true)
+assert.equal(input.reconstructed, 800)
+assert.ok(Array.isArray(input.rows))
+const inputRows = input.rows.map(object)
+const manifest = parsePreparedManifest(
+  JSON.parse(await readFile('.tmp/jpegxl-lossy-lab/corpus-512-v2/manifest.json', 'utf8')),
+)
+const selection = selectPreparedFixtures(manifest, { mode: 'screen' })
+assert.ok(selection.complete && selection.fixtures.length === 16)
+const sourceFiles = ['dc-screen-models.ts', 'run-dc-model-screen.ts']
+  .map((name) => `benchmark/jpegxl/lossy-lab/${name}`)
+  .concat([
+    'benchmark/jpegxl/lossy-lab/libjxl-display-loss.ts',
+    'benchmark/jpegxl/lossy-lab/libjxl-perceptual-local-port.ts',
+    'benchmark/jpegxl/lossy-lab/libjxl-perceptual-malta-port.ts',
+    'benchmark/jpegxl/lossy-lab/libjxl-perceptual-pool-port.ts',
+    'benchmark/jpegxl/lossy-lab/local-error-predictors.ts',
+  ])
+await mkdir(`${root}/points`, { recursive: true })
+const sourceHashes = await Promise.all(
+  sourceFiles.map(async (path) => ({ path, sha256: hash(await readFile(path)) })),
+)
+await writeFile(
+  `${root}/start.json`,
+  JSON.stringify(
+    {
+      started: new Date().toISOString(),
+      base: plan.base,
+      planHash: hash(planBytes),
+      inputHash: hash(inputBytes),
+      sourceHashes,
+    },
+    null,
+    2,
+  ) + '\n',
+  { flag: 'wx' },
+)
+let states = 0,
+  evaluated = 0
+const output = []
+for (const fixture of selection.fixtures) {
+  assert.equal(fixture.split, 'development')
+  const file = await readFile(fixture.png)
+  assert.equal(hash(file), fixture.fixtureSha256)
+  const png = PNG.sync.read(file)
+  assert.equal(png.width, 512)
+  assert.equal(png.height, 512)
+  const source = prepare(png.data, 512, 512)
+  const cache = new Map<string, ModelScores>()
+  const cases = inputRows.filter((row) => row.id === fixture.id)
+  assert.deepEqual(
+    cases.map((row) => row.distance),
+    [0.5, 1, 2, 4, 7],
+  )
+  for (const row of cases) {
+    assert.equal(row.sourceHash, fixture.fixtureSha256)
+    assert.ok(Array.isArray(row.observations))
+    const modes = row.observations.map(object)
+    assert.deepEqual(
+      modes.map((p) => p.mode),
+      ['aligned', 'predictor'],
+    )
+    const observations = []
+    for (const mode of modes) {
+      assert.ok(Array.isArray(mode.variants))
+      const variants = mode.variants.map(object)
+      assert.deepEqual(
+        variants.map((p) => p.variant),
+        ['actual', 'x', 'y', 'b', 'all'],
+      )
+      const predictions = []
+      for (const variant of variants) {
+        assert.equal(typeof variant.imagePath, 'string')
+        if (typeof variant.imagePath !== 'string') throw new Error('Missing diagnostic PNG')
+        const bytes = await readFile(variant.imagePath),
+          pngHash = hash(bytes)
+        assert.equal(pngHash, variant.pngHash)
+        let predicted = cache.get(pngHash)
+        const reused = predicted !== undefined
+        if (!predicted) {
+          const decoded = PNG.sync.read(bytes)
+          assert.equal(decoded.width, 512)
+          assert.equal(decoded.height, 512)
+          assert.equal(hash(decoded.data), variant.displayHash)
+          predicted = evaluate(source, prepare(decoded.data, 512, 512))
+          cache.set(pngHash, predicted)
+          evaluated++
+        }
+        const native = object(variant.metrics)
+        predictions.push({
+          variant: variant.variant,
+          pngHash,
+          displayHash: variant.displayHash,
+          imagePath: variant.imagePath,
+          reused,
+          native: {
+            maximum: number(native.butteraugliMax),
+            norm3: number(native.butteraugliNorm3),
+          },
+          models: predicted,
+        })
+        states++
+      }
+      observations.push({ mode: mode.mode, streamHash: mode.streamHash, variants: predictions })
+    }
+    const result = {
+      id: fixture.id,
+      distance: row.distance,
+      sourceHash: fixture.fixtureSha256,
+      observations,
+    }
+    output.push(result)
+    await writeFile(
+      `${root}/points/${fixture.id}-${String(row.distance)}.json`,
+      JSON.stringify(result, null, 2) + '\n',
+      { flag: 'wx' },
+    )
+    console.log(
+      `${output.length}/80 pairs; ${states}/800 states; ${evaluated} distinct model evaluations`,
+    )
+  }
+}
+assert.equal(states, 800)
+assert.equal(output.length, 80)
+await writeFile(
+  `${root}/results.json`,
+  JSON.stringify(
+    {
+      passed: true,
+      base: plan.base,
+      completed: new Date().toISOString(),
+      states,
+      evaluated,
+      modelNames,
+      rows: output,
+    },
+    null,
+    2,
+  ) + '\n',
+  { flag: 'wx' },
+)
+console.log(
+  'Completed three fixed formulas on all 800 saved states; no new images or native scoring.',
+)
diff --git a/benchmark/jpegxl/lossy-lab/dc-model-assessment.ts b/benchmark/jpegxl/lossy-lab/dc-model-assessment.ts
