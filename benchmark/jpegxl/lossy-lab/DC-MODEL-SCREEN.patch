@@ -0,0 +1,45 @@
+import assert from 'node:assert/strict'
+import { writeFile } from 'node:fs/promises'
+import { assess } from './dc-model-assessment.ts'
+import { prepare, evaluate, modelNames } from './dc-screen-models.ts'
+
+const correct = Array.from({ length: 10 }, (_, i) => ({
+  actual: i < 5 ? 2 : -2,
+  predicted: i < 5 ? 1 : -1,
+}))
+assert.equal(assess(correct).passed, true)
+assert.equal(assess(correct.slice(0, 9)).passed, false)
+const falseSafe = correct.map((p, i) => (i === 0 ? { ...p, predicted: 0 } : p))
+assert.equal(assess(falseSafe).material.accuracy, 0.9)
+assert.equal(assess(falseSafe).material.missedHarm, 1)
+assert.equal(assess(falseSafe).passed, false)
+const wrong = correct.map((p, i) => (i >= 7 ? { ...p, predicted: 1 } : p))
+assert.equal(assess(wrong).material.accuracy, 0.7)
+assert.equal(assess(wrong).passed, false)
+const boundary = correct.map((p, i) => (i >= 8 ? { ...p, predicted: 1 } : p))
+assert.equal(assess(boundary).material.accuracy, 0.8)
+assert.equal(assess(boundary).passed, true)
+assert.equal(assess([...correct, { actual: 0.1, predicted: -1 }]).material.material, 10)
+assert.equal(assess([...correct, { actual: 1, predicted: -1 }]).material.missedHarm, 0)
+assert.throws(() => assess([{ actual: Number.NaN, predicted: 1 }]))
+const rgba = new Uint8Array(19 * 17 * 4)
+for (let p = 0; p < 19 * 17; p++) {
+  rgba[p * 4] = p % 255
+  rgba[p * 4 + 1] = 64
+  rgba[p * 4 + 2] = 128
+  rgba[p * 4 + 3] = 255
+}
+const source = prepare(rgba, 19, 17),
+  identity = evaluate(source, source)
+for (const model of modelNames) assert.deepEqual(identity[model], { maximum: 0, norm3: 0 })
+await writeFile(
+  '.tmp/jpegxl-lossy-lab/dc-model-screen-20261104/assessment-tests.json',
+  JSON.stringify(
+    { passed: true, thresholdChecks: 8, identityModels: 3, invalidScore: 1 },
+    null,
+    2,
+  ) + '\n',
+)
+console.log(
+  'Assessment sample count, accuracy, missed-harm and threshold cases pass; all three odd-size identity models are zero.',
+)
diff --git a/benchmark/jpegxl/lossy-lab/verify-dc-model-screen.ts b/benchmark/jpegxl/lossy-lab/verify-dc-model-screen.ts
new file mode 100644
--- /dev/null
+++ b/benchmark/jpegxl/lossy-lab/verify-dc-model-screen.ts
@@ -0,0 +1,140 @@
+import assert from 'node:assert/strict'
+import { createHash } from 'node:crypto'
+import { readFile, writeFile } from 'node:fs/promises'
+import { object, number } from '../comparison/model.ts'
+import { modelNames } from './dc-screen-models.ts'
+
+const root = '.tmp/jpegxl-lossy-lab/dc-model-screen-20261104'
+const hash = (data: Uint8Array) => createHash('sha256').update(data).digest('hex')
+const start = object(JSON.parse(await readFile(`${root}/start.json`, 'utf8')))
+assert.equal(hash(await readFile(`${root}/plan.json`)), start.planHash)
+assert.ok(Array.isArray(start.sourceHashes))
+for (const entry of start.sourceHashes.map(object)) {
+  assert.equal(typeof entry.path, 'string')
+  if (typeof entry.path !== 'string') throw new Error('Missing source')
+  assert.equal(hash(await readFile(entry.path)), entry.sha256)
+}
+const oldBytes = await readFile('.tmp/jpegxl-lossy-lab/dc-channel-audit-20261104/audit.json')
+assert.equal(hash(oldBytes), start.inputHash)
+const old = object(JSON.parse(oldBytes.toString())),
+  result = object(JSON.parse(await readFile(`${root}/results.json`, 'utf8')))
+assert.ok(Array.isArray(old.rows) && Array.isArray(result.rows))
+const oldRows = old.rows.map(object)
+let checked = 0,
+  reused = 0,
+  evaluated = 0
+const keys = new Set<string>()
+const cached = new Map<string, Row>()
+type Row = ReturnType<typeof object>
+for (const row of result.rows.map(object)) {
+  const key = `${String(row.id)}/${String(row.distance)}`
+  assert.equal(keys.has(key), false)
+  keys.add(key)
+  const previous = oldRows.find((v) => v.id === row.id && v.distance === row.distance)
+  assert.ok(previous)
+  assert.equal(row.sourceHash, previous.sourceHash)
+  assert.ok(Array.isArray(row.observations) && Array.isArray(previous.observations))
+  const oldModes = previous.observations.map(object)
+  assert.deepEqual(
+    row.observations.map((v) => object(v).mode),
+    ['aligned', 'predictor'],
+  )
+  let all: Row | undefined
+  for (const mode of row.observations.map(object)) {
+    const priorMode = oldModes.find((v) => v.mode === mode.mode)
+    assert.ok(priorMode)
+    assert.equal(mode.streamHash, priorMode.streamHash)
+    assert.ok(Array.isArray(mode.variants) && Array.isArray(priorMode.variants))
+    assert.deepEqual(
+      mode.variants.map((v) => object(v).variant),
+      ['actual', 'x', 'y', 'b', 'all'],
+    )
+    const priorVariants = priorMode.variants.map(object)
+    for (const variant of mode.variants.map(object)) {
+      const original = priorVariants.find((v) => v.variant === variant.variant)
+      assert.ok(original)
+      assert.equal(variant.pngHash, original.pngHash)
+      assert.equal(variant.displayHash, original.displayHash)
+      assert.equal(variant.imagePath, original.imagePath)
+      assert.equal(typeof variant.imagePath, 'string')
+      if (typeof variant.imagePath !== 'string') throw new Error('Missing image')
+      assert.equal(hash(await readFile(variant.imagePath)), variant.pngHash)
+      assert.deepEqual(variant.native, {
+        maximum: number(object(original.metrics).butteraugliMax),
+        norm3: number(object(original.metrics).butteraugliNorm3),
+      })
+      const scores = object(variant.models)
+      assert.deepEqual(Object.keys(scores), modelNames)
+      for (const model of modelNames)
+        for (const metric of ['maximum', 'norm3'])
+          assert.ok(number(object(scores[model])[metric]) >= 0)
+      const cachedKey = `${String(row.id)}/${String(variant.pngHash)}`
+      if (variant.reused === true) {
+        assert.deepEqual(cached.get(cachedKey), scores)
+        reused++
+      } else {
+        assert.equal(variant.reused, false)
+        assert.equal(cached.has(cachedKey), false)
+        cached.set(cachedKey, scores)
+        evaluated++
+      }
+      if (variant.variant === 'all') {
+        if (all) assert.deepEqual(scores, all)
+        else all = scores
+      }
+      checked++
+    }
+  }
+}
+assert.equal(keys.size, 80)
