+import { expect, it } from 'vitest'
+import {
+  libjxlAdjustSelectedBlockQuantization,
+  libjxlThresholdQuantize,
+} from '../benchmark/jpegxl/lossy-lab/libjxl-block-quantization-port.ts'
+import { jpegXlDevelopmentDequantization } from '../src/codecs/jpegxl-vardct-render.ts'
+import {
+  jpegXlVarDctStrategyBlockWidths,
+  jpegXlVarDctStrategyBlockHeights,
+} from '../src/codecs/jpegxl-vardct-jpeg.ts'
+
+it('uses symmetric nearest-even rounding after the dead zone', () => {
+  for (const [value, threshold, expected] of [
+    [0.6, 0.64, 0],
+    [-0.6, 0.64, 0],
+    [0.64, 0.64, 1],
+    [-0.64, 0.64, -1],
+    [1.5, 0.64, 2],
+    [2.5, 0.64, 2],
+    [-1.5, 0.64, -2],
+    [-2.5, 0.64, -2],
+  ])
+    expect(libjxlThresholdQuantize(value ?? 0, threshold ?? 0)).toBe(expected)
+})
+
+it('raises flat 8x8 precision and preserves its input coefficients', () => {
+  const planes = [new Float64Array(64), new Float64Array(64), new Float64Array(64)]
+  const matrices = [
+    new Float64Array(64).fill(1),
+    new Float64Array(64).fill(1),
+    new Float64Array(64).fill(1),
+  ]
+  const thresholds = new Float64Array(12),
+    statistics = new Float64Array(8)
+  expect(
+    libjxlAdjustSelectedBlockQuantization(
+      0,
+      1,
+      1,
+      20,
+      20,
+      1,
+      1,
+      planes,
+      matrices,
+      thresholds,
+      statistics,
+    ),
+  ).toBe(21)
+  expect(Array.from(thresholds)).toEqual([
+    0.58, 0.62, 0.62, 0.62, 0.58, 0.64, 0.64, 0.64, 0.58, 0.62, 0.62, 0.62,
+  ])
+  expect(planes.every((plane) => plane.every((value) => value === 0))).toBe(true)
+})
+
+it('couples sparse luma precision and a quadrant threshold to keep a weak pattern', () => {
+  const x = new Float64Array(64),
+    y = new Float64Array(64),
+    b = new Float64Array(64)
+  y[63] = 0.55
+  b[63] = -0.55
+  const matrices = [
+    new Float64Array(64).fill(1),
+    new Float64Array(64).fill(1),
+    new Float64Array(64).fill(1),
+  ]
+  const thresholds = new Float64Array(12)
+  const quant = libjxlAdjustSelectedBlockQuantization(
+    0,
+    1,
+    1,
+    20,
+    20,
+    1,
+    1,
+    [x, y, b],
+    matrices,
+    thresholds,
+    new Float64Array(8),
+  )
+  expect(quant).toBe(22)
+  expect(thresholds[7]).toBeCloseTo((0.9999 * 0.55 * 21) / 20, 14)
+  expect(libjxlThresholdQuantize((0.55 * quant) / 20, thresholds[7] ?? 0)).toBe(1)
+  expect(libjxlThresholdQuantize(0.55, 0.64)).toBe(0)
+})
+
+it('takes the maximum channel proposal after restoring native blue coefficients', () => {
+  const x = new Float64Array(64),
+    y = new Float64Array(64),
+    b = new Float64Array(64)
+  y[63] = 2
+  b[63] = -2
+  const matrices = [
+    new Float64Array(64).fill(1),
+    new Float64Array(64).fill(1),
+    new Float64Array(64).fill(1),
+  ]
+  const run = () =>
+    libjxlAdjustSelectedBlockQuantization(
+      0,
+      1,
+      1,
+      20,
+      20,
+      1,
+      1,
+      [x, y, b],
+      matrices,
+      new Float64Array(12),
+      new Float64Array(8),
+    )
+  expect(run()).toBe(41)
+  b[63] = 0
+  expect(run()).toBe(61)
+})
+
+it.each([1, 2, 3, 12, 13, 14, 15, 16, 17])(
+  'keeps partial transform %s quantization unchanged',
+  (strategy) => {
+    const planes = [
+      new Float64Array(64).fill(100),
+      new Float64Array(64).fill(-100),
+      new Float64Array(64).fill(50),
+    ]
+    for (const quant of [1, 20, 256])
+      expect(
+        libjxlAdjustSelectedBlockQuantization(
+          strategy,
+          1,
+          1,
+          quant,
+          20,
+          1,
+          1,
+          planes,
+          jpegXlDevelopmentDequantization(strategy),
+          new Float64Array(12),
+          new Float64Array(8),
+        ),
+      ).toBe(quant)
+  },
+)
+
+it.each([6, 7, 10, 11])('uses the source error weights for rectangle strategy %s', (strategy) => {
+  const bw = jpegXlVarDctStrategyBlockWidths[strategy] ?? 0,
+    bh = jpegXlVarDctStrategyBlockHeights[strategy] ?? 0
+  const size = bw * bh * 64
+  const planes = [new Float64Array(size).fill(0.25), new Float64Array(size), new Float64Array(size)]
+  const matrices = [
+    new Float64Array(size).fill(1),
+    new Float64Array(size).fill(1),
+    new Float64Array(size).fill(1),
+  ]
+  // 16x8 uses the fourth row; 32x16 uses the second, in both orientations.
+  expect(
+    libjxlAdjustSelectedBlockQuantization(
+      strategy,
+      bw,
+      bh,
+      20,
+      20,
+      1,
+      1,
+      planes,
+      matrices,
+      new Float64Array(12),
+      new Float64Array(8),
+    ),
+  ).toBe(strategy === 6 || strategy === 7 ? 21 : 20)
+})
+
+it('bounds sparse luma enhancement at the largest decodable quantizer', () => {
+  const x = new Float64Array(256),
+    y = new Float64Array(256),
+    b = new Float64Array(256)
+  y[255] = 0.55
