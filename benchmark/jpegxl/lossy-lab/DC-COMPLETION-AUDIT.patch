+++ b/benchmark/jpegxl/lossy-lab/verify-dc-completion-tree.ts
@@ -0,0 +1,117 @@
+import assert from 'node:assert/strict'
+import { readFile, writeFile } from 'node:fs/promises'
+import { libjxlFixedDcTree } from '../../../.tmp/jpegxl-lossy-lab/dc-completion-20261103/prototype/libjxl-fixed-dc-port.ts'
+import {
+  inspectJpegXlSource,
+  JpegXlCodestreamSource,
+} from '../../../src/codecs/jpegxl-container.ts'
+import { readJpegXlSourceFrameStructures } from '../../../src/codecs/jpegxl-decode.ts'
+import { resolveJpegXlLimits } from '../../../src/codecs/jpegxl-limits.ts'
+import { prepareJpegXlVarDctLowFrequency } from '../../../src/codecs/jpegxl-vardct-render.ts'
+import { JpegXlVarDctMemoryLedger } from '../../../src/codecs/jpegxl-vardct-memory.ts'
+import { defaultImageLimits } from '../../../src/limits.ts'
+import { MemorySource } from '../../../src/source.ts'
+const root = '.tmp/jpegxl-lossy-lab/dc-completion-20261103'
+for (const [count, nodes] of [
+  [1, 1],
+  [512, 1],
+  [1024, 3],
+  [4096, 3],
+  [8192, 7],
+  [12288, 67],
+] as const)
+  assert.equal(libjxlFixedDcTree(count, 8).length, nodes)
+for (const count of [0, -1, NaN, 1.5]) assert.throws(() => libjxlFixedDcTree(count, 8))
+for (const depth of [0, 33, NaN, 1.5]) assert.throws(() => libjxlFixedDcTree(100, depth))
+const full = libjxlFixedDcTree(12288, 8)
+assert.deepEqual(
+  full
+    .filter((n) => n.kind === 'branch')
+    .map((n) => n.split)
+    .sort((a, b) => a - b),
+  [
+    -500, -392, -255, -191, -127, -95, -63, -47, -31, -23, -15, -11, -7, -4, -3, -1, 0, 1, 3, 5, 7,
+    11, 15, 23, 31, 47, 63, 95, 127, 191, 255, 392, 500,
+  ],
+)
+for (const [depth, mul] of [
+  [11, 1],
+  [12, 2],
+  [15, 16],
+  [32, 16],
+] as const) {
+  const scaled = libjxlFixedDcTree(12288, depth)
+  assert.deepEqual(
+    scaled,
+    full.map((node) => (node.kind === 'leaf' ? node : { ...node, split: node.split * mul })),
+  )
+}
+async function decode(path: string) {
+  const source = new MemorySource(await readFile(path))
+  const logical = new JpegXlCodestreamSource(
+    source,
+    await inspectJpegXlSource(source, resolveJpegXlLimits()),
+  )
+  const frame = (await readJpegXlSourceFrameStructures(logical, defaultImageLimits)).at(-1)
+  if (!frame) throw new Error('Missing frame')
+  const sections = await Promise.all(frame.sections.map((s) => logical.read(s.offset, s.length)))
+  const state = prepareJpegXlVarDctLowFrequency(
+    sections,
+    frame,
+    new JpegXlVarDctMemoryLedger(defaultImageLimits.maxDecodedBytes),
+  )
+  return { frame, sections, state }
+}
+let cases = 0
+for (const [width, height] of [
+  [1, 17],
+  [17, 1],
+  [17, 19],
+  [65, 73],
+  [2057, 9],
+  [9, 2057],
+] as const)
+  for (const distance of [0.65, 2, 7]) {
+    const name = `${width}x${height}-${distance}.jxl`
+    const before = await decode(`.tmp/jpegxl-lossy-lab/dc-quantization-20261103/fixtures/${name}`)
+    const after = await decode(`${root}/fixtures/${name}`)
+    try {
+      assert.equal(before.frame.frameFlags & 128, 128)
+      assert.equal(after.frame.frameFlags & 128, 0)
+      assert.deepEqual(after.state.dcGroup.dcCoefficients, before.state.dcGroup.dcCoefficients)
+      assert.deepEqual(
+        after.state.lfGlobal.globalModularCode?.nodes,
+        libjxlFixedDcTree(Math.ceil(width / 8) * Math.ceil(height / 8) * 3, 8),
+      )
+      if (after.sections.length > 1)
+        for (let group = 0; group < after.frame.dcGroupCount; group++)
+          assert.equal((after.sections[group + 1]?.[0] ?? 0) & 7, 5)
+      cases++
+    } finally {
+      before.state.release()
+      after.state.release()
+    }
+  }
+await writeFile(
+  `${root}/completion-checks.json`,
+  JSON.stringify({
+    passed: true,
+    cases,
+    treeExtentCases: 6,
+    invalidTreeInputs: 8,
+    bitDepthCases: 4,
+    cutoffsExact: true,
+    dcIntegersUnchanged: true,
+    smoothingOn: true,
+    globalTreeExact: true,
+  }) + '\n',
+)
+console.log(
+  JSON.stringify({
+    passed: true,
+    cases,
+    smoothingOn: true,
+    dcIntegersUnchanged: true,
+    globalTreeExact: true,
+  }),
+)
