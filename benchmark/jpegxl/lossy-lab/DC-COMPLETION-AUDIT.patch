--- /dev/null
+++ b/benchmark/jpegxl/lossy-lab/audit-dc-completion-rate.ts
@@ -0,0 +1,141 @@
+import assert from 'node:assert/strict'
+import { readFile, readdir, writeFile } from 'node:fs/promises'
+import { object } from '../comparison/model.ts'
+import { parsePoint } from './model.ts'
+import {
+  inspectJpegXlSource,
+  JpegXlCodestreamSource,
+} from '../../../src/codecs/jpegxl-container.ts'
+import {
+  readJpegXlSourceFrameStructures,
+  decodeJpegXlStandaloneModular,
+} from '../../../src/codecs/jpegxl-decode.ts'
+import { readStandaloneModularProgram } from '../../../.tmp/jpegxl-lossy-lab/dc-completion-20261103/diagnostic/jpegxl-decode.ts'
+import { resolveJpegXlLimits } from '../../../src/codecs/jpegxl-limits.ts'
+import { prepareJpegXlVarDctLowFrequency } from '../../../src/codecs/jpegxl-vardct-render.ts'
+import { JpegXlVarDctMemoryLedger } from '../../../src/codecs/jpegxl-vardct-memory.ts'
+import { defaultImageLimits } from '../../../src/limits.ts'
+import { MemorySource } from '../../../src/source.ts'
+const root = '.tmp/jpegxl-lossy-lab/dc-completion-20261103'
+const current = `${root}/screen/standalone-dc-complete-purejsimage`
+const old =
+  '.tmp/jpegxl-lossy-lab/dc-quantization-20261103/screen/standalone-dc-nonlinear-purejsimage'
+async function read(path: string) {
+  const bytes = await readFile(path)
+  const source = new MemorySource(bytes)
+  const logical = new JpegXlCodestreamSource(
+    source,
+    await inspectJpegXlSource(source, resolveJpegXlLimits()),
+  )
+  const frame = (await readJpegXlSourceFrameStructures(logical, defaultImageLimits)).at(-1)
+  if (!frame || frame.sections.length < 2 || frame.dcGroupCount !== 1)
+    throw new Error('Need separated single DC group')
+  const sections = await Promise.all(frame.sections.map((s) => logical.read(s.offset, s.length)))
+  const state = prepareJpegXlVarDctLowFrequency(
+    sections,
+    frame,
+    new JpegXlVarDctMemoryLedger(defaultImageLimits.maxDecodedBytes),
+  )
+  try {
+    const dc = sections[1]
+    if (!dc) throw new Error('Missing DC section')
+    const shape = { width: state.dcGroup.blockWidth, height: state.dcGroup.blockHeight }
+    const program = readStandaloneModularProgram(
+      dc,
+      2,
+      [shape, shape, shape],
+      1,
+      state.lfGlobal.globalModularCode,
+    )
+    const decoded = decodeJpegXlStandaloneModular(
+      dc,
+      2,
+      [shape, shape, shape],
+      1,
+      state.lfGlobal.globalModularCode,
+    )
+    return {
+      planes: decoded.planes,
+      bytes: bytes.length,
+      lfBytes: sections[0]?.length ?? 0,
+      dcBytes: dc.length,
+      headerBits: program.residualBitPosition - 2,
+      residualBits: decoded.endingBitPosition - program.residualBitPosition,
+      metadataAndPadBits: dc.length * 8 - decoded.endingBitPosition,
+      histograms: program.pixelCode.uintConfigs.length,
+      leaves: program.nodes.filter((node) => node.kind === 'leaf').length,
+    }
+  } finally {
+    state.release()
+  }
+}
+const rows = []
+for (const id of await readdir(current)) {
+  const candidate = object(JSON.parse(await readFile(`${current}/${id}/result.json`, 'utf8')))
+  const previous = object(JSON.parse(await readFile(`${old}/${id}/result.json`, 'utf8')))
+  assert.equal(candidate.fixtureSha256, previous.fixtureSha256)
+  if (!Array.isArray(candidate.points) || !Array.isArray(previous.points))
+    throw new Error('Missing points')
+  const a = candidate.points.map(parsePoint),
+    b = previous.points.map(parsePoint)
+  for (const p of a) {
+    const q = b.find((row) => row.setting === p.setting)
+    if (!q) throw new Error('Different ladders')
+    const after = await read(`${current}/${id}/${p.setting}.jxl`),
+      before = await read(`${old}/${id}/${p.setting}.jxl`)
+    assert.deepEqual(after.planes, before.planes)
+    const { planes: _after, ...next } = after,
+      { planes: _before, ...prior } = before
+    rows.push({
+      id,
+      distance: p.setting,
+      before: prior,
+      after: next,
+      dcIntegersExact: true,
+      sizeDelta: after.bytes - before.bytes,
+      modelDeltaBits: (after.lfBytes - before.lfBytes) * 8 + after.headerBits - before.headerBits,
+      residualDeltaBits: after.residualBits - before.residualBits,
+      metadataAndPadDeltaBits: after.metadataAndPadBits - before.metadataAndPadBits,
+      ssimDelta: p.ssimulacra2 - q.ssimulacra2,
+      norm3DeltaPercent: (p.butteraugliNorm3 / q.butteraugliNorm3 - 1) * 100,
+      maxDeltaPercent: (p.butteraugliMax / q.butteraugliMax - 1) * 100,
+    })
+  }
+}
+assert.equal(rows.length, 80)
+const totals = {
+  beforeBytes: 0,
+  afterBytes: 0,
+  modelDeltaBits: 0,
+  residualDeltaBits: 0,
+  metadataAndPadDeltaBits: 0,
+  ssimLosses: 0,
+  norm3Losses: 0,
+  maxLosses: 0,
+  ssimDelta: 0,
+  norm3DeltaPercent: 0,
+  maxDeltaPercent: 0,
+}
+for (const row of rows) {
+  totals.beforeBytes += row.before.bytes
+  totals.afterBytes += row.after.bytes
+  totals.modelDeltaBits += row.modelDeltaBits
+  totals.residualDeltaBits += row.residualDeltaBits
+  totals.metadataAndPadDeltaBits += row.metadataAndPadDeltaBits
+  totals.ssimLosses += Number(row.ssimDelta < 0)
+  totals.norm3Losses += Number(row.norm3DeltaPercent > 0)
+  totals.maxLosses += Number(row.maxDeltaPercent > 0)
+  totals.ssimDelta += row.ssimDelta / rows.length
+  totals.norm3DeltaPercent += row.norm3DeltaPercent / rows.length
+  totals.maxDeltaPercent += row.maxDeltaPercent / rows.length
+}
+const result = {
+  passed: true,
+  points: rows.length,
+  totals,
+  rows,
+  policy:
+    'Read-only saved development outputs. All raw DC integers and previously audited AC sections are equal. Quality changes therefore come from the smoothing flag. Model delta includes the complete LF global section and local DC header, including alignment; no omitted global tree cost. These are same-distance deltas, not BD-rates.',
+}
+await writeFile(`${root}/rate-audit.json`, JSON.stringify(result, null, 2) + '\n')
+console.log(JSON.stringify({ passed: true, points: rows.length, totals }))
diff --git a/benchmark/jpegxl/lossy-lab/verify-dc-completion-tree.ts b/benchmark/jpegxl/lossy-lab/verify-dc-completion-tree.ts
