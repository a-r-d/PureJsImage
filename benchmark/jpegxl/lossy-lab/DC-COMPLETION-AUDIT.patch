@@ -0,0 +1,45 @@
+import assert from 'node:assert/strict'
+import { execFile } from 'node:child_process'
+import { promisify } from 'node:util'
+import { readFile, writeFile } from 'node:fs/promises'
+import { PNG } from 'pngjs'
+import { encodeTransplant } from '../../../.tmp/jpegxl-lossy-lab/dc-completion-20261103/prototype/transplant.ts'
+import { libjxlPortOverrides } from '../../../.tmp/jpegxl-lossy-lab/dc-completion-20261103/prototype/libjxl-ports.ts'
+const root = '.tmp/jpegxl-lossy-lab/dc-completion-20261103'
+const rows = []
+for (const [width, height] of [
+  [17, 19],
+  [257, 17],
+] as const) {
+  const pixels = Uint8Array.from(
+    { length: width * height * 4 },
+    (_, i) => (i * 17 + Math.floor(i / width) * 37) % 256,
+  )
+  const input = pixels.slice(),
+    options = libjxlPortOverrides('standalone-dc-complete', 2, width, height)
+  const first = await encodeTransplant(pixels, width, height, 2, options),
+    second = await encodeTransplant(pixels, width, height, 2, options)
+  assert.deepEqual(first.bytes, second.bytes)
+  assert.deepEqual(pixels, input)
+  const path = `${root}/fixtures/alpha-${width}x${height}`
+  await writeFile(`${path}.jxl`, first.bytes)
+  await promisify(execFile)(
+    '.tmp/jpegxl-oracles/libjxl-v0.12.0/source/build-pinned/tools/djxl',
+    [`${path}.jxl`, `${path}.png`],
+    { timeout: 120000 },
+  )
+  const decoded = PNG.sync.read(await readFile(`${path}.png`))
+  assert.equal(decoded.width, width)
+  assert.equal(decoded.height, height)
+  for (let i = 3; i < pixels.length; i += 4) assert.equal(decoded.data[i], pixels[i])
+  rows.push({
+    width,
+    height,
+    bytes: first.bytes.length,
+    alphaExact: true,
+    nativeValid: true,
+    repeatable: true,
+  })
+}
+await writeFile(`${root}/alpha-checks.json`, JSON.stringify({ passed: true, rows }, null, 2) + '\n')
+console.log(JSON.stringify({ passed: true, cases: rows.length }))
diff --git a/benchmark/jpegxl/lossy-lab/review-dc-completion-pairs.ts b/benchmark/jpegxl/lossy-lab/review-dc-completion-pairs.ts
new file mode 100644
--- /dev/null
+++ b/benchmark/jpegxl/lossy-lab/review-dc-completion-pairs.ts
@@ -0,0 +1,65 @@
+import { readFile, writeFile } from 'node:fs/promises'
+import { object, number } from '../comparison/model.ts'
+import { parsePoint } from './model.ts'
+const root = '.tmp/jpegxl-lossy-lab/dc-completion-20261103'
+const comparison = object(JSON.parse(await readFile(`${root}/lab/against-production.json`, 'utf8')))
+if (!Array.isArray(comparison.comparisons) || typeof comparison.reference !== 'string')
+  throw new Error('Missing main comparisons')
+const worst = comparison.comparisons
+  .map(object)
+  .filter((row) => row.metric === 'butteraugliMax')
+  .sort((a, b) => number(b.percent) - number(a.percent))
+  .slice(0, 3)
+const rows = []
+for (const row of worst) {
+  if (typeof row.id !== 'string') throw new Error('Missing image')
+  const path = `${root}/lab/standalone-dc-complete-purejsimage/${row.id}`
+  const before = object(
+      JSON.parse(await readFile(`${comparison.reference}/${row.id}/result.json`, 'utf8')),
+    ),
+    after = object(JSON.parse(await readFile(`${path}/result.json`, 'utf8')))
+  if (!Array.isArray(before.points) || !Array.isArray(after.points))
+    throw new Error('Missing points')
+  const base = before.points.map(parsePoint)
+  const pairs = after.points
+    .map(parsePoint)
+    .map((candidate) => {
+      const reference = base.toSorted(
+        (a, b) =>
+          Math.abs(Math.log(a.bytes / candidate.bytes)) -
+          Math.abs(Math.log(b.bytes / candidate.bytes)),
+      )[0]
+      if (!reference) throw new Error('Missing reference')
+      return {
+        candidate,
+        reference,
+        byteRatio: candidate.bytes / reference.bytes,
+        maxRatio: candidate.butteraugliMax / reference.butteraugliMax,
+      }
+    })
+    .filter((pair) => Math.abs(Math.log(pair.byteRatio)) <= 0.15)
+    .sort((a, b) => b.maxRatio - a.maxRatio)
+  const selected = pairs[0]
+  if (!selected) throw new Error('No nearby-rate pair')
+  rows.push({
+    id: row.id,
+    bdMax: row.percent,
+    ...selected,
+    candidatePath: `${path}/${selected.candidate.setting}.png`,
+    referencePath: `${comparison.reference}/${row.id}/${selected.reference.setting}.png`,
+  })
+}
+await writeFile(`${root}/visual-pairs.json`, JSON.stringify(rows, null, 2) + '\n')
+console.log(
+  JSON.stringify(
+    rows.map((r) => ({
+      id: r.id,
+      bdMax: r.bdMax,
+      candidateDistance: r.candidate.setting,
+      mainDistance: r.reference.setting,
+      byteRatio: r.byteRatio,
+      candidatePath: r.candidatePath,
+      referencePath: r.referencePath,
+    })),
+  ),
+)
