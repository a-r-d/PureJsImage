+import { expect, it } from 'vitest'
+import { populateSelectorDcError } from '../benchmark/jpegxl/lossy-lab/selector-dc-error.ts'
+import { forwardSelectorTransform } from '../benchmark/jpegxl/lossy-lab/selector-transforms.ts'
+import { developmentDcGrid } from '../benchmark/jpegxl/lossy-lab/transform-kernels.ts'
+import {
+  inverseJpegXlDevelopmentTransform,
+  populateJpegXlDevelopmentLowestFrequencies,
+} from '../src/codecs/jpegxl-vardct-render.ts'
+import {
+  jpegXlVarDctStrategyBlockWidths,
+  jpegXlVarDctStrategyBlockHeights,
+} from '../src/codecs/jpegxl-vardct-jpeg.ts'
+
+it.each([0, 1, 4, 5, 6, 8, 10, 18, 19])(
+  'predicts the unsmoothed DC reconstruction error for strategy %s',
+  (strategy) => {
+    const bw = jpegXlVarDctStrategyBlockWidths[strategy] ?? 0,
+      bh = jpegXlVarDctStrategyBlockHeights[strategy] ?? 0,
+      width = bw * 8,
+      size = bw * bh * 64
+    const input = Float32Array.from(
+      { length: size },
+      (_, i) => 0.41 + Math.sin((i % width) / 13) * 0.03 + Math.cos(i / width / 11) * 0.02,
+    )
+    const coefficients = new Float64Array(size),
+      scratch = new Float64Array(Math.max(128, size)),
+      dc = new Float64Array(64),
+      frequencies = new Float64Array(64),
+      residual = new Float64Array(size),
+      predicted = new Float32Array(size),
+      decoded = new Float32Array(size),
+      active = new Uint16Array(64)
+    forwardSelectorTransform(strategy, input, scratch, coefficients)
+    const dcStep = 1 / 256,
+      acScale = 0.031
+    // Existing AC error must survive filling the low frequencies.
+    const acIndex = size - 1
+    residual[acIndex] = 0.0007 / acScale
+    populateSelectorDcError(coefficients, residual, bw, bh, dcStep, acScale, dc, frequencies)
+    expect(residual[acIndex]).toBe(0.0007 / acScale)
+    inverseJpegXlDevelopmentTransform(strategy, residual, scratch, predicted, active)
+    developmentDcGrid(coefficients, bw, bh, dc)
+    for (let i = 0; i < bw * bh; i++) dc[i] = Math.round((dc[i] ?? 0) / dcStep) * dcStep
+    populateJpegXlDevelopmentLowestFrequencies(coefficients, dc, bw, bh, frequencies)
+    coefficients[acIndex] = (coefficients[acIndex] ?? 0) - 0.0007
+    inverseJpegXlDevelopmentTransform(strategy, coefficients, scratch, decoded, active)
+    for (let i = 0; i < size; i++)
+      expect((predicted[i] ?? 0) * acScale).toBeCloseTo((input[i] ?? 0) - (decoded[i] ?? 0), 6)
+  },
+)
