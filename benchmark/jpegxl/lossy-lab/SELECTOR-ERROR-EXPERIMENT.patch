@@ -0,0 +1,58 @@
+import { expect, it } from 'vitest'
+import { refreshSelectorTileCorrelation } from '../benchmark/jpegxl/lossy-lab/selector-source-correlation.ts'
+
+it('recovers block-centered chroma slopes on an incomplete tile', () => {
+  const base = {
+    blocksWide: 10,
+    blocksHigh: 9,
+    correlationX: new Int32Array(4),
+    correlationB: new Int32Array(4),
+  }
+  let reads = 0
+  const context = {
+    quantize: Math.round,
+    readBlock: (x: number, y: number) => {
+      if (x >= 10 || y >= 9) throw new Error('Read outside image')
+      reads++
+      const luma = Float32Array.from({ length: 64 }, (_, p) => (p % 8) / 32 + x + y)
+      return [
+        Float32Array.from(luma, (v) => v / 4 + 3 * x),
+        luma,
+        Float32Array.from(luma, (v) => -v / 2 + y),
+      ]
+    },
+  }
+  refreshSelectorTileCorrelation(base, context, 8, 8, 'all')
+  expect(reads).toBe(2)
+  expect(base.correlationX).toEqual(Int32Array.of(0, 0, 0, 21))
+  expect(base.correlationB).toEqual(Int32Array.of(0, 0, 0, -42))
+  base.correlationB[3] = 19
+  refreshSelectorTileCorrelation(base, context, 8, 8, 'x')
+  expect(base.correlationB[3]).toBe(19)
+})
+
+it('weights sensitive blocks more strongly without changing a constant field', () => {
+  const base = {
+    blocksWide: 2,
+    blocksHigh: 1,
+    correlationX: new Int32Array(1),
+    correlationB: new Int32Array(1),
+  }
+  const context = {
+    quantize: Math.round,
+    readBlock: (x: number) => {
+      const luma = Float32Array.from({ length: 64 }, (_, p) => (p % 8) / 32)
+      return [
+        Float32Array.from(luma, (v) => v * (x === 0 ? 0.25 : 0.75)),
+        luma,
+        new Float32Array(64),
+      ]
+    },
+  }
+  refreshSelectorTileCorrelation(base, context, 0, 0, 'all')
+  const unweighted = base.correlationX[0]
+  refreshSelectorTileCorrelation(base, context, 0, 0, 'all', Float32Array.of(2, 2))
+  expect(base.correlationX[0]).toBe(unweighted)
+  refreshSelectorTileCorrelation(base, context, 0, 0, 'all', Float32Array.of(1, 4))
+  expect(base.correlationX[0]).toBeGreaterThan(unweighted ?? 0)
+})
