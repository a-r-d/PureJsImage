@@ -0,0 +1,38 @@
+/**
+ * First-party linear error estimate using our decoder's default Gaborish
+ * kernel. Candidate borders are clamped because neighboring candidates have
+ * not been selected. EPF and the inverse filter's approximation are omitted.
+ */
+export function filterSelectorError(
+  source: Float32Array,
+  destination: Float32Array,
+  width: number,
+  height: number,
+): void {
+  const adjacent = 1.1 * 0.104699568,
+    diagonal = 1.1 * 0.055680538,
+    normalization = 1 / (1 + 4 * (adjacent + diagonal)),
+    adjacentWeight = adjacent * normalization,
+    diagonalWeight = diagonal * normalization
+  for (let y = 0; y < height; y++) {
+    const row = y * width,
+      top = Math.max(0, y - 1) * width,
+      bottom = Math.min(height - 1, y + 1) * width
+    for (let x = 0; x < width; x++) {
+      const left = Math.max(0, x - 1),
+        right = Math.min(width - 1, x + 1)
+      destination[row + x] =
+        (source[row + x] ?? 0) * normalization +
+        ((source[row + left] ?? 0) +
+          (source[row + right] ?? 0) +
+          (source[top + x] ?? 0) +
+          (source[bottom + x] ?? 0)) *
+          adjacentWeight +
+        ((source[top + left] ?? 0) +
+          (source[top + right] ?? 0) +
+          (source[bottom + left] ?? 0) +
+          (source[bottom + right] ?? 0)) *
+          diagonalWeight
+    }
+  }
+}
