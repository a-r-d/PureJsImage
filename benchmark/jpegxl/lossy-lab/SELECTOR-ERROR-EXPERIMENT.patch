+/** First-party propagation of decoder CfL error into a chroma residual. */
+export function addSelectorCorrelationError(
+  residual: Float64Array,
+  luma: Float64Array,
+  blocksWide: number,
+  blocksHigh: number,
+  acRatio: number,
+  dcRatio: number,
+): void {
+  const width = Math.max(blocksWide, blocksHigh) * 8,
+    lowWidth = Math.max(blocksWide, blocksHigh),
+    lowHeight = Math.min(blocksWide, blocksHigh)
+  for (let y = 0; y < lowHeight * 8; y++)
+    for (let x = 0; x < width; x++) {
+      const p = y * width + x,
+        ratio = y < lowHeight && x < lowWidth ? dcRatio : acRatio
+      residual[p] = (residual[p] ?? 0) + ratio * (luma[p] ?? 0)
+    }
+}
