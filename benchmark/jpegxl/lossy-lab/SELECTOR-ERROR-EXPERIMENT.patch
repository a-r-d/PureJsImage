+import { expect, it } from 'vitest'
+import { filterSelectorError } from '../benchmark/jpegxl/lossy-lab/selector-gaborish-error.ts'
+
+it.each([
+  [8, 8],
+  [8, 32],
+  [32, 8],
+  [32, 32],
+])('preserves constant error including the %sx%s candidate borders', (width, height) => {
+  const source = new Float32Array(width * height).fill(0.0125),
+    destination = new Float32Array(source.length)
+  filterSelectorError(source, destination, width, height)
+  expect(destination).toEqual(source)
+})
+
+it('spreads an interior impulse symmetrically while preserving its sum', () => {
+  const source = new Float32Array(64),
+    destination = new Float32Array(64)
+  source[27] = 1
+  filterSelectorError(source, destination, 8, 8)
+  expect(destination[26]).toBe(destination[28])
+  expect(destination[19]).toBe(destination[35])
+  expect(destination[18]).toBe(destination[36])
+  expect(destination[20]).toBe(destination[34])
+  expect(destination[27]).toBeGreaterThan(destination[26] ?? 0)
+  expect(destination[26]).toBeGreaterThan(destination[18] ?? 0)
+  expect(destination.reduce((sum, value) => sum + value, 0)).toBeCloseTo(1, 6)
+  expect(destination[0]).toBe(0)
+})
