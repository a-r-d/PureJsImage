+import { expect, it } from 'vitest'
+import { addSelectorCorrelationError } from '../benchmark/jpegxl/lossy-lab/selector-correlation-error.ts'
+
+it.each([
+  [1, 1],
+  [1, 4],
+  [4, 1],
+  [4, 4],
+])('uses separate DC and AC prediction for a %sx%s footprint', (bw, bh) => {
+  const residual = new Float64Array(bw * bh * 64).fill(0.01),
+    yError = new Float64Array(residual.length).fill(-0.002),
+    width = Math.max(bw, bh) * 8
+  addSelectorCorrelationError(residual, yError, bw, bh, 1.25, 1)
+  expect(residual[0]).toBeCloseTo(0.008, 12)
+  expect(residual[(Math.min(bw, bh) - 1) * width + Math.max(bw, bh) - 1]).toBeCloseTo(0.008, 12)
+  expect(residual[Math.max(bw, bh)]).toBeCloseTo(0.0075, 12)
+  expect(residual[residual.length - 1]).toBeCloseTo(0.0075, 12)
+  expect(yError[0]).toBe(-0.002)
+})
+
+it('allows luma error to cancel an oppositely signed chroma residual', () => {
+  const residual = new Float64Array(64).fill(0.125),
+    luma = new Float64Array(64).fill(-0.5)
+  addSelectorCorrelationError(residual, luma, 1, 1, 0.25, 0)
+  expect(residual[0]).toBe(0.125)
+  expect(residual.subarray(1)).toEqual(new Float64Array(63))
+})
diff --git a/benchmark/jpegxl/lossy-lab/selector-source-correlation.ts b/benchmark/jpegxl/lossy-lab/selector-source-correlation.ts
new file mode 100644
--- /dev/null
+++ b/benchmark/jpegxl/lossy-lab/selector-source-correlation.ts
@@ -0,0 +1,73 @@
+/**
+ * Source-informed ordering: libjxl lib/jxl/enc_heuristics.cc, v0.12.0,
+ * a7a9c787341cf703dede03c2009fa460cae5e5df.
+ * Copyright (c) the JPEG XL Project Authors. BSD-3-Clause
+ * Changes: applies post-Gaborish CfL ordering to our own covariance estimator.
+ * No native CfL estimator, constants or tables are copied. Per-tile execution
+ * and optional initial-quantizer weighting are first-party adaptations.
+ */
+import type { JpegXlDevelopmentTransformContext } from '../../../src/codecs/jpegxl-development-decisions.ts'
+import type { VarDctCoefficientGeometry } from '../../../src/codecs/jpegxl-jpeg-encode.ts'
+
+/**
+ * First-party tile adaptation of our encoder's block-centered covariance CfL
+ * estimator. Runs on the selector's filtered pixels and fills its existing
+ * maps. Optional Q-squared weighting estimates sensitivity to AC precision.
+ * No libjxl CfL search, constants or tables are ported here.
+ */
+export function refreshSelectorTileCorrelation(
+  base: Pick<
+    VarDctCoefficientGeometry,
+    'blocksWide' | 'blocksHigh' | 'correlationX' | 'correlationB'
+  >,
+  context: JpegXlDevelopmentTransformContext,
+  originX: number,
+  originY: number,
+  channels: 'all' | 'x' | 'b',
+  field?: Float32Array,
+): void {
+  const xMap = base.correlationX,
+    bMap = base.correlationB
+  if (!xMap || !bMap) throw new Error('Missing own correlation maps')
+  let yy = 0,
+    xy = 0,
+    by = 0
+  for (let y = originY; y < Math.min(base.blocksHigh, originY + 8); y++)
+    for (let x = originX; x < Math.min(base.blocksWide, originX + 8); x++) {
+      const block = context.readBlock(x, y, false),
+        xp = block[0],
+        yp = block[1],
+        bp = block[2]
+      if (!xp || !yp || !bp) throw new Error('Missing correlation source plane')
+      let mx = 0,
+        my = 0,
+        mb = 0
+      for (let p = 0; p < 64; p++) {
+        mx += xp[p] ?? 0
+        my += yp[p] ?? 0
+        mb += bp[p] ?? 0
+      }
+      mx = Math.fround(mx / 64)
+      my = Math.fround(my / 64)
+      mb = Math.fround(mb / 64)
+      let localY = 0,
+        localX = 0,
+        localB = 0
+      for (let p = 0; p < 64; p++) {
+        const dy = (yp[p] ?? 0) - my
+        localY += dy * dy
+        localX += ((xp[p] ?? 0) - mx) * dy
+        localB += ((bp[p] ?? 0) - mb) * dy
+      }
+      const q = field?.[y * base.blocksWide + x] ?? 1,
+        weight = q * q
+      yy = Math.fround(yy + localY * weight)
+      xy = Math.fround(xy + localX * weight)
+      by = Math.fround(by + localB * weight)
+    }
+  const tile = Math.floor(originY / 8) * Math.ceil(base.blocksWide / 8) + Math.floor(originX / 8)
+  if (channels !== 'b')
+    xMap[tile] = yy < 1e-9 ? 0 : Math.max(-128, Math.min(127, Math.round((84 * xy) / yy)))
+  if (channels !== 'x')
+    bMap[tile] = yy < 1e-9 ? 0 : Math.max(-128, Math.min(127, Math.round((84 * by) / yy)))
+}
