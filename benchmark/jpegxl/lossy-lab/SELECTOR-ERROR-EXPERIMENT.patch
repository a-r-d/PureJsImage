+import { populateJpegXlDevelopmentLowestFrequencies } from '../../../src/codecs/jpegxl-vardct-render.ts'
+import { developmentDcGrid } from './transform-kernels.ts'
+
+/** First-party estimate of the unsmoothed DC error written by strategy-transplant. */
+export function populateSelectorDcError(
+  coefficients: Float64Array,
+  residual: Float64Array,
+  blocksWide: number,
+  blocksHigh: number,
+  dcStep: number,
+  acScale: number,
+  dc: Float64Array,
+  frequencies: Float64Array,
+): void {
+  developmentDcGrid(coefficients, blocksWide, blocksHigh, dc)
+  for (let i = 0; i < blocksWide * blocksHigh; i++) {
+    const value = dc[i] ?? 0
+    dc[i] = (value - Math.round(value / dcStep) * dcStep) / acScale
+  }
+  // The selector stores error divided by AC scale. Restore the same low
+  // frequencies as the decoder, preserving the AC error already in residual.
+  populateJpegXlDevelopmentLowestFrequencies(residual, dc, blocksWide, blocksHigh, frequencies)
+}
