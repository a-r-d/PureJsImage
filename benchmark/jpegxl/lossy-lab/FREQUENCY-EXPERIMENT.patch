diff --git a/benchmark/jpegxl/lossy-lab/frequency-allocation.ts b/benchmark/jpegxl/lossy-lab/frequency-allocation.ts
new file mode 100644
index 00000000..c77f1418
--- /dev/null
+++ b/benchmark/jpegxl/lossy-lab/frequency-allocation.ts
@@ -0,0 +1,59 @@
+/** First-party development allocation from source luma frequency energy. No peer maps. */
+import type { JpegXlDevelopmentTransformContext } from '../../../src/codecs/jpegxl-development-decisions.ts'
+import type { VarDctCoefficientGeometry } from '../../../src/codecs/jpegxl-jpeg-encode.ts'
+import { forwardSelectorTransform } from './selector-transforms.ts'
+import { frequencyBand } from './frequency-error.ts'
+export type FrequencyAllocation = 'middle' | 'detail' | 'low' | 'high'
+export function redistributeFrequencyPrecision(
+  field: Float32Array,
+  geometry: VarDctCoefficientGeometry,
+  context: JpegXlDevelopmentTransformContext,
+  band: FrequencyAllocation,
+  strength: number,
+): void {
+  const memory = geometry.memory
+  if (
+    !memory ||
+    field.length !== geometry.blocksWide * geometry.blocksHigh ||
+    !(strength > 0 && strength <= 1)
+  )
+    throw new Error('Invalid frequency allocation')
+  const shares = memory.allocate(Float32Array, field.length),
+    scratch = memory.allocate(Float64Array, 64),
+    coefficients = memory.allocate(Float64Array, 64)
+  try {
+    let mean = 0
+    for (let y = 0; y < geometry.blocksHigh; y++)
+      for (let x = 0; x < geometry.blocksWide; x++) {
+        const luma = context.readBlock(x, y, false)[1]
+        if (!luma) throw new Error('Missing source luma')
+        forwardSelectorTransform(0, luma, scratch, coefficients)
+        let selected = 0,
+          total = 0
+        for (let p = 1; p < 64; p++) {
+          const value = coefficients[p] ?? 0,
+            energy = value * value
+          const at = frequencyBand(p % 8, Math.floor(p / 8))
+          total += energy
+          if (
+            (band === 'detail' && at >= 2) ||
+            (band === 'middle' && at === 2) ||
+            (band === 'low' && at === 1) ||
+            (band === 'high' && at === 3)
+          )
+            selected += energy
+        }
+        const at = y * geometry.blocksWide + x
+        // Fixed small energy floor prevents a flat cell's rounding dust deciding allocation.
+        shares[at] = total > 1e-12 ? selected / total : 0
+        mean += shares[at] ?? 0
+      }
+    mean /= field.length
+    for (let i = 0; i < field.length; i++)
+      field[i] = (field[i] ?? 0) * Math.exp(strength * ((shares[i] ?? 0) - mean))
+  } finally {
+    memory.release(shares)
+    memory.release(scratch)
+    memory.release(coefficients)
+  }
+}
diff --git a/benchmark/jpegxl/lossy-lab/run-frequency-screen.ts b/benchmark/jpegxl/lossy-lab/run-frequency-screen.ts
new file mode 100644
index 00000000..92f1ad4e
--- /dev/null
+++ b/benchmark/jpegxl/lossy-lab/run-frequency-screen.ts
@@ -0,0 +1,78 @@
+import { execFileSync } from 'node:child_process'
+import { appendFile, mkdir, open, readFile } from 'node:fs/promises'
+import { object, number, string } from '../comparison/model.ts'
+const [root] = process.argv.slice(2)
+if (!root) throw new Error('Need output root')
+const modes = [
+  'standalone-forward-all',
+  'standalone-frequency-detail',
+  'standalone-frequency-middle',
+  'standalone-frequency-low',
+  'standalone-frequency-high',
+  'standalone-frequency-weak',
+]
+for (let index = 0; index < modes.length; index++) {
+  const mode = modes[index]
+  if (!mode) throw new Error('Missing mode')
+  const directory = `${root}/${mode}-screen`
+  await mkdir(directory)
+  const log = await open(`${directory}/run.log`, 'w')
+  console.log(`Starting ${mode}`)
+  try {
+    execFileSync(
+      process.execPath,
+      [
+        'benchmark/jpegxl/lossy-lab/run.ts',
+        '--manifest',
+        '.tmp/jpegxl-lossy-lab/corpus-512-v2/manifest.json',
+        '--out',
+        directory,
+        '--mode',
+        'screen',
+        '--variant',
+        mode,
+        '--workers',
+        '4',
+        '--strategy-port',
+        mode,
+      ],
+      { stdio: ['ignore', log.fd, log.fd] },
+    )
+    execFileSync(
+      process.execPath,
+      [
+        'benchmark/jpegxl/lossy-lab/summarize-port.ts',
+        directory,
+        `${root}/standalone-forward-all-screen/standalone-forward-all-purejsimage`,
+      ],
+      { stdio: ['ignore', log.fd, log.fd] },
+    )
+  } finally {
+    await log.close()
+  }
+  const report = object(JSON.parse(await readFile(`${directory}/against-control.json`, 'utf8')))
+  if (
+    !Array.isArray(report.control) ||
+    !Array.isArray(report.peers) ||
+    !Array.isArray(report.failures) ||
+    report.failures.length
+  )
+    throw new Error('Incomplete comparison')
+  const rates = (rows: unknown[]) =>
+    ['ssimulacra2', 'butteraugliNorm3', 'butteraugliMax']
+      .map((metric) => {
+        const row = rows.map(object).find((r) => r.metric === metric)
+        if (!row || number(row.count) !== 16) throw new Error('Incomplete metric')
+        return number(row.mean).toFixed(3)
+      })
+      .join('/')
+  const control = rates(report.control),
+    vips = rates(report.peers.filter((r) => object(r).peer === 'vips')),
+    jsquash = rates(report.peers.filter((r) => object(r).peer === 'jsquash'))
+  const label = string(mode)
+  await appendFile(
+    'benchmark/jpegxl/lossy-lab-log.md',
+    `\n| LL-${940 + index}, 2026-10-27 | ${label}: source-frequency precision redistribution at fixed geometric mean field. | All 80 screen outputs validate and score. Control ${control}%; vips ${vips}%; jSquash ${jsquash}%. | Four-worker quality timing excluded. | Screen evidence; no promotion or holdout. Raw: frequency-20261027/${label}-screen. | measured |\n`,
+  )
+  console.log(JSON.stringify({ mode, control, vips, jsquash }))
+}
diff --git a/benchmark/jpegxl/lossy-lab/frequency-error.ts b/benchmark/jpegxl/lossy-lab/frequency-error.ts
new file mode 100644
index 00000000..1b49b986
--- /dev/null
+++ b/benchmark/jpegxl/lossy-lab/frequency-error.ts
@@ -0,0 +1,88 @@
+/** First-party orthonormal 8x8 DCT diagnostic on displayed XYB planes. */
+import { dctBasis } from './transform-kernels.ts'
+import type { DisplayPlanes } from './libjxl-display-loss.ts'
+export const frequencyBands = ['dc', 'low', 'middle', 'high'] as const
+export function frequencyBand(x: number, y: number): number {
+  const sum = x + y
+  return sum === 0 ? 0 : sum <= 2 ? 1 : sum <= 6 ? 2 : 3
+}
+function transform(
+  source: Float32Array,
+  width: number,
+  x: number,
+  y: number,
+  scratch: Float64Array,
+  out: Float64Array,
+): void {
+  const basis = dctBasis(8)
+  for (let row = 0; row < 8; row++)
+    for (let u = 0; u < 8; u++) {
+      let value = 0
+      for (let col = 0; col < 8; col++)
+        value += (source[(y + row) * width + x + col] ?? 0) * (basis[u * 8 + col] ?? 0)
+      scratch[row * 8 + u] = value
+    }
+  for (let v = 0; v < 8; v++)
+    for (let u = 0; u < 8; u++) {
+      let value = 0
+      for (let row = 0; row < 8; row++)
+        value += (scratch[row * 8 + u] ?? 0) * (basis[v * 8 + row] ?? 0)
+      out[v * 8 + u] = value
+    }
+}
+export function frequencyError(
+  source: DisplayPlanes,
+  decoded: DisplayPlanes,
+  width: number,
+  height: number,
+) {
+  if (
+    !Number.isSafeInteger(width) ||
+    !Number.isSafeInteger(height) ||
+    width < 8 ||
+    height < 8 ||
+    width % 8 ||
+    height % 8 ||
+    [...source, ...decoded].some((p) => p.length !== width * height)
+  )
+    throw new Error('Expected complete 8x8 diagnostic tiles')
+  const error = new Float64Array(12),
+    signal = new Float64Array(12),
+    lost = new Float64Array(12),
+    added = new Float64Array(12)
+  const coefficientError = new Float64Array(192),
+    coefficientSignal = new Float64Array(192)
+  const a = new Float64Array(64),
+    b = new Float64Array(64),
+    scratch = new Float64Array(64)
+  for (let c = 0; c < 3; c++) {
+    const src = source[c],
+      dst = decoded[c]
+    if (!src || !dst) throw new Error('Missing plane')
+    for (let y = 0; y < height; y += 8)
+      for (let x = 0; x < width; x += 8) {
+        transform(src, width, x, y, scratch, a)
+        transform(dst, width, x, y, scratch, b)
+        for (let p = 0; p < 64; p++) {
+          const at = c * 4 + frequencyBand(p % 8, Math.floor(p / 8)),
+            av = a[p] ?? 0,
+            bv = b[p] ?? 0
+          error[at] = (error[at] ?? 0) + (av - bv) ** 2
+          const frequency = c * 64 + p
+          coefficientError[frequency] = (coefficientError[frequency] ?? 0) + (av - bv) ** 2
+          coefficientSignal[frequency] = (coefficientSignal[frequency] ?? 0) + av * av
+          signal[at] = (signal[at] ?? 0) + av * av
+          lost[at] = (lost[at] ?? 0) + Math.max(0, av * av - bv * bv)
+          added[at] = (added[at] ?? 0) + Math.max(0, bv * bv - av * av)
+        }
+      }
+  }
+  return {
+    error: Array.from(error, (v) => v / (width * height)),
+    signal: Array.from(signal, (v) => v / (width * height)),
+    lost: Array.from(lost, (v) => v / (width * height)),
+    added: Array.from(added, (v) => v / (width * height)),
+    coefficientError: Array.from(coefficientError, (v) => v / (width * height)),
+    coefficientSignal: Array.from(coefficientSignal, (v) => v / (width * height)),
+  }
+}
