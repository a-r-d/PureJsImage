diff --git a/benchmark/jpegxl/lossy-lab/selector-mask-loss.ts b/benchmark/jpegxl/lossy-lab/selector-mask-loss.ts
new file mode 100644
index 00000000..7b9ab294
--- /dev/null
+++ b/benchmark/jpegxl/lossy-lab/selector-mask-loss.ts
@@ -0,0 +1,31 @@
+/**
+ * Source: libjxl lib/jxl/enc_ac_strategy.cc, v0.12.0,
+ * a7a9c787341cf703dede03c2009fa460cae5e5df.
+ * Copyright (c) the JPEG XL Project Authors. BSD-3-Clause
+ * Changes: first-party row traversal of the already ported eighth-power spatial
+ * loss. Preserves pixel and arithmetic order; removes per-pixel division and
+ * remainder. Uses the existing bounded tile mask and adds no allocation.
+ */
+export function selectorMaskLoss(
+  spatial: Float32Array,
+  mask: Float32Array,
+  width: number,
+  height: number,
+  maskOrigin: number,
+  maskOffset: number,
+  channelWeight: number,
+): number {
+  let loss = 0,
+    p = 0
+  for (let y = 0; y < height; y++) {
+    let at = maskOrigin + y * 64
+    for (let x = 0; x < width; x++, p++, at++) {
+      let error = (spatial[p] ?? 0) * ((mask[at] ?? 1) + maskOffset) * channelWeight
+      error *= error
+      error *= error
+      error *= error
+      loss += error
+    }
+  }
+  return loss
+}
diff --git a/tests/jpegxl-selector-mask-loss.test.ts b/tests/jpegxl-selector-mask-loss.test.ts
new file mode 100644
index 00000000..9e171ffe
--- /dev/null
+++ b/tests/jpegxl-selector-mask-loss.test.ts
@@ -0,0 +1,35 @@
+import { expect, it } from 'vitest'
+import { selectorMaskLoss } from '../benchmark/jpegxl/lossy-lab/selector-mask-loss.ts'
+
+it('preserves spatial loss exactly across tile edges, transform shapes and channels', () => {
+  const spatial = Float32Array.from({ length: 4096 }, (_, p) => Math.sin(p * 1.37) / 1024)
+  const mask = Float32Array.from({ length: 4096 }, (_, p) => 1 + Math.cos(p * 0.13) * 0.99)
+  for (const width of [8, 16, 32, 64])
+    for (const height of [8, 16, 32, 64])
+      for (const [x, y] of [
+        [0, 0],
+        [64 - width, 64 - height],
+      ])
+        for (const [offset, weight] of [
+          [0, 1],
+          [12, 8.2],
+          [4, 1.03],
+        ]) {
+          if (x === undefined || y === undefined || offset === undefined || weight === undefined)
+            throw new Error('Missing test case')
+          let expected = 0
+          for (let p = 0; p < width * height; p++) {
+            let error =
+              (spatial[p] ?? 0) *
+              ((mask[(y + Math.floor(p / width)) * 64 + x + (p % width)] ?? 1) + offset) *
+              weight
+            error *= error
+            error *= error
+            error *= error
+            expected += error
+          }
+          expect(selectorMaskLoss(spatial, mask, width, height, y * 64 + x, offset, weight)).toBe(
+            expected,
+          )
+        }
+})
