+    }
+    const ratio = median(ratios)
+    runs.push({
+      run: prefix || 'initial',
+      ratio,
+      mad: median(ratios.map((value) => Math.abs(value - ratio))),
+      ratios,
+    })
+    rows.push(...selected)
+  }
+  const ratios = runs.flatMap((run) => run.ratios),
+    ratio = median(ratios)
+  if (ratios.length !== 30) throw new Error('Expected all 30 pairs')
+  summaries.push({
+    id,
+    pairs: 30,
+    ratio,
+    mad: median(ratios.map((value) => Math.abs(value - ratio))),
+    wins: ratios.filter((value) => value < 1).length,
