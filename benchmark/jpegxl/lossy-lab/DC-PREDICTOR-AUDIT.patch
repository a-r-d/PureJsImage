+const median = (values: number[]): number => {
+  const sorted = values.toSorted((a, b) => a - b),
+    half = Math.floor(sorted.length / 2)
+  return sorted.length % 2
+    ? (sorted[half] ?? 0)
+    : ((sorted[half - 1] ?? 0) + (sorted[half] ?? 0)) / 2
+}
