+import { readFile, writeFile } from 'node:fs/promises'
+import { object, number } from '../comparison/model.ts'
+const root = '.tmp/jpegxl-lossy-lab/dc-predictor-20261103'
+const median = (values: number[]): number => {
+  const sorted = values.toSorted((a, b) => a - b),
+    half = Math.floor(sorted.length / 2)
+  return sorted.length % 2
+    ? (sorted[half] ?? 0)
+    : ((sorted[half - 1] ?? 0) + (sorted[half] ?? 0)) / 2
+}
+const summaries = []
+for (const id of ['im26-3012', 'im26-3312']) {
+  const rows: Record<string, unknown>[] = [],
+    runs = []
+  for (const prefix of ['', 'confirm-']) {
+    const raw = object(JSON.parse(await readFile(`${root}/${prefix}dc-${id}-time.json`, 'utf8')))
+    if (!Array.isArray(raw.rows) || raw.count !== 15) throw new Error('Missing fixed timing run')
