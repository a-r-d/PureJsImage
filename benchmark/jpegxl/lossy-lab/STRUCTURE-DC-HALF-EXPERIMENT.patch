diff --git a/benchmark/jpegxl/lossy-lab/dc-error-diffusion.ts b/benchmark/jpegxl/lossy-lab/dc-error-diffusion.ts
new file mode 100644
index 00000000..e46ee894
--- /dev/null
+++ b/benchmark/jpegxl/lossy-lab/dc-error-diffusion.ts
@@ -0,0 +1,34 @@
+/** First-party serpentine diffusion on the DC coefficient grid; development only. */
+export function diffuseDc(
+  source:Float64Array,
+  target:Int16Array|Int32Array,
+  width:number,
+  height:number,
+  strength:number,
+  rowA:Float64Array,
+  rowB:Float64Array,
+):void {
+  if(!Number.isSafeInteger(width)||!Number.isSafeInteger(height)||width<1||height<1||
+    source.length!==width*height||target.length<source.length||rowA.length<width+2||rowB.length<width+2||
+    !Number.isFinite(strength)||strength<0||strength>1) throw new Error('Invalid DC diffusion shape')
+  rowA.fill(0);rowB.fill(0)
+  let current=rowA,next=rowB
+  for(let y=0;y<height;y++) {
+    const direction=y%2===0?1:-1
+    for(let x=direction===1?0:width-1;x>=0&&x<width;x+=direction) {
+      const at=y*width+x
+      const value=(source[at]??0)+(current[x+1]??0)
+      const rounded=Math.round(value)
+      target[at]=rounded
+      const error=(value-rounded)*strength/16
+      current[x+1+direction]=(current[x+1+direction]??0)+7*error
+      next[x+1-direction]=(next[x+1-direction]??0)+3*error
+      next[x+1]=(next[x+1]??0)+5*error
+      next[x+1+direction]=(next[x+1+direction]??0)+error
+    }
+    const old=current
+    current=next
+    next=old
+    next.fill(0)
+  }
+}
