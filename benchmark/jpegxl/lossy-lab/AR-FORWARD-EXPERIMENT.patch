+  | 'native'
+  | 'unbiased'
+  | 'four'
+  | 'all'
+  | 'unmasked'
+  | 'luma'
+  | 'safe'
+  | 'weak'
+
+export function arCandidateSteps(distance: number, mode: ArPort): readonly number[] {
+  if (mode === 'four' || mode === 'safe' || mode === 'weak') return [0, 2, 4, 7]
+  if (mode === 'all') return [0, 1, 2, 3, 4, 5, 6, 7]
+  return distance > 4.5 ? [0, 4] : [0, 2, 7]
