+              const dcPlane = base.dcComponents[c < 2 ? c ^ 1 : c]?.coefficients
+              const dst = samples[c]
+              if (!plane || !target || !matrix || !dcPlane || !dst)
+                throw new Error('Missing AR coefficient plane')
+              const offset =
+                plane.coefficientOffsets?.[(y % 32) * plane.blocksPerLineForMcu + (x % 32)]
+              if (offset === undefined || offset < 0)
+                throw new Error('Missing AR coefficient offset')
+              const scale =
+                (invGlobal / (quantization[owner] ?? 1)) *
+                (c === 0
+                  ? 0.8 ** ((base.xScale ?? 2) - 2)
+                  : c === 2
+                    ? 0.8 ** ((base.bScale ?? 2) - 2)
+                    : 1)
+              for (let p = 0; p < size; p++) {
+                const q =
+                  plane.coefficients[offset + (size === 64 ? (p & 7) * 8 + (p >>> 3) : p)] ?? 0
+                target[p] =
+                  (Math.abs(q) === 1
+                    ? Math.sign(q) * (defaultJpegXlQuantizationBiases[c] ?? 1)
+                    : q === 0
+                      ? 0
+                      : q - 0.145 / q) *
+                  scale *
+                  (matrix[p] ?? 0)
+              }
+            }
+            for (let c = 0; c < 3; c++) {
+              const target = values[c],
+                dst = samples[c],
+                dcPlane = base.dcComponents[c < 2 ? c ^ 1 : c]?.coefficients
+              if (!target || !dst || !dcPlane) throw new Error('Missing AR inverse plane')
+              const ratio =
+                c === 0
+                  ? (correlation?.baseCorrelationX ?? 0) +
+                    (base.correlationX?.[tile] ?? 0) / (correlation?.colorFactor ?? 84)
+                  : c === 2
+                    ? (correlation ? correlation.baseCorrelationB - 1 : 0) +
+                      (base.correlationB?.[tile] ?? 0) / (correlation?.colorFactor ?? 84)
+                    : 0
+              if (c !== 1)
+                for (let p = 0; p < size; p++)
+                  target[p] = (target[p] ?? 0) + (values[1][p] ?? 0) * ratio
+              const dcStep = (invGlobal * (base.dcQuantization?.[c] ?? 0)) / (base.quantDc ?? 0)
+              for (let dy = 0; dy < bh; dy++)
+                for (let dx = 0; dx < bw; dx++)
+                  dc[dy * bw + dx] = (dcPlane[(y + dy) * base.blocksWide + x + dx] ?? 0) * dcStep
+              populateJpegXlDevelopmentLowestFrequencies(target, dc, bw, bh, frequencies)
+              inverseWeightedSelectorTransform(
+                strategy,
+                target.subarray(0, size),
+                scratch,
+                dst.subarray(0, size),
+                active,
+              )
+            }
+            for (let py = Math.max(top, y * 8); py < Math.min(bottom, (y + bh) * 8); py++)
+              for (let px = Math.max(left, x * 8); px < Math.min(right, (x + bw) * 8); px++) {
+                const p = (py - y * 8) * bw * 8 + px - x * 8,
+                  at = (py - originY) * 80 + px - originX
+                raw[0][at] = samples[0][p] ?? 0
+                raw[1][at] = samples[1][p] ?? 0
+                raw[2][at] = (samples[2][p] ?? 0) + (samples[1][p] ?? 0)
+              }
+          }
+        // Gaborish clamps the image edge; EPF mirrors it after Gaborish.
+        for (let py = 0; py < 80; py++)
+          for (let px = 0; px < 80; px++) {
+            const x = Math.max(left, Math.min(right - 1, originX + px)) - originX
+            const y = Math.max(top, Math.min(bottom - 1, originY + py)) - originY
+            raw[0][py * 80 + px] = raw[0][y * 80 + x] ?? 0
+            raw[1][py * 80 + px] = raw[1][y * 80 + x] ?? 0
+            raw[2][py * 80 + px] = raw[2][y * 80 + x] ?? 0
+          }
+        if (base.developmentFilters?.gaborish)
+          gaborishJpegXlDevelopmentTile({}, raw, 80, 80, 80, differences[0])
+        for (let py = 0; py < 80; py++)
+          for (let px = 0; px < 80; px++) {
+            const gx = originX + px,
+              gy = originY + py
+            if (gx >= 0 && gx < width && gy >= 0 && gy < height) continue
+            const x = mirror(gx, width) - originX,
+              y = mirror(gy, height) - originY
+            raw[0][py * 80 + px] = raw[0][y * 80 + x] ?? 0
+            raw[1][py * 80 + px] = raw[1][y * 80 + x] ?? 0
+            raw[2][py * 80 + px] = raw[2][y * 80 + x] ?? 0
+          }
+        errors.fill(0)
+        mask.fill(tx, ty)
+        for (let s = 0; s < steps.length; s++) {
+          for (let by = 0; by < 10; by++)
+            for (let bx = 0; bx < 10; bx++) {
+              const x = Math.max(0, Math.min(base.blocksWide - 1, tx + bx - 1)),
+                y = Math.max(0, Math.min(base.blocksHigh - 1, ty + by - 1))
+              const sigma = Math.min(
+                -1e-4,
+                ((0.46 /
+                  (((base.globalScale ?? 0) / 65536) *
+                    (quantization[y * base.blocksWide + x] ?? 1) *
+                    -1.17157287525381)) *
+                  (steps[s] ?? 0)) /
+                  7,
+              )
+              inverseSigmas[by * 10 + bx] = 1 / sigma
+            }
+          filtered[0].set(raw[0])
+          filtered[1].set(raw[1])
+          filtered[2].set(raw[2])
+          if ((base.developmentFilters?.epfIterations ?? 0) >= 3) {
+            epf0JpegXlDevelopmentTile(
+              filtered,
+              80,
+              80,
+              80,
+              10,
+              inverseSigmas,
+              0,
+              output,
+              differences,
+              80,
+            )
+            copyFilteredOutput()
+          }
+          epfJpegXlDevelopmentTile(
+            filtered,
+            80,
+            80,
+            80,
+            10,
+            inverseSigmas,
+            0,
+            output,
+            differences,
+            80,
+          )
+          if ((base.developmentFilters?.epfIterations ?? 0) >= 2) {
+            copyFilteredOutput()
+            epf2JpegXlDevelopmentTile(filtered, 80, 80, 80, 10, inverseSigmas, 0, output, 80)
+          }
+          observe?.(steps[s] ?? 0, tx * 8, ty * 8, output)
+          for (let by = 0; by < Math.min(8, base.blocksHigh - ty); by++)
+            for (let bx = 0; bx < Math.min(8, base.blocksWide - tx); bx++) {
+              const source = context.readBlock(tx + bx, ty + by, false)
+              let errorX = 0,
+                errorY = 0,
+                errorB = 0
+              for (let py = 0; py < Math.min(8, height - (ty + by) * 8); py++)
+                for (let px = 0; px < Math.min(8, width - (tx + bx) * 8); px++) {
+                  const p = py * 8 + px,
+                    at = (by * 8 + py + 8) * 80 + bx * 8 + px + 8
+                  const m =
+                    mode === 'unmasked' ? 1 : (mask.data[(by * 8 + py) * 64 + bx * 8 + px] ?? 1)
+                  const dx = (source[0]?.[p] ?? 0) - (output[0][at] ?? 0)
+                  const dy = (source[1]?.[p] ?? 0) - (output[1][at] ?? 0)
+                  const db = (source[2]?.[p] ?? 0) + (source[1]?.[p] ?? 0) - (output[2][at] ?? 0)
+                  errorX += m * m * dx * dx
+                  errorY += m * m * dy * dy
+                  errorB += m * m * db * db
+                }
+              errors[s * 64 + by * 8 + bx] =
+                mode === 'luma' ? errorY : 12.339445295782363 * errorX + errorY + 0.2 * errorB
+            }
+        }
+        for (let by = 0; by < Math.min(8, base.blocksHigh - ty); by++)
+          for (let bx = 0; bx < Math.min(8, base.blocksWide - tx); bx++) {
+            for (let s = 0; s < steps.length; s++)
+              blockErrors[s] = errors[s * 64 + by * 8 + bx] ?? 0
+            sharpness[(ty + by) * base.blocksWide + tx + bx] = arBestSharpness(
+              steps,
+              blockErrors,
+              distance,
+              mode,
+            )
+          }
+      }
+  } finally {
+    mask.release()
+    for (const buffer of [
+      owners,
+      ...raw,
+      ...filtered,
+      ...output,
+      ...differences,
+      ...values,
+      ...samples,
+      scratch,
+      dc,
+      frequencies,
+      active,
+      seen,
+      inverseSigmas,
+      errors,
+      blockErrors,
+    ])
+      memory.release(buffer)
+  }
+}
diff --git a/tests/jpegxl-libjxl-ar-port.test.ts b/tests/jpegxl-libjxl-ar-port.test.ts
new file mode 100644
index 00000000..a362d234
--- /dev/null
+++ b/tests/jpegxl-libjxl-ar-port.test.ts
@@ -0,0 +1,130 @@
+import { expect, it } from 'vitest'
+import { arBestSharpness, arCandidateSteps } from '../benchmark/jpegxl/lossy-lab/libjxl-ar-port.ts'
+
+it('uses the native low and high distance sharpness choices', () => {
+  expect(arCandidateSteps(4.5, 'native')).toEqual([0, 2, 7])
+  expect(arCandidateSteps(4.51, 'native')).toEqual([0, 4])
+})
+
+it('preserves the native preference for no smoothing on tied errors', () => {
+  expect(arBestSharpness([0, 2, 7], [1, 1, 1], 2, 'native')).toBe(0)
+  expect(arBestSharpness([0, 2, 7], [1.02, 1, 1.1], 2, 'native')).toBe(0)
+  expect(arBestSharpness([0, 2, 7], [1.02, 1, 1.1], 2, 'unbiased')).toBe(2)
+})
+
+it('chooses reconstructed error rather than sharpness ordering', () => {
+  expect(arBestSharpness([0, 2, 7], [3, 2, 1], 2, 'native')).toBe(7)
+  expect(arBestSharpness([0, 2, 7], [3, 1, 2], 2, 'native')).toBe(2)
+})
+
+it('bounds the no-smoothing preference at coarse distances', () => {
+  expect(arBestSharpness([0, 4], [1.12, 1], 5, 'native')).toBe(4)
+  expect(arBestSharpness([0, 4], [1.12, 1], 25, 'native')).toBe(4)
+  expect(arBestSharpness([0, 4], [1.09, 1], 5, 'native')).toBe(0)
+})
+
+it('requires a meaningful improvement before replacing the retained sharpness', () => {
+  expect(arBestSharpness([0, 2, 4, 7], [3, 0.995, 1, 2], 2, 'safe')).toBe(4)
+  expect(arBestSharpness([0, 2, 4, 7], [3, 0.98, 1, 2], 2, 'safe')).toBe(2)
+  expect(arBestSharpness([0, 2, 4, 7], [3, 0.98, 1, 2], 2, 'weak')).toBe(4)
+})
+
+it.each([
+  [73, 29, 2],
+  [273, 79, 2],
+  [73, 29, 7],
+  [273, 79, 7],
+])(
+  'reconstructs emitted pixels across tile and group boundaries (%s x %s, d%s)',
+  async (width, height, distance) => {
+    const { libjxlPortOverrides } = await import('../benchmark/jpegxl/lossy-lab/libjxl-ports.ts')
+    const { libjxlArSharpness } = await import('../benchmark/jpegxl/lossy-lab/libjxl-ar-port.ts')
+    const { encodeTransplant } = await import('../benchmark/jpegxl/lossy-lab/transplant.ts')
+    const { convertJpegXlNativeXybPlanes } = await import('../src/codecs/jpegxl-vardct-render.ts')
+    const { jpegxlCodec } = await import('../src/codecs/jpegxl.ts')
+    const { MemorySource } = await import('../src/source.ts')
+    const { defaultImageLimits } = await import('../src/limits.ts')
+    const pixels = Uint8Array.from({ length: width * height * 4 }, (_, i) =>
+      i % 4 === 3
+        ? 255
+        : Math.round(
+            100 +
+              (i % 4) * 20 +
+              25 * Math.sin(Math.floor(i / 4) / 7) +
+              15 * Math.cos(Math.floor(i / 4 / width) / 5),
+          ),
+    )
+    const reconstructed = [
+      new Float64Array(width * height),
+      new Float64Array(width * height),
+      new Float64Array(width * height),
+    ] as const
+    const overrides = libjxlPortOverrides(
+      distance === 7 ? 'standalone-ar-iterations-static' : 'standalone-guard-coarse',
+      distance,
+      width,
+      height,
+    )
+    const rewrite = overrides.rewriteGeometry
+    if (!rewrite) throw new Error('Missing standalone rewrite')
+    const encoded = await encodeTransplant(pixels, width, height, distance, {
+      ...overrides,
+      rewriteGeometry(base, context) {
+        const geometry = rewrite(base, context)
+        libjxlArSharpness(
+          geometry,
+          context,
+          2,
+          width,
+          height,
+          'four',
+          (sharpness, x, y, planes) => {
+            if (sharpness !== 4) return
+            for (let py = 0; py < Math.min(64, height - y); py++)
+              for (let px = 0; px < Math.min(64, width - x); px++)
+                for (let c = 0; c < 3; c++) {
+                  const target = reconstructed[c]
+                  if (!target) throw new Error('Missing reconstruction target')
+                  target[(y + py) * width + x + px] = planes[c]?.[(py + 8) * 80 + px + 8] ?? 0
+                }
+          },
+        )
+        geometry.sharpnessMap?.fill(4)
+        return geometry
+      },
+    })
+    const rgb = convertJpegXlNativeXybPlanes(reconstructed, undefined)
+    const decoder = await jpegxlCodec.createDecoder?.(
+      new MemorySource(encoded.bytes),
+      defaultImageLimits,
+    )
+    if (!decoder) throw new Error('Missing decoder')
+    let maximum = 0,
+      count = 0
+    for await (const block of decoder.decode()) {
+      try {
+        for (let y = 0; y < block.height; y++)
+          for (let x = 0; x < block.width; x++)
+            for (let c = 0; c < 3; c++) {
+              const expected = Math.max(
+                0,
+                Math.min(255, Math.round((rgb[c]?.[(block.y + y) * width + x] ?? 0) * 255)),
+              )
+              maximum = Math.max(
+                maximum,
+                Math.abs(expected - (block.data[y * block.stride + x * 4 + c] ?? 0)),
+              )
+              count++
+            }
+      } finally {
+        block.release?.()
+      }
+    }
+    expect(count).toBe(width * height * 3)
+    expect(maximum).toBeLessThanOrEqual(1)
+  },
+)
+
+it('requires actual error reduction even when the no-smoothing bias prefers zero', () => {
+  expect(arBestSharpness([0, 2, 4, 7], [1.02, 2, 1, 3], 2, 'safe')).toBe(4)
+})
diff --git a/tests/jpegxl-writer-forward.test.ts b/tests/jpegxl-writer-forward.test.ts
new file mode 100644
index 00000000..b94231d0
--- /dev/null
+++ b/tests/jpegxl-writer-forward.test.ts
@@ -0,0 +1,37 @@
+import { expect, it } from 'vitest'
+import { encodeTransplant } from '../benchmark/jpegxl/lossy-lab/transplant.ts'
+import { libjxlPortOverrides } from '../benchmark/jpegxl/lossy-lab/libjxl-ports.ts'
+
+it.each([
+  'standalone-forward-small',
+  'standalone-forward-paired',
+  'standalone-forward-all',
+] as const)('preserves encoded bytes using %s writer transforms', async (mode) => {
+  const width = 129,
+    height = 89
+  const pixels = Uint8Array.from({ length: width * height * 4 }, (_, i) =>
+    i % 4 === 3
+      ? 255
+      : Math.round(
+          80 +
+            (i % 4) * 30 +
+            25 * Math.sin(Math.floor(i / 4) / 12) +
+            10 * Math.cos(Math.floor(i / 4 / width) / 9),
+        ),
+  )
+  const baseline = await encodeTransplant(
+    pixels,
+    width,
+    height,
+    2,
+    libjxlPortOverrides('standalone-guard-coarse', 2, width, height),
+  )
+  const candidate = await encodeTransplant(
+    pixels,
+    width,
+    height,
+    2,
+    libjxlPortOverrides(mode, 2, width, height),
+  )
+  expect(candidate.bytes).toEqual(baseline.bytes)
+})
