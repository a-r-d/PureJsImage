diff --git a/benchmark/jpegxl/lossy-lab/libjxl-block-quantization-port.ts b/benchmark/jpegxl/lossy-lab/libjxl-block-quantization-port.ts
new file mode 100644
index 00000000..c4a5b11d
--- /dev/null
+++ b/benchmark/jpegxl/lossy-lab/libjxl-block-quantization-port.ts
@@ -0,0 +1,147 @@
+/**
+ * Source: libjxl lib/jxl/enc_group.cc, AdjustQuantBlockAC, QuantizeBlockAC,
+ * QuantizeRoundtripYBlockAC and ComputeCoefficients; v0.12.0,
+ * a7a9c787341cf703dede03c2009fa460cae5e5df.
+ * Copyright (c) the JPEG XL Project Authors. BSD-3-Clause
+ * Changes: scalar TypeScript uses our physical dequantization steps and
+ * double-precision arithmetic. Reconstruct the native B input from our B-Y
+ * plane. Caller owns bounded scratch and keeps our separate DC representation.
+ * No SIMD, threading or native memory infrastructure is copied.
+ */
+
+const errorWeights = new Float64Array([
+  0.22080615753848404, 0.45797479824262011, 0.29859235095977965,
+  0.70109486510286834, 0.16185281305512639, 0.14387691730035473,
+  0.114985964456218638, 0.44656840441027695, 0.10587658215149048,
+  0.46849665264409396, 0.41239077937781954, 0.088667407767185444,
+])
+const magnitudeWeights = new Float64Array([
+  0.27450281941822197, 1.1255766549984996, 0.98950459134128388,
+  0.4652168675598285, 0.40945807983455818, 0.36581899811751367,
+  0.28034972424715715, 0.9182653201929738, 1.5581531543057416,
+  0.26873118114033728, 0.68863712390392484, 1.2082185408666786,
+])
+
+export function libjxlThresholdQuantize(value: number, threshold: number): number {
+  if (Math.abs(value) < threshold) return 0
+  const lower = Math.floor(value)
+  return value - lower === 0.5 ? (lower % 2 === 0 ? lower : lower + 1) : Math.round(value)
+}
+
+/** Return the selected raw quantizer and write X/Y/B quadrant thresholds. */
+export function libjxlAdjustSelectedBlockQuantization(
+  strategy: number,
+  blocksWide: number,
+  blocksHigh: number,
+  originalQuant: number,
+  invGlobal: number,
+  xMultiplier: number,
+  bMultiplier: number,
+  planes: readonly Float64Array[],
+  matrices: readonly Float64Array[],
+  thresholds: Float64Array,
+  statistics: Float64Array,
+): number {
+  const xblocks = Math.max(blocksWide, blocksHigh)
+  const yblocks = Math.min(blocksWide, blocksHigh)
+  const width = xblocks * 8
+  const height = yblocks * 8
+  const area = xblocks * yblocks
+  const partial = strategy === 1 || strategy === 2 || strategy === 3 ||
+    (strategy >= 12 && strategy <= 17)
+  let maximumQuant = 0
+  const luma = planes[1]
+  if (!luma || thresholds.length < 12 || statistics.length < 8 ||
+      !Number.isInteger(originalQuant) || originalQuant < 1 || originalQuant > 256 ||
+      !(invGlobal > 0) || !(xMultiplier > 0) || !(bMultiplier > 0))
+    throw new Error('Invalid selected-block quantization input')
+  for (let ci = 0; ci < 3; ci++) {
+    const c = ci < 2 ? ci ^ 1 : ci
+    const plane = planes[c]
+    const matrix = matrices[c]
+    if (!plane || !matrix || plane.length < area * 64 || matrix.length < area * 64)
+      throw new Error('Missing selected-block coefficients')
+    const offset = c * 4
+    thresholds[offset] = 0.58
+    for (let i = 1; i < 4; i++) thresholds[offset + i] = 0.64
+    let quant = originalQuant
+    if (!partial) {
+      if (area > 1) {
+        const reduction = Math.min(0.08, 0.003 * area)
+        for (let i = 0; i < 4; i++)
+          thresholds[offset + i] = Math.max(0.54, (thresholds[offset + i] ?? 0) - reduction)
+      }
+      statistics.fill(0, 0, 8)
+      let highFrequencySum = 0
+      let errorSum = 0
+      let magnitudeSum = 0
+      const step = invGlobal / originalQuant * (c === 0 ? xMultiplier : c === 2 ? bMultiplier : 1)
+      for (let y = 0; y < height; y++) {
+        const quadrantY = y >= height / 2 ? 2 : 0
+        for (let x = 0; x < width; x++) {
+          if (x < xblocks && y < yblocks) continue
+          const p = y * width + x
+          const quadrant = quadrantY + (x >= width / 2 ? 1 : 0)
+          const input = (plane[p] ?? 0) + (c === 2 ? luma[p] ?? 0 : 0)
+          const value = input / (step * (matrix[p] ?? 0))
+          const rounded = libjxlThresholdQuantize(value, thresholds[offset + quadrant] ?? 0)
+          const error = Math.abs(value - rounded)
+          const magnitude = Math.abs(rounded)
+          errorSum += error
+          magnitudeSum += magnitude
+          if (c === 1 && rounded === 0)
+            statistics[4 + quadrant] = Math.max(statistics[4 + quadrant] ?? 0, error)
+          if (rounded !== 0) {
+            statistics[quadrant] = (statistics[quadrant] ?? 0) + magnitude
+            if ((y >= 7 * yblocks && x >= 7 * xblocks) ||
+                ((y === height - 1 || x === width - 1) && x >= 4 * xblocks && y >= 4 * yblocks))
+              highFrequencySum += Math.abs(value)
+          }
+        }
+      }
+      const n0 = statistics[0] ?? 0, n1 = statistics[1] ?? 0
+      const n2 = statistics[2] ?? 0, n3 = statistics[3] ?? 0
+      const e0 = statistics[4] ?? 0, e1 = statistics[5] ?? 0
+      const e2 = statistics[6] ?? 0, e3 = statistics[7] ?? 0
+      if (c === 1 && magnitudeSum * 8 < area) {
+        if ((n1 === 0 && e1 > 0.46) || (n2 === 0 && e2 > 0.46) || (n3 === 0 && e3 > 0.46))
+          quant++
+        if (n3 === 0 && e3 > 0.46)
+          thresholds[offset + 3] = 0.9999 * e3 * quant / originalQuant
+        else if ((n1 === 0 && e1 > 0.46) || (n2 === 0 && e2 > 0.46)) {
+          thresholds[offset + 1] = 0.9999 * Math.max(e1, e2) * quant / originalQuant
+          thresholds[offset + 2] = thresholds[offset + 1] ?? 0
+        } else if (n0 === 0 && e0 > 0.46)
+          thresholds[offset] = 0.9999 * e0 * quant / originalQuant
+      }
+      const all = n0 + n1 + n2 + n3 + 1
+      const highFrequencyWeight = c === 0 ? 70 : c === 1 ? 30 : 60
+      if (highFrequencyWeight * highFrequencySum >= all)
+        quant = Math.min(255, Math.trunc(quant + highFrequencyWeight * highFrequencySum / all))
+      if (strategy === 0 && n0 + n1 + n2 + n3 < 11) quant = Math.min(255, quant + 1)
+      errorSum *= 2.2942708343284721
+      magnitudeSum *= 2.2942708343284721
+      if (strategy >= 4) {
+        const row = strategy === 4 ? 0 : strategy === 6 || strategy === 7 ? 1 : strategy === 5 ? 2 : 3
+        const denominator = (errorWeights[row * 3 + c] ?? 0) * area * 64 +
+          (magnitudeWeights[row * 3 + c] ?? 0) * magnitudeSum
+        if (errorSum > denominator)
+          quant = Math.min(255, quant + Math.max(0, Math.min(2, Math.trunc(errorSum / denominator))))
+      }
+      const minimum = Math.min(n0, n1, n2, n3)
+      const activity = minimum < 15 * area ? Math.trunc((Math.trunc(minimum) + Math.trunc(area / 2)) / area) : 15
+      if (c === 1)
+        for (let i = 1; i < 4; i++) thresholds[offset + i] = (thresholds[offset + i] ?? 0) + 0.01 * activity
+      quant = Math.max(4, Math.trunc(quant / 2), quant - activity)
+    }
+    maximumQuant = Math.max(maximumQuant, quant)
+  }
+  // Native discards the X/B adjustment thresholds, then quantizes their CfL
+  // residuals with these separate thresholds after reconstructing Y.
+  const chromaReduction = area >= 4 ? 0.00744 * area : 0
+  for (let c = 0; c < 3; c += 2) {
+    thresholds[c * 4] = Math.max(0.5, 0.58 - chromaReduction)
+    for (let i = 1; i < 4; i++) thresholds[c * 4 + i] = Math.max(0.5, 0.62 - chromaReduction)
+  }
+  return maximumQuant
+}
