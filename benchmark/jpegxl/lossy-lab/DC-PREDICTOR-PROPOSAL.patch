--- /dev/null
+++ b/benchmark/jpegxl/lossy-lab/libjxl-predictor-dc-port.ts
@@ -0,0 +1,103 @@
+/**
+ * Source: libjxl lib/jxl/enc_modular.cc, QuantizeWP and AddVarDCTDC;
+ * lib/jxl/quantizer.h and modular/encoding/context_predict.h; v0.12.0,
+ * a7a9c787341cf703dede03c2009fa460cae5e5df.
+ * Copyright (c) the JPEG XL Project Authors. BSD-3-Clause
+ * Changes: scalar TypeScript uses our first-party weighted predictor and memory
+ * ledger. Gather DC at one sample per 8x8 cell; reset prediction per DC group.
+ * Preserve original-luma B-Y residuals and the aligned nominal DC matrix.
+ * The existing extra precision bit is part of this nonlinear rule. Preserve float32
+ * boundaries and round halfway away from zero. Reject out-of-range integers.
+ * No native infrastructure, peer decisions or runtime dependencies.
+ */
+import {
+  defaultJpegXlWeightedPredictor,
+  JpegXlWeightedPredictor,
+} from '../../../src/codecs/jpegxl-decode.ts'
+import type { JpegXlEncoderMemory } from '../../../src/codecs/jpegxl-encoder-memory.ts'
+import type { VarDctCoefficientGeometry } from '../../../src/codecs/jpegxl-jpeg-encode.ts'
+
+const deadZone = Math.fround(0.62)
+
+/** Quantize a scaled value relative to the current weighted prediction. */
+export function libjxlNonlinearDcValue(value: number, inverseStep: number, prediction: number): number {
+  let residual = Math.fround(Math.fround(value * inverseStep) - prediction)
+  if (residual > -deadZone && residual < deadZone) residual = 0
+  if (!Number.isFinite(residual)) throw new Error('Non-finite DC quantizer input')
+  let rounded = Math.sign(residual) * Math.floor(Math.abs(residual) + 0.5)
+  if (rounded > 2 || rounded < -2)
+    rounded = Math.sign(residual) * Math.floor(Math.abs(residual * 0.5) + 0.5) * 2
+  const result = rounded + prediction
+  if (!Number.isSafeInteger(result) || result < -2_147_483_648 || result > 2_147_483_647)
+    throw new Error('DC quantizer exceeds signed 32-bit range')
+  return result === 0 ? 0 : result
+}
+
+export function libjxlQuantizeDcPlane(
+  source: Float32Array,
+  target: Int32Array,
+  stride: number,
+  originX: number,
+  originY: number,
+  width: number,
+  height: number,
+  inverseStep: number,
+  memory: JpegXlEncoderMemory,
+): void {
+  if (!(inverseStep > 0) || !Number.isFinite(inverseStep) || width < 1 || height < 1 ||
+      originX < 0 || originY < 0 || originX + width > stride ||
+      (originY + height) * stride > source.length || source.length !== target.length)
+    throw new Error('Invalid DC plane geometry or precision')
+  memory.run(() => {
+    const predictor = new JpegXlWeightedPredictor(width, defaultJpegXlWeightedPredictor, {
+      predictions: memory.allocate(Float64Array, 4),
+      predictionErrors: Array.from({ length: 4 }, () => memory.allocate(Uint32Array, (width + 2) * 2)),
+      errors: memory.allocate(Int32Array, (width + 2) * 2),
+    })
+    const properties = memory.allocate(Int32Array, 16)
+    for (let y = 0; y < height; y++) {
+      const row = (originY + y) * stride + originX
+      for (let x = 0; x < width; x++) {
+        const at = row + x
+        const left = x > 0 ? (target[at - 1] ?? 0) : y > 0 ? (target[at - stride] ?? 0) : 0
+        const top = y > 0 ? (target[at - stride] ?? 0) : left
+        const topLeft = x > 0 && y > 0 ? (target[at - stride - 1] ?? 0) : left
+        const topRight = x + 1 < width && y > 0 ? (target[at - stride + 1] ?? 0) : top
+        const topTop = y > 1 ? (target[at - 2 * stride] ?? 0) : top
+        const prediction = predictor.predict(x, y, width, top, left, topRight, topLeft, topTop, properties)
+        const quantized = libjxlNonlinearDcValue(source[at] ?? 0, inverseStep, prediction)
+        target[at] = quantized
+        predictor.update(quantized, x, y)
+      }
+    }
+  })
+}
+
+export function libjxlQuantizeDc(
+  base: VarDctCoefficientGeometry,
+  source: readonly Float32Array[],
+  wireMatrix: readonly [number, number, number],
+): void {
+  const memory = base.memory
+  const width = base.blocksWide, height = base.blocksHigh
+  if (!memory || base.colorTransform !== 'xyb' || base.shifts.some(shift => shift[0] !== 0 || shift[1] !== 0))
+    throw new Error('Predictor DC proposal requires planar XYB 4:4:4')
+  const invGlobal = 65536 / (base.globalScale ?? 0)
+  for (let c = 0; c < 3; c++) {
+    const target = base.dcComponents[c < 2 ? c ^ 1 : c]
+    const plane = source[c]
+    const step = invGlobal * (wireMatrix[c] ?? 0) / (base.quantDc ?? 0)
+    if (!target || !(target.coefficients instanceof Int32Array) || target.coefficientStride !== 1 ||
+        !plane || plane.length !== width * height || !(step > 0) || !Number.isFinite(step))
+      throw new Error('Invalid predictor DC plane or aligned step')
+    // Extra precision 1 represents half nominal steps. Large nonlinear residuals
+    // are rounded to even integers, preserving the nominal step away from prediction.
+    const inverseStep = 2 / step
+    for (let originY = 0; originY < height; originY += 256) {
+      for (let originX = 0; originX < width; originX += 256) {
+        libjxlQuantizeDcPlane(plane, target.coefficients, width, originX, originY,
+          Math.min(256, width - originX), Math.min(256, height - originY), inverseStep, memory)
+      }
+    }
+  }
+}
