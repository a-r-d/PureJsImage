+++ b/benchmark/jpegxl/lossy-lab/dc-wire-matrix.ts
@@ -0,0 +1,20 @@
+// First-party correction: use the exact serialized DC matrix when quantizing DC.
+// One fixed development trial; no peer maps or public entry point.
+import {JpegXlBitReader} from '../../../src/codecs/jpegxl-bitstream.ts'
+import {JpegXlBitWriter} from '../../../src/codecs/jpegxl-modular-encode.ts'
+import {writeJpegXlDevelopmentF16} from '../../../src/codecs/jpegxl-jpeg-encode.ts'
+import {type JpegXlEncoderMemory,withJpegXlMemory} from '../../../src/codecs/jpegxl-encoder-memory.ts'
+
+export function dcWireMatrix(values:readonly number[],memory?:JpegXlEncoderMemory):readonly [number,number,number]{
+ if(values.length!==3||values.some(value=>!(value>0)||!Number.isFinite(value))) throw new Error('Invalid DC matrix')
+ return withJpegXlMemory(memory,()=>{
+  const writer=new JpegXlBitWriter(memory,6)
+  for(const value of values) writeJpegXlDevelopmentF16(writer,value*128)
+  const reader=new JpegXlBitReader(writer.finish())
+  const read=():number=>{
+   const bits=reader.readBits(16)
+   return (1+(bits&1023)/1024)*2**(((bits>>>10)&31)-15)/128
+  }
+  return [read(),read(),read()]
+ })
+}
