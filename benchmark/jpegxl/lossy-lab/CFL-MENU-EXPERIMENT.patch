+/**
+ * Source: libjxl lib/jxl/enc_chroma_from_luma.cc (CFLFunction,
+ * FindBestMultiplier and ComputeTile), lib/jxl/enc_heuristics.cc (CfL1/CfL2),
+ * v0.12.0, a7a9c787341cf703dede03c2009fa460cae5e5df.
+ * Copyright (c) the JPEG XL Project Authors. BSD-3-Clause
+ * Changes: scalar TypeScript with double accumulators and Float32 weighted
+ * coefficients. Reuses our transforms and selector scratch, one bounded tile.
+ * B-minus-Y input makes native B base=1 algebraically equivalent to base=0.
+ * DC correlation remains our default. No SIMD, threading, native or peer maps.
+ * Diagnostics can omit shrinkage or apply our writer's chroma matrix scales.
+ */
+import type { JpegXlDevelopmentTransformContext } from '../../../src/codecs/jpegxl-development-decisions.ts'
+import type { VarDctCoefficientGeometry } from '../../../src/codecs/jpegxl-jpeg-encode.ts'
+import { jpegXlDevelopmentDequantization } from '../../../src/codecs/jpegxl-vardct-render.ts'
+import {
+  jpegXlVarDctStrategyBlockWidths,
+  jpegXlVarDctStrategyBlockHeights,
+} from '../../../src/codecs/jpegxl-vardct-jpeg.ts'
+import { libjxlTransformQuantization } from './libjxl-quantization-port.ts'
+
+export function libjxlShrinkCfLMultiplier(value: number): number {
+  const x = value >= 2.6 ? value - 2.6 : value <= -2.6 ? value + 2.6 : 0
+  const rounded = x < 0 ? -Math.round(-x) : Math.round(x)
+  return Math.max(-128, Math.min(127, rounded))
+}
+
+export function libjxlCfLMultiplier(
+  luma: Float32Array,
+  chroma: Float32Array,
+  count: number,
+  fast: boolean,
+  shrink = true,
+): number {
+  if (!Number.isInteger(count) || count < 0 || count > luma.length || count > chroma.length)
+    throw new Error('Invalid CfL coefficient extent')
+  if (count === 0) return 0
+  const regularization = count * 1e-9
+  let x = 0
+  if (fast) {
+    let ca = 0,
+      cb = 0
+    for (let i = 0; i < count; i++) {
+      const a = (luma[i] ?? 0) / 84,
+        b = -(chroma[i] ?? 0)
+      ca += a * a
+      cb += a * b
+    }
+    x = -cb / (ca + regularization * 0.5)
+  } else {
+    for (let iteration = 0; iteration < 20; iteration++) {
+      let derivative = 2 * regularization * x,
+        plus = 2 * regularization * (x + 100),
+        minus = 2 * regularization * (x - 100)
+      for (let i = 0; i < count; i++) {
+        const a = (luma[i] ?? 0) / 84,
+          b = -(chroma[i] ?? 0),
+          v = a * x + b
+        // Native uses the central residual to mask all three derivatives.
+        if (Math.abs(v) >= 100) continue
+        const vp = a * (x + 100) + b,
+          vm = a * (x - 100) + b,
+          coefficient = (2 / 3) * a
+        derivative += coefficient * (Math.abs(v) + 1) * (v < 0 ? -1 : 1)
+        plus += coefficient * (Math.abs(vp) + 1) * (vp < 0 ? -1 : 1)
+        minus += coefficient * (Math.abs(vm) + 1) * (vm < 0 ? -1 : 1)
+      }
