+                1,
+                Math.min(
+                  256,
+                  Math.floor(
+                    libjxlTransformQuantization(
+                      field,
+                      base.blocksWide,
+                      x,
+                      y,
+                      bw,
+                      bh,
+                      distance,
+                      false,
+                      false,
+                    ) + 0.5,
+                  ),
+                ),
+              )
+            : 1
+          const naturalWidth = Math.max(bw, bh) * 8
+          for (let i = 0; i < size; i++) {
+            const lf =
+              i % naturalWidth < Math.max(bw, bh) && Math.floor(i / naturalWidth) < Math.min(bw, bh)
+            const wx = q / ((mx[i] ?? 1) * scaleX),
+              wb = q / ((mb[i] ?? 1) * scaleB)
+            yx[count] = lf ? 0 : (cy[i] ?? 0) * wx
+            xx[count] = lf ? 0 : (cx[i] ?? 0) * wx
+            yb[count] = lf ? 0 : (cy[i] ?? 0) * wb
+            bb[count] = lf ? 0 : (cb[i] ?? 0) * wb
+            count++
+          }
+        }
+      const tile = Math.floor(ty / 8) * Math.ceil(base.blocksWide / 8) + Math.floor(tx / 8)
+      correlationX[tile] = libjxlCfLMultiplier(yx, xx, count, fast, shrink)
+      correlationB[tile] = libjxlCfLMultiplier(yb, bb, count, fast, shrink)
+    },
+  }
+}
