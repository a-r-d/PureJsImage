+  jpegXlVarDctStrategyBlockHeights,
+} from '../src/codecs/jpegxl-vardct-jpeg.ts'
+
+it('rounds signed shrinkage ties away from zero and clamps the map range', () => {
+  expect(libjxlShrinkCfLMultiplier(3.1)).toBe(1)
+  expect(libjxlShrinkCfLMultiplier(-3.1)).toBe(-1)
+  expect(libjxlShrinkCfLMultiplier(2.6)).toBe(0)
+  expect(libjxlShrinkCfLMultiplier(-2.6)).toBe(0)
+  expect(libjxlShrinkCfLMultiplier(1000)).toBe(127)
+  expect(libjxlShrinkCfLMultiplier(-1000)).toBe(-128)
+})
+
+it.each([false, true])('handles empty and flat coefficient sets, fast=%s', (fast) => {
+  expect(libjxlCfLMultiplier(new Float32Array(), new Float32Array(), 0, fast)).toBe(0)
+  expect(libjxlCfLMultiplier(new Float32Array(64), new Float32Array(64), 64, fast)).toBe(0)
+})
+
+it.each([1, -1])('fits and shrinks a known signed AC correlation %s', (sign) => {
+  const y = Float32Array.of(84, -84, 168, -168)
+  const x = Float32Array.from(y, (v) => (sign * v) / 4)
+  expect(libjxlCfLMultiplier(y, x, 4, true)).toBe(sign * 18)
+  expect(libjxlCfLMultiplier(y, x, 4, true, false)).toBe(sign * 21)
+  expect(Math.abs(libjxlCfLMultiplier(y, x, 4, false) - sign * 18)).toBeLessThanOrEqual(1)
+})
+
+it.each([false, true])('suppresses weak estimates and bounds signed maps, fast=%s', (fast) => {
+  const y = Float32Array.of(84, -84)
+  expect(libjxlCfLMultiplier(y, Float32Array.of(2, -2), 2, fast)).toBe(0)
+  const strong = Float32Array.of(1000, -1000)
+  if (fast) {
+    expect(libjxlCfLMultiplier(y, strong, 2, true)).toBe(127)
+    expect(libjxlCfLMultiplier(y, Float32Array.of(-1000, 1000), 2, true)).toBe(-128)
+  } else {
+    // The full fit clips large central residuals, including the initial one.
+    expect(libjxlCfLMultiplier(y, strong, 2, false)).toBe(0)
+  }
+})
+
+it('ignores clipped outliers in the full objective', () => {
+  const y = Float32Array.of(84, -84, 168, -168, 84)
+  const x = Float32Array.of(21, -21, 42, -42, 10000)
+  expect(Math.abs(libjxlCfLMultiplier(y, x, 5, false) - 18)).toBeLessThanOrEqual(1)
+  expect(libjxlCfLMultiplier(y, x, 5, true)).toBe(127)
+})
+
+it('rejects invalid coefficient extents', () => {
+  const data = new Float32Array(4)
+  for (const count of [-1, 1.5, 5, NaN])
+    expect(() => libjxlCfLMultiplier(data, data, count, true)).toThrow(
+      'Invalid CfL coefficient extent',
+    )
+})
+
+it.each([0, 1, 2, 3, 4, 5, 6, 7, 10, 11])(
+  'preserves signed linear AC fits across selected transform %s and ignores DC offsets',
+  async (strategy) => {
+    const width = 64,
+      height = 64
+    const pixels = new Uint8Array(width * height * 4).fill(128)
+    for (let p = 3; p < pixels.length; p += 4) pixels[p] = 255
+    await encodeTransplant(pixels, width, height, 2, {
+      rewriteGeometry: (base) => {
+        const memory = base.memory
+        if (!memory) throw new Error('Missing test memory')
+        const planes = Array.from({ length: 3 }, () => memory.allocate(Float32Array, 4096))
+        const transformed = Array.from({ length: 3 }, () => memory.allocate(Float64Array, 4096))
+        const scratch = memory.allocate(Float64Array, 4096)
+        const blocks = Array.from({ length: 3 }, () => memory.allocate(Float32Array, 64))
+        const field = memory.allocate(Float32Array, 64).fill(1)
+        const strategies = memory.allocate(Int32Array, 64).fill(strategy)
+        const first = memory.allocate(Uint8Array, 64)
+        const bw = jpegXlVarDctStrategyBlockWidths[strategy] ?? 0,
+          bh = jpegXlVarDctStrategyBlockHeights[strategy] ?? 0
+        for (let y = 0; y < 8; y += bh) for (let x = 0; x < 8; x += bw) first[y * 8 + x] = 1
+        const estimator = libjxlCfLEstimator(
+          base,
+          {
+            quantize: Math.round,
+            readBlock: (bx, by) => {
+              const xx = blocks[0],
+                yy = blocks[1],
+                bb = blocks[2]
+              if (!xx || !yy || !bb) throw new Error('Missing test block')
+              for (let y = 0; y < 8; y++)
+                for (let x = 0; x < 8; x++) {
+                  const v =
+                    0.2 + 0.1 * Math.sin((bx * 8 + x) / 7) + 0.04 * Math.cos((by * 8 + y) / 3)
+                  yy[y * 8 + x] = v
+                  xx[y * 8 + x] = 0.25 * v + 0.03
+                  bb[y * 8 + x] = -0.125 * v + 0.07
+                }
+              return blocks
+            },
+          },
+          { planes, transformed, scratch, transform: forwardSelectorTransform },
+          strategies,
+          first,
+          field,
+          2,
+          true,
+        )
+        const before = memory.liveBytes
+        estimator.update(0, 0, false)
+        expect(base.correlationX?.[0]).toBe(18)
+        expect(base.correlationB?.[0]).toBe(-8)
+        estimator.update(0, 0, true)
+        expect(base.correlationX?.[0]).toBe(18)
+        expect(base.correlationB?.[0]).toBe(-8)
+        estimator.release()
+        expect(memory.liveBytes).toBe(before - 65_536)
+        for (const buffer of [
+          ...planes,
+          ...transformed,
+          ...blocks,
+          scratch,
+          field,
+          strategies,
+          first,
+        ])
+          memory.release(buffer)
+        return base
+      },
+    })
+  },
