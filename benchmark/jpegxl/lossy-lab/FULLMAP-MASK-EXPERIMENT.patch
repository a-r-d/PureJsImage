+import { expect, it } from 'vitest'
+import { displayLinearPlanes } from '../benchmark/jpegxl/lossy-lab/libjxl-display-loss.ts'
+import {
+  perceptualQuadraticMaps,
+  preparePerceptualDecodedLinear,
+  preparePerceptualLinear,
+} from '../benchmark/jpegxl/lossy-lab/libjxl-perceptual-local-port.ts'
+import { perceptualDirectionalMap } from '../benchmark/jpegxl/lossy-lab/libjxl-perceptual-malta-port.ts'
+
+it('omits only the unused decoded mask and preserves full and cropped cost maps', () => {
+  for (const [width, height] of [
+    [1, 1],
+    [19, 17],
+  ]) {
+    if (!width || !height) throw new Error('Missing extent')
+    const original = Uint8Array.from({ length: width * height * 4 }, (_, i) =>
+        i % 4 === 3 ? 255 : (i * 17 + Math.floor(i / 4) * 9) % 256,
+      ),
+      changed = original.map((v, i) => (i % 4 === 3 ? v : Math.min(255, v + 4))),
+      source = preparePerceptualLinear(displayLinearPlanes(original, width, height), width, height),
+      rgb = displayLinearPlanes(changed, width, height),
+      complete = preparePerceptualLinear(rgb, width, height),
+      decoded = preparePerceptualDecodedLinear(rgb, width, height),
+      { mask, ...bands } = complete
+    expect(mask.length).toBe(width * height)
+    expect('mask' in decoded).toBe(false)
+    expect(decoded).toEqual(bands)
+    for (const box of [undefined, { x: width - 1, y: height - 1, width: 1, height: 1 }]) {
+      const expected = perceptualQuadraticMaps(source, complete, box),
+        actual = perceptualQuadraticMaps(source, decoded, box)
+      expect(actual).toEqual(expected)
+      expect(perceptualDirectionalMap(source, decoded, actual.asymmetric, box)).toEqual(
+        perceptualDirectionalMap(source, complete, expected.asymmetric, box),
+      )
+    }
+  }
+  expect(() =>
+    preparePerceptualDecodedLinear(
+      [new Float32Array(2), new Float32Array(2), new Float32Array(2)],
+      2,
+      2,
+    ),
+  ).toThrow('extent')
+})
