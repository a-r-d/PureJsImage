+// Choose the closest value produced by the normative AC reconstruction bias.
+const quantizeAcNearest = (coefficient: number, bias: number): number => {
+  const magnitude = Math.abs(coefficient)
+  let value = Math.round(magnitude)
+  const reconstructed = value === 0 ? 0 : value === 1 ? bias : value - 0.145 / value
+  const next = value === 0 ? bias : value + 1 - 0.145 / (value + 1)
+  if (magnitude > (reconstructed + next) * 0.5) value++
+  return coefficient < 0 ? -value : value
+}
 
