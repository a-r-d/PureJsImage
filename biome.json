{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!benchmark/.tmp",
      "!!benchmark/corpus/files",
      "!!benchmark/results",
      "!!tests/fixtures/scientific-ome-zarr/idr0062-6001240-v0.4/**",
      "!!tests/fixtures/scientific-ome-zarr/idr0062-6001240-v0.5/**",
      "!!tests/fixtures/scientific-ome-zarr/idr0033-BR00109990-C2-v0.5/**",
      "!!tests/fixtures/scientific-ome-zarr/idr0010-76-45-well-A1-v0.5/**",
      "!!tests/fixtures/scientific-ome-zarr/idr0001-2551-C3-0-v0.4/**",
      "!!tests/fixtures/scientific-ome-zarr/idr0101-13457537-v0.4/**",
      "!!src/scientific/formats/dicom/dictionary.generated.ts",
      "!!src/scientific/browser-reader-catalog.generated.ts",
      "!!scripts/dicom/ps3.6-2026c-registry.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "overrides": [
    {
      "includes": ["docs-astro/**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    }
  ]
}
