{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": false,
    "strict": true,
    "types": [],
    "verbatimModuleSyntax": true
  },
  "files": [
    "src/browser.ts",
    "src/scientific/browser.ts",
    "src/codec-entries/all.ts",
    "src/accelerator-entries/wasm-jpeg-browser.ts",
    "docs-astro/src/scripts/demo.ts",
    "docs-astro/src/scripts/wsi-viewer.ts",
    "docs-astro/src/scripts/wsi-worker.ts",
    "docs-astro/src/scripts/scientific-explorer.ts",
    "docs-astro/src/scripts/scientific-worker.ts"
  ]
}
